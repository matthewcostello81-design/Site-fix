{%- comment -%}
  PG Track: brand the Track123 order-tracking page, and point every "track your
  order" link at it.

  ---------------------------------------------------------------- THE LINKS

  The tracker lives at the app-proxy path /apps/track123. Every nav on the site
  was pointing at /pages/track-order instead -- a leftover North Cove page of
  carrier links with no lookup tool on it. There are four copies of that nav
  (pg-home, pg-cart-header and pg-landing render one each, and pg-theme-css
  injects a JS fallback used on the proxy page itself), spread across 73KB,
  39KB and 20KB files. Rather than rewrite three large files through the API to
  change one string in each, the href is corrected wherever it appears:

  - a few timed passes rewrite the attribute so the link previews correctly and
    middle-click / copy-link give the right URL;
  - a capture-phase click handler is the backstop, so a link injected after the
    last pass still lands on the tracker.

  Both are cheap and idempotent. No interval, no MutationObserver -- this theme
  has enough of those already.

  ---------------------------------------------------------------- THE PAGE

  Track123 mounts a Vue app into #track123-app as plain light DOM -- no iframe,
  no shadow root -- so theme CSS reaches it. It appends its own stylesheets to
  <head> at runtime, which means they land AFTER the theme's and win on equal
  specificity. That is a load-order problem, not a specificity one, so the
  overrides are !important. That also beats the app's inline :style bindings,
  which is how the orange progress bar gets recoloured without touching the app.

  Everything is scoped under #track123-app, which exists on exactly one page.
  Scoping by container rather than by request.path means no locale prefix
  (/en/apps/track123), trailing slash or sub-path can make it miss, and it
  cannot misfire anywhere else.

  Selectors are substring matches on the app's own naming (every class is
  prefixed track123_, and the tracker's variants all share the step_line stem),
  so a rename that keeps the semantics still hits. Anything that does miss
  simply keeps the app's default look -- nothing collapses.

  The banner is an inline background-image on the app's form background, and so
  only applies in the app's Tab layout; the Tile layout has no banner and the
  rule simply finds nothing. It can also be set in the Track123 admin (Tracking
  Page > Order lookup > Layout > Image, and Mobile image). Set it in ONE place:
  with this CSS shipped, an admin change will look like it did nothing. Delete
  the pgt_banner assign below to hand control back to the app.
{%- endcomment -%}
{%- assign pgt_banner = 'https://cdn.shopify.com/s/files/1/0815/5706/1860/files/hf_20260814_025444_07f5c6ff-b029-4da5-a8d5-7c0569bf8820.png?v=1786676464' -%}
<style>
  /* ---- tokens the app already consumes: no !important needed ---- */
  #track123-app{
    --Track123-primary:#9B4BC4;
    --Track123-bg:transparent;
    --Track123-line:rgba(168,120,214,.24);
    --Track123-Form-Content:#F1EDF7;
    --Track123-Detail-Progress-line:rgba(168,120,214,.35);
    --Track123-icon-color:#C79BEA;
    --Track123-Dark-bg:#16101F;
    --Track123-default-star:#C79BEA;
    --Track123-all-radius:12px;
    --Track123-big-radius:20px;
    --Track123-small-radius:12px;
  }

  /* ---- the banner ---- */
  {%- if pgt_banner != blank -%}
  #track123-app [class*="tab_form_background"],
  #track123-app [class*="form_background"]{
    background-image:linear-gradient(180deg,rgba(11,7,16,.35) 0%,rgba(11,7,16,.92) 100%),
                     url('{{ pgt_banner }}') !important;
    background-size:cover !important;
    background-position:50% 45% !important;
    background-repeat:no-repeat !important;
  }
  {%- endif -%}

  /* ---- the lookup card: same recipe the rest of the site uses ---- */
  #track123-app [class*="form_wrapper"],
  #track123-app .track_form{
    background:linear-gradient(165deg,#170E22 0%,#120B1B 55%,#0D0813 100%) !important;
    border:1px solid rgba(139,68,190,.34) !important;
    border-radius:20px !important;
    box-shadow:0 34px 90px -46px rgba(139,68,190,.75),0 0 0 1px rgba(255,255,255,.02) inset !important;
    color:#F1EDF7 !important;
  }
  #track123-app [class*="form_wrapper"] *:not(button):not([class*="tab_bar"]){color:#F1EDF7}

  /* ---- fields ---- */
  #track123-app input:not([type=hidden]):not([type=checkbox]):not([type=radio]):not([type=submit]),
  #track123-app [class*="form_input"],
  #track123-app [class*="form_field"]{
    background:#0F0A16 !important;
    border:1px solid rgba(168,120,214,.24) !important;
    border-radius:12px !important;
    color:#F1EDF7 !important;
    caret-color:#C79BEA !important;
  }
  #track123-app input::placeholder{color:#7E7290 !important;opacity:1 !important}
  #track123-app input:focus{
    border-color:#9B4BC4 !important;
    box-shadow:0 0 0 3px rgba(155,75,196,.22) !important;
    outline:none !important;
  }

  /* ---- the wordmark header ----
     pg-theme-css injects .pgf-head / .pgf-nav as the fallback header on any
     page without a header of its own, which includes this one. Its logo is
     capped at 88px against 14px/6px padding, so the wordmark sits crowded up
     under the announcement marquee and reads larger and softer than the
     wordmark anywhere else on the site. Sized and spaced to match here only --
     the CMS pages that share this header are left alone.

     mix-blend-mode is deliberately NOT touched: the asset leans on `screen` to
     drop its own dark background, and normalising it would put the box back. */
  html.pgt-on .pgf-head{
    background:#0B0710 !important;
    border-bottom:0 !important;
    padding:22px 16px 10px !important;
    height:auto !important;
    overflow:visible !important;
    line-height:0 !important;
  }
  html.pgt-on .pgf-head img{
    max-height:56px !important;
    max-width:min(400px,70vw) !important;
    width:auto !important;
    height:auto !important;
    object-fit:contain !important;
    margin:0 auto !important;
  }
  html.pgt-on .pgf-nav{
    background:#0B0710 !important;
    border-bottom:1px solid rgba(168,120,214,.16) !important;
    padding:10px 16px 16px !important;
    gap:30px !important;
  }
  @media (max-width:600px){
    html.pgt-on .pgf-head{padding:16px 12px 8px !important}
    html.pgt-on .pgf-head img{max-height:42px !important;max-width:78vw !important}
    html.pgt-on .pgf-nav{gap:18px !important;padding:8px 12px 14px !important}
  }

  /* ---- the black button becomes the CTA used everywhere else ----
     Both layouts are covered: the Tab layout puts its button inside a form
     wrapper, the Tile layout does not, so the net is every button in the
     widget that is not a close/copy/icon control. The tab rules below come
     after this one on purpose, so a tab built as a <button> still wins. */
  #track123-app #track123_submit_button,
  #track123-app button[class*="track123_form_button"],
  #track123-app button:not([class*="close"]):not([class*="copy"]):not([class*="icon"]):not([class*="tab"]),
  #track123-app [class*="form_wrapper"] button{
    background:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 50%,#4A1C66 100%) !important;
    background-color:#7A2FA2 !important;
    border:0 !important;
    border-radius:999px !important;
    color:#fff !important;
    -webkit-text-fill-color:#fff !important;
    font-weight:700 !important;
    letter-spacing:.05em !important;
    text-transform:uppercase !important;
    box-shadow:0 10px 30px -12px rgba(155,75,196,.75) !important;
  }

  /* ---- Order Number / Tracking Number tabs ---- */
  #track123-app [class*="tab_bar"]{
    color:#A296B4 !important;
    background:transparent !important;
    background-image:none !important;
    border:0 !important;
    border-bottom:3px solid transparent !important;
    border-radius:0 !important;
    box-shadow:none !important;
    text-transform:none !important;
  }
  #track123-app [class*="tab_bar_color"]{
    color:#F1EDF7 !important;
    border-bottom-color:#C79BEA !important;
    opacity:1 !important;
  }

  /* ---- the orange step tracker ----
     Three implementations ship under step_line / step_line1 / step_line2, so
     the rules key on the shared stem and cover all of them. */
  #track123-app [class*="step_line"][class*="_track"],
  #track123-app [class*="step_line"] [class*="_track"]{
    background:rgba(168,120,214,.18) !important;
  }
  #track123-app [class*="step_line"] [class*="_process"],
  #track123-app [class*="step_line"] [class*="_dot"],
  #track123-app [class*="step_line"] [class*="_icon"]:not([class*="_border"]):not([class*="_container"]){
    background:linear-gradient(90deg,#7A2FA2,#C79BEA) !important;
    border-color:#C79BEA !important;
  }
  #track123-app [class*="step_line"] [class*="_icon_border"]{
    background:transparent !important;
    box-shadow:0 0 0 4px rgba(155,75,196,.18) !important;
  }
  #track123-app [class*="not_active"]{opacity:.45 !important}
  #track123-app [class*="step_line"] svg [fill]:not([fill="none"]){fill:#fff !important}
  #track123-app [class*="step_line"] svg [stroke]:not([stroke="none"]){stroke:#fff !important}

  /* ---- the vertical detail timeline below the tracker ---- */
  #track123-app [class*="detail_step_line"]{border-left-color:rgba(168,120,214,.35) !important}
  #track123-app [class*="detail_dot"]{background:#C79BEA !important}

  /* ---- phones ----
     Three separate things make this page "not fit" on a phone, and only one of
     them is layout:

     1. iOS Safari zooms the whole page in when a text input smaller than 16px
        takes focus, and never zooms back out. A 14px field is enough to do it.
        Every input is pinned to 16px, which is the actual fix -- not a
        user-scalable=no viewport, which breaks pinch-zoom for everyone.
     2. The lookup card is a row of two columns with an OR divider between them.
        Told to wrap, it stacks; if the app's own small-screen CSS already
        stacks it, this is a no-op.
     3. The five-step tracker is intrinsically wider than a phone. Left alone it
        stretches the document and every section on the page gains a horizontal
        scrollbar. Given its own scroll container, it scrolls in place instead. */
  @media (max-width:600px){
    #track123-app{
      max-width:100% !important;
      overflow-x:hidden !important;
      padding-left:12px !important;
      padding-right:12px !important;
      box-sizing:border-box !important;
    }
    #track123-app *{max-width:100% !important;box-sizing:border-box !important}

    /* 1. no zoom-on-focus */
    #track123-app input:not([type=hidden]):not([type=checkbox]):not([type=radio]),
    #track123-app select,
    #track123-app textarea{font-size:16px !important}

    /* 2. stack the two lookup columns */
    #track123-app [class*="form_wrapper"],
    #track123-app [class*="form_content"],
    #track123-app [class*="form_box"]{
      flex-wrap:wrap !important;
      width:100% !important;
      padding:18px 14px !important;
      border-radius:16px !important;
    }
    #track123-app [class*="form_wrapper"] > *{min-width:0 !important}
    /* the vertical OR rule between the columns reads as a stray line once they
       stack, so it lies down with them */
    #track123-app [class*="_or"],
    #track123-app [class*="divider"]{
      width:100% !important;
      height:auto !important;
      margin:6px 0 !important;
    }
    #track123-app button{width:100% !important}

    /* 3. the tracker scrolls in place rather than widening the document */
    #track123-app [class*="step_line"]{
      max-width:100% !important;
      overflow-x:auto !important;
      -webkit-overflow-scrolling:touch !important;
      scrollbar-width:none !important;
    }
    #track123-app [class*="step_line"]::-webkit-scrollbar{display:none !important}
    #track123-app [class*="step_line"] > *{max-width:none !important}
  }
</style>
<script>
(function(){
  if (window.pgTrackLink) return; window.pgTrackLink = 1;

  var OLD = '/pages/track-order';
  var NEW = '/apps/track123';

  /* html.pgt-on gates the rules that reach OUTSIDE the widget -- the injected
     wordmark header, which is shared with the CMS pages and must not be
     restyled there. Keyed on the widget being present as well as the path, so
     a locale prefix or a trailing slash cannot make it miss. If it never gets
     set, the header simply looks like it does today. */
  var PATH = /^\/(?:[a-z]{2}(?:-[a-z]{2})?\/)?apps\/track123(?:\/|$)/i;
  function mark(){
    if (!PATH.test(location.pathname) && !document.getElementById('track123-app')) return false;
    document.documentElement.classList.add('pgt-on');
    return true;
  }

  function isOld(a){
    var h = a.getAttribute('href') || '';
    return h.split('?')[0].replace(/\/$/, '').indexOf(OLD) > -1;
  }

  function fix(){
    var as = document.querySelectorAll('a[href*="' + OLD + '"]');
    for (var i = 0; i < as.length; i++){
      if (isOld(as[i])) as[i].setAttribute('href', NEW);
    }
  }

  /* the header and the navs are injected at different times by different
     sections, so a few cheap passes cover them without leaving a timer running */
  function pass(){ mark(); fix(); }
  pass();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', pass);
  [400, 1200, 3000].forEach(function(ms){ setTimeout(pass, ms); });

  /* and the backstop: a link built after the last pass still goes to the
     tracker, because the click itself is redirected */
  document.addEventListener('click', function(e){
    var a = e.target && e.target.closest ? e.target.closest('a[href*="' + OLD + '"]') : null;
    if (!a || !isOld(a)) return;
    e.preventDefault();
    window.location.href = NEW;
  }, true);
})();
</script>
