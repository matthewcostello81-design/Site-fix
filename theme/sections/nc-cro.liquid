      });
      bar.querySelector('.tb-btn').addEventListener('click',function(){var a=liveAtc();if(a)a.click();});
      document.body.appendChild(bar);
      function syncTop(){
        var a=liveAtc();
        if(!a){bar.classList.remove('nc-show');return;}
        var B2=curB();if(!B2)return;
        var tot2b=Math.round((B2.main.pr+B2.a1.pr)*100)/100,tot3b=Math.round((B2.main.pr+B2.a1.pr+B2.a2.pr)*100)/100;
        var pr=[isWR()?liveSingle():B2.main.pr,deal(tot2b,0.10),deal(tot3b,0.15)];
        var tl=document.querySelectorAll('#ncpdp .nc-tiers .nc-tier');
        var idx=0;for(var i2=0;i2<tl.length;i2++){if(tl[i2].classList.contains('nc-on'))idx=i2;}
        var ops=bar.querySelectorAll('.tb-op');
        for(var j=0;j<3;j++){if(ops[j]){var pi=ops[j].querySelector('i');var wantP=money(pr[j]);if(pi&&pi.textContent!==wantP)pi.textContent=wantP;ops[j].classList.toggle('on',j===idx);}}
        var inc=bar.querySelector('.tb-inc');
        var incTx=idx===1?'2 items: this + '+B2.a1.nm:idx===2?'3 items: this + '+B2.a1.nm+' & '+B2.a2.nm:'1 item \u2014 just this product';
        if(inc&&inc.textContent!==incTx)inc.textContent=incTx;
        if(inc)inc.classList.toggle('nc-off',idx===0);
        var tin9=bar.querySelector('.tb-in');
        var info9=bar.querySelector('.tb-info');
        if(window.innerWidth<=700){if(inc&&tin9&&inc.parentElement!==tin9)tin9.appendChild(inc);}
        else{if(inc&&info9&&inc.parentElement!==info9)info9.appendChild(inc);}
        var pEl=bar.querySelector('.tb-price');
        var want=money(pr[idx]||pr[0]);
        if(pEl.textContent!==want)pEl.textContent=want;
        var saveTx=(function(){var em=tl[idx]&&tl[idx].querySelector('.nc-tier-save');return em?em.textContent.trim():'';})();
        var sv=bar.querySelector('.tb-save');
        if(sv.textContent!==saveTx)sv.textContent=saveTx;
        sv.style.display=saveTx?'':'none';
        var r=a.getBoundingClientRect();
        var vh=window.innerHeight||document.documentElement.clientHeight;
        var isOut=(r.width===0&&r.height===0)?(window.pageYOffset>350):(r.bottom<0);
        bar.classList.toggle('nc-show',!!vh&&isOut);
        var mb7=window.innerWidth<=700&&bar.classList.contains('nc-show');
        var snB=document.querySelector('.nc-sticknav');
        if(snB){snB.classList.remove('nc-hidebar');snB.classList.toggle('nc-slim',mb7);}
        var annEl=document.querySelector('.shopify-section[id*="nc_announce"]');
        if(annEl)annEl.classList.remove('nc-hideann');
        var annS2=document.querySelector('.shopify-section[id*="nc_announce"]');
        var offT=annS2?Math.max(0,Math.round(annS2.getBoundingClientRect().bottom)):0;
        var sn2=document.querySelector('.nc-sticknav');
        if(sn2&&(sn2.classList.contains('nc-show')||sn2.classList.contains('nc-always'))&&!sn2.classList.contains('nc-hidebar'))offT+=Math.round(sn2.getBoundingClientRect().height);
        if(bar.style.top!==offT+'px')bar.style.top=offT+'px';
      }
      window.__ncTopSync=syncTop;
      window.addEventListener('scroll',syncTop,{passive:true});
      window.addEventListener('resize',syncTop,{passive:true});
      syncTop();
    }
    tierFix();
  }
  document.addEventListener('click',function(e){
    var btn=e.target&&e.target.closest&&e.target.closest('#ncpdp button.nc-atc');
    if(!btn)return;
    var B=curB();
    if(!B)return;
    var t2on=document.querySelector('#ncpdp .nc-tier[data-nc-bundle="2"].nc-on');
    var t3on=document.querySelector('#ncpdp .nc-tier[data-nc-bundle="3"].nc-on');
