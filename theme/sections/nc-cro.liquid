  function tierFix(){
    var B=curB();
    if(!B)return;
    var tiers=document.querySelectorAll('#ncpdp .nc-tiers .nc-tier');
    if(tiers.length<3)return;
    var t2=tiers[1],t3=tiers[2];
    var tot2=Math.round((B.main.pr+B.a1.pr)*100)/100;
    var tot3=Math.round((B.main.pr+B.a1.pr+B.a2.pr)*100)/100;
    var d2=dealI([B.main.pr,B.a1.pr],0.10),d3=dealI([B.main.pr,B.a1.pr,B.a2.pr],0.15);
    var was2=Math.round(((B.main.was||B.main.pr)+(B.a1.was||B.a1.pr))*100)/100,was3=Math.round(((B.main.was||B.main.pr)+(B.a1.was||B.a1.pr)+(B.a2.was||B.a2.pr))*100)/100;
    var pc2=was2>d2?Math.round((was2-d2)/was2*100):10,pc3=was3>d3?Math.round((was3-d3)/was3*100):15;
    var MB=window.innerWidth<=760;
    var n1=MB?B.a1.sh:B.a1.nm,n2=MB?B.a2.sh:B.a2.nm;
    setTier(t2,'2','Recovery Duo','This + '+n1,d2,was2,pc2);
    setTier(t3,'3',MB?'Complete Kit':'Complete Recovery Kit','This + '+n1+' + '+n2,d3,was3,pc3);
    var p1=tiers[0].querySelector('.nc-tier-price');
    if(p1&&!p1.querySelector('.nc-tier-save')){
      var s1=p1.querySelector('s');
      if(s1){
        var was1=parseFloat(s1.textContent.replace(/[^0-9.]/g,''))||0;
        var now1=parseFloat((p1.textContent.match(/[\d.]+/)||['0'])[0])||0;
        if(was1>now1&&now1>0){
          var em1=document.createElement('em');em1.className='nc-tier-save';em1.textContent='Save '+Math.round((1-now1/was1)*100)+'%';p1.appendChild(em1);
        }
      }
    }
    var atc=liveAtc();
    if(atc&&!atc.classList.contains('nc-atc-loading')&&!atc.classList.contains('nc-atc-done')){
      var label;
      if(t2.classList.contains('nc-on'))label='Add Duo \u2014 '+money(d2);
      else if(t3.classList.contains('nc-on'))label='Add Kit \u2014 '+money(d3);
      else label='Add Single \u2014 '+money(B.main.pr);
      if(atc.textContent.trim()!==label)atc.textContent=label;
    }
    mirrorTop();
  }
