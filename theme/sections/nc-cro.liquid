      tiers.parentNode.insertBefore(c,tiers);
      var KEY='nc_deal_start';var HOLD=15*60*1000;var RESET=12*60*60*1000;
      var start=0;
      try{start=parseInt(localStorage.getItem(KEY)||'0');}catch(e){}
