  var QTYT={'side-sleeper-leg-pillow':1};
  /* Pair/Trio: one colour dropdown per pillow; each row becomes its own cart line. */
  /* Shopify returns few related products for a new item; top the rail up from the
     catalogue by cloning a rendered card and swapping in link, image, title and price. */
  /* Colour click -> jump the gallery to that variant's own photo, and run the tier
     maths on the same frame so the price never flashes the theme's value first. */
  /* Badge is pinned to the gallery frame, so show it only on the first slide. */
  /* Preload gallery videos; rewind to 0 and play whenever a video slide comes into view. */
  /* ZSHIP = Zendrop US transit days per product; +2-4 handling = the window we show.
     nc-cartfix hardcodes "Ships by today+2" for everything, which says nothing useful. */
  function qtyTiers(){
    var h=handle();if(!h||!QTYT[h])return;
    var tiers=document.querySelectorAll('#ncpdp .nc-tiers .nc-tier');
    if(tiers.length<3)return;
    var unit=SALEM[h]||0,was=WASH[h]||0;
    if(!(unit>0))return;
    var PCT=[0,0.10,0.15],i;
    for(i=0;i<3;i++){
      var q=i+1;
      var line=Math.round(unit*q*100)/100;
      /* one entry per unit: Shopify floors the discount per unit, not per line, so
         dealI([79.98],0.10) gave 71.99 where the cart actually charges 72.00 */
      var units=[];for(var u2=0;u2<q;u2++)units.push(unit);
      var d=(PCT[i]>0)?dealI(units,PCT[i]):line;
      var w=Math.round((was>unit?was:unit)*q*100)/100;
      var pc=(w>d)?Math.round((w-d)/w*100):0;
      var t=tiers[i];
      t.removeAttribute('data-nc-bundle');
      if(t.getAttribute('data-qty')!==String(q))t.setAttribute('data-qty',String(q));
      var p=t.querySelector('.nc-tier-price');
      if(p){
        var want=money(d);
        if(p.textContent.indexOf(want)===-1)p.innerHTML=want+' <s>'+money(w)+'</s> <em class="nc-tier-save">Save '+pc+'%</em>';
      }
    }
  }
