      drawerExtras();
      cartEl.addEventListener('wheel',function(e){
        if(!cartEl.classList.contains('toggle'))return;
        var dy=e.deltaY;
        if(e.deltaMode===1)dy*=16;else if(e.deltaMode===2)dy*=cartEl.clientHeight;
        e.preventDefault();e.stopImmediatePropagation();
        cartEl.scrollTop+=dy;
      },{passive:false,capture:true});
    }
    if(!window.__ncQty2){
      window.__ncQty2=1;
