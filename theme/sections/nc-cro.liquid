          fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify({line:parseInt(line,10),quantity:q})})
            .then(function(r){return r.json();})
            .then(function(){return ncRefreshCart();})
            .catch(function(){});
        },450);
      },true);
    }
    if(liveAtc()&&curB()&&!document.querySelector('.nc-topbar')){
      var bar=document.createElement('div');bar.className='nc-topbar';
      var pimg=document.querySelector('#ncpdp img');
      bar.innerHTML='<div class="tb-in">'+(pimg?'<img class="tb-img" src="'+pimg.src+'" alt="">':'')+'<div class="tb-info"><div class="tb-r1"><div class="tb-name"></div><div class="tb-prow"><b class="tb-price"></b><span class="tb-save"></span></div></div><div class="tb-inc"></div></div><div class="tb-seg" role="radiogroup" aria-label="Choose your bundle"><span class="tb-op" data-i="0" role="radio" tabindex="0"><b>Single</b><i></i></span><span class="tb-op" data-i="1" role="radio" tabindex="0"><b>Duo</b><i></i></span><span class="tb-op" data-i="2" role="radio" tabindex="0"><b>Kit</b><i></i></span></div><button type="button" class="tb-btn">Add to Cart</button></div>';
