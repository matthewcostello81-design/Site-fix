{% comment %} NC mobile polish: FREE price on the cart gift line, compact collection sort/filter controls, footer logo built from the theme logo setting, Help/Policies layout, and the PDP highlight-box card treatment. Doubled-id selectors so these win regardless of section order. {% endcomment %}
{%- assign nc_flogo = '' -%}
{%- if settings.logo != blank -%}{%- assign nc_flogo = settings.logo | image_url: width: 400 -%}{%- endif -%}
<style>
/* 1. Cart: the free gift gets the same green discount pill every other line gets under
      its title (nc-cro's .nc-dline treatment, grid-area ds). Own class so nc-cro does
      not strip it — it removes .nc-dline whenever a line has no percentage discount. */
#cart#cart .nc-gfree,body.template-cart .nc-gfree{grid-area:ds;display:flex !important;align-items:center !important;gap:2px !important;color:#2C7360 !important;-webkit-text-fill-color:#2C7360 !important;font-size:13px !important;font-weight:800 !important;margin:0 !important;line-height:1.2 !important;background:linear-gradient(100deg,rgba(44,115,96,0.28),rgba(44,115,96,0) 82%) !important;border-radius:100px !important;padding:5px 14px 5px 7px !important;width:-moz-fit-content !important;width:fit-content !important;justify-self:start !important;white-space:nowrap !important}
#cart#cart .nc-gfree svg,body.template-cart .nc-gfree svg{position:static !important;width:12px !important;height:12px !important;min-width:0 !important;max-width:12px !important;flex:0 0 12px !important;background:none !important;box-shadow:none !important;padding:0 !important;border-radius:0 !important}

/* 1b. One grey for every struck price on the site. These were a mix of #333333,
       #44544e, #7c8c84, #9aa8a5 and #9AA7AC; standardise on the cart's grey.
       Doubling the class was not enough: collection cards are held black by
       `.product-card .price .old-price` (0-3-0 + !important) and the cart add-on
       tiles by `#cart#cart#cart .nc-rec-was` (three IDs). Hence the quadrupled
       classes, plus explicit four-ID variants for the cart/PDP cases. */
.old-price.old-price.old-price.old-price,.nc-was.nc-was.nc-was.nc-was,.ncwas.ncwas.ncwas.ncwas,.nc-rec-was.nc-rec-was.nc-rec-was.nc-rec-was,.tp-was.tp-was.tp-was.tp-was,.tb-was.tb-was.tb-was.tb-was,.nc-og-was.nc-og-was.nc-og-was.nc-og-was,.nc-lsave-was.nc-lsave-was.nc-lsave-was.nc-lsave-was,.nch-pwas.nch-pwas.nch-pwas.nch-pwas,.was1.was1.was1.was1,.was2.was2.was2.was2,.was3.was3.was3.was3,.nc-herogift__was.nc-herogift__was.nc-herogift__was.nc-herogift__was,.nc-herogift__was.nc-herogift__was.nc-herogift__was.nc-herogift__was s,.price.price.price.price s,.price.price.price.price del,s.money.money.money.money,del.money.money.money.money,#cart#cart#cart#cart .nc-rec-was,#cart#cart#cart#cart .old-price,#cart#cart#cart#cart .nc-lsave-was,#cart#cart#cart#cart p.price s,#ncpdp#ncpdp#ncpdp#ncpdp .tp-was,#ncpdp#ncpdp#ncpdp#ncpdp .nc-was,#root#root .l4hs .price .old-price{color:#9AA7AC !important;-webkit-text-fill-color:#9AA7AC !important;text-decoration-line:line-through !important;text-decoration-color:#9AA7AC !important}

/* 1c. Cart add-on tiles: nc-cro rebuilds the wood-roller tile with
       `pr.textContent='$24.99'` and then APPENDS the <s>, so its struck price lands
       to the right of the price while every other tile has it on the left. The price
       row is a flexbox and the live price is an anonymous item (order 0), so pulling
       the <s> to order:-1 puts it first without fighting nc-cro's rebuild. */
#cart#cart .nc-recs-panel .nc-rec-price .nc-rec-was{order:-1 !important}

@media(max-width:760px){
  /* 2. Collection page: compact sort + filter controls */
  .nc-fbar .nc-fsort,.nc-fbar .nc-fcat,select.nc-fsort,select.nc-fcat{font-size:13px !important;height:38px !important;min-height:0 !important;padding:0 26px 0 10px !important;max-width:44vw !important}
  .nc-fbar{gap:8px !important;padding-top:6px !important;padding-bottom:6px !important}

  /* 3. Footer: big logo, hard left */
  #shopify-section-footer#shopify-section-footer .nc-foot-lock{justify-content:flex-start !important;gap:12px !important}
  #shopify-section-footer#shopify-section-footer .nc-foot-chip{height:96px !important;padding:8px 14px !important;border-radius:16px !important}
  #shopify-section-footer#shopify-section-footer .nc-foot-emblem{height:80px !important;max-width:200px !important}

  /* 4. Footer: Policies sits directly to the right of Help. Help is sized to its
        content instead of a half-width track, so Policies pulls in tight against
        it rather than starting at the middle of the screen. */
  #shopify-section-footer#shopify-section-footer .nc-foot-links{display:grid !important;grid-template-columns:auto 1fr !important;gap:0 24px !important;justify-content:start !important;padding-left:12px !important;padding-right:12px !important}
  #shopify-section-footer#shopify-section-footer .nc-foot-links > .nc-foot-col{min-width:0 !important}
  #shopify-section-footer#shopify-section-footer .nc-foot-links ul{gap:9px !important}
}

/* 5. PDP highlight box: card treatment — cream gradient, teal→orange spine down the
      left, hairline rules between rows, and icon tiles lifted off the surface with
      a gradient fill + inset ring. */
#ncpdp#ncpdp .nc-qb{position:relative !important;overflow:hidden !important;margin:14px 0 !important;padding:4px 16px 4px 24px !important;border-radius:18px !important;border:1px solid rgba(44,110,114,.18) !important;background-color:#FDFCF8 !important;background-image:linear-gradient(155deg,rgba(44,110,114,.08),rgba(255,255,255,0) 46%,rgba(217,118,58,.07)) !important;background-repeat:no-repeat !important;background-position:center !important;background-size:cover !important;box-shadow:0 18px 32px -28px rgba(15,42,51,.55),inset 0 1px 0 rgba(255,255,255,.85) !important}
/* Spine: brand stops only — #2C6E72 teal, #5FB894 the bright green off the SAVED
   badge, #D9763A / #E8935A the CTA oranges. The earlier dark green (#2C7360) blended
   into orange through rgb(130,116,77), i.e. brown; the bright green keeps the mix
   light. Green holds 16-30% and 70-84%, orange holds 38-62%, so both colours read as
   solid runs and the crossovers stay 8% narrow. Gradient is 320% of the bar and
   drifts between its ends to read as flow. */
@keyframes ncQbFlow{0%,100%{background-position:50% 0%}50%{background-position:50% 100%}}
#ncpdp#ncpdp .nc-qb::before{content:'' !important;position:absolute !important;left:0 !important;top:0 !important;bottom:0 !important;width:9px !important;background-image:linear-gradient(180deg,#2C6E72 0%,#5FB894 16%,#5FB894 30%,#D9763A 38%,#E8935A 50%,#D9763A 62%,#5FB894 70%,#5FB894 84%,#2C6E72 100%) !important;background-size:100% 320% !important;background-repeat:no-repeat !important;animation:ncQbFlow 8s ease-in-out infinite !important;pointer-events:none !important}
@media(prefers-reduced-motion:reduce){#ncpdp#ncpdp .nc-qb::before{animation:none !important}}
#ncpdp#ncpdp .nc-qb > div{position:relative !important;padding:11px 2px !important;border-bottom:1px solid rgba(44,110,114,.13) !important}
#ncpdp#ncpdp .nc-qb > div:last-child{border-bottom:0 !important}
#ncpdp#ncpdp#ncpdp#ncpdp .nc-qb > div svg{background-color:#fff !important;background-image:linear-gradient(140deg,rgba(44,110,114,.22),rgba(44,110,114,.06) 56%,rgba(217,118,58,.16)) !important;box-shadow:inset 0 0 0 1px rgba(44,110,114,.20),0 7px 13px -9px rgba(15,42,51,.6) !important}
@media(hover:hover) and (pointer:fine){
  #ncpdp#ncpdp .nc-qb > div{transition:transform .18s ease !important}
  #ncpdp#ncpdp .nc-qb > div:hover{transform:translateX(3px) !important}
}
@media(max-width:760px){
  #ncpdp#ncpdp .nc-qb{margin:12px 0 !important;padding:2px 12px 2px 20px !important;border-radius:16px !important}
  #ncpdp#ncpdp .nc-qb::before{width:7px !important}
  #ncpdp#ncpdp .nc-qb > div{padding:9px 2px !important}
}
</style>
<script>
(function(){
  var LOGO={{ nc_flogo | json }};
  /* nc-footer builds the logo chip by cloning #cart img.nc-dlogo, which is absent on
     most pages — that is why the wordmark shows with no logo beside it. Build the
     chip from the theme logo setting instead. */
  function footLogo(){
    if(!LOGO)return;
    var lock=document.querySelector('#shopify-section-footer .nc-foot-lock');
    if(!lock||lock.querySelector('.nc-foot-chip'))return;
    var chip=document.createElement('span');chip.className='nc-foot-chip';
    var img=document.createElement('img');img.className='nc-foot-emblem';img.src=LOGO;img.alt='North Cove Wellness';
    chip.appendChild(img);
    lock.insertBefore(chip,lock.firstChild);
  }
  /* nc-cro strips .nc-lsave off the gift line, so it renders with no price at all.
     Use our own class so nc-cro will not remove it again. */
  function giftFree(){
    var lis=document.querySelectorAll('#cart .l4ca > li');
    for(var i=0;i<lis.length;i++){
      var li=lis[i],a=li.querySelector('a[href*="/products/"]');
      if(!a||String(a.getAttribute('href')||'').indexOf('resistance-bands')<0)continue;
      var sec=li.querySelector('section');
      if(!sec||sec.querySelector('.nc-gfree'))continue;
      var w=document.createElement('div');w.className='nc-gfree';
      w.innerHTML="<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20.6 13.4 12 22l-9-9V3h10z'/><circle cx='7.5' cy='7.5' r='1.4'/></svg>FREE GIFT";
      sec.insertBefore(w,sec.firstChild);
    }
  }
  /* The flame glyph's orange accent was drawn from y=17.9 while the flame's lowest
     point is y=15.9, so it hung detached below the shape; the outline also carried an
     inner notch that muddled at 30px. Swap in a cleaner flame with the accent inside
     the bulb. data-nck stays 'heat' so nc-quiz's icon pass leaves it alone. */
  var FLAME="<path d='M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z'/><path stroke='#D9763A' d='M12 18.7a2.6 2.6 0 0 1-2-2.7'/>";
  function flameFix(){
    var sv=document.querySelectorAll('#ncpdp .nc-qb svg[data-nck="heat"]');
    for(var i=0;i<sv.length;i++){
      if(sv[i].getAttribute('data-ncflame'))continue;
      sv[i].setAttribute('data-ncflame','1');
      sv[i].innerHTML=FLAME;
    }
  }
  /* "Knots that come back no matter what" was drawing the open-palm glyph, which says
     nothing about recurrence and is unreadable at this size. A rotate arrow reads as
     "keeps coming back" immediately. Swap the contents only and leave data-nck alone,
     otherwise nc-quiz sees a key mismatch and re-renders over us every pass. */
  var CYCLE="<path d='M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8'/><path stroke='#D9763A' d='M21 3v5h-5'/>";
  function cycleFix(){
    var ds=document.querySelectorAll('#ncpdp .nc-qb > div');
    for(var i=0;i<ds.length;i++){
      var d=ds[i],txt=(d.getAttribute('data-ncfull')||d.textContent||'').toLowerCase();
      if(txt.indexOf('come back no matter')<0)continue;
      var sv=d.querySelector('svg');
      if(!sv||sv.getAttribute('data-nccycle'))continue;
      sv.setAttribute('data-nccycle','1');
      sv.innerHTML=CYCLE;
    }
  }
  function run(){try{footLogo();}catch(e){}try{giftFree();}catch(e){}try{flameFix();}catch(e){}try{cycleFix();}catch(e){}}
  var t=null;
  function queue(){if(t)return;t=setTimeout(function(){t=null;run();},120);}
  if(document.readyState!=='loading')run();else document.addEventListener('DOMContentLoaded',run);
  setTimeout(run,600);setTimeout(run,1600);setTimeout(run,3200);
  try{new MutationObserver(queue).observe(document.body,{childList:true,subtree:true});}catch(e){}
})();
</script>
{% schema %}
{"name":"NC Mobile Fix","settings":[],"presets":[{"name":"NC Mobile Fix"}]}
{% endschema %}
