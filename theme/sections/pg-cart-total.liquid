{%- comment -%}
  PG Cart Total: two numbers at the bottom of the cart.

  The panel was showing three overlapping things: pg-drawer's "Sale Savings /
  Bundle Discount / Total Savings" box, the theme's own Subtotal row, and the
  Total. Two of those are savings figures computed different ways, which is how
  a shopper ends up unsure what they are actually paying.

  It then spent a while showing the opposite problem -- a full itemisation:

      Original price     $551.96
      Sale savings      -$276.02
      Promo discount     -$36.99
      ------------------------------
      Total savings      $313.01

  Five numbers, three of which exist only to explain the fourth, stacked above
  the Total. On a phone they filled the space the checkout button should own,
  and a shopper reading them has to do arithmetic to answer the only two
  questions they have. So the box is now one line:

      You saved (57%)    $313.01

  and the cart's own Total row sits directly beneath it. What they saved, what
  they owe, nothing else. The intermediate figures are still COMPUTED -- `saved`
  is derived from them -- they are simply not printed.

  The arithmetic is anchored on the real total rather than added up
  independently: Original comes from compare-at prices, Total comes straight
  from cart.total_price, and the saving is the difference. That way the figure
  can never disagree with what is charged -- including when Shopify picks one
  automatic discount over another.

  With nothing discounted there is no saving to report, so the box falls back to
  stating the charge rather than printing "You saved $0.00".

  Shipping Protection is excluded from Original and from the savings, since it
  is a service the shopper opted into and never carries a compare-at price. It
  is still inside Total, because it is still charged.
{%- endcomment -%}
<style>
  /* pg-drawer's own savings box and the theme's subtotal row are superseded */
  #cart .sticky-in-panel .pg-sav{display:none !important}
  /* :has() guard matters. .pg-tt is pg-drawer's render-time class, not ours --
     nothing in this repo creates it. Written unguarded, this rule hides every
     row that LACKS the class, so before pg-drawer's pass lands (or if it ever
     renames it) the entire totals list vanishes and the pane shows savings, a
     trust row and Checkout with no amount charged anywhere on screen. Guarded,
     a missing .pg-tt simply leaves the theme's own rows visible. */
  #cart .sticky-in-panel .l4tt:has(li.pg-tt) li:not(.pg-tt){display:none !important}

  #cart .pg-tot{
    /* POP-IN. This box used to be created only once /cart.js came back, about
       two seconds after the drawer opened, and inserting a 38px block above the
       totals shoved CHECKOUT and everything under it down the screen. Measured
       over six seconds after an open: eight separate layout jumps, the pane
       moving 632 -> 553 -> 565 -> 563 -> 519px. The box is now created empty and
       immediately, and min-height holds exactly the space one row will need, so
       filling it in later changes no geometry at all. */
    min-height:38px;
    box-sizing:border-box;
    margin:2px 0 6px;padding:10px 12px;border-radius:12px;
    background:linear-gradient(120deg,#F8F3FC,#F1E7F8);
    border:1px solid rgba(122,47,162,.2);
    font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;
  }
  #cart .pg-tot-r{
    display:flex;justify-content:space-between;align-items:baseline;gap:12px;
    font-size:13px;line-height:1.6;color:#4A1C66;
  }
  #cart .pg-tot-r span:last-child{font-weight:700;white-space:nowrap}
  #cart .pg-tot-r.pg-tot-off span{color:#7A2FA2}
  /* Savings is a supporting figure, not the headline -- the amount charged is.
     With the breakdown gone there is nothing above it to divide from, so the
     rule and its top padding go too. */
  #cart .pg-tot-r.pg-tot-sum{
    font-size:13.5px;font-weight:700;
  }
  #cart .pg-tot-r.pg-tot-sum span{font-weight:700;color:#3B1553}
  /* the savings line carries the accent */
  #cart .pg-tot-r.pg-tot-saved span{color:#7A2FA2}
  @media(max-width:760px){
    #cart .pg-tot{padding:8px 10px}
    #cart .pg-tot-r{font-size:12.5px;line-height:1.5}
    #cart .pg-tot-r.pg-tot-sum{font-size:13px}
  }

  /* The bottom of the cart is painted black by something that survives both a
     stylesheet rule and an inline stamp, which leaves a pseudo-element as the
     only candidate -- and a pseudo cannot be reached from JS. lightenBottom()
     tags each element it repaints, so the pseudos can be cleared here. */
  #cart .pg-white,
  #cart .pg-white::before,
  #cart .pg-white::after{
    background:#FFFFFF !important;
    background-color:#FFFFFF !important;
    background-image:none !important;
  }
</style>
<script>
(function(){
  if (window.pgCartTotal) return; window.pgCartTotal = 1;

  var VMAP = null;   /* variant id -> [price, compare_at] in cents */
  var last = '';

  fetch('/products.json?limit=50').then(function(r){ return r.json(); }).then(function(j){
    VMAP = {};
    (j.products || []).forEach(function(p){
      (p.variants || []).forEach(function(v){
        VMAP[v.id] = [Math.round(parseFloat(v.price || 0) * 100),
                      Math.round(parseFloat(v.compare_at_price || 0) * 100)];
      });
    });
  }).catch(function(){});

  function money(c){ return '$' + (c / 100).toFixed(2); }
  function row(label, value, cls){
    return '<div class="pg-tot-r' + (cls ? ' ' + cls : '') + '"><span>' + label +
           '</span><span>' + value + '</span></div>';
  }

  /* The sticky footer sat on a black ground while the rest of the cart is
     white. The class names of the wrappers differ by breakpoint, so rather
     than name one this walks up from the pane to #cart and paints the whole
     chain white, along with the pane's siblings -- the payment-icon strip and
     the bottom bar sit on the same ground.

     Two things this deliberately does NOT do. It does not test whether an
     element is currently dark before repainting: an earlier version painted
     once per element and the black came straight back, because the theme
     re-stamps its own inline background afterwards. Running every pass means
     the last write is always ours. And it only ever touches ancestors and
     siblings, never descendants of the pane, so the lavender totals box, the
     purple checkout button and the shipping-protection card keep their own
     fills. */
  function lightenBottom(){
    var pane = document.querySelector('#cart .sticky-in-panel');
    var cart = document.getElementById('cart');
    if (!pane || !cart) return;

    var targets = [], chain = [];
    for (var el = pane; el && el !== document.body; el = el.parentNode){
      chain.push(el);
      targets.push(el);
      if (el === cart) break;
    }
    /* siblings of every link in the chain, not just the pane's: the black band
       runs the full width of the drawer, wider than the pane's own row */
    chain.forEach(function(node){
      if (!node.parentNode) return;
      Array.prototype.forEach.call(node.parentNode.children, function(sib){
        if (targets.indexOf(sib) < 0) targets.push(sib);
      });
    });

    targets.forEach(function(el){
      if (el.nodeType !== 1) return;
      el.classList.add('pg-white');
      el.style.setProperty('background-color', '#FFFFFF', 'important');
      el.style.setProperty('background-image', 'none', 'important');
    });
  }

  /* The amount charged is the headline; the theme renders it as the one
     surviving row in .l4tt and styles it no larger than the breakdown above.
     Stamped rather than written in CSS because the theme sets it inline. */
  function sizeTotal(){
    var pane = document.querySelector('#cart .sticky-in-panel');
    if (!pane) return;
    var rows = pane.querySelectorAll('.l4tt li.pg-tt, .l4tt li');
    Array.prototype.forEach.call(rows, function(li){
      if (getComputedStyle(li).display === 'none') return;
      var set = {'font-size': '21px', 'font-weight': '800', 'color': '#3B1553', 'line-height': '1.3'};
      for (var k in set) li.style.setProperty(k, set[k], 'important');
      li.querySelectorAll('*').forEach(function(kid){
        for (var k2 in set) kid.style.setProperty(k2, set[k2], 'important');
      });
    });
  }

  function render(){
    /* ahead of the VMAP guard: the background must go white even if the
       product feed never loads */
    lightenBottom();
    sizeTotal();
    var pane = document.querySelector('#cart .sticky-in-panel');
    if (!pane) return;

    /* claim the space NOW, empty, so nothing below it moves when the numbers
       land. See the min-height note in the stylesheet above. */
    var box = pane.querySelector('.pg-tot');
    if (!box){
      box = document.createElement('div');
      box.className = 'pg-tot';
      pane.insertBefore(box, pane.querySelector('.l4tt') || pane.firstChild);
    }
    if (!VMAP) return;
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(c){
      var items = c.items || [];
      if (!items.length){
        var old = pane.querySelector('.pg-tot');
        if (old) old.parentNode.removeChild(old);
        last = '';
        return;
      }

      /* Original: every unit at its compare-at price, falling back to the
         selling price where there is no compare-at. Shipping Protection is a
         service, not a discounted product, so it sits outside this figure. */
      var original = 0, selling = 0, prot = 0;
      items.forEach(function(it){
        if ((it.handle || '').indexOf('shipping-protection') > -1){ prot += it.line_price; return; }
        var v = VMAP[it.variant_id];
        var unit = v ? v[0] : it.price;
        var cap = (v && v[1] > v[0]) ? v[1] : unit;
        original += cap * it.quantity;
        selling += unit * it.quantity;
      });

      var total = c.total_price;                       /* the real charge */
      var saved = Math.max(0, (original + prot) - total);
      var pct = original > 0 ? Math.round(saved / (original + prot) * 100) : 0;

      var key = [original, prot, total].join('|');
      if (key === last && pane.querySelector('.pg-tot')) return;
      last = key;

      /* ONE LINE. What they saved -- or, with nothing discounted, what they
         owe, because "You saved $0.00" is worse than saying nothing. The
         cart's own Total row sits directly beneath this box either way. */
      var html = saved > 0
        ? row('You saved (' + pct + '%)', money(saved), 'pg-tot-sum pg-tot-saved')
        : row('Total', money(total), 'pg-tot-sum');

      var b2 = pane.querySelector('.pg-tot');
      if (b2 && b2.innerHTML !== html) b2.innerHTML = html;
    }).catch(function(){});
  }

  /* WHY NOT A METRONOME. This ran render() every 800ms, which meant the numbers
     could arrive up to 800ms late after an add, and every tick re-stamped inline
     styles on the totals rows whether or not anything had changed. It now runs
     when the cart actually changes -- the drawer is rebuilt wholesale on every
     add, remove and quantity change, so its mutations are the signal -- with a
     slow interval kept only as a backstop for changes made in another tab. */
  var queued = false;
  function soon(){
    if (queued) return;
    queued = true;
    setTimeout(function(){ queued = false; render(); }, 60);
  }
  if (window.MutationObserver){
    var drawer = document.getElementById('cart');
    if (drawer) new MutationObserver(soon).observe(drawer, {childList: true, subtree: true});
  }
  document.addEventListener('click', function(e){
    if (e.target.closest && e.target.closest('[href="/cart"], .pgx-cart, #pg-cartfab, .pg-unlock-go, .pg-unlock-add')) soon();
  }, true);
  setInterval(render, 2500);
  render();
})();
</script>
{% schema %}
{"name": "PG Cart Total", "settings": []}
{% endschema %}
