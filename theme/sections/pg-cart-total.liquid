{%- comment -%}
  PG Cart Total: one clear price breakdown at the bottom of the cart.

  The panel was showing three overlapping things: pg-drawer's "Sale Savings /
  Bundle Discount / Total Savings" box, the theme's own Subtotal row, and the
  Total. Two of those are savings figures computed different ways, which is how
  a shopper ends up unsure what they are actually paying.

  This replaces all of it with four lines that always reconcile:

      Original price     $259.98     every unit at its full compare-at price
      Sale savings      -$130.00     compare-at minus the selling price
      Promo discount     -$16.25     whatever Shopify actually applied
      ------------------------------
      Total savings     $146.25      what the three rows above add up to

  The panel deliberately ends on the SAVINGS, not on the amount charged: the
  cart's own "Total" row sits directly beneath this box, so printing the total
  twice made the shopper read the same number twice and the savings not at all.
  The bold line is now the one number this box exists to communicate.

  The arithmetic is anchored on the real total rather than added up
  independently: Original comes from compare-at prices, Total comes straight
  from cart.total_price, and Promo is the remainder after sale savings. That
  way the rows can never sum to something other than what is charged --
  including when Shopify picks one automatic discount over another, which it
  does, since only ONE automatic discount applies per order.

  The promo row only appears when Shopify has actually discounted something, so
  the cart never claims a promo it did not get -- which also means the row is
  the honest answer to "did my bundle deal work?", however the shopper got
  there: adding one at a time or taking a bundle tile on the product page. The
  BXGY ladders key off quantity in the cart, not the route taken to it.

  Shipping Protection is excluded from Original and from the savings, since it
  is a service the shopper opted into and never carries a compare-at price. It
  is still inside Total, because it is still charged.
{%- endcomment -%}
<style>
  /* pg-drawer's own savings box and the theme's subtotal row are superseded */
  #cart .sticky-in-panel .pg-sav{display:none !important}
  #cart .sticky-in-panel .l4tt li:not(.pg-tt){display:none !important}

  #cart .pg-tot{
    margin:2px 0 6px;padding:10px 12px;border-radius:12px;
    background:linear-gradient(120deg,#F8F3FC,#F1E7F8);
    border:1px solid rgba(122,47,162,.2);
    font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;
  }
  #cart .pg-tot-r{
    display:flex;justify-content:space-between;align-items:baseline;gap:12px;
    font-size:13px;line-height:1.6;color:#4A1C66;
  }
  #cart .pg-tot-r span:last-child{font-weight:700;white-space:nowrap}
  #cart .pg-tot-r.pg-tot-off span{color:#7A2FA2}
  #cart .pg-tot-r.pg-tot-sum{
    margin-top:5px;padding-top:6px;border-top:1px solid rgba(122,47,162,.22);
    font-size:15.5px;font-weight:800;
  }
  #cart .pg-tot-r.pg-tot-sum span{font-weight:800;color:#3B1553}
  /* the savings line is the point of the box, so it carries the accent */
  #cart .pg-tot-r.pg-tot-saved span{color:#7A2FA2}
  @media(max-width:760px){
    #cart .pg-tot{padding:8px 10px}
    #cart .pg-tot-r{font-size:12.5px;line-height:1.5}
    #cart .pg-tot-r.pg-tot-sum{font-size:14.5px}
  }
</style>
<script>
(function(){
  if (window.pgCartTotal) return; window.pgCartTotal = 1;

  var VMAP = null;   /* variant id -> [price, compare_at] in cents */
  var last = '';

  fetch('/products.json?limit=50').then(function(r){ return r.json(); }).then(function(j){
    VMAP = {};
    (j.products || []).forEach(function(p){
      (p.variants || []).forEach(function(v){
        VMAP[v.id] = [Math.round(parseFloat(v.price || 0) * 100),
                      Math.round(parseFloat(v.compare_at_price || 0) * 100)];
      });
    });
  }).catch(function(){});

  function money(c){ return '$' + (c / 100).toFixed(2); }
  function row(label, value, cls){
    return '<div class="pg-tot-r' + (cls ? ' ' + cls : '') + '"><span>' + label +
           '</span><span>' + value + '</span></div>';
  }

  /* The sticky footer sat on a black ground: something between the pane and
     #cart paints a dark background, and the cart is otherwise white. Rather
     than guess which wrapper it is -- the class names differ by breakpoint --
     this walks up from the pane and repaints only the elements that actually
     compute to a dark fill, leaving anything already light alone. The pane's
     own siblings get the same test, since the payment-icon strip below it sits
     on the same dark ground. */
  function lightenBottom(){
    var pane = document.querySelector('#cart .sticky-in-panel');
    var cart = document.getElementById('cart');
    if (!pane || !cart) return;

    var seen = [];
    for (var el = pane; el && el !== document.body; el = el.parentNode){
      seen.push(el);
      if (el === cart) break;
    }
    if (pane.parentNode){
      Array.prototype.forEach.call(pane.parentNode.children, function(sib){
        if (seen.indexOf(sib) < 0) seen.push(sib);
      });
    }

    seen.forEach(function(el){
      if (el.nodeType !== 1 || el.dataset.pgLit) return;
      var bg = getComputedStyle(el).backgroundColor || '';
      var m = bg.match(/rgba?\(([^)]+)\)/);
      if (!m) return;
      var p = m[1].split(',').map(parseFloat);
      if (p.length > 3 && p[3] < 0.05) return;              /* transparent, skip */
      var lum = (0.299 * p[0] + 0.587 * p[1] + 0.114 * p[2]) / 255;
      if (lum > 0.6) return;                                 /* already light */
      el.dataset.pgLit = '1';
      el.style.setProperty('background-color', '#FFFFFF', 'important');
      el.style.setProperty('background-image', 'none', 'important');
    });
  }

  function render(){
    if (!VMAP) return;
    lightenBottom();
    var pane = document.querySelector('#cart .sticky-in-panel');
    if (!pane) return;
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(c){
      var items = c.items || [];
      if (!items.length){
        var old = pane.querySelector('.pg-tot');
        if (old) old.parentNode.removeChild(old);
        last = '';
        return;
      }

      /* Original: every unit at its compare-at price, falling back to the
         selling price where there is no compare-at. Shipping Protection is a
         service, not a discounted product, so it sits outside this figure. */
      var original = 0, selling = 0, prot = 0;
      items.forEach(function(it){
        if ((it.handle || '').indexOf('shipping-protection') > -1){ prot += it.line_price; return; }
        var v = VMAP[it.variant_id];
        var unit = v ? v[0] : it.price;
        var cap = (v && v[1] > v[0]) ? v[1] : unit;
        original += cap * it.quantity;
        selling += unit * it.quantity;
      });

      var total = c.total_price;                       /* the real charge */
      var sale = Math.max(0, original - selling);      /* compare-at savings */
      var promo = Math.max(0, (original + prot) - total - sale);
      var saved = Math.max(0, (original + prot) - total);
      var pct = original > 0 ? Math.round(saved / (original + prot) * 100) : 0;

      var key = [original, prot, total, sale, promo].join('|');
      if (key === last && pane.querySelector('.pg-tot')) return;
      last = key;

      var html = row('Original price', money(original + prot));
      if (sale > 0) html += row('Sale savings', '-' + money(sale), 'pg-tot-off');
      if (promo > 0) html += row('Promo discount', '-' + money(promo), 'pg-tot-off');

      /* Bottom line: what they saved. With nothing discounted there is no
         savings to report, so the box falls back to stating the charge rather
         than printing "Total savings $0.00". */
      if (saved > 0) html += row('Total savings (' + pct + '%)', money(saved), 'pg-tot-sum pg-tot-saved');
      else html += row('Total', money(total), 'pg-tot-sum');

      var box = pane.querySelector('.pg-tot');
      if (!box){
        box = document.createElement('div');
        box.className = 'pg-tot';
        pane.insertBefore(box, pane.querySelector('.l4tt') || pane.firstChild);
      }
      box.innerHTML = html;
    }).catch(function(){});
  }

  setInterval(render, 800);
  render();
})();
</script>
{% schema %}
{"name": "PG Cart Total", "settings": []}
{% endschema %}
