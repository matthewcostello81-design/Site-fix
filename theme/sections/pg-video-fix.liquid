{%- comment -%}
  PG Video Fix.
  pg-landing builds its gallery from product.images, and in Liquid product.images returns
  images only, so any video attached to the product is silently dropped. This section
  renders the product's video media with video_tag, then moves it into the landing hero and
  adds a poster thumbnail with a play badge in front of the image thumbs.
  The thumb is a <button>, and this theme paints every button solid black, so every visual
  property on .pgx-vthumb is forced. Add this section directly after pg-landing.
{%- endcomment -%}
{%- assign p = section.settings.product -%}
{%- if p != blank -%}
  {%- assign vids = p.media | where: 'media_type', 'video' -%}
  {%- if vids.size > 0 -%}
  <div id="pgx-vfix" hidden>
    {%- for m in vids -%}
      <div class="pgx-vfix-item" data-pgx-vpost="{{ m.preview_image | image_url: width: 700 }}">
        {{ m | video_tag: controls: true, preload: 'metadata', muted: true, loop: true }}
      </div>
    {%- endfor -%}
  </div>
  <style>
    #pgx-vfix{display:none !important}
    #pgx .pgx-hero{position:relative}
    #pgx .pgx-hero video{width:100% !important;height:auto !important;display:block;background:#0d0713;border-radius:10px}
    #pgx .pgx-thumbs .pgx-vthumb,
    #pgx button.pgx-vthumb{
      position:relative !important;display:block !important;
      padding:0 !important;margin:0 !important;border:0 !important;
      background:#f6f6f6 !important;background-color:#f6f6f6 !important;background-image:none !important;
      border-radius:10px !important;overflow:hidden !important;cursor:pointer !important;
      box-shadow:none !important;-webkit-appearance:none !important;appearance:none !important;
      min-height:0 !important;height:auto !important;width:100% !important;line-height:0 !important;
      color:inherit !important;font-size:0 !important;
    }
    #pgx .pgx-vthumb img{aspect-ratio:1/1 !important;object-fit:cover !important;width:100% !important;height:auto !important;display:block !important;position:relative !important;z-index:0 !important;opacity:1 !important}
    #pgx .pgx-vthumb:before{content:'' !important;position:absolute !important;inset:0 !important;background:linear-gradient(180deg,rgba(42,17,64,.10) 0%,rgba(42,17,64,.42) 100%) !important;z-index:1 !important;pointer-events:none !important}
    #pgx .pgx-vthumb .pgx-play{position:absolute !important;top:50% !important;left:50% !important;transform:translate(-50%,-50%) !important;width:48px !important;height:48px !important;border-radius:50% !important;background:rgba(255,255,255,.90) !important;-webkit-backdrop-filter:blur(10px) saturate(1.6) !important;backdrop-filter:blur(10px) saturate(1.6) !important;display:flex !important;align-items:center !important;justify-content:center !important;z-index:2 !important;box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 12px 26px -10px rgba(42,17,64,.75) !important;transition:transform .18s ease,background-color .18s ease !important;pointer-events:none !important}
    #pgx .pgx-vthumb .pgx-play:before{content:'' !important;margin-left:4px !important;border-left:15px solid #7A2FA2 !important;border-top:9px solid transparent !important;border-bottom:9px solid transparent !important;width:0 !important;height:0 !important}
    #pgx .pgx-vthumb:hover .pgx-play{transform:translate(-50%,-50%) scale(1.08) !important;background:#fff !important}
    #pgx .pgx-vthumb .pgx-vtag{position:absolute !important;left:10px !important;bottom:10px !important;z-index:2 !important;font-family:Poppins,Segoe UI,Helvetica,Arial,sans-serif !important;font-size:11px !important;font-weight:700 !important;letter-spacing:.10em !important;text-transform:uppercase !important;color:#fff !important;background:rgba(122,47,162,.86) !important;-webkit-backdrop-filter:blur(8px) !important;backdrop-filter:blur(8px) !important;padding:5px 9px !important;border-radius:999px !important;line-height:1 !important;pointer-events:none !important}
    @media only screen and (max-width:900px){
      #pgx .pgx-vthumb .pgx-play{width:42px !important;height:42px !important}
      #pgx .pgx-vthumb .pgx-play:before{border-left-width:13px !important;border-top-width:8px !important;border-bottom-width:8px !important}
      #pgx .pgx-vthumb .pgx-vtag{font-size:10px !important;padding:4px 8px !important;left:8px !important;bottom:8px !important}
    }
  </style>
  <script>
  (function(){
    if (window.pgxVideoFix) { return; }
    window.pgxVideoFix = 1;

    function init(){
      var src = document.getElementById('pgx-vfix');
      if (!src) { return true; }
      var hero = document.querySelector('#pgx .pgx-hero');
      var heroImg = document.getElementById('pgx-hero-img');
      if (!hero || !heroImg) { return false; }

      var items = src.querySelectorAll('.pgx-vfix-item');
      if (!items.length) { return true; }

      var thumbs = document.querySelector('#pgx .pgx-thumbs');
      if (!thumbs) {
        thumbs = document.createElement('div');
        thumbs.className = 'pgx-thumbs';
        if (hero.parentNode) { hero.parentNode.appendChild(thumbs); }
      }

      function hideVideos(){
        var vs = hero.querySelectorAll('video');
        for (var k = 0; k < vs.length; k++) { vs[k].pause(); vs[k].style.display = 'none'; }
      }

      for (var i = items.length - 1; i >= 0; i--) {
        var it = items[i];
        var vid = it.querySelector('video');
        if (!vid) { continue; }

        vid.setAttribute('playsinline', '');
        vid.setAttribute('webkit-playsinline', '');
        vid.style.display = 'none';
        hero.appendChild(vid);

        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'pgx-vthumb';
        b.setAttribute('aria-label', 'Play product video');

        var im = document.createElement('img');
        im.src = it.getAttribute('data-pgx-vpost') || '';
        im.alt = 'Product video';
        im.loading = 'lazy';

        var play = document.createElement('span');
        play.className = 'pgx-play';

        var tag = document.createElement('span');
        tag.className = 'pgx-vtag';
        tag.textContent = 'Video';

        b.appendChild(im);
        b.appendChild(play);
        b.appendChild(tag);

        (function(v){
          b.addEventListener('click', function(){
            hideVideos();
            heroImg.style.display = 'none';
            v.style.display = 'block';
            try { v.currentTime = 0; } catch (e) {}
            var pr = v.play();
            if (pr && pr.catch) { pr.catch(function(){}); }
          });
        })(vid);

        thumbs.insertBefore(b, thumbs.firstChild);
      }

      document.addEventListener('click', function(e){
        var t = (e.target && e.target.closest) ? e.target.closest('[data-pgx-thumb]') : null;
        if (!t) { return; }
        hideVideos();
        heroImg.style.display = 'block';
      }, true);

      if (src.parentNode) { src.parentNode.removeChild(src); }
      return true;
    }

    var n = 0;
    var t = setInterval(function(){ n++; if (init() || n > 30) { clearInterval(t); } }, 250);
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }
  })();
  </script>
  {%- endif -%}
{%- endif -%}
{% schema %}
{
  "name": "PG Video Fix",
  "settings": [
    {"type": "product", "id": "product", "label": "Product (must match the PG Landing product)"}
  ],
  "presets": [{"name": "PG Video Fix"}]
}
{% endschema %}
