<script>
(function(){
  if (window.pgGiftOff) return; window.pgGiftOff = 1;

  function giftRows(){
    var out = [];
    document.querySelectorAll('#cart .l4ca > li, body.template-cart .form-cart .l4ca > li')
      .forEach(function(li){ if (li.querySelector('.pg-free-tag')) out.push(li); });
    return out;
  }

  /* $13.99 from the variant's compare-at via Liquid, with a hard fallback: an
     all_products lookup can come back empty, and an empty struck price is
     exactly the "you dont have original price above it crossed out" the owner
     reported. */
  var WAS = {{ pg_gift_was | json }};
  if (!/^\$[\d.,]+$/.test(String(WAS || ''))) WAS = '$13.99';

  /* THE PRICE CELL, BUILT AND OWNED HERE. */
  function cellOf(li){
    var cell = li.querySelector('.pg-gift-cell');
    if (cell) return cell;
    var sect = li.querySelector('section');
    if (!sect) return null;
    cell = document.createElement('div');
    /* `nc-lsave` rides along too: some of the theme's price rules are scoped to
       that CONTAINER (measured -- the struck price came out 13.5px/400 in a bare
       cell against 12px/600 in a real one), so wearing the class is the only way
       to inherit them rather than re-derive them. The cell is still built and
       owned here; only the styling is borrowed. */
    cell.className = 'pg-gift-cell nc-lsave';
    cell.innerHTML = '<s class="pg-gift-was nc-lsave-was"></s>' +
                     '<b class="pg-gift-now nc-lsave-now"></b>' +
                     '<span class="pg-gift-off">SAVE 100%</span>';
    sect.appendChild(cell);
    return cell;
  }

  function setText(el, t){ if (el && el.textContent !== t) el.textContent = t; }

  function figures(cell){
    setText(cell.querySelector('.pg-gift-was'), WAS);
    setText(cell.querySelector('.pg-gift-now'), '$0.00');
    setText(cell.querySelector('.pg-gift-off'), 'SAVE 100%');
  }

  /* THE PILL. Its GRID PLACEMENT is handled in CSS above -- that was the actual
     bug. What still has to be done from script is the inline geometry pg-drawer's
     ftFix() pins (width and text-indent, both inline !important, unbeatable from
     a stylesheet). */
  function pillLeft(li){
    var tag = li.querySelector('.pg-free-tag');
    if (!tag) return;
    /* OUT OF THE GRID ENTIRELY -- pg-chips' own conclusion for its plaque, and
       the only placement that cannot be auto-flowed into the wrong cell. */
    var h2 = li.querySelector('h2');
    if (h2 && tag.parentNode !== h2) h2.appendChild(tag);
    if (tag.style.justifyContent !== 'flex-start'){
      tag.style.setProperty('justify-content', 'flex-start', 'important');
      tag.style.setProperty('text-align', 'left', 'important');
      tag.style.setProperty('padding', '6px 11px', 'important');
    }
    if (tag.style.width !== 'auto') tag.style.setProperty('width', 'auto', 'important');
    if (tag.style.textIndent !== '0px') tag.style.setProperty('text-indent', '0', 'important');
  }

  /* ---------------- a case for every console ----------------
     Owner's rule, stated plainly: the spare-case offer covers every console in
     the cart that does not already have a case -- the free one included. Three
     consoles and one free case means TWO spares, so the third console is not
     left without.

     pg-unlock's accRow() answers a different question:

         q = (o.totalQty + o.need) - (PAID cases only)

     `need` is however many units the next bundle rung would add, so the count
     includes consoles the shopper has not bought yet; and excluding the free
     case means the one console that IS covered still gets counted. Neither is
     the number the row is asking about.

     An earlier version of this block tried to NUDGE pg-unlock into recomputing
     its own figure by removing the row. That cannot help when the formula
     itself is the wrong one, and a row removal on every cart change is a
     rebuild the shopper can see -- exactly the kind of churn this cart has been
     reported for. It is gone. What replaces it writes the three things the row
     states and nothing else: data-q (which pg-unlock's accPost reads when it
     adds), the label, and the price pair.

     Each is written only when it actually differs, so a settled row is never
     touched. pg-unlock rewrites the row wholesale whenever its own signature
     changes, and this simply re-applies on the next pass -- the same
     arrangement pg-upsell-fit already uses for the R36S rename, and safe for
     the same reason. */
  var ACC = {
    'handheld-game-console': {
      mark: 'r36s-protective-case', now: 1399, was: 2499,
      one: 'Add a spare protective case', many: 'Add a spare case for each console'
    },
    'lenticular-poster': {
      mark: '30x40cm-frame', now: 1499, was: 2799,
      one: 'Add the matching frame', many: 'Add a frame for each print'
    }
  };

  function accMoney(c){ return '$' + (c / 100).toFixed(2); }

  function lineQty(li){
    var inp = li.querySelector('input[type=number]');
    if (inp) return parseInt(inp.value, 10) || 0;
    /* nc-cartfix replaces the stepper with <b class="nc-qv">n</b> */
    var qv = li.querySelector('.nc-qv');
    if (qv) return parseInt(qv.textContent, 10) || 0;
    return 1;
  }

  /* units of a product in the cart, read off the rendered rows -- no network.
     The free gift line is NOT excluded here: a console that already has the
     free case does not need a spare, which is the whole point of the rule. */
  function unitsOf(mark){
    var n = 0;
    document.querySelectorAll('#cart .l4ca:not(.in-panel) > li, body.template-cart .form-cart .l4ca:not(.in-panel) > li')
      .forEach(function(li){
        if (!li.querySelector('a[href*="' + mark + '"]')) return;
        n += lineQty(li);
      });
    return n;
  }

  function accFit(){
    document.querySelectorAll('#cart .pg-unlock[data-pg-unlock]').forEach(function(row){
      var handle = row.getAttribute('data-pg-unlock') || '', cfg = null, k;
      for (k in ACC){ if (handle.indexOf(k) > -1){ cfg = ACC[k]; break; } }
      if (!cfg) return;
      var acc = row.querySelector('.pg-uacc');
      if (!acc) return;

      var want = unitsOf(k) - unitsOf(cfg.mark);
      if (want < 1){
        if (acc.style.display !== 'none') acc.style.setProperty('display', 'none', 'important');
        return;
      }
      if (acc.style.display === 'none') acc.style.removeProperty('display');

      if (acc.getAttribute('data-q') !== String(want)) acc.setAttribute('data-q', String(want));

      var t = acc.querySelector('.pg-uacc-t');
      var label = want > 1 ? cfg.many : cfg.one;
      if (t && t.textContent !== label) t.textContent = label;

      var p = acc.querySelector('.pg-uacc-p');
      var html = '<s>' + accMoney(cfg.was * want) + '</s>' + accMoney(cfg.now * want);
      if (p && p.innerHTML !== html) p.innerHTML = html;
    });
  }

  function pass(){
    giftRows().forEach(function(li){
      pillLeft(li);
      var host = cellOf(li);
      if (!host) return;
      figures(host);
    });
    accFit();
  }

  var pending = false;
  function soon(){
    if (pending) return;
    pending = true;
    setTimeout(function(){ pending = false; pass(); }, 80);
  }

  if (window.MutationObserver){
    (function watch(){
      var c = document.getElementById('cart');
      if (c){ try { new MutationObserver(soon).observe(c, {childList:true, subtree:true}); } catch(e){} }
      else setTimeout(watch, 500);
    })();
  }
  /* ftFix's own schedule, plus one after it, so the pill settles on this side */
  [450, 1550, 3550, 4200].forEach(function(ms){ setTimeout(pass, ms); });
  setInterval(pass, 1200);
  pass();
})();
</script>
