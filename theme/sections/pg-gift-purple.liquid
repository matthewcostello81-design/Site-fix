{%- comment -%}
  PG Gift Purple: make the gift line's SAVE 100% the SAME purple as the other
  pills in the cart, for the two reasons it was not.

  This lives in its own file rather than inside pg-cart-tune because that file is
  already 34KB and this is a self-contained correction with one job. It writes
  two properties on one class and nothing else in the theme writes either of
  them, so it cannot contend with anything.

  ------------------------------------------------------------------ CAUSE ONE

  PHASE. The gradient is not different -- it is character for character the
  declaration pg-drawer gives .pg-save-chip and .pg-free-tag, confirmed by
  computed style (sameGradient: true). But a CSS animation starts when its
  ELEMENT does, and these pills are created by different sections at different
  moments, so at any instant each sits at a different point in the same
  five-second pgShift sweep.

  Every pill is anchored to one origin with a negative animation-delay equal to
  how long ago that origin was -- the phase an animation started then would be
  in. Stamped once per element, because a CHANGED delay restarts the animation
  and shows as a jump.

  ------------------------------------------------------------------ CAUSE TWO

  SCALE, which phase alone could never fix. `background-size:240% 240%` is
  relative to the ELEMENT'S OWN box, and the pills are different widths.
  Measured in Chromium against the theme's own pill geometry:

      reference pill "-44%"    42.0px wide  ->  gradient runs over 100.8px
      ours "SAVE 100%"         79.8px wide  ->  gradient runs over 191.5px

  The same five stops stretched to nearly twice the length. At any instant the
  two show a different slice of it, so they read as different purples with
  neither colour nor phase to blame.

  So the reference pill is measured at runtime and its gradient size copied onto
  ours in PIXELS -- 100.8px on both -- after which the colour at a given phase is
  the same. Written only when the value changes, so the animation is never
  restarted. With no reference pill on screen (a cart holding only the gift)
  nothing is written and the theme's percentage stands.
{%- endcomment -%}
<script>
(function(){
  if (window.pgGiftPurple) return; window.pgGiftPurple = 1;

  /* one origin for every pill, so "in phase" means something */
  var PHASE0 = Date.now() - (window.performance && performance.now ? performance.now() : 0);
  var PHASED = '.pg-gift-off, .pg-save-chip, .pg-free-tag, .pg-unlock-tag, .pg-frameoffer-sv';

  function syncPhase(){
    document.querySelectorAll(PHASED).forEach(function(el){
      if (el.getAttribute('data-pg-phase')) return;
      el.setAttribute('data-pg-phase', '1');
      var d = ((Date.now() - PHASE0) % 5000) / 1000;
      el.style.setProperty('animation-delay', '-' + d.toFixed(3) + 's', 'important');
    });
  }

  /* and the same gradient scale, in pixels, copied off a real pill */
  function matchPurple(){
    var ref = document.querySelector('#cart .pg-save-chip, #cart .pg-free-tag');
    if (!ref) return;
    var r = ref.getBoundingClientRect();
    if (!r.width || !r.height) return;
    var bs = (r.width * 2.4).toFixed(1) + 'px ' + (r.height * 2.4).toFixed(1) + 'px';
    document.querySelectorAll('#cart .pg-gift-off, body.template-cart .pg-gift-off').forEach(function(el){
      if (el.getAttribute('data-pg-bs') === bs) return;
      el.setAttribute('data-pg-bs', bs);
      el.style.setProperty('background-size', bs, 'important');
    });
  }

  function pass(){ syncPhase(); matchPurple(); }

  var pending = false;
  function soon(){
    if (pending) return;
    pending = true;
    setTimeout(function(){ pending = false; pass(); }, 80);
  }

  if (window.MutationObserver){
    (function watch(){
      var c = document.getElementById('cart');
      if (c){ try { new MutationObserver(soon).observe(c, {childList:true, subtree:true}); } catch(e){} }
      else setTimeout(watch, 500);
    })();
  }
  setInterval(pass, 1200);
  pass();
})();
</script>
{% schema %}
{"name": "PG Gift Purple", "settings": []}
{% endschema %}
