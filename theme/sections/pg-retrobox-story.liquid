{%- if section.settings.story_image -%}{%- assign rbs_story = section.settings.story_image | image_url: width: 900 -%}{%- assign rbs_story6 = section.settings.story_image | image_url: width: 600 -%}
{%- elsif rbs_img8d -%}{%- assign rbs_story = rbs_img8d | image_url: width: 900 -%}{%- assign rbs_story6 = rbs_img8d | image_url: width: 600 -%}
{%- else -%}{%- assign rbs_story = rbs_cdn | append: 'hf_20260926_180846_d29b2711-8709-4a41-9b27-a9ea0ca4a933.png?width=900' -%}{%- assign rbs_story6 = rbs_cdn | append: 'hf_20260926_180846_d29b2711-8709-4a41-9b27-a9ea0ca4a933.png?width=600' -%}{%- endif -%}
{%- if rbs_img8 -%}{%- assign rbs_box8 = rbs_img8 | image_url: width: 600 -%}{%- else -%}{%- assign rbs_box8 = rbs_cdn | append: 'hf_20260926_180847_c4d3e607-2e94-4f0e-834b-73eb70c52a60.png?width=600' -%}{%- endif -%}
{%- if rbs_img16 -%}{%- assign rbs_box16 = rbs_img16 | image_url: width: 600 -%}{%- else -%}{%- assign rbs_box16 = rbs_cdn | append: 'hf_20260926_175910_950fa892-84dd-4f15-8fca-4158bda08928.png?width=600' -%}{%- endif -%}
{%- comment -%} the two editions' live prices, for the price cards and the chart {%- endcomment -%}
