{%- for v in product.variants -%}
  {%- if v.option1 == '8-Bit Edition' -%}{%- assign rbs_p8 = v.price -%}{%- endif -%}
  {%- if v.option1 == '16-Bit Edition' -%}{%- assign rbs_p16 = v.price -%}{%- endif -%}
{%- endfor -%}
<style>
  /* ---------------- 1. benefits ---------------- */
  /* four across, icon over label; the icon scales with its column */
  #pgx .pg-rbs-ben{list-style:none !important;margin:6px 0 18px !important;padding:0 !important;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
  #pgx .pg-rbs-ben li{list-style:none !important;display:flex;flex-direction:column;align-items:center;text-align:center;gap:9px;margin:0 !important;padding:0 !important;min-width:0;
    font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;line-height:1.3;color:#CFC4DE}
  #pgx .pg-rbs-ben li:before{content:none !important}
  #pgx .pg-rbs-ben .ic{flex:none;width:74%;max-width:64px;aspect-ratio:1/1;border-radius:50%;display:flex;align-items:center;justify-content:center;
    background:rgba(139,68,190,.3);border:0;
    box-shadow:inset 0 0 0 1px rgba(199,155,234,.38),0 0 20px 0 rgba(139,68,190,.45)}
  #pgx .pg-rbs-ben .ic svg{width:56%;height:56%;stroke:#D9B4FF;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  #pgx .pg-rbs-ben li > span:last-child{display:block;min-width:0;max-width:100%}
  #pgx .pg-rbs-ben b{display:block;margin-bottom:2px;font-size:12px;line-height:1.2;font-weight:800;color:#fff;text-wrap:balance}
  /* the number of games: its own line, white like the rest of the label */
  #pgx .pg-rbs-ben b i{display:block;font-style:normal;color:#fff;white-space:nowrap}
  #pgx#pgx .pgx-buy > .pgx-title{text-wrap:balance}

  /* ---------------- 3. the story ---------------- */
  .pg-rbs{font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;color:#F1EDF7;background:#0B0710}
  /* inside #pgx the page's own dark gradient shows through; the solid fill is
     only for the moment before the script seats it there */
  #pgx .pg-rbs{background:transparent}
  .pg-rbs *{box-sizing:border-box}
  #pgx .pg-rbs{padding:26px 0 6px}
  /* one module, joined chapters: the first carries the rounded top and the
     last the rounded bottom, a hairline divides them, and every one opens
     with the purple glow at its top */
  .pg-rbs-sec{position:relative;width:calc(100% - 48px);max-width:1120px;margin:0 auto;padding:58px 44px 54px;text-align:center;overflow:hidden;
    border:1px solid rgba(199,155,234,.22);border-bottom-width:0;border-radius:0;
    background:radial-gradient(90% 62% at 50% 0%,rgba(155,75,196,.22),rgba(155,75,196,0) 72%),rgba(255,255,255,.03)}
  .pg-rbs-sec + .pg-rbs-sec{border-top-color:rgba(199,155,234,.14)}
  .pg-rbs-sec:first-child{border-radius:28px 28px 0 0}
  .pg-rbs-sec:last-child{border-bottom-width:1px;border-radius:0 0 28px 28px;margin-bottom:28px;box-shadow:0 34px 80px -60px rgba(139,68,190,.95)}
  .pg-rbs-sec:before{content:"";position:absolute;left:50%;top:0;width:96px;height:3px;margin-left:-48px;border-radius:0 0 4px 4px;
    background:linear-gradient(90deg,#9B4BC4,#D9B3F5)}
  .pg-rbs-eye{display:inline-block;margin:0 0 16px;padding:7px 14px;border-radius:999px;
    border:1px solid rgba(199,155,234,.42);background:rgba(155,75,196,.16);
    font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:11px;line-height:1.2;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:#C79BEA}
  .pg-rbs h2{margin:0 auto 14px;max-width:820px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:40px;line-height:1.12;font-weight:800;letter-spacing:-.01em;color:#fff;text-wrap:balance}
  .pg-rbs h2 span{background:linear-gradient(100deg,#F3E8FF 0%,#D9B3F5 30%,#B06CE8 60%,#8B3FB8 100%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
  .pg-rbs-lead{margin:0 auto;max-width:640px;font-size:16.5px;line-height:1.6;color:#CFC4DE;text-wrap:pretty}
  .pg-rbs-lead b{color:#fff}
  /* the closing line of the childhood panel, the same on every console page */
  .pg-rbs-mem{margin:18px 0 0;padding-left:14px;border-left:3px solid #9B4BC4;font-size:17px;line-height:1.45;font-weight:700;font-style:italic;color:#D9B3F5}
  @media (max-width:900px){
    .pg-rbs-mem{margin:16px auto 0;padding:0;border:0;font-size:15.5px;text-align:center}
  }

  .pg-rbs-split{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;text-align:left}
  .pg-rbs-split h2,.pg-rbs-split .pg-rbs-lead{margin-left:0;margin-right:0}
  .pg-rbs-photo{border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,.09);background:#16101F;box-shadow:0 30px 70px -40px rgba(139,68,190,.8)}
  .pg-rbs-photo img{display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:cover}
  .pg-rbs-hero .pg-rbs-photo{order:-1}
  .pg-rbs-math{display:flex;gap:12px;margin:22px 0 0}
  .pg-rbs-math div{flex:1;min-width:0;padding:14px 16px;border-radius:14px;background:#16101F;border:1px solid rgba(255,255,255,.09);cursor:pointer;
    -webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;transition:transform .15s ease,border-color .15s ease,box-shadow .15s ease}
  .pg-rbs-math small,.pg-rbs-math em,.pg-rbs-math .go{white-space:nowrap}
  /* the card of the edition selected in the buy box is the lit one */
  .pg-rbs-math div.us{border-color:rgba(199,155,234,.55);background:linear-gradient(140deg,#1D1230,#16101F)}
  .pg-rbs-math div:hover,.pg-rbs-math div:focus-visible{border-color:#C79BEA;box-shadow:0 14px 30px -18px rgba(155,75,196,.95);transform:translateY(-2px);outline:0}
  .pg-rbs-math div:active{transform:translateY(0)}
  .pg-rbs-math .go{display:block;margin-top:9px;font-size:11.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#C79BEA}
  /* the top bar is pinned, so a jump to the tiles stops short of it */
  #pgx .pgx-bs{scroll-margin-top:76px}
  .pg-rbs-math small{display:block;font-size:11.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#B9AECB}
  .pg-rbs-math div.us small{color:#C79BEA}
  .pg-rbs-math strong{display:block;margin-top:4px;font-size:26px;font-weight:800;color:#fff;line-height:1.1}
  .pg-rbs-math em{display:block;margin-top:3px;font-style:normal;font-size:12.5px;color:#CFC4DE}

  .pg-rbs-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin:34px 0 0}
  /* spec tiles: a big stat over a short description */
  .pg-rbs-feat{position:relative;padding:32px 18px 30px;border-radius:22px;overflow:hidden;
    background:linear-gradient(180deg,rgba(155,75,196,.14),rgba(155,75,196,0) 60%),#16101F;border:1px solid rgba(199,155,234,.18)}
  .pg-rbs-feat .ic{width:72px;height:72px;margin:0 auto 16px;border-radius:20px;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(135deg,#C48EEA 0%,#A85DD3 35%,#8F3FB8 65%,#5A2280 100%);box-shadow:0 12px 26px -14px rgba(155,75,196,.9)}
  .pg-rbs-feat .ic svg{width:54px;height:54px;stroke:#fff;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  /* the stat words carry a slow white-to-lavender sweep */
  .pg-rbs-feat h3{margin:0 0 8px;font-family:inherit;font-size:26px;line-height:1.1;font-weight:800;letter-spacing:-.01em;text-wrap:balance;
    background:linear-gradient(100deg,#fff 0%,#D9B3F5 25%,#fff 50%,#D9B3F5 75%,#fff 100%);background-size:200% 100%;background-position:0% 50%;
    -webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;
    animation:pg-rbs-statflow 4s linear infinite}
  @keyframes pg-rbs-statflow{from{background-position:0% 50%}to{background-position:200% 50%}}
  @media (prefers-reduced-motion:reduce){.pg-rbs-feat h3{animation:none}}
  .pg-rbs-feat p{margin:0;font-size:15px;line-height:1.5;color:#CFC4DE;text-wrap:balance}

  /* in the box: one card per edition, photo left, name and one line right */
  .pg-rbs-cases{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:860px;margin:30px auto 0;text-align:left}
  .pg-rbs-case{display:grid;grid-template-columns:124px minmax(0,1fr);gap:16px;align-items:center;padding:16px;border-radius:18px;background:#16101F;border:1px solid rgba(255,255,255,.09)}
  .pg-rbs-case img{display:block;width:124px;height:124px;border-radius:14px;object-fit:cover;background:#0D0714}
  .pg-rbs-case .tag{display:inline-block;margin:0 0 7px;padding:4px 9px;border-radius:999px;background:rgba(155,75,196,.2);border:1px solid rgba(199,155,234,.4);font-size:10.5px;line-height:1.2;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#C79BEA}
  .pg-rbs-case h3{margin:0 0 5px;font-family:inherit;font-size:16px;line-height:1.25;font-weight:800;color:#fff}
  .pg-rbs-case p{margin:0;font-size:13px;line-height:1.5;color:#CFC4DE}
  .pg-rbs-tbl{max-width:720px;margin:34px auto 0;text-align:left}
  .pg-rbs-row{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr) minmax(0,1fr);align-items:stretch}
  .pg-rbs-row > div{display:flex;align-items:center;justify-content:center;padding:14px 8px;border-bottom:1px solid rgba(255,255,255,.08);font-size:14px;line-height:1.3}
  .pg-rbs-row > div:first-child{justify-content:flex-start;padding-left:4px;font-weight:600;color:#F1EDF7}
  .pg-rbs-row > div.us{background:#1A1129;border-left:1px solid rgba(199,155,234,.45);border-right:1px solid rgba(199,155,234,.45)}
  .pg-rbs-row.hd > div{border-bottom:0;padding:16px 8px;font-size:13.5px;font-weight:800;text-align:center;color:#fff}
  .pg-rbs-row.hd > div.us{border-top:1px solid rgba(199,155,234,.45);border-radius:16px 16px 0 0}
  .pg-rbs-row.hd > div.them{color:#B9AECB;font-weight:700}
  .pg-rbs-row:last-child > div{border-bottom:0}
  .pg-rbs-row:last-child > div.us{border-bottom:1px solid rgba(199,155,234,.45);border-radius:0 0 16px 16px}
  .pg-rbs-tbl .y,.pg-rbs-tbl .n{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none}
  .pg-rbs-tbl .y{background:linear-gradient(135deg,#9B4BC4,#7A2FA2)}
  .pg-rbs-tbl .n{background:#2A2236}
  .pg-rbs-tbl .y svg,.pg-rbs-tbl .n svg{width:13px;height:13px;fill:none;stroke:#fff;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
  .pg-rbs-tbl .n svg{stroke:#8E829F}
