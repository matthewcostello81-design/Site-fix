    .pg-rbs-feat{padding:24px 8px 22px;border-radius:20px}
    .pg-rbs-feat .ic{width:60px;height:60px;margin-bottom:12px;border-radius:17px}
    .pg-rbs-feat .ic svg{width:46px;height:46px}
    .pg-rbs-feat h3{font-size:clamp(20px,5.8vw,24px);margin-bottom:6px}
    .pg-rbs-feat p{font-size:13.5px;line-height:1.45}
    .pg-rbs-cases{grid-template-columns:1fr;gap:12px;margin-top:22px}
    .pg-rbs-case{grid-template-columns:96px minmax(0,1fr);gap:13px;padding:13px}
    .pg-rbs-case img{width:96px;height:96px}
    .pg-rbs-case h3{font-size:15px}
    .pg-rbs-case p{font-size:12.5px}
    .pg-rbs-tbl{margin-top:26px}
    .pg-rbs-row > div{font-size:13px;padding:12px 6px}
    .pg-rbs-row.hd > div{font-size:12.5px;padding:13px 6px}
    .pg-rbs-cta{display:flex;width:100%;margin-top:28px;padding:16px 12px}
  }
  /* phones: the bold label only, in two short lines under a big icon. The
     second line is a bare text node, so it is hidden by zeroing the span's
     type and giving the label its size back. */
  @media (max-width:600px){
    #pgx .pg-rbs-ben{gap:6px}
    #pgx .pg-rbs-ben li{gap:8px}
    #pgx .pg-rbs-ben li > span:last-child{font-size:0;line-height:0}
    #pgx .pg-rbs-ben b{margin:0;font-size:11.5px;line-height:1.22}
  }
  @media (max-width:370px){
    #pgx .pg-rbs-ben b{font-size:10.5px}
  }
  @media (max-width:380px){
    .pg-rbs h2{font-size:25px}
    .pg-rbs-math strong{font-size:22px}
  }
  /* the very narrow phones */
  @media (max-width:340px){
    #pgx .pg-rbs-ben b{font-size:10px}
    .pg-rbs-math small{font-size:9.5px;letter-spacing:.03em}
    .pg-rbs-math em{font-size:11px}
  }
</style>

<div id="pg-rbs-src" hidden>
  <ul class="pg-rbs-ben" data-rbs="ben">
    <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M7.4 6h9.2a5 5 0 0 1 4.9 6l-.8 4.6a2.8 2.8 0 0 1-5 1.2L14.4 16H9.6l-1.3 1.8a2.8 2.8 0 0 1-5-1.2L2.5 12a5 5 0 0 1 4.9-6z" fill="rgba(255,255,255,.16)"/><path d="M7.6 9.5v4.2M5.5 11.6h4.2"/><circle cx="15.2" cy="10.2" r=".95" fill="#fff" stroke="none"/><circle cx="17.9" cy="11.9" r=".95" fill="#fff" stroke="none"/><circle cx="15.2" cy="13.6" r=".95" fill="#fff" stroke="none"/><circle cx="12.5" cy="11.9" r=".95" fill="#fff" stroke="none"/><path d="M8 6V5.2a1 1 0 0 1 1-1h1.2M16 6V5.2a1 1 0 0 0-1-1h-1.2"/></svg></span><span><b><i>30 Classic</i> Games</b>Built in on each edition</span></li>
    <li><span class="ic"><svg viewBox="0 0 24 24"><rect x="2.5" y="4.5" width="19" height="12.5" rx="2.2" fill="rgba(255,255,255,.14)"/><path d="M8 20.5h8M12 17v3.5"/><path d="M9 8.5l6 2.5-6 2.5z" fill="#fff" stroke="none"/></svg></span><span><b>Plugs Into<br>Your TV</b>HD output over HDMI</span></li>
    <li><span class="ic"><svg viewBox="0 0 24 24"><path d="M5 3.5h11.2L20 7.3V19.5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1z" fill="rgba(255,255,255,.14)"/><path d="M8 3.5v4.2h7V3.5"/><rect x="7.2" y="12.4" width="9.6" height="6.2" rx="1" fill="#fff" stroke="none"/></svg></span><span><b>Save Your<br>Progress</b>Pick up where you left off</span></li>
    <li><span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12.6" r="7.9" fill="rgba(255,255,255,.14)"/><path d="M8.9 8.6a5.1 5.1 0 1 0 6.2 0"/><path d="M12 5.6v6" stroke-width="2"/></svg></span><span><b>Ready Out<br>of the Box</b>No downloads, no accounts</span></li>
  </ul>
</div>

<div class="pg-rbs" id="pg-rbs">
  <section class="pg-rbs-sec pg-rbs-hero">
    <div class="pg-rbs-split">
      <div>
        <span class="pg-rbs-eye">Your childhood, upgraded</span>
        <h2>The Couch Co-op Nights You Grew Up With. <span>Back on Your TV.</span></h2>
        <p class="pg-rbs-lead">Saturday mornings on the living room carpet. Passing the controller after every lost life. Sleepovers that ran way past bedtime. <b>30 classic games built in</b>, on the big screen the minute you plug&nbsp;in.</p>
        <p class="pg-rbs-mem">The games you remember. The feeling you forgot.</p>
      </div>
      <div class="pg-rbs-photo">
        <img src="{{ rbs_hero }}" srcset="{{ rbs_hero6 }} 600w, {{ rbs_hero }} 900w" sizes="(max-width: 900px) 92vw, 520px" alt="PocketEra RetroBox 16-Bit Edition on a gaming desk" loading="lazy" decoding="async" width="900" height="1125">
      </div>
    </div>
  </section>

  <section class="pg-rbs-sec">
    <div class="pg-rbs-split">
      <div>
        <span class="pg-rbs-eye">Pick your era</span>
        <h2>Two Classic Editions. <span>Choose Yours.</span></h2>
        <p class="pg-rbs-lead">Both come with 30 games built in and ship free. Pick the one you grew up with, or the one you always&nbsp;wanted.</p>
        <div class="pg-rbs-math">
          <div class="us" role="button" tabindex="0" data-rbs-cta data-rbs-pick="e8" aria-label="8-Bit Edition, {{ rbs_p8 | money_without_trailing_zeros }}. Choose the 8-Bit Edition"><small>8-Bit Edition</small><strong>{{ rbs_p8 | money_without_trailing_zeros }}</strong><em>30 built-in games<br>1 controller</em><span class="go">Choose 8-Bit &rarr;</span></div>
          <div role="button" tabindex="0" data-rbs-cta data-rbs-pick="e16" aria-label="16-Bit Edition, {{ rbs_p16 | money_without_trailing_zeros }}. Choose the 16-Bit Edition"><small>16-Bit Edition</small><strong>{{ rbs_p16 | money_without_trailing_zeros }}</strong><em>30 built-in games<br>2 controllers</em><span class="go">Choose 16-Bit &rarr;</span></div>
        </div>
      </div>
      <div class="pg-rbs-photo">
        <img src="{{ rbs_story }}" srcset="{{ rbs_story6 }} 600w, {{ rbs_story }} 900w" sizes="(max-width: 900px) 92vw, 520px" alt="PocketEra RetroBox 8-Bit Edition on a gaming desk" loading="lazy" decoding="async" width="900" height="900">
      </div>
    </div>
  </section>

  <section class="pg-rbs-sec">
    <span class="pg-rbs-eye">Under the hood</span>
    <h2>Plug In, Power On. <span>Press Start.</span></h2>
    <p class="pg-rbs-lead">The parts that matter once the controller is in your&nbsp;hands.</p>
    <div class="pg-rbs-grid">
      <div class="pg-rbs-feat"><span class="ic"><svg viewBox="0 0 24 24"><path d="M7.4 6h9.2a5 5 0 0 1 4.9 6l-.8 4.6a2.8 2.8 0 0 1-5 1.2L14.4 16H9.6l-1.3 1.8a2.8 2.8 0 0 1-5-1.2L2.5 12a5 5 0 0 1 4.9-6z" fill="rgba(255,255,255,.16)"/><path d="M7.6 9.5v4.2M5.5 11.6h4.2"/><circle cx="15.2" cy="10.2" r=".95" fill="#fff" stroke="none"/><circle cx="17.9" cy="11.9" r=".95" fill="#fff" stroke="none"/><circle cx="15.2" cy="13.6" r=".95" fill="#fff" stroke="none"/><circle cx="12.5" cy="11.9" r=".95" fill="#fff" stroke="none"/></svg></span><h3>30 Games</h3><p>Built in on each edition, ready to play.</p></div>
      <div class="pg-rbs-feat"><span class="ic"><svg viewBox="0 0 24 24"><rect x="2.5" y="4" width="19" height="13" rx="2" fill="rgba(255,255,255,.16)"/><rect x="5" y="6.3" width="14" height="8.4" rx="1" fill="rgba(255,255,255,.14)" stroke="none"/><path d="M10.6 8.5v4.4l3.8-2.2z" fill="rgba(255,255,255,.92)" stroke="none"/><path d="M12 17v3.2M8 20.5h8"/></svg></span><h3>HD Output</h3><p>Plugs into any TV with an HDMI port.</p></div>
      <div class="pg-rbs-feat"><span class="ic"><svg viewBox="0 0 24 24"><path d="M5 3.5h11.2L20 7.3V19.5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1z" fill="rgba(255,255,255,.16)"/><path d="M8 3.5v4.2h7V3.5"/><rect x="7.2" y="12.4" width="9.6" height="6.2" rx="1" fill="rgba(255,255,255,.55)" stroke="none"/></svg></span><h3>Save Game</h3><p>Save your progress, pick it up later.</p></div>
      <div class="pg-rbs-feat"><span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="rgba(255,255,255,.16)"/><path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9M12 3c-2.6 2.6-3.9 5.6-3.9 9s1.3 6.4 3.9 9"/></svg></span><h3>18 Languages</h3><p>A menu the whole family can read.</p></div>
    </div>
  </section>

  <section class="pg-rbs-sec">
    <span class="pg-rbs-eye">In the box</span>
    <h2>Pick Your Classic. <span>Plug It In.</span></h2>
    <p class="pg-rbs-lead">Each edition is a small classic-style console with wired controllers and 30 games built in. It runs on any USB 5V/2A&nbsp;adapter.</p>
    <div class="pg-rbs-cases">
      <div class="pg-rbs-case"><img src="{{ rbs_box8 }}" alt="PocketEra RetroBox 8-Bit Edition with its controller" loading="lazy" decoding="async" width="360" height="360"><div><span class="tag">8-Bit Edition</span><h3>The Grey Classic</h3><p>Grey and dark grey console plus one wired controller with a D-pad and two red A and B buttons. 30 built-in 8-bit games.</p></div></div>
      <div class="pg-rbs-case"><img src="{{ rbs_box16 }}" alt="PocketEra RetroBox 16-Bit Edition with two controllers" loading="lazy" decoding="async" width="360" height="360"><div><span class="tag">16-Bit Edition</span><h3>The Purple-Button Classic</h3><p>Light grey console with purple Power and Reset buttons, and two wired controllers for 2-player nights. 30 built-in 16-bit games.</p></div></div>
    </div>
    <span class="pg-rbs-cta" role="button" tabindex="0" data-rbs-cta>Choose Your Edition <span>&rarr;</span></span>
  </section>

  <section class="pg-rbs-sec pg-rbs-end">
    <span class="pg-rbs-eye">Side by side</span>
    <h2>Why the RetroBox <span>Stands Out.</span></h2>
<p class="pg-rbs-lead">Both editions, next to tracking down a used original console and its&nbsp;games.</p>
{%- comment -%} Cells: Y = tick, N = cross, S8 / S16 = the button that picks that edition, anything else prints as text. Only rows that are plainly true of both sides; no market prices. {%- endcomment -%}
{%- capture rbs_y -%}<span class="y" aria-label="Yes"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>{%- endcapture -%}
{%- capture rbs_n -%}<span class="n" aria-label="No"><svg viewBox="0 0 24 24"><path d="M7 7l10 10M17 7L7 17"/></svg></span>{%- endcapture -%}
{%- capture rbs_rows -%}Games in the box~30 built in~30 built in~Sold separately|Controllers in the box~1 wired~2 wired~Varies|HDMI to a modern TV~Y~Y~N|Save from the menu~Y~Y~N|Menu languages~18~18~No menu|Power~USB 5V/2A~USB 5V/2A~Own adapter|New, free shipping~Y~Y~N|Price~{{ rbs_p8 | money_without_trailing_zeros }}~{{ rbs_p16 | money_without_trailing_zeros }}~Varies, used|~S8~S16~{%- endcapture -%}
<div class="pg-rbs-tbl pg-rbs-tbl3" role="table" aria-label="PocketEra RetroBox 8-Bit and 16-Bit Editions compared with a used original console">
<div class="pg-rbs-row hd" role="row"><div role="columnheader"></div><div class="us" role="columnheader">8-Bit<i>RetroBox</i></div><div class="us" role="columnheader">16-Bit<i>RetroBox</i></div><div class="them" role="columnheader">Original<i>Used console</i></div></div>
{%- assign rbs_rowlist = rbs_rows | split: '|' -%}
{%- for row in rbs_rowlist -%}
{%- assign cells = row | split: '~' -%}
<div class="pg-rbs-row{% if cells[1] == 'S8' %} shop{% endif %}" role="row"><div role="cell">{{ cells[0] }}</div>{%- for i in (1..3) -%}{%- assign cell = cells[i] -%}<div role="cell"{% if i < 3 %} class="us"{% endif %}>{%- if cell == 'Y' -%}{{ rbs_y }}{%- elsif cell == 'N' -%}{{ rbs_n }}{%- elsif cell == 'S8' -%}<span class="pg-rbs-mini" role="button" tabindex="0" data-rbs-cta data-rbs-pick="e8">Shop 8-Bit</span>{%- elsif cell == 'S16' -%}<span class="pg-rbs-mini" role="button" tabindex="0" data-rbs-cta data-rbs-pick="e16">Shop 16-Bit</span>{%- else -%}{{ cell }}{%- endif -%}</div>{%- endfor -%}</div>
{%- endfor -%}
</div>
    <span class="pg-rbs-cta" role="button" tabindex="0" data-rbs-cta>Choose Your Edition <span>&rarr;</span></span>
  </section>
</div>

<script src="{{ 'pgx-pg-retrobox-story.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
