{%- for image in product.images -%}
  {%- if image.alt contains '16-Bit Edition' -%}
    {%- if image.alt contains 'desk' -%}{%- assign rbs_img16d = image -%}{%- else -%}{%- assign rbs_img16 = image -%}{%- endif -%}
  {%- elsif image.alt contains '8-Bit Edition' -%}
    {%- if image.alt contains 'desk' -%}{%- assign rbs_img8d = image -%}{%- else -%}{%- assign rbs_img8 = image -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- comment -%} each photo as a 900px and a 600px URL: the product image when found, else the CDN file {%- endcomment -%}
