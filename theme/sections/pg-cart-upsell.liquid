{%- comment -%}
  PG Cart Upsell: free-gift banner on the cart page. The R36S protective case
  is auto-added at $0 by pg-drawer whenever the cart holds a paid item, so this
  card only announces the gift. No add button, no other catalog products.
{%- endcomment -%}
{%- assign case = section.settings.case_product -%}
{%- if cart.item_count > 0 -%}

<style>
  .pgu{max-width:1280px;margin:0 auto;padding:10px 24px 60px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif}
  .pgu-h{display:flex;align-items:center;gap:16px;color:#7A2FA2;font-size:14px;letter-spacing:.18em;font-weight:600;margin-bottom:14px;text-transform:uppercase}
  .pgu-h:before,.pgu-h:after{content:"";height:1px;background:#7A2FA2;flex:1}
  .pgu-card{display:flex;align-items:center;gap:18px;border:1px solid #e0cdee;border-radius:14px;padding:16px 18px;background:linear-gradient(120deg,#fdfbfe,#f6effb);box-shadow:0 16px 38px -30px rgba(74,28,102,.5);max-width:640px;margin:0 auto}
  .pgu-card img{width:84px;height:84px;border-radius:10px;object-fit:cover;flex:none}
  .pgu-name{font-weight:700;font-size:16.5px;color:#121212}
  .pgu-sub{font-size:13px;color:#555;margin-top:3px}
  .pgu-price{margin-top:6px;font-size:16px;font-weight:700;color:#121212;display:flex;align-items:center;gap:9px}
  .pgu-price s{color:#8a8a8a;font-weight:400;font-size:13.5px}
  .pgu-free{display:inline-block;background:linear-gradient(120deg,#9B4BC4,#7A2FA2);color:#fff;font-size:12px;font-weight:700;letter-spacing:.08em;padding:4px 12px;border-radius:999px;text-transform:uppercase}
  .pgu-check{margin-left:auto;flex:none;width:42px;height:42px;border-radius:50%;background:#7A2FA2;display:flex;align-items:center;justify-content:center}
  .pgu-check svg{width:22px;height:22px;stroke:#fff;fill:none;stroke-width:2.4}
  @media (max-width: 640px){
    .pgu{padding:6px 16px 44px}
    .pgu-card{flex-wrap:wrap}
    .pgu-check{margin-left:0}
  }
</style>

<div class="pgu" data-pgu>
  <div class="pgu-h">Free gift included</div>
  <div class="pgu-card">
    {%- if case != blank and case.featured_image -%}
      <img src="{{ case.featured_image | image_url: width: 168 }}" alt="{{ section.settings.display_title | escape }}">
    {%- endif -%}
    <div>
      <div class="pgu-name">{{ section.settings.display_title | default: 'R36S Protective Case' }}</div>
      <div class="pgu-sub">Added to your cart automatically with any order</div>
      <div class="pgu-price"><span class="pgu-free">Free</span><s>{{ 1999 | money }}</s></div>
    </div>
    <div class="pgu-check"><svg viewBox="0 0 24 24"><path d="M5 13l4 4 10-11"/></svg></div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "PG Cart Upsell",
  "settings": [
    {"type": "product", "id": "case_product", "label": "Gift product (image source)"},
    {"type": "text", "id": "display_title", "label": "Display title", "default": "R36S Protective Case"}
  ]
}
{% endschema %}
