{%- comment -%}
  PG Cart Upsell: single cross-sell card on the cart page. Offers only the
  configured product (the R36S protective case). Replaces the theme's
  recently-viewed rail so no other catalog products are offered.
{%- endcomment -%}
{%- assign case = section.settings.case_product -%}
{%- if case != blank and case.available -%}
{%- assign in_cart = false -%}
{%- for item in cart.items -%}
  {%- if item.product_id == case.id -%}{%- assign in_cart = true -%}{%- endif -%}
{%- endfor -%}

<style>
  .pgu{max-width:1280px;margin:0 auto;padding:10px 24px 60px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif}
  .pgu-h{display:flex;align-items:center;gap:16px;color:#7A2FA2;font-size:14px;letter-spacing:.18em;font-weight:600;margin-bottom:14px;text-transform:uppercase}
  .pgu-h:before,.pgu-h:after{content:"";height:1px;background:#7A2FA2;flex:1}
  .pgu-card{display:flex;align-items:center;gap:18px;border:1px solid #e0cdee;border-radius:12px;padding:16px 18px;background:#fdfbfe;max-width:640px;margin:0 auto}
  .pgu-card img{width:84px;height:84px;border-radius:10px;object-fit:cover;flex:none}
  .pgu-name{font-weight:700;font-size:16.5px;color:#121212}
  .pgu-sub{font-size:13px;color:#7A2FA2;font-weight:600;margin-top:3px}
  .pgu-price{margin-top:5px;font-size:16px;font-weight:700;color:#121212}
  .pgu-price s{color:#8a8a8a;font-weight:400;font-size:13.5px;margin-left:7px}
  .pgu-btn{margin-left:auto;flex:none;border:0;background:#121212 !important;background-color:#121212 !important;color:#fff;font-size:14.5px;font-weight:600;padding:12px 26px;border-radius:6px;cursor:pointer;font-family:'Poppins',sans-serif}
  .pgu-btn:hover{background:#7A2FA2 !important;background-color:#7A2FA2 !important}
  .pgu-btn[disabled]{opacity:.55;cursor:default}
  @media (max-width: 640px){
    .pgu{padding:6px 16px 44px}
    .pgu-card{flex-wrap:wrap}
    .pgu-btn{margin-left:0;width:100%}
  }
</style>

<div class="pgu" data-pgu>
  <div class="pgu-h">Complete your setup</div>
  <div class="pgu-card">
    <img src="{{ case.featured_image | image_url: width: 168 }}" alt="{{ section.settings.display_title | escape }}">
    <div>
      <div class="pgu-name">{{ section.settings.display_title | default: case.title }}</div>
      <div class="pgu-sub">2+ items unlock 10% OFF automatically at checkout</div>
      <div class="pgu-price">
        {{ case.price | money }}
        {%- if case.compare_at_price > case.price -%}<s>{{ case.compare_at_price | money }}</s>{%- endif -%}
      </div>
    </div>
    {%- if in_cart -%}
      <button type="button" class="pgu-btn" disabled>Added &#10003;</button>
    {%- else -%}
      <button type="button" class="pgu-btn" id="pgu-add" data-variant="{{ case.selected_or_first_available_variant.id }}">Add</button>
    {%- endif -%}
  </div>
</div>

<script>
(function(){
  var btn = document.getElementById('pgu-add');
  if (!btn || btn.dataset.pguInit) return;
  btn.dataset.pguInit = '1';
  btn.addEventListener('click', function(){
    btn.disabled = true; btn.textContent = 'Adding...';
    fetch('/cart/add.js', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({items: [{id: parseInt(btn.dataset.variant, 10), quantity: 1}]})
    }).then(function(r){
      if (!r.ok) throw new Error('add failed');
      window.location.reload();
    }).catch(function(){
      btn.disabled = false; btn.textContent = 'Add';
    });
  });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "PG Cart Upsell",
  "settings": [
    {"type": "product", "id": "case_product", "label": "Cross-sell product"},
    {"type": "text", "id": "display_title", "label": "Display title", "default": "R36S Protective Case"}
  ]
}
{% endschema %}
