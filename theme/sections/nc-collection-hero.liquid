</style>
<script>
(function(){
  function start(){
    var slides=document.querySelectorAll('.nc-rot__slide');
    if(slides.length<2||window.__ncRot)return;
    window.__ncRot=1;
    var i=[].indexOf.call(slides,document.querySelector('.nc-rot__slide.on'));if(i<0)i=0;
    setInterval(function(){
      var s=document.querySelectorAll('.nc-rot__slide');if(s.length<2)return;
      if(s[i])s[i].classList.remove('on');
      i=(i+1)%s.length;
      if(s[i])s[i].classList.add('on');
    },2300);
  }
  if(document.readyState!=='loading')start();else document.addEventListener('DOMContentLoaded',start);
  setTimeout(start,1500);setTimeout(start,3000);
})();
</script>
