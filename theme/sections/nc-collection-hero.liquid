.product-card h3 a{transition:color .2s ease}
.product-card:hover h3 a{color:#2C6E72}
.product-card > div{padding-left:15px;padding-right:15px}
.product-card .static{padding-left:15px;padding-right:15px}
.product-card h3{font-size:15.5px;font-weight:700;line-height:1.3;margin-top:14px}
.product-card h3 a{color:#0F2A33}
.product-card .price{color:#0F2A33;font-weight:800;font-size:17px}
.product-card .old-price{color:#7c8c84;font-weight:600;text-decoration:line-through;font-size:14px}
.product-card .overlay-sale{position:absolute!important;top:12px;left:12px;z-index:4;margin:0!important;background:#15414A!important;color:#fff!important;border:0!important;border-radius:100px!important;padding:6px 12px!important;font-weight:800!important;font-size:11.5px!important;letter-spacing:.04em!important;line-height:1!important;text-transform:uppercase!important;white-space:nowrap;box-shadow:0 6px 16px -8px rgba(15,42,51,.6)!important}
.product-card .link-btn,.product-card .submit,.product-card form .submit{display:flex!important;justify-content:center!important;align-items:center;width:100%!important;margin-top:8px}
.product-card .overlay-buy_button,.product-card .link-btn a,.product-card .submit button,.product-card button.overlay-buy_button{display:inline-flex!important;align-items:center;justify-content:center;gap:6px;width:auto!important;max-width:none!important;min-width:0!important;background:#0F2A33!important;color:#fff!important;border:none!important;border-radius:100px!important;font-weight:600!important;font-size:12.5px!important;letter-spacing:.04em;line-height:1!important;padding:9px 20px!important;min-height:0!important;height:auto!important;box-shadow:0 8px 18px -10px rgba(15,42,51,.5)!important;transition:background .2s ease,transform .2s ease,box-shadow .2s ease}
.product-card:hover .overlay-buy_button,.product-card:hover .link-btn a,.product-card:hover .submit button{transform:translateY(-1px);box-shadow:0 12px 24px -10px rgba(15,42,51,.55)!important}
.product-card .overlay-buy_button:hover,.product-card .link-btn a:hover,.product-card .submit button:hover{background:#2C6E72!important}
@media(max-width:600px){.product-card .overlay-sale{top:9px;left:9px;padding:5px 10px!important;font-size:11px!important}}
.nc-ed__img:has(img){min-height:0;border:0;background:none;padding:0;display:block}
.nc-ed__img img{width:100%;height:auto;display:block;border-radius:0}
.nc-collhero .nc-ed .nc-ed__img{width:auto !important;max-width:none !important;margin:20px 0 6px !important;max-height:none !important;border-radius:20px !important;overflow:hidden !important}
.nc-collhero .nc-ed .nc-ed__img img{max-height:none !important;height:clamp(200px,26vw,350px) !important;width:100% !important;object-fit:cover !important;border-radius:20px !important}
.nc-collhero .nc-ed .nc-ed__img--full img{height:auto !important;object-fit:contain !important}
.nc-promo__media img{width:100%;height:auto;max-height:100%;object-fit:contain;border-radius:14px;display:block}
.nc-collhero .nc-promo__media img{position:absolute !important;inset:0 !important;width:100% !important;height:100% !important;object-fit:cover !important;border-radius:0 !important;display:block;margin:0 !important;padding:0 !important;max-height:none !important}
</style>
<style>
