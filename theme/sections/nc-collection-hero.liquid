.collection-wrapper > header,.collection-wrapper > div > header{display:none!important}
#content div[id*="main-collection"]{background:transparent!important}
div[id*="main-collection"] [class*="palette-"],div[id*="main-collection"] .container,div[id*="main-collection"] .boxed,div[id*="main-collection"] .grid{background:transparent!important;background-color:transparent!important}
#content .f8sr select,#root #content .f8sr select{-webkit-appearance:none;appearance:none;background-color:#fff!important;color:#0F2A33!important;border:1px solid rgba(15,42,51,.18)!important;border-radius:10px!important;padding:11px 42px 11px 16px!important;font-weight:700!important;font-size:14px!important;min-width:200px;width:auto;height:auto!important;cursor:pointer;box-shadow:0 4px 14px -10px rgba(15,42,51,.4)!important}
#content .f8sr fieldset{display:flex!important;align-items:center;gap:12px;flex-wrap:wrap;border:0!important;padding:0!important;margin:0!important}
#content .f8sr .hx{margin-right:auto!important;font-weight:800!important;color:#0F2A33!important;font-size:15px!important}
#content .f8sr hr{display:none!important}
#content .f8sr p:has(#sort_by){margin:0!important;display:flex;align-items:center;gap:8px}
#content .f8sr p:has(#sort_by) label{font-weight:700;color:#0F2A33;font-size:13px;white-space:nowrap;margin:0}
#content .f8sr .l4vw{display:inline-flex;gap:6px;align-items:center;margin:0;padding:0;list-style:none}
#content .f8sr .l4vw li{margin:0}
#content .f8sr .l4vw li a{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border:1px solid rgba(15,42,51,.18)!important;border-radius:9px!important;background:#fff!important;color:#0F2A33!important}
#content .f8sr .l4vw li.active a{background:#0F2A33!important;color:#fff!important;border-color:#0F2A33!important}
#content .n6pg ol{display:flex;gap:6px;align-items:center;justify-content:flex-end;list-style:none;margin:0;padding:0;flex-wrap:wrap}
#content .n6pg ol li{margin:0}
#content .n6pg ol li a,#content .n6pg ol li.active{display:inline-flex;align-items:center;justify-content:center;min-width:38px;height:38px;padding:0 12px;border-radius:9px;font-weight:700;font-size:14px;line-height:1}
#content .n6pg ol li a{background:#fff!important;border:1px solid rgba(15,42,51,.18)!important;color:#0F2A33!important;text-decoration:none!important}
#content .n6pg ol li.active{background:#0F2A33!important;color:#fff!important;border:1px solid #0F2A33!important}
#content .n6pg ol li a:hover{background:#2C6E72!important;color:#fff!important;border-color:#2C6E72!important}
@media(max-width:600px){#content .f8sr p:has(#sort_by){flex:1 1 100%}#content .f8sr select{width:100%!important;min-width:0!important}#content .n6pg ol{justify-content:center}}
#shopify-section-{{ section.id }}{margin:0}
#shopify-section-{{ section.id }} .nc-collhero{background:transparent}
.nc-ed{width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);padding:46px clamp(16px,3vw,52px) 6px;text-align:left}
.nc-ed__eye{display:inline-block;font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:#2C6E72;margin-bottom:12px}
.nc-ed__h1{font-size:clamp(34px,6vw,58px);line-height:1.03;font-weight:800;color:#0F2A33;margin:0 0 14px;text-transform:capitalize}
.nc-ed__sub{font-size:clamp(17px,2.4vw,22px);font-weight:700;color:#0F2A33;margin:0 0 16px}
.nc-ed__desc{font-size:16px;line-height:1.62;color:#3C5860;max-width:820px}
.nc-ed__desc p{margin:0}
.nc-ed__img{width:100vw;max-width:100vw;margin:26px calc(50% - 50vw) 0;border-radius:0;border-top:1px dashed rgba(15,42,51,.2);border-bottom:1px dashed rgba(15,42,51,.2);background:rgba(255,255,255,.18);min-height:clamp(200px,42vw,340px);display:flex;align-items:center;justify-content:center}
.nc-ed__img span{font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#8a9a92}
.nc-rot{width:100vw;max-width:100vw;margin:30px calc(50% - 50vw) 10px;padding:4px clamp(16px,3vw,52px) 0;background:transparent}
.nc-rot__track{position:relative;min-height:34px;display:flex;align-items:center;justify-content:center}
.nc-rot__slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:clamp(15px,2.2vw,21px);font-weight:800;color:#0F2A33;opacity:0;transform:translateY(6px);transition:opacity .35s ease,transform .35s ease;padding:0 8px;text-align:center}
