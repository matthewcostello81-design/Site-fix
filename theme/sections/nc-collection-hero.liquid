.nc-promo{width:auto;margin:26px clamp(12px,3vw,40px) 34px;border-radius:22px;background:#fff;border:1px solid rgba(15,42,51,.1);box-shadow:0 30px 60px -38px rgba(15,42,51,.5);overflow:hidden;display:grid;grid-template-columns:.7fr 1.3fr}
