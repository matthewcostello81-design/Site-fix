.nc-promo__eye{display:inline-block;font-size:11.5px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:#2C6E72;margin-bottom:11px}
.nc-promo__head{font-size:clamp(24px,3vw,34px);line-height:1.08;font-weight:800;color:#0F2A33;margin:0 0 12px;max-width:20ch}
.nc-promo__sub{font-size:15.5px;line-height:1.55;color:#3C5860;margin:0 0 18px;max-width:46ch}
.nc-promo__badges{display:grid;grid-template-columns:1fr 1fr;gap:12px 18px;margin-bottom:0}
.nc-promo__badge{display:flex;align-items:center;gap:12px;color:#0F2A33;font-weight:700;font-size:14px}
.nc-promo__ic{flex:0 0 auto;width:40px;height:40px;border-radius:11px;background:rgba(44,110,114,.1);display:flex;align-items:center;justify-content:center;color:#2C6E72}
