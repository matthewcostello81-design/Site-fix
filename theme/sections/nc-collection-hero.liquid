@media(max-width:600px){.nc-ed{padding:34px 14px 4px}.nc-rot{padding:4px 14px 0}.nc-promo__badges{grid-template-columns:1fr}}
.product-card{position:relative;background:rgba(255,255,255,.5)!important;border:1px solid rgba(15,42,51,.1)!important;border-radius:16px;overflow:hidden;padding-bottom:14px;box-shadow:0 6px 20px -14px rgba(15,42,51,.35)!important;transition:transform .3s cubic-bezier(.22,.61,.36,1),box-shadow .3s ease,border-color .3s ease}
