body .product-card .overlay-sale,body li.product-card .overlay-sale{font-size:13px!important;padding:5px 11px!important}
@media(max-width:760px){body .product-card .overlay-sale,body li.product-card .overlay-sale{font-size:10px!important;padding:3px 7px!important;border-radius:8px!important}}
