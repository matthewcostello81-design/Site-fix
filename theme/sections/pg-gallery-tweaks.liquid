{%- comment -%}
  PG Gallery Tweaks (orbs product page): open on a real orb, not the group shot,
  and show that the filmstrip can be swiped.

  1. THE GROUP SHOT. The product's media[0] is the five-orbs-together photo
     (alt "Crystal PokeOrb - HERO"). It is also the product's featuredMedia, so
     it is what the collection card shows -- and that is the right picture there,
     because the card is selling the range.

     It is the wrong picture to OPEN the product page on: that page is selling
     one orb, and the hero should be an orb. So the hero is advanced off it to
     the first real character image.

     It is NOT deleted, and the product's media is not touched at all: deleting
     it would strip it from the product card too, which was explicitly to be
     kept, and media deletion cannot be undone.

     WHY NOT HIDE A THUMBNAIL. An earlier version of this file hid the first
     button in the filmstrip, on the assumption that the group shot led that
     strip. It does not. The strip holds 35 buttons and they are media[1...],
     one per character, starting at "13 Arceus" -- the group shot is not in the
     strip at all, it is only the initial hero. Hiding button 0 therefore hid a
     real variant and left the group shot exactly where it was. The check below
     is on the HERO image instead, matched on the media's own filename and its
     "HERO" alt text so it cannot catch a character image by accident.

     The swap is re-checked rather than done once, because pg-landing rebuilds
     the gallery after its fetch. It is inherently idempotent: the group shot is
     not in the strip, so once the hero has moved off it the condition is false
     and nothing more happens -- it cannot fight a shopper's own selection.

  2. THE SWIPE HINT. pg-gallery-mobile deliberately hides the carousel arrows on
     phones, because they sat on top of the orbs. That fixed the covering but
     left no sign the strip scrolls, so the photos under the hero read as a dead
     row. This adds a hint UNDER the strip rather than over it -- nothing is
     covered -- with chevrons that drift to suggest the direction. It disappears
     for good the moment the strip is scrolled, and that is remembered, so it
     teaches once instead of nagging. Mobile only; desktop keeps its arrows.

  Registered in templates/product.pg-crystal.json rather than a section group:
  the overlay group is at Shopify's hard limit of 25 sections, and this belongs
  to one product page anyway.
{%- endcomment -%}
<style>
  #pgx .pg-gt-swipe{
    display:none;
    align-items:center;justify-content:center;gap:8px;
    margin:9px auto 0;
    padding:6px 14px;
    width:max-content;max-width:100%;
    border-radius:999px;
    background:rgba(139,68,190,.14);
    border:1px solid rgba(190,140,235,.42);
    color:#E4D3F7;
    font-size:11.5px;font-weight:800;
    letter-spacing:.10em;text-transform:uppercase;
    white-space:nowrap;
    pointer-events:none;
  }
  #pgx .pg-gt-swipe span{display:inline-block;animation:pgGtNudge 1.5s ease-in-out infinite}
  #pgx .pg-gt-swipe .pg-gt-l{animation-direction:reverse}
  @keyframes pgGtNudge{
    0%,100%{transform:translateX(0);opacity:.55}
    50%    {transform:translateX(4px);opacity:1}
  }
  @media (max-width:900px){
    #pgx .pg-gt-swipe.pg-gt-on{display:flex}
  }
  @media (prefers-reduced-motion:reduce){
    #pgx .pg-gt-swipe span{animation:none}
  }
</style>
<script>
(function(){
  if (window.pgGalTweaks) return; window.pgGalTweaks = 1;

  /* the group shot, identified two independent ways */
  var HERO_FILE = 'f32899a3';
  var HERO_ALT  = /HERO/i;
  var SEEN = 'pgGtSwiped';
  var hinted = false;

  function isGroupShot(img){
    if (!img) return false;
    var src = img.getAttribute('src') || '';
    var alt = img.getAttribute('alt') || '';
    return src.indexOf(HERO_FILE) > -1 || HERO_ALT.test(alt);
  }

  /* 1. never open on the group shot */
  function dropHero(){
    var hero = document.getElementById('pgx-hero-img') ||
               document.querySelector('#pgx .pgx-hero img');
    if (!isGroupShot(hero)) return;            /* already on a real orb */

    var strip = document.querySelector('#pgx .pgx-thumbwrap .pgx-thumbs');
    if (!strip) return;
    var btn = strip.querySelector('button');
    if (!btn) return;                          /* nothing to move to yet */
    try { btn.click(); } catch(e){}
  }

  /* 2. the swipe hint */
  function hint(){
    if (hinted) return;
    var wrap = document.querySelector('#pgx .pgx-thumbwrap');
    if (!wrap) return;
    var strip = wrap.querySelector('.pgx-thumbs');
    if (!strip) return;

    var seen = false;
    try { seen = localStorage.getItem(SEEN) === '1'; } catch(e){}
    if (seen) { hinted = true; return; }
    if (strip.scrollWidth <= strip.clientWidth + 4) return;   /* nothing to swipe to */

    var el = document.createElement('div');
    el.className = 'pg-gt-swipe pg-gt-on';
    el.setAttribute('aria-hidden', 'true');
    el.innerHTML = '<span class="pg-gt-l">&lsaquo;</span> Swipe for more <span>&rsaquo;</span>';
    wrap.parentNode.insertBefore(el, wrap.nextSibling);
    hinted = true;

    function done(){
      if (el.parentNode) el.parentNode.removeChild(el);
      try { localStorage.setItem(SEEN, '1'); } catch(e){}
      strip.removeEventListener('scroll', done);
      strip.removeEventListener('touchmove', done);
    }
    strip.addEventListener('scroll', done, {passive: true});
    strip.addEventListener('touchmove', done, {passive: true});
  }

  function pass(){ dropHero(); hint(); }

  function boot(){
    if (!document.getElementById('pgx')) return;
    pass();
    var root = document.getElementById('pgx');
    if (root && window.MutationObserver){
      var queued = false;
      new MutationObserver(function(){
        if (queued) return;
        queued = true;
        setTimeout(function(){ queued = false; pass(); }, 80);
      }).observe(root, {childList: true, subtree: true});
    }
    [300, 900, 2000, 4000, 7000].forEach(function(t){ setTimeout(pass, t); });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>
{% schema %}
{"name": "PG Gallery Tweaks", "settings": [], "presets": [{"name": "PG Gallery Tweaks"}]}
{% endschema %}
