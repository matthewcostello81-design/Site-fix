{%- comment -%}
  PG Gallery Tweaks (orbs product page): drop the group shot from the gallery,
  and show that the filmstrip can be swiped.

  1. THE FIRST IMAGE. The product's first image is the five-orbs-together group
     shot. It is the right picture for a collection card -- it shows the range at
     a glance -- but it is the wrong picture to OPEN the product page on, because
     the page is selling one orb and the hero should be that orb.

     So it is hidden from the PDP gallery ONLY. The product's media is not
     touched and the image stays the product's featured image, so the product
     card keeps it exactly as it is today. That was the explicit requirement, and
     it is also why this is a theme change rather than a media deletion: deleting
     it would strip it from the card too, and it cannot be un-deleted.

     The hero is moved on to the second image when the page opens -- but only if
     the hero is actually showing the hidden one, so a variant deep-link that
     already picked a different image is left alone.

  2. THE SWIPE HINT. pg-gallery-mobile deliberately hides the carousel arrows on
     phones, because they sat on top of the orbs. That fixed the covering but
     left no sign the strip scrolls at all, so the photos below the hero looked
     like a dead row. This adds a hint UNDER the strip rather than over it --
     nothing is covered -- with chevrons that drift to suggest the direction.

     It disappears for good the moment the strip is actually scrolled, and the
     fact that it has been used is remembered, so it teaches once instead of
     nagging on every visit. Mobile only: the desktop strip keeps its arrows.

  Registered in templates/product.pg-crystal.json rather than a section group:
  the overlay group is at Shopify's hard limit of 25 sections, and this belongs
  to one product page anyway.
{%- endcomment -%}
<style>
  /* 1. the group shot, hidden from the gallery only */
  #pgx .pgx-thumbwrap .pgx-thumbs button.pg-gt-hide{display:none !important}

  /* 2. the swipe hint, below the strip so it covers no artwork */
  #pgx .pg-gt-swipe{
    display:none;
    align-items:center;justify-content:center;gap:8px;
    margin:9px auto 0;
    padding:6px 14px;
    width:max-content;max-width:100%;
    border-radius:999px;
    background:rgba(139,68,190,.14);
    border:1px solid rgba(190,140,235,.42);
    color:#E4D3F7;
    font-size:11.5px;font-weight:800;
    letter-spacing:.10em;text-transform:uppercase;
    white-space:nowrap;
    pointer-events:none;
  }
  #pgx .pg-gt-swipe span{
    display:inline-block;
    animation:pgGtNudge 1.5s ease-in-out infinite;
  }
  #pgx .pg-gt-swipe .pg-gt-l{animation-direction:reverse}
  @keyframes pgGtNudge{
    0%,100%{transform:translateX(0);opacity:.55}
    50%    {transform:translateX(4px);opacity:1}
  }
  @media (max-width:900px){
    #pgx .pg-gt-swipe.pg-gt-on{display:flex}
  }
  @media (prefers-reduced-motion:reduce){
    #pgx .pg-gt-swipe span{animation:none}
  }
</style>
<script>
(function(){
  if (window.pgGalTweaks) return; window.pgGalTweaks = 1;

  var SEEN = 'pgGtSwiped';
  var hidden = false, hinted = false;

  function base(u){ return (u || '').split('?')[0]; }

  /* 1. hide the group shot and move the hero off it */
  function hideFirst(){
    if (hidden) return;
    var strip = document.querySelector('#pgx .pgx-thumbwrap .pgx-thumbs');
    if (!strip) return;
    var btns = strip.querySelectorAll('button');
    if (btns.length < 2) return;              /* never hide the only picture */

    var first = btns[0];
    var firstImg = first.querySelector('img');
    var hero = document.getElementById('pgx-hero-img') ||
               document.querySelector('#pgx .pgx-hero img');

    /* only advance the hero if it is actually showing the one being hidden */
    var showingIt = !!(hero && firstImg && base(hero.getAttribute('src')) === base(firstImg.getAttribute('src')));

    first.classList.add('pg-gt-hide');
    hidden = true;

    if (showingIt){
      try { btns[1].click(); } catch(e){}
    }
  }

  /* 2. the swipe hint */
  function hint(){
    if (hinted) return;
    var wrap = document.querySelector('#pgx .pgx-thumbwrap');
    if (!wrap) return;
    var strip = wrap.querySelector('.pgx-thumbs');
    if (!strip) return;

    var seen = false;
    try { seen = localStorage.getItem(SEEN) === '1'; } catch(e){}
    if (seen) { hinted = true; return; }

    /* nothing to swipe to */
    if (strip.scrollWidth <= strip.clientWidth + 4) return;

    var el = document.createElement('div');
    el.className = 'pg-gt-swipe pg-gt-on';
    el.setAttribute('aria-hidden', 'true');
    el.innerHTML = '<span class="pg-gt-l">&lsaquo;</span> Swipe for more <span>&rsaquo;</span>';
    wrap.parentNode.insertBefore(el, wrap.nextSibling);
    hinted = true;

    function done(){
      if (el.parentNode) el.parentNode.removeChild(el);
      try { localStorage.setItem(SEEN, '1'); } catch(e){}
      strip.removeEventListener('scroll', done);
      strip.removeEventListener('touchmove', done);
    }
    strip.addEventListener('scroll', done, {passive: true});
    strip.addEventListener('touchmove', done, {passive: true});
  }

  function pass(){ hideFirst(); hint(); }

  function boot(){
    if (!document.getElementById('pgx')) return;
    pass();
    /* pg-landing builds the strip after its own fetch, and pgLadder re-renders
       around it, so keep looking until both have landed rather than once */
    var root = document.getElementById('pgx');
    if (root && window.MutationObserver){
      var queued = false;
      new MutationObserver(function(){
        if (hidden && hinted) return;
        if (queued) return;
        queued = true;
        setTimeout(function(){ queued = false; pass(); }, 80);
      }).observe(root, {childList: true, subtree: true});
    }
    [300, 900, 2000, 4000].forEach(function(t){ setTimeout(pass, t); });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>
{% schema %}
{"name": "PG Gallery Tweaks", "settings": [], "presets": [{"name": "PG Gallery Tweaks"}]}
{% endschema %}
