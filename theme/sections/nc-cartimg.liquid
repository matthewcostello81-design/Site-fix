{% comment %} Cart thumbnail for the Foot & Leg Compression Massager. nc-cro's CIMG map pins this line item to an older photo; this points it at the uploaded product shot instead. It stamps data-nc-ci with nc-cro's own url, which is the exact value cartImg() checks before re-applying, so nc-cro skips the node rather than fighting for it. The observer is childList/subtree only, so the attribute writes below cannot retrigger it. No other product is touched. {% endcomment %}
<script>
(function(){
  if(window.__ncCartFoot)return;window.__ncCartFoot=1;
  var H='foot-therapy-air-wave-massager-for-leg-feet';
  var NEW='https://cdn.shopify.com/s/files/1/0815/5706/1860/files/nc-y-foot_a136ccd0-6e74-4a09-bec5-a9d4aa84a09d.jpg?v=1785650161&width=400';
  var OLD='https://cdn.shopify.com/s/files/1/0815/5706/1860/files/hf_20260724_231320_ea345a34-4e83-42c2-8d15-d14a653073b7.png';
  function fix(){
    var nodes=document.querySelectorAll('.l4ca > li, #cart .nc-rec');
    for(var i=0;i<nodes.length;i++){
      var li=nodes[i];
      if(!li.querySelector('a[href*="/products/'+H+'"]'))continue;
      var img=li.querySelector('figure img')||li.querySelector('img');
      if(!img||img.getAttribute('data-nc-foot')==='1')continue;
      img.setAttribute('data-nc-foot','1');
      img.setAttribute('data-nc-ci',OLD);
      var pic=img.closest('picture');
      if(pic){var ss=pic.querySelectorAll('source');for(var s=0;s<ss.length;s++)ss[s].setAttribute('srcset',NEW);}
      img.removeAttribute('srcset');
      img.setAttribute('src',NEW);
    }
  }
  function bind(){
    var c=document.getElementById('cart');
    if(!c||c.__ncFootObs)return;
    c.__ncFootObs=1;
    new MutationObserver(fix).observe(c,{childList:true,subtree:true});
  }
  function go(){fix();bind();}
  go();
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);
  [600,1500,3000].forEach(function(t){setTimeout(go,t);});
})();
</script>
{% comment %} Sale badge on the Birchwood Roller Set card. The card showed 33% OFF: fixBadge() in nc-nohover derives the percentage as saving/(price+saving), but the theme nests the struck .old-price INSIDE .price, so its Math.max reads the compare-at price (109.99) instead of the sale price, giving 55/164.99 rather than 55/109.99. Two variants also make saleBadge() in nc-cro pair the lowest sale price with the lowest compare-at price on collection pages, and it re-applies every 300ms from the master interval. Rather than fight three writers for the text node, the real percentage is computed here in Liquid (highest variant discount) and painted over the badge in CSS, which no JS text write can undo. Computed at render time, so it follows the variant prices instead of going stale. {% endcomment %}
{%- assign ncb_p = all_products['natural-wood-body-massage-roller-set'] -%}
{%- assign ncb_best = 0 -%}
{%- for ncb_v in ncb_p.variants -%}
  {%- if ncb_v.compare_at_price > ncb_v.price -%}
    {%- assign ncb_d = ncb_v.compare_at_price | minus: ncb_v.price | times: 100 | divided_by: ncb_v.compare_at_price -%}
    {%- if ncb_d > ncb_best -%}{%- assign ncb_best = ncb_d -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if ncb_best > 0 -%}
<style>
#root .product-card:has(a[href*="natural-wood-body-massage-roller-set"]) .overlay-sale,
.product-card:has(a[href*="natural-wood-body-massage-roller-set"]) .overlay-sale,
.legacy-product-card:has(a[href*="natural-wood-body-massage-roller-set"]) .overlay-sale{color:transparent!important;position:relative!important}
#root .product-card:has(a[href*="natural-wood-body-massage-roller-set"]) .overlay-sale::after,
.product-card:has(a[href*="natural-wood-body-massage-roller-set"]) .overlay-sale::after,
.legacy-product-card:has(a[href*="natural-wood-body-massage-roller-set"]) .overlay-sale::after{content:'{{ ncb_best }}% OFF'!important;position:absolute!important;left:0!important;top:0!important;right:0!important;bottom:0!important;display:flex!important;align-items:center!important;justify-content:center!important;color:#fff!important;white-space:nowrap!important}
</style>
{%- endif -%}
{% comment %} PDP highlight bullets went blank on mobile. nc-quiz rewrites every .nc-qb row into a full-text span (.nc-qb-f) plus a shorter mobile span (.nc-qb-m), then below 760px hides .nc-qb-f and shows .nc-qb-m. But .nc-qb-m is only emitted when the row's copy matches an entry in nc-quiz's hardcoded MAP of pain-point strings. Most PDPs match because nc-cro's qbFix overwrites their rows with PAINS copy drawn from those same strings; a product outside PAINS keeps its own theme-block copy, matches nothing, and so gets no .nc-qb-m — leaving the row with its only text node hidden and nothing to replace it. The 5-Level Resistance Band Set is one such product. Restoring the full text is gated on :not(:has(.nc-qb-m)), so this touches only rows that are genuinely blank and leaves every working short-text row exactly as it was. Those rows also need white-space:normal: both nc-quiz and nc-cro pin the row to nowrap + overflow:hidden, which suits the terse pain-point copy but would clip a full-length highlight at the card edge. {% endcomment %}
<style>
@media(max-width:760px){
  #ncpdp#ncpdp .nc-qb > div:not(:has(.nc-qb-m)){white-space:normal!important;overflow:visible!important;align-items:center!important}
  #ncpdp#ncpdp .nc-qb > div:not(:has(.nc-qb-m)) .nc-qb-f{display:inline!important}
}
</style>
