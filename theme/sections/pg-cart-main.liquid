{%- comment -%}
  PG Cart Main: full replacement for the theme cart page, copying the live
  North Cove drawer-style cart in the PocketEra purple palette. Stars row,
  free shipping pill, savings progress, compact line items with steppers,
  free gift row, shipping protection toggle, Better together (crystal orbs
  only), totals with savings rows and a gradient SECURE CHECKOUT button.
{%- endcomment -%}
{%- assign gift_handle = 'free-gift' -%}
{%- assign sp_handle = 'shipping-protection' -%}
{%- assign eligible = 0 -%}
{%- assign compare_savings = 0 -%}
{%- assign visible_count = 0 -%}
{%- for item in cart.items -%}
  {%- assign h = item.product.handle -%}
  {%- unless h contains sp_handle -%}{%- assign visible_count = visible_count | plus: item.quantity -%}{%- endunless -%}
  {%- unless h contains gift_handle or h contains sp_handle -%}
    {%- assign eligible = eligible | plus: item.quantity -%}
    {%- if item.variant.compare_at_price > item.final_price -%}
      {%- assign d = item.variant.compare_at_price | minus: item.final_price | times: item.quantity -%}
      {%- assign compare_savings = compare_savings | plus: d -%}
    {%- endif -%}
  {%- endunless -%}
{%- endfor -%}
{%- assign total_savings = compare_savings | plus: cart.total_discount -%}

<style>
  .pgm{max-width:760px;margin:0 auto;padding:26px 18px 70px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;color:#121212}
  .pgm *{box-sizing:border-box}
  .pgm-h1{display:flex;align-items:baseline;gap:12px;margin:0 0 2px}
  .pgm-h1 b{font-size:30px;font-weight:700}
  .pgm-h1 span{font-size:14px;color:#666}
  .pgm-stars{font-size:13.5px;color:#3a3a3a;margin:4px 0 14px;font-weight:600}
  .pgm-stars i{color:#F5A623;font-style:normal;letter-spacing:1px}
  .pgm-ship{background:linear-gradient(120deg,#F6EFFB,#EEE0F7);border:1px solid rgba(122,47,162,.25);color:#4A1C66;border-radius:12px;text-align:center;font-size:14px;font-weight:600;padding:12px 14px;margin-bottom:12px}
  .pgm-tiers{background:linear-gradient(120deg,#F6EFFB,#EEE0F7);border:1px solid rgba(122,47,162,.25);border-radius:14px;padding:14px 16px 16px;margin-bottom:16px}
  .pgm-tiers-msg{text-align:center;font-size:13.5px;font-weight:600;color:#2b2b2b;margin-bottom:10px}
  .pgm-tiers-msg b{color:#7A2FA2}
  .pgm-track{position:relative;height:6px;border-radius:999px;background:#e3d4ef}
  .pgm-track i{position:absolute;left:0;top:0;bottom:0;border-radius:999px;background:linear-gradient(90deg,#9B4BC4,#7A2FA2)}
  .pgm-card{background:#fff;border:1px solid #e0cdee;border-radius:14px;box-shadow:0 12px 30px -24px rgba(74,28,102,.4);display:flex;align-items:center;gap:14px;padding:12px 14px;margin-bottom:12px;position:relative}
  .pgm-card img{width:82px;height:82px;object-fit:cover;border-radius:10px;flex:none;background:#f4f4f4}
  .pgm-mid{flex:1;min-width:0}
  .pgm-t{font-size:15px;font-weight:600;color:#121212;text-decoration:none;display:block;line-height:1.3}
  .pgm-v{font-size:12.5px;color:#777;margin-top:2px}
  .pgm-badge{display:inline-block;background:linear-gradient(120deg,#9B4BC4,#7A2FA2);color:#fff;font-size:11px;font-weight:700;letter-spacing:.07em;padding:3px 10px;border-radius:999px;text-transform:uppercase;margin-top:5px}
  .pgm-qty{display:inline-flex;align-items:center;border:1px solid #ddd;border-radius:9px;margin-top:8px;overflow:hidden;background:#fff}
  .pgm-qty button{border:0;background:#fff;color:#7A2FA2;font-size:16px;font-weight:700;width:30px;height:28px;cursor:pointer;padding:0;line-height:1}
  .pgm-qty button:hover{background:#f6effb}
  .pgm-qty span{min-width:28px;text-align:center;font-size:13.5px;font-weight:600}
  .pgm-right{text-align:right;flex:none}
  .pgm-was{font-size:12.5px;color:#999;text-decoration:line-through}
  .pgm-right{display:flex;flex-direction:column;align-items:flex-end;justify-content:flex-end;align-self:stretch}
  .pgm-badge{background:linear-gradient(120deg,#9B4BC4,#7A2FA2 55%,#4A1C66) !important;color:#fff !important;border:none !important}
  .pgm-card.is-gift .pgm-price{display:none}
  @keyframes pgShiftM{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
  .pgm-save{display:inline-block;background-image:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 30%,#4A1C66 50%,#7A2FA2 70%,#9B4BC4 100%);background-size:240% 240%;animation:pgShiftM 5s ease-in-out infinite;color:#fff;font-size:11px;font-weight:700;letter-spacing:.05em;padding:3px 10px;border-radius:999px;text-transform:uppercase;margin:2px 0;width:max-content}
  .pgm-price{font-size:16px;font-weight:700;color:#7A2FA2}
  .pgm-del{position:absolute;top:10px;right:12px;border:0;background:none;cursor:pointer;color:#b6a3c6;font-size:15px;padding:4px;line-height:1}
  .pgm-del:hover{color:#7A2FA2}
  .pgm-card.is-gift .pgm-price{color:#121212}
  .pgm-sp{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid #e0cdee;border-radius:14px;padding:13px 14px;margin:14px 0;box-shadow:0 12px 30px -24px rgba(74,28,102,.4)}
  .pgm-sp-ic{flex:none;width:42px;height:42px;border-radius:50%;background:#f5eefa;display:flex;align-items:center;justify-content:center}
  .pgm-sp-ic svg{width:22px;height:22px;stroke:#7A2FA2;fill:none;stroke-width:1.8}
  .pgm-sp-t{flex:1;min-width:0}
  .pgm-sp-t b{display:block;font-size:14.5px}
  .pgm-sp-t small{display:block;font-size:12px;color:#6a6a6a;margin-top:1px}
  .pgm-sp-price{font-weight:700;font-size:14.5px;color:#7A2FA2;margin-right:2px}
  .pgm-sw{position:relative;display:inline-block;width:46px;height:26px;flex:none;cursor:pointer}
  .pgm-sw input{opacity:0;width:0;height:0;position:absolute}
  .pgm-sw i{position:absolute;inset:0;background:#d6d6d6;border-radius:999px;transition:background .2s ease;display:block}
  .pgm-sw i:before{content:"";position:absolute;top:50%;left:3px;width:20px;height:20px;margin-top:-10px;border-radius:50%;background:#fff;transition:transform .2s ease;box-shadow:0 2px 6px rgba(0,0,0,.25)}
  .pgm-sw input:checked + i{background:#7A2FA2}
  .pgm-sw input:checked + i:before{transform:translateX(20px)}
  .pgm-sp[data-busy]{opacity:.55;pointer-events:none}
  .pgm-bt-h{display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;margin:22px 0 10px}
  .pgm-bt-h svg{width:16px;height:16px;stroke:#7A2FA2;fill:none;stroke-width:2}
  .pgm-rec{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid #e0cdee;border-radius:14px;padding:12px 14px;box-shadow:0 12px 30px -24px rgba(74,28,102,.4)}
  .pgm-rec img{width:74px;height:74px;object-fit:cover;border-radius:10px;flex:none}
  .pgm-rec-mid{flex:1;min-width:0}
  .pgm-rec-t{font-size:14.5px;font-weight:600}
  .pgm-rec-p{margin-top:4px;font-size:14px;font-weight:700;color:#7A2FA2}
  .pgm-rec-p s{color:#999;font-weight:400;font-size:12.5px;margin-right:6px}
  .pgm-rec-off{display:inline-block;background:linear-gradient(120deg,#9B4BC4,#7A2FA2);color:#fff;font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;margin-left:6px;vertical-align:1px}
  .pgm-rec-add{flex:none;background:#fff;color:#7A2FA2;border:1.5px solid #7A2FA2;border-radius:999px;font-size:13px;font-weight:700;letter-spacing:.05em;padding:10px 24px;cursor:pointer;font-family:inherit;transition:all .15s ease}
  .pgm-rec-add:hover{background:linear-gradient(120deg,#9B4BC4,#7A2FA2);color:#fff}
  .pgm-rec-add[disabled]{opacity:.55;cursor:default}
  .pgm-sum{margin-top:20px;border-top:1px solid #e6dcf0;padding-top:14px}
  .pgm-row{display:flex;justify-content:space-between;font-size:14px;padding:7px 10px;border-radius:9px}
  .pgm-row.hl{background:linear-gradient(120deg,#F6EFFB,#EEE0F7);color:#4A1C66;font-weight:700;margin-top:6px}
  .pgm-row.tot{font-size:18px;font-weight:700;padding-top:14px}
  .pgm-co{display:block;width:100%;border:0;margin-top:14px;padding:17px 20px;font-size:15.5px;cursor:pointer;font-family:inherit;color:#fff}
  .pgm-pay{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:14px}
  .pgm-pay svg{height:26px;width:auto}
  .pgm-empty{text-align:center;padding:60px 0}
  .pgm-empty a{display:inline-block;margin-top:14px;background:linear-gradient(120deg,#9B4BC4,#7A2FA2);color:#fff;text-decoration:none;font-weight:700;padding:13px 34px;border-radius:999px}
  @media(max-width:560px){
    .pgm-card img{width:66px;height:66px}
    .pgm-rec-add{padding:9px 16px}
  }

  .pgm-badge,.pgm-save{font-size:11px !important;line-height:1.5 !important;padding:3px 10px !important;letter-spacing:.05em !important;width:max-content !important;max-width:100% !important;min-width:0 !important;border-radius:999px !important}
</style>

<div class="pgm" id="pgm">
{%- if cart.item_count == 0 -%}
  <div class="pgm-empty">
    <b style="font-size:22px">Your cart is empty</b>
    <div style="color:#666;margin-top:6px">Add something to get the free case.</div>
    <a href="{{ routes.root_url }}">Continue shopping</a>
  </div>
{%- else -%}
  <div class="pgm-h1"><b>Your Cart</b><span>{{ visible_count }} item{% if visible_count != 1 %}s{% endif %} in cart</span></div>
  <div class="pgm-stars"><i>&#9733;&#9733;&#9733;&#9733;&#9733;</i> 10,000+ happy customers</div>
  <div class="pgm-ship">FREE Shipping included</div>

  <div class="pgm-tiers">
    {%- if eligible >= 3 -%}
      <div class="pgm-tiers-msg">Max Savings Unlocked <b>Extra 15% Off is applied at checkout!</b></div>
      <div class="pgm-track"><i style="width:100%"></i></div>
    {%- elsif eligible == 2 -%}
      <div class="pgm-tiers-msg"><b>10% Off applied at checkout.</b> Add 1 more item for 15% Off!</div>
      <div class="pgm-track"><i style="width:66%"></i></div>
    {%- else -%}
      <div class="pgm-tiers-msg">Add 1 more item to unlock <b>10% Off your order</b></div>
      <div class="pgm-track"><i style="width:33%"></i></div>
    {%- endif -%}
  </div>

  {%- for item in cart.items -%}
    {%- assign h = item.product.handle -%}
    {%- if h contains sp_handle -%}{%- continue -%}{%- endif -%}
    {%- comment -%}
      A case line is the gift only when it carries the _free_gift property that
      pg-drawer stamps on the line it auto-adds (console in cart), or when the
      line is genuinely free. Matching the handle alone labelled a case the
      shopper paid for as a FREE GIFT and hid its stepper and remove button.
    {%- endcomment -%}
    {%- assign is_gift = false -%}
    {%- if item.properties._free_gift or item.final_line_price == 0 -%}{%- assign is_gift = true -%}{%- endif -%}
    <div class="pgm-card{% if is_gift %} is-gift{% endif %}">
      <img src="{{ item.image | image_url: width: 164 }}" alt="{{ item.product.title | escape }}">
      <div class="pgm-mid">
        <a class="pgm-t" href="{% if is_gift %}#{% else %}{{ item.url }}{% endif %}">{{ item.product.title }}</a>
        {%- unless is_gift or item.product.has_only_default_variant -%}
          <div class="pgm-v">{%- for opt in item.options_with_values -%}{{ opt.value }}{%- unless forloop.last %} / {% endunless -%}{%- endfor -%}</div>
        {%- endunless -%}
        {%- if is_gift -%}
          <span class="pgm-badge">Free Gift</span>
        {%- else -%}
          {%- if item.variant.compare_at_price > item.final_price -%}
            {%- assign pgm_pct = item.variant.compare_at_price | minus: item.final_price | times: 100.0 | divided_by: item.variant.compare_at_price | round -%}
            <span class="pgm-save">Save {{ pgm_pct }}%</span>
          {%- endif -%}
          <div class="pgm-qty" data-key="{{ item.key }}">
            <button type="button" data-d="-1" aria-label="Decrease quantity">&minus;</button>
            <span>{{ item.quantity }}</span>
            <button type="button" data-d="1" aria-label="Increase quantity">+</button>
          </div>
        {%- endif -%}
      </div>
      <div class="pgm-right">
        {%- if is_gift -%}
          <div class="pgm-was">{{ 1999 | money }}</div>
          <div class="pgm-price">FREE</div>
        {%- else -%}
          {%- if item.variant.compare_at_price > item.final_price -%}
            <div class="pgm-was">{{ item.variant.compare_at_price | times: item.quantity | money }}</div>
          {%- endif -%}
          <div class="pgm-price">{{ item.final_line_price | money }}</div>
        {%- endif -%}
      </div>
      {%- unless is_gift -%}
        <button type="button" class="pgm-del" data-key="{{ item.key }}" aria-label="Remove">&#128465;</button>
      {%- endunless -%}
    </div>
  {%- endfor -%}

  <div class="pgm-sp" data-pgm-sp>
    <div class="pgm-sp-ic"><svg viewBox="0 0 24 24"><path d="M12 2l8 3v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5z"/><path d="M9 12l2 2 4-4"/></svg></div>
    <div class="pgm-sp-t"><b>Shipping Protection</b><small>Protect your order against loss or damage in transit</small></div>
    <span class="pgm-sp-price">$2.99</span>
    <label class="pgm-sw"><input type="checkbox" aria-label="Add shipping protection"><i></i></label>
  </div>

  {%- assign orb = all_products['pokemon-crystal-ball-3d-pikachu-gengar-mewtwo-night-light-lamp-pokeball-3d-glass-pokemon-crystal-ball-statue-kids-birthday-gift'] -%}
  {%- assign orb_in_cart = false -%}
  {%- for item in cart.items -%}{%- if item.product.handle contains 'crystal-ball' -%}{%- assign orb_in_cart = true -%}{%- endif -%}{%- endfor -%}
  {%- if orb != blank and orb.available and orb_in_cart == false -%}
  <div class="pgm-bt-h"><svg viewBox="0 0 24 24"><path d="M12 3l2 5 5 .7-3.7 3.5.9 5-4.2-2.4L7.8 17l.9-5L5 8.7 10 8z"/></svg> Better together</div>
  <div class="pgm-rec">
    <img src="{{ orb.featured_image | image_url: width: 148 }}" alt="Pokemon Crystal Ball">
    <div class="pgm-rec-mid">
      <div class="pgm-rec-t">Pokemon Crystal Ball</div>
      <div class="pgm-rec-p"><s>{{ orb.compare_at_price | money }}</s>{{ orb.price | money }}<span class="pgm-rec-off">10% off your order</span></div>
    </div>
    <button type="button" class="pgm-rec-add" data-variant="{{ orb.selected_or_first_available_variant.id }}">ADD</button>
  </div>
  {%- endif -%}

  <div class="pgm-sum">
    <div class="pgm-row"><span>Subtotal ({{ visible_count }} item{% if visible_count != 1 %}s{% endif %}):</span><span>{{ cart.original_total_price | money }}</span></div>
    {%- if total_savings > 0 -%}
      <div class="pgm-row hl"><span>Total Savings:</span><span>-{{ total_savings | money }}</span></div>
    {%- endif -%}
    <div class="pgm-row hl"><span>Shipping:</span><span>FREE</span></div>
    <div class="pgm-row hl"><span>R36S Protective Case:</span><span>FREE</span></div>
    {%- if eligible >= 2 -%}
      <div class="pgm-row hl"><span>Bundle discount:</span><span>{% if eligible >= 3 %}15%{% else %}10%{% endif %} off at checkout</span></div>
    {%- endif -%}
    <div class="pgm-row tot"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
    <form action="{{ routes.cart_url }}" method="post">
      <button class="pgm-co" type="submit" name="checkout">&#128274; Secure Checkout</button>
    </form>
    <div class="pgm-pay">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag }}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
</div>

<script>
(function(){
  if (window.pgmCart) return; window.pgmCart = 1;
  var SP_ID = 49529437028580;
  /* The theme's global button CSS wins the cascade, so button looks are
     stamped inline with !important. */
  function stamp(el, s){ for (var k in s) el.style.setProperty(k, s[k], 'important'); }
  function restyle(){
    document.querySelectorAll('.pgm-qty button').forEach(function(b){
      stamp(b, {'background-color': '#fff', 'background-image': 'none', 'color': '#7A2FA2', 'border': '0', 'border-radius': '8px', 'font-size': '16px', 'font-weight': '700', 'width': '30px', 'height': '28px', 'padding': '0', 'line-height': '1', 'min-width': '0', 'min-height': '0', 'box-shadow': 'none', 'text-transform': 'none', 'letter-spacing': '0', 'animation': 'none', 'margin': '0'});
    });
    document.querySelectorAll('.pgm-del').forEach(function(b){
      stamp(b, {'background-color': 'transparent', 'background-image': 'none', 'color': '#b6a3c6', 'border': '0', 'border-radius': '6px', 'padding': '4px', 'font-size': '15px', 'width': 'auto', 'height': 'auto', 'min-width': '0', 'min-height': '0', 'box-shadow': 'none', 'line-height': '1', 'animation': 'none', 'margin': '0'});
    });
    document.querySelectorAll('.pgm-rec-add').forEach(function(b){
      stamp(b, {'background-color': '#fff', 'background-image': 'none', 'color': '#7A2FA2', 'border': '1.5px solid #7A2FA2', 'border-radius': '999px', 'font-size': '13px', 'font-weight': '700', 'letter-spacing': '.05em', 'padding': '10px 24px', 'width': 'auto', 'height': 'auto', 'min-width': '0', 'min-height': '0', 'box-shadow': 'none', 'text-transform': 'uppercase', 'animation': 'none', 'margin': '0'});
    });
    document.querySelectorAll('.pgm-co').forEach(function(b){
      stamp(b, {'background-image': 'linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 50%,#4A1C66 100%)', 'background-color': '#7A2FA2', 'color': '#fff', 'border': '0', 'border-radius': '999px', 'padding': '17px 20px', 'font-size': '15.5px', 'font-weight': '700', 'letter-spacing': '.05em', 'text-transform': 'uppercase', 'width': '100%', 'height': 'auto', 'min-height': '0', 'line-height': '1.2', 'box-shadow': '0 14px 30px -12px rgba(122,47,162,.6)', 'animation': 'none', 'margin': '14px 0 0'});
    });
  }
  if (document.readyState !== 'loading') restyle(); else document.addEventListener('DOMContentLoaded', restyle);
  setTimeout(restyle, 500);
  function change(body){
    return fetch('/cart/change.js', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)}).then(function(r){
      if (!r.ok) throw 0;
      location.reload();
    });
  }
  document.addEventListener('click', function(e){
    var d = e.target.closest('.pgm-del');
    if (d){ change({id: d.dataset.key, quantity: 0}).catch(function(){}); return; }
    var q = e.target.closest('.pgm-qty button');
    if (q){
      var box = q.closest('.pgm-qty');
      var cur = parseInt(box.querySelector('span').textContent, 10) || 1;
      var next = cur + parseInt(q.dataset.d, 10);
      if (next < 0) next = 0;
      change({id: box.dataset.key, quantity: next}).catch(function(){});
      return;
    }
    var a = e.target.closest('.pgm-rec-add');
    if (a && !a.disabled){
      a.disabled = true; a.textContent = 'ADDING...';
      fetch('/cart/add.js', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({items: [{id: parseInt(a.dataset.variant, 10), quantity: 1}]})}).then(function(r){
        if (!r.ok) throw 0;
        location.reload();
      }).catch(function(){ a.disabled = false; a.textContent = 'ADD'; });
    }
  });
  var sp = document.querySelector('[data-pgm-sp]');
  if (sp){
    var input = sp.querySelector('input');
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(c){
      input.checked = c.items.some(function(it){ return it.id === SP_ID; });
    }).catch(function(){});
    input.addEventListener('change', function(){
      sp.setAttribute('data-busy', '1');
      var req = input.checked
        ? fetch('/cart/add.js', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({items: [{id: SP_ID, quantity: 1}]})})
        : fetch('/cart/update.js', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({updates: {"49529437028580": 0}})});
      req.then(function(r){ if (!r.ok) throw 0; location.reload(); }).catch(function(){
        input.checked = !input.checked;
        sp.removeAttribute('data-busy');
      });
    });
  }
})();
</script>

<script>
(function(){
  if (window.pgmTight) return; window.pgmTight = 1;
  function tight(){
    document.querySelectorAll('.pgm-save,.pgm-badge').forEach(function(b){
      if (b.dataset.pgTight) return; b.dataset.pgTight = '1';
      ['width:max-content','max-width:100%','min-width:0','align-self:flex-start','justify-self:start','flex:none','font-size:11px','line-height:1.5','padding:3px 10px','letter-spacing:.05em','border-radius:999px','display:inline-block','text-align:center'].forEach(function(kv){
        var i = kv.indexOf(':');
        b.style.setProperty(kv.slice(0, i), kv.slice(i + 1), 'important');
      });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tight); else tight();
  setInterval(tight, 1200);
})();
</script>
{% schema %}
{"name": "PG Cart Main", "settings": []}
{% endschema %}
