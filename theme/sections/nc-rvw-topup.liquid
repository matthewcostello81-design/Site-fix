{% comment %} NC review count fix: the PDP review widget (nc-enhance) renders its cards from the custom.nc_loox_rvw metafield but takes its "Based on N reviews" total from loox.num_reviews, which the Loox app overwrites with its own count whenever it syncs (it set it to 1 mid-import on the 5-Level Resistance Band Set while the metafield held 10 real reviews). This section makes the card list the source of truth for the visible numbers: it reads the review count from nc_loox_rvw server-side and corrects the summary line, the "Showing all N reviews" note, and the hidden .jdgm-rev-widg count attribute that nc-cro's star row and popover read. No fetching, no fabricated data; numbers always equal the real reviews rendered on the page. {% endcomment %}
{%- if product -%}
{%- assign _ncr = product.metafields.custom.nc_loox_rvw.value -%}
{%- if _ncr and _ncr.reviews and _ncr.reviews.size > 0 -%}
<script>
(function(){
if(window.__ncRvwCnt)return;window.__ncRvwCnt=1;
var N={{ _ncr.reviews.size }};
function fix(){
  var c=document.querySelector('#nc-reviews .nc-rvw-count');
  var want='Based on '+N+' review'+(N>1?'s':'');
  if(c&&c.textContent!==want)c.textContent=want;
  var note=document.querySelector('#nc-reviews .ncr2-note');
  if(note){
    var cards=document.querySelectorAll('#nc-reviews .ncr2-card').length;
    var wantNote=(cards>=N)?('Showing all '+N+' reviews.'):('Showing '+cards+' of '+N+' reviews.');
    if(note.textContent!==wantNote)note.textContent=wantNote;
  }
  var w=document.querySelector('.jdgm-rev-widg');
  if(w&&w.getAttribute('data-number-of-reviews')!==String(N))w.setAttribute('data-number-of-reviews',String(N));
}
if(document.readyState!=='loading')fix();else document.addEventListener('DOMContentLoaded',fix);
[300,800,1600,3000,6000].forEach(function(t){setTimeout(fix,t)});
})();
</script>
{%- endif -%}
{%- endif -%}
{% schema %}
{"name":"NC Review Topup","settings":[]}
{% endschema %}
