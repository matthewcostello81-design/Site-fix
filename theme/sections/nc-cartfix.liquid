#root .product-card .overlay-buy_button.loading::after,#root .product-card .overlay-buy_button.adding::after{content:'' !important;position:absolute;top:50%;left:50%;width:16px;height:16px;margin:-8px 0 0 -8px;border:2px solid rgba(255,255,255,.5);border-top-color:#fff;border-radius:50%;animation:ncSpin .6s linear infinite;z-index:6}
#root .product-card .overlay-buy_button.processed::after{content:'\2713' !important;position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px;font-weight:800;line-height:1;transform:translateY(2px);z-index:6}
