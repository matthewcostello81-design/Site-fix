{%- comment -%}
  PG Page Logo: fix the header on Track Your Order, Contact and the policy
  pages -- the wordmark colour and the black bar under it.

  Two earlier attempts missed because I was guessing at the markup. The header
  is `sections/pg-cart-header.liquid`, registered as `pg_header` in
  templates/page.json and page.contact.json. It renders:

      <div class="pgc-announce">…</div>
      <header class="pgc-head">
        <div class="pgc-head-in">
          <a class="pgc-logo pgc-x"><img src="…logo.png"></a>
          …
        </div>
        <nav class="pgc-nav">…</nav>
      </header>

  pg-mobile then hides `.pgc-logo img` and injects `a.pg-wordmark` into
  `.pgc-logo`, so the wordmark is the mark on these pages too.

  Why CSS kept losing: pg-mobile paints `.pg-wordmark` with `!important`, and
  several layers restyle this header, so the winner varies. Rather than fight
  the cascade again, the colour is stamped INLINE with !important -- an inline
  declaration outranks every stylesheet, which is the same technique the cart
  pills needed.

  The black bar has no selector I can name from any file I have read, so it is
  found by shape and content: an element in the top region of the page that is
  painted near-black, is short and wide, and contains NO text is a bar, never
  content. Text, links and the wordmark are all excluded by that test, so the
  nav and logo cannot be caught. It is made transparent rather than removed, so
  if it is structural the layout does not shift.
{%- endcomment -%}
<style>
/* backstop; the inline stamp below is what actually guarantees it */
html body header.pgc-head a.pg-wordmark.pg-wordmark{
  color:#F8F4FF !important;
  -webkit-text-fill-color:#F8F4FF !important;
  text-shadow:0 0 6px rgba(246,219,255,.45),0 0 16px rgba(199,155,234,.32),0 0 38px rgba(139,68,190,.22) !important;
}
html body .pgc-head img,
html body .pgc-logo img{display:none !important}
</style>
<script>
(function(){
  if (window.pgPageLogo) return; window.pgPageLogo = 1;

  var MARK = {
    'color': '#F8F4FF',
    '-webkit-text-fill-color': '#F8F4FF',
    'background': 'none',
    'background-image': 'none',
    'filter': 'none',
    'text-shadow': '0 0 6px rgba(246,219,255,.45),0 0 16px rgba(199,155,234,.32),0 0 38px rgba(139,68,190,.22)'
  };

  function paintMark(){
    document.querySelectorAll('.pgc-head .pg-wordmark').forEach(function(el){
      if (el.dataset.pgMark) return;
      el.dataset.pgMark = '1';
      for (var k in MARK) el.style.setProperty(k, MARK[k], 'important');
    });
    /* neither the logo anchor nor the grid row should ever carry a fill */
    document.querySelectorAll('.pgc-logo, .pgc-head-in').forEach(function(el){
      if (el.dataset.pgClear) return;
      el.dataset.pgClear = '1';
      el.style.setProperty('background', 'none', 'important');
      el.style.setProperty('background-color', 'transparent', 'important');
      el.style.setProperty('background-image', 'none', 'important');
    });
  }

  function nearBlack(el){
    var cs = window.getComputedStyle(el);
    var m = (cs.backgroundColor || '').match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?/);
    if (!m) return false;
    var a = m[4] === undefined ? 1 : parseFloat(m[4]);
    if (a < 0.35) return false;
    var lum = (parseInt(m[1], 10) * 299 + parseInt(m[2], 10) * 587 + parseInt(m[3], 10) * 114) / 1000;
    return lum < 50;
  }

  /* Only on the templates that use this header. */
  function killBars(){
    var head = document.querySelector('.pgc-head');
    if (!head) return;
    var limit = head.getBoundingClientRect().bottom + window.scrollY + 120;

    document.querySelectorAll('body *').forEach(function(el){
      if (el.dataset.pgBar) return;
      if (el.tagName === 'IMG'){
        if (el.closest('.pgc-head')){
          el.dataset.pgBar = '1';
          el.style.setProperty('display', 'none', 'important');
        }
        return;
      }
      /* Skip only the things a bar can never be: the header bar itself, the
         nav, and any box holding the wordmark. An earlier pass also skipped
         anything containing text or a link, which was wrong -- the logo anchor
         holds both, so a black background on IT was never even tested. */
      if (el === head) return;
      if (el.tagName === 'NAV' || (el.closest && el.closest('nav'))) return;

      var r = el.getBoundingClientRect();
      var top = r.top + window.scrollY;
      if (top > limit) return;
      if (!(r.height > 3 && r.height < 60 && r.width > 150)) return;
      if (!nearBlack(el)) return;

      el.dataset.pgBar = '1';
      el.style.setProperty('background', 'transparent', 'important');
      el.style.setProperty('background-color', 'transparent', 'important');
      el.style.setProperty('box-shadow', 'none', 'important');
      el.style.setProperty('border', '0', 'important');
    });
  }

  function pass(){ paintMark(); killBars(); }

  function boot(){
    pass();
    [200, 600, 1400, 2600].forEach(function(t){ setTimeout(pass, t); });
    window.addEventListener('resize', pass);
    setInterval(pass, 1500);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
{% schema %}
{"name": "PG Page Logo", "settings": []}
{% endschema %}
