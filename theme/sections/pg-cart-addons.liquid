    a.innerHTML = '<i aria-hidden="true" class="icon-chevron-left"></i> Continue shopping';
    msg.parentNode.insertBefore(a, msg);
  }
  function check(){
    prune();
    try { emptyBack(); } catch (e){}
    var s = domSig();
    if (s !== seenSig){ seenSig = s; schedule(200); late(); return; }
    show();
    try { syncImages(); } catch (e){}
  }

  /* ---------------- acting ---------------- */
  var busy = false;
  function post(url, body){
    return fetch(url, {method: 'POST', headers: {'Content-Type': 'application/json'}, credentials: 'same-origin', body: JSON.stringify(body)})
      .then(function(r){ if (!r || !r.ok) throw new Error('write'); return r; });
  }
  function perform(o, el){
    if (o.kind === 'add') return post('/cart/add.js', {items: o.items});
    var sel = el.querySelector('.pg-addon-pick select');
    var v = o.target(sel ? sel.value : null);
    if (!v || !v.avail) return Promise.reject(new Error('sold out'));
        /* a swap that names its own items (the Flip SP's Max upgrade: one Max per
           single colour) adds them all in one go; the others add the target */
        return post('/cart/add.js', {items: o.itemsFor ? o.itemsFor(v) : (o.items || [{id: v.id, quantity: o.addQty}])})
