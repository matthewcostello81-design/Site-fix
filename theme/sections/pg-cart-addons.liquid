  /* (2026-09-19: a slim() that moved the shipping-protection toggle out of the
     pinned pane lived here for twenty minutes and made the drawer glitch --
     pg-drawer rebuilds the pane and the two moves showed as a teleport. The
     toggle stays in the pane. Never move pane children from this file.) */
  function slotFor(c){
    var list = c.querySelector('.l4ca:not(.in-panel)');
    if (!list) return null;
    var slot = c.querySelector('#pg-unlock-slot');
    if (!slot){
      slot = document.createElement('div');
      slot.id = 'pg-unlock-slot';
      /* BELOW the items since 2026-09-19 (see pg-cart-mobile placeUnlock) */
      list.parentNode.insertBefore(slot, list.nextSibling);
    }
    return slot;
  }

  function paint(offers){
    var c = document.getElementById('cart');
    if (!c) return;
    var want = {};
    /* the node cached on an offer may be from before a drawer rebuild: only a
       card that is in the drawer NOW is re-used */
    offers.forEach(function(o){ o.el = null; want[o.key] = o; });
    c.querySelectorAll('.pg-addon').forEach(function(el){
      var k = el.getAttribute('data-addon');
      /* not wanted, spent, or a second copy of a card already kept */
      if (!want[k] || want[k].el || el.classList.contains('is-done')){ if (el.parentNode) el.parentNode.removeChild(el); return; }
      want[k].el = el;
    });
    if (!offers.length) return;
    var slot = slotFor(c);
    if (!slot) return;
    var added = false;
    offers.forEach(function(o, i){
      var el = o.el || card(o);
      if (el === o.el) refresh(el, o);
      /* after pg-cart-offer's cards (-10 and up), ahead of the hidden rows */
      if (el.style.order !== String(-4 + i)) el.style.order = String(-4 + i);
      if (el.parentNode !== slot){ slot.appendChild(el); added = true; }
      o.el = el;
    });
