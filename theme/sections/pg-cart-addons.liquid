  /* THE EMPTY DRAWER GETS ITS OWN WAY OUT (2026-09-21, owner: "when the cart
     is empty there should be a back arrow that takes them to the homepage;
     when there's stuff in it, to the page they were on"). The theme draws its
     "Continue shopping" link only beside items, and that one just closes the
     drawer, which IS the page they were on. The empty render has no link at
     all, so one is put above the message, pointing home. */
  function emptyBack(){
    var c = document.getElementById('cart');
