  /* the first picture an offer is shown with is the one it keeps */
  var KEPT = {};
  function keep(family, img){
    if (!KEPT[family] && img) KEPT[family] = img;
    return KEPT[family] || img;
  }
  /* ---------------- the add-on rows (2026-09-18/19) ----------------
