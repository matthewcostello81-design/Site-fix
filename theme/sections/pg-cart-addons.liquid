      .then(function(r){ return r.json(); })
      .then(function(cart){
        var updates = {}, any = false;
        Object.keys(o.take).forEach(function(vid){
          var have = 0;
          (cart.items || []).forEach(function(it){ if (String(it.variant_id) === vid) have += it.quantity; });
          if (!have) return;
          updates[vid] = Math.max(0, have - o.take[vid]);
