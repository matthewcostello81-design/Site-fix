</style>
<script>
(function(){
  if (window.pgCartAddons) return; window.pgCartAddons = 1;

  var H = {
    wall:  'anime-pokemon-3d-lenticular-poster-charizard-squirtle-bulbasaur-come-alive-with-amazing-3d-effects-wall-art-printwithout-frame',
    frame: '30x40cm-frame-black-and-white-wood-grain-photo-frame-can-be-hung-on-the-wall-with-certificate-poster-canvas-painting-decoration',
        pro2:  'pocket-era-r36-pro-2',
        /* the 'flip' family is the R36S Ultra since 2026-09-21: the Flip SP
           product and its three add-ons were rewritten in place, so the keys
           keep their short names and only the handles moved */
        flip:  'pocket-era-r36s-ultra',
        fsil:  'r36s-ultra-silicone-case',
        fhard: 'r36s-ultra-hard-shell-case',
        fprot: 'r36s-ultra-screen-protector',
        psil:  'r36-pro-2-silicone-case',
        phard: 'r36-pro-2-hard-shell-case',
        pprot: 'r36-pro-2-screen-protector',
        /* the Protection Kits (2026-09-21): the three accessories as ONE product
           each, the way the supplier ships them; free beside a Max console */
        fkit:  'r36s-ultra-max-kit',
        pkit:  'r36-pro-2-max-kit'
  };
  var FRAME_VARIANT = 49688364613860;
  /* the products pg-cart-offer has a card for (its own H table) */
  var THEIRS = {
    'pokemon-crystal-ball-3d-pikachu-gengar-mewtwo-night-light-lamp-pokeball-3d-glass-pokemon-crystal-ball-statue-kids-birthday-gift': 'orb',
    'handheld-game-console': 'console', 'r36s-duo-pack': 'console', 'r36s-trio-pack': 'console',
    'r36s-protective-case-free-gift': 'console',
    'dragon-ball-z-legends-lamp': 'lamp', 'legends-power-ball': 'ball'
  };
  THEIRS[H.wall] = 'wall';
    /* the Flip SP and its two add-on cases are ONE family, 'flip': a case in
       the cart belongs to the Flip SP (it is sold only as an add-on), and a
       cart holding only a case shows no offer (flipOffer keys on the singles) */
    var FLIPS = {};
    FLIPS[H.flip] = 'flip'; FLIPS[H.fsil] = 'flip'; FLIPS[H.fhard] = 'flip'; FLIPS[H.fprot] = 'flip'; FLIPS[H.fkit] = 'flip';
    /* the R36 Pro 2 and its three add-ons are one family the same way (2026-09-19,
       "add the same upsells for r36 that you have for the flip ... also add screen
       protectors for both as another optional upsell, 9.99, 14.99 originally") */
    var PRO2S = {};
    PRO2S[H.pro2] = 'pro2'; PRO2S[H.psil] = 'pro2'; PRO2S[H.phard] = 'pro2'; PRO2S[H.pprot] = 'pro2'; PRO2S[H.pkit] = 'pro2';
    var FSIL_VARIANT = 49908115210468, FHARD_VARIANT = 49908115308772, FPROT_VARIANT = 49913872908516;
    var PSIL_VARIANT = 49913872810212, PHARD_VARIANT = 49913872842980, PPROT_VARIANT = 49913872875748;
    var FKIT_VARIANT = 49931342217444, PKIT_VARIANT = 49931342282980;
    /* the R36S Ultra's Bundle (option1; option2 is the colour, matching the
       Pro 2 since the Flip SP became the Ultra on 2026-09-21) */
    var FB = {single: 'Single Device (64GB)', max: 'Max Bundle (128GB)', duo: 'Duo Max Bundle (2x 128GB)'};
  var B = {single: 'Single Device (64GB)', max: 'Max Bundle (128GB)', duo: 'Duo Max Bundle (2x 128GB)'};

  /* the admin's "Extra 5% off entire order" is in every printed price, the
     same way pg-cart-offer reads and applies it (the till floors the cut) */
  var ADMIN_RATE = 0.05, RATE = ADMIN_RATE;
  function readRate(cart){
    var found = null;
    function take(d){
      if (!d || d.type !== 'automatic' || d.value_type !== 'percentage' || d.target_selection !== 'all') return;
      var v = parseFloat(d.value || 0) / 100;
      if (v > 0 && v < 0.9 && (found === null || v > found)) found = v;
    }
    (cart.cart_level_discount_applications || []).forEach(take);
    (cart.items || []).forEach(function(it){
      (it.line_level_discount_allocations || []).forEach(function(a){ take(a && a.discount_application); });
    });
    return found === null ? ADMIN_RATE : found;
  }
  function net(c){ return c - Math.floor(c * RATE); }
  function money(c){ return '$' + (c / 100).toFixed(2); }
  function pct(was, now){ return was > now ? Math.floor((was - now) / was * 100) : 0; }
  function esc(s){ return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;'); }
  function sized(src, w){
    if (!src) return '';
    var s = String(src);
    return s + (s.indexOf('?') > -1 ? '&' : '?') + 'width=' + w;
  }

  /* ---------------- product data ---------------- */
  var P = {}, PBUSY = {};
  function product(handle){
    if (P[handle]) return Promise.resolve(P[handle]);
    if (PBUSY[handle]) return PBUSY[handle];
    PBUSY[handle] = fetch('/products/' + handle + '.js').then(function(r){ return r.ok ? r.json() : null; }).then(function(pr){
      PBUSY[handle] = null;
      if (!pr) return null;
      var out = {handle: handle, image: pr.featured_image || (pr.images && pr.images[0]) || '', variants: []};
      (pr.variants || []).forEach(function(v){
        out.variants.push({
          id: v.id, o1: v.option1, o2: v.option2, o3: v.option3,
          price: v.price, cap: v.compare_at_price || 0, avail: v.available !== false,
          img: (v.featured_image && v.featured_image.src) || ''
        });
      });
      P[handle] = out;
      return out;
    }).catch(function(){ PBUSY[handle] = null; return null; });
    return PBUSY[handle];
  }

  /* ---------------- the offers ---------------- */
  function frameOffer(cart){
