     cart is empty shipping protection is still on there"): once the last
     product leaves, a lone shipping-protection line is taken out too, so the
     cart is truly empty and the drawer says so. pg-drawer's own toggle keeps
     adding it beside real items as before. */
  var SP_VARIANT = 49529437028580;
  function loneProtection(cart){
    var items = cart.items || [];
    return items.length > 0 && items.every(function(it){ return it.handle === 'shipping-protection'; });
  }
  function trimKits(cart){
    if (trimming || busy) return Promise.resolve(null);
    if (loneProtection(cart)){
      trimming = true;
      var up = {}; up[String(SP_VARIANT)] = 0;
      return post('/cart/update.js', {updates: up})
        .then(function(){ return fetch('/cart.js', {credentials: 'same-origin', headers: {'Accept': 'application/json'}}); })
        .then(function(r){ return r.json(); })
        .then(function(fresh){ trimming = false; if (window.pgDrawerRefresh){ try { window.pgDrawerRefresh(); } catch (e){} } return fresh; })
        .catch(function(){ trimming = false; return null; });
    }
    var fams = Object.keys(FAMS).filter(function(k){
      return (cart.items || []).some(function(it){ return it.handle === FAMS[k].kit.handle; });
    });
    if (!fams.length) return Promise.resolve(null);
    return Promise.all(fams.map(function(k){ return product(FAMS[k].handle); })).then(function(prs){
      var updates = {}, any = false;
      fams.forEach(function(k, i){
        var F = FAMS[k], pr = prs[i];
        if (!pr) return;
        var t = tally(cart, F, pr), allowed = t.maxUnits.length, have = t.have[F.kit.handle] || 0;
        if (have > allowed){ updates[String(F.kit.id)] = allowed; any = true; }
      });
      if (!any) return null;
      trimming = true;
      return post('/cart/update.js', {updates: updates})
        .then(function(){ return fetch('/cart.js', {credentials: 'same-origin', headers: {'Accept': 'application/json'}}); })
        .then(function(r){ return r.json(); })
        .then(function(fresh){
          trimming = false;
          if (window.pgDrawerRefresh){ try { window.pgDrawerRefresh(); } catch (e){} }
          return fresh;
        })
        .catch(function(){ trimming = false; return null; });
    });
