      el.innerHTML = '<span class="pg-addon-ck" aria-hidden="true"></span>' +
        '<img alt="" width="40" height="40" decoding="sync" src="' + esc(o.img || '') + '">' +
        '<div class="pg-addon-t"><b>' + esc(o.title) + '</b><span class="pg-addon-px">' + priceHtml(o) + '</span></div>' +
        pick;
