       mutation, and calling it on every pass would keep the observer spinning */
    if (added && window.pgPlaceUnlock){ try { window.pgPlaceUnlock(); } catch (e){} }
  }

  /* ---------------- 3. the line picture follows the variant ---------------- */
  function fileOf(u){
    var s = String(u || '').split('?')[0].split('/').pop() || '';
    return s.replace(/_(\d+x\d*|x\d+|pico|icon|thumb|small|compact|medium|large|grande|master)(@\dx)?(?=\.[a-z]+$)/i, '').toLowerCase();
  }
  var IMG = {};   /* variant id -> the image /cart.js gave that line, kept between reads */
  function noteImages(cart){
    (cart.items || []).forEach(function(it){ if (it.image) IMG[String(it.variant_id)] = it.image; });
  }
  function syncImages(){
    var by = IMG;
    document.querySelectorAll('#cart .l4ca:not(.in-panel) > li').forEach(function(li){
      if (li.closest('.nc-recs, .nc-recs-panel, .pg-unlock')) return;
      var a = li.querySelector('a[href*="/products/"][href*="variant="]');
      var img = li.querySelector('figure img, picture img, img');
      if (!a || !img) return;
      var m = (a.getAttribute('href') || '').match(/[?&]variant=(\d+)/);
      var want = m && by[m[1]];
      if (!want) return;
      if (fileOf(img.currentSrc || img.getAttribute('src')) === fileOf(want)) return;
      var url = sized(want, 360);
      var pic = img.closest('picture');
      if (pic) pic.querySelectorAll('source').forEach(function(s){ s.setAttribute('srcset', url); });
      img.removeAttribute('srcset');
      img.removeAttribute('sizes');
      img.setAttribute('src', url);
    });
  }

  /* ---------------- watching ----------------
