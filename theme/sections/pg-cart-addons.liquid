    font-size:10.5px;font-weight:800;text-transform:uppercase;font-style:normal;
    color:#fff;background:linear-gradient(120deg,#9B4BC4,#7A2FA2);
  }
  #cart#cart#cart#cart .pg-addon-t small{display:block;font-size:11px;line-height:1.3;color:#6E5C80;margin-top:2px}
  #cart#cart#cart#cart .pg-addon-t small.pg-addon-inc{color:#7A2FA2;font-weight:600}
  #cart#cart#cart#cart .pg-addon-pick{grid-column:1 / -1;display:flex;flex-direction:column;gap:1px;min-width:0}
