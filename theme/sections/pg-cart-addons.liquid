  function addonRows(cart, famKey){
    var F = FAMS[famKey];
    var lines = (cart.items || []).filter(function(it){ return it.handle === F.handle; });
    if (!lines.length) return Promise.resolve([]);
    return product(F.handle).then(function(pr){
      if (!pr) return [];
      var t = tally(cart, F, pr), kits = t.maxUnits.length;
      if (!t.singles && !kits) return [];
      function rowFor(r, need, free){
        return product(r.handle).then(function(cp){
          if (!cp) return null;
          var v = null;
          cp.variants.forEach(function(x){ if (String(x.id) === String(r.id)) v = x; });
          if (!v) v = cp.variants[0];
          if (!v || !v.avail) return null;
          return {
            key: r.fam + ':' + (free ? 'k' : '') + need, kind: 'add', tone: 'row', free: !!free,
            img: keep(r.fam, sized(v.img || cp.image, 160)),
            title: need > 1 ? 'Add ' + need + ' ' + r.noun + 's' : 'Add ' + r.noun,
            sub: '',
            was: (v.cap || v.price) * need, now: free ? 0 : v.price * need,
            btn: free ? 'Add free' : 'Add for ' + money(v.price * need),
            items: [{id: v.id, quantity: need}]
          };
        });
      }
      var jobs = [];
      /* THE KIT FIRST (2026-09-21): a Max console whose free Protection Kit
         line is missing (a shopper deleted it) gets it back as a FREE row */
      var kitNeed = Math.max(0, kits - (t.have[F.kit.handle] || 0));
      if (kitNeed > 0) jobs.push(rowFor(F.kit, kitNeed, true));
      /* then the singles' paid add-on rows, one per single console, less
         what the cart already holds (the owner: "it should only be
         individual items if they do the add-ons from the first bundle") */
      if (t.singles) F.rows.forEach(function(r){
        var need = Math.max(0, t.singles - (t.have[r.handle] || 0));
        if (need > 0) jobs.push(rowFor(r, need, false));
      });
      return Promise.all(jobs).then(function(r){ return r.filter(Boolean); });
    });
  }
  function flipOffer(cart){
    /* the same shape as the Pro 2 (owner, 2026-09-19 evening: "the cart is
       glitching when you add one max package and it's not showing upsells for
       the duo max"): singles -> the add-on rows; a Max Package -> the Duo Max
       row, which swaps the Max out */
    return addonRows(cart, 'flip').then(function(rows){
      if (rows.length) return rows;
      return flipUpgrade(cart).then(function(o){ return o ? [o] : []; });
    });
  }
  /* THE SECOND CONSOLE (2026-09-21, replaces the Duo Max variant swap: AutoDS
     fulfils one supplier SKU per cart line, so the Duo Max is two Max console
     lines now). One Max console in the cart -> a row that ADDS a second Max
     console (a colour picker for it) together with its free Protection Kit;
     the admin's Duo Max Savings then takes F.duoOff off EACH of the two, so
     the pair lands on the Duo Max price. Two or more Max consoles already
     earn it: no row. Singles are the add-on rows' business (addonRows). */
  function secondConsole(cart, famKey){
    var F = FAMS[famKey];
    var lines = (cart.items || []).filter(function(it){ return it.handle === F.handle; });
    if (!lines.length) return Promise.resolve(null);
    return product(F.handle).then(function(pr){
      if (!pr) return null;
      var t = tally(cart, F, pr);
      if (t.singles || t.maxUnits.length !== 1) return null;
      var m = t.maxUnits[0], opts = [];
      pr.variants.forEach(function(v){ if (F.max(v) && v.avail) opts.push({id: F.colour(v), t: F.colour(v)}); });
      if (!opts.length) return null;
      var pref = opts.some(function(o){ return o.id === F.colour(m); }) ? F.colour(m) : opts[0].id;
      function maxOf(c){ var hit = null; pr.variants.forEach(function(v){ if (!hit && F.max(v) && F.colour(v) === c) hit = v; }); return hit; }
      /* what the second console adds to the bill: its price less the two
         cuts the pair earns (the first console's price drops as well) */
      var plus = Math.max(0, m.price - 2 * F.duoOff);
      var secondOff = Math.max(0, Math.round((1 - plus / m.price) * 100));
      var famTag = famKey === 'flip' ? 'fduo' : 'p2duo';
      return {
        key: famTag, kind: 'swap', tone: 'row',
        img: keep(famTag, sized(m.img || pr.image, 200)),
        /* the second console brings its own free kit, and the row says so (owner, 2026-09-21) */
        title: 'Duo Max: 2nd Console' + (secondOff >= 10 ? ' ' + secondOff + '% Off' : '') + ' + Free Protection Kit',
        sub: '', plus: '+' + money(plus),
        was: m.cap || m.price, now: Math.max(0, m.price - F.duoOff),
        btn: 'Make it a duo',
        pick: {label: 'Console 2', options: opts, value: pref},
        target: function(val){ return maxOf(val || pref); },
        itemsFor: function(v){ return [{id: v.id, quantity: 1}, {id: F.kit.id, quantity: 1}]; },
        addQty: 1, take: {}
      };
    });
  }
  function flipUpgrade(cart){ return secondConsole(cart, 'flip'); }
  /* the Pro 2: its bundle-upgrade row first (a checkbox row too, 2026-09-19:
     "the upgrade max bundle stuff for r36 is getting cut off in the upsell in
     cart now, make sure it looks similar to the individual items we have with
     the flip", "too many words", "just use checkbox"), then the add-on rows */
  function pro2Offer(cart){
    /* owner, 2026-09-19 evening: "if they have singles in cart they should be
       getting upsells on those 3 items. but if they add a max to the cart it
       should only offer duo max and incentivise them to go up, and if they do
       upsell to duo max it should replace what's in their current cart". So:
       singles in the cart -> the add-on rows (never a bundle upgrade); no
       singles -> pro2Upgrade(), which only answers for Max Bundles now (one
       Max -> the Duo Max with a console 2 colour, two Max -> the Duo Max), and
       its swap takes the Max OUT as the Duo goes in */
    return addonRows(cart, 'pro2').then(function(rows){
      if (rows.length) return rows;
      return pro2Upgrade(cart).then(function(o){ return o ? [o] : []; });
    });
  }
  function pro2Upgrade(cart){ return secondConsole(cart, 'pro2'); }

  /* 5. WHO HOLDS THE ONE SEAT. sure: this file's card shows and
     pg-cart-offer's is hidden. Not sure: pg-cart-offer's card has the seat and
     ours is only a stand-in should it have none. */
  function gross(it){ return it.original_line_price != null ? it.original_line_price : it.line_price; }
    function choose(cart, pro2, frame, flip){
    var newest = null, theirs = false, prints = 0;
    (cart.items || []).forEach(function(it){
      if (!gross(it)) return;                       /* free lines name no family, as in pg-cart-offer */
            var f = PRO2S[it.handle] || FLIPS[it.handle] || THEIRS[it.handle] || null;
      if (!f) return;
      if (!newest) newest = f;                      /* /cart.js lists lines newest first */
            if (f !== 'pro2' && f !== 'flip') theirs = true; /* both families are this file's */
      if (it.handle === H.wall) prints += it.quantity;
