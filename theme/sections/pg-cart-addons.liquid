        /* the Flip family holds the seat when it was added last, or when nothing
           else in the cart has a card (a Pro 2 line with no card of its own, a
           lone Duo Max say, does not count); it carries an ARRAY of cards (0 to 3) */
        var flips = flip && flip.length ? flip : null;
        var p2 = pro2 && pro2.length ? pro2 : null;
        if (flips && (newest === 'flip' || (!theirs && (newest !== 'pro2' || !p2)))) return {offers: flips, sure: true};
        if (p2 && (newest === 'pro2' || !theirs)) return {offers: p2, sure: true};
    if (frame && newest === 'wall' && prints % 3 === 0) return {offer: frame, sure: true};
        if (p2) return {offers: p2, sure: false};
        if (frame) return {offer: frame, sure: false};
        return {offers: flips, sure: false};
  }
  function pickFor(cart){
    RATE = readRate(cart);
        return Promise.all([pro2Offer(cart), frameOffer(cart), flipOffer(cart)]).then(function(r){
            return choose(cart, r[0], r[1], r[2]);
    });
  }

  /* ---------------- the card ---------------- */
  function priceHtml(o){
    var was = o.wasNet != null ? o.wasNet : o.was;
    var now = o.nowNet != null ? o.nowNet : o.now;   /* product prices, the 5% is the totals box's (2026-09-19 evening) */
    var save = pct(was, now);
    /* an upgrade row prints what the upgrade costs on top ("+$42.75") and the
       bundle's cut against its compare-at, not two totals the shopper has to
       subtract (2026-09-19, "too many words") */
    /* a kit row (2026-09-21): the Protection Kit is free beside its Max console */
    if (o.free) return '<s>' + money(was) + '</s>Free';
    if (o.plus) return esc(o.plus) + (save ? '<i class="pg-addon-sv">Save ' + save + '%</i>' : '');
    return (was > now ? '<s>' + money(was) + '</s>' : '') + money(now) +
      (save ? '<i class="pg-addon-sv">Save ' + save + '%</i>' : '');
  }
  function card(o){
    var el = document.createElement('div');
    el.className = 'pg-addon';
    el.setAttribute('data-addon', o.key);
    if (o.tone) el.setAttribute('data-tone', o.tone);
    var pick = '';
    if (o.pick){
      pick = '<label class="pg-addon-pick"><span>' + esc(o.pick.label) + '</span><select>';
      o.pick.options.forEach(function(op){
        pick += '<option value="' + esc(op.id) + '"' + (String(op.id) === String(o.pick.value) ? ' selected' : '') + '>' + esc(op.t) + '</option>';
      });
      pick += '</select></label>';
