     Color) each sell three one-variant add-ons: a silicone daily
     case, a hard shell travel case and a screen protector. The owner's rule
     for the cart: the SINGLE consoles of a family get a compact CHECKBOX ROW
     per accessory they are still missing ("make sure the upsells work in cart
     for the single items only", "upsell both ... but dont have all the
     sentences below it"), one per single console ("for the duo pack each
     upsell should be 2x"), less what the cart holds. A Max / Duo Max includes
     all three and gets none. Resolves to an ARRAY of 0 to 3 offers. The Flip
     never gets a bundle-upgrade card ("only offer the add-ons in the cart,
     not the next bundle up"); the Pro 2's upgrade row goes ahead of its rows
     (pro2Offer). */
  var FAMS = {
    flip: {handle: H.flip, single: function(v){ return v.o1 === FB.single; }, max: function(v){ return v.o1 === FB.max; }, colour: function(v){ return v.o2; }, duoOff: 3250,
      kit: {handle: H.fkit, id: FKIT_VARIANT, fam: 'fkit', noun: 'Protection Kit'}, rows: [
      {handle: H.fsil, id: FSIL_VARIANT, fam: 'fsil', noun: 'Clear Daily Case'},
      {handle: H.fhard, id: FHARD_VARIANT, fam: 'fhard', noun: 'Hard Shell Travel Case'},
      {handle: H.fprot, id: FPROT_VARIANT, fam: 'fprot', noun: 'Screen Protector'}]},
    pro2: {handle: H.pro2, single: function(v){ return v.o1 === B.single; }, max: function(v){ return v.o1 === B.max; }, colour: function(v){ return v.o2; }, duoOff: 3000,
      kit: {handle: H.pkit, id: PKIT_VARIANT, fam: 'pkit', noun: 'Protection Kit'}, rows: [
      {handle: H.psil, id: PSIL_VARIANT, fam: 'psil', noun: 'Silicone Daily Case'},
      {handle: H.phard, id: PHARD_VARIANT, fam: 'phard', noun: 'Hard Shell Travel Case'},
      {handle: H.pprot, id: PPROT_VARIANT, fam: 'pprot', noun: 'Screen Protector'}]}
  };
  /* what a family holds (2026-09-21): single units, the Max consoles one by
     one, and how many of each product the cart carries, by handle */
  function tally(cart, F, pr){
    var byId = {};
    pr.variants.forEach(function(v){ byId[String(v.id)] = v; });
    var t = {singles: 0, maxUnits: [], have: {}};
    (cart.items || []).forEach(function(it){
      t.have[it.handle] = (t.have[it.handle] || 0) + it.quantity;
      if (it.handle !== F.handle) return;
      var v = byId[String(it.variant_id)];
      if (!v) return;
      if (F.single(v)) t.singles += it.quantity;
      else if (F.max(v)){ for (var i = 0; i < it.quantity; i++) t.maxUnits.push(v); }
    });
