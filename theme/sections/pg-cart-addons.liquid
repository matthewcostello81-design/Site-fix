    var has = !!c.querySelector('.l4ca:not(.in-panel) > li');
    var old = c.querySelector('.pg-empty-back');
    if (has){ if (old && old.parentNode) old.parentNode.removeChild(old); return; }
    if (old) return;
    var msg = null;
    c.querySelectorAll('p, div, span, h2, h3').forEach(function(e){
      if (!msg && !e.children.length && /cart is empty/i.test(e.textContent || '')) msg = e;
    });
    if (!msg || !msg.parentNode) return;
    var a = document.createElement('a');
    a.href = '/';
