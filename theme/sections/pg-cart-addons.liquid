  var lastResync = 0, resyncs = 0;
  function resync(cart){
    var c = document.getElementById('cart');
    if (!c || busy || trimming) return;
    var inCart = {};
    (cart.items || []).forEach(function(it){ inCart[String(it.variant_id)] = 1; });
    var ghost = false;
    c.querySelectorAll('.l4ca:not(.in-panel) > li').forEach(function(li){
      if (li.closest('.nc-recs, .nc-recs-panel, .pg-unlock')) return;
      var a = li.querySelector('a[href*="variant="]');
      var m = a && (a.getAttribute('href') || '').match(/[?&]variant=(\d+)/);
      if (m && !inCart[m[1]]) ghost = true;
    });
