    timer = setTimeout(function(){ timer = null; read(); }, ms || 200);
  }
  /* a row whose product has left the list goes in the same frame as the
     rebuild, not when the read answers */
  function prune(){
    var empty = !document.querySelector('#cart .l4ca:not(.in-panel) > li');
    document.querySelectorAll('#cart .pg-addon').forEach(function(el){
      var h = famOf(el.getAttribute('data-addon'));
