    });
  }
  /* A SECOND LOOK A BEAT LATER (2026-09-21, owner: "when I add the upsell then
     delete it, the upsell doesn't reappear"). pg-cart-fast hands every
     /cart.js reader one shared answer for 500ms and only forgets it on writes
     it can see; the theme's own remove goes past it, so the read fired by the
