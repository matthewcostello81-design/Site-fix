    if (/^(fsil|fhard|fprot|fkit):/.test(key) || /^f(duo|switch)/.test(key)) return H.flip;
    if (/^(psil|phard|pprot|pkit):/.test(key) || /^p2/.test(key)) return H.pro2;
    if (/^frame:/.test(key)) return H.wall;
    return null;
  }
  function domHas(handle){ return !!document.querySelector('#cart .l4ca:not(.in-panel) > li a[href*="/products/' + handle + '"]'); }
  function show(){
    var c = document.getElementById('cart');
    if (!c || busy) return;
    /* our own write is in: the spent card goes, and who holds the seat is
       left as it is until the read that follows has answered */
    if (force){ paint([]); return; }
        var pick = lastPick, mine = null, want = offersOf(pick);
        /* a row whose product just left the list is not put back from the last
           read (owner, 2026-09-19 evening: "when you hit garbage icon to get rid
           of stuff there shouldn't be any cart flickering"); the read that
           follows the delete paints what is right */
        want = want.filter(function(o){ var h = famOf(o.key); return !h || domHas(h); });
        if (want.length && c.querySelector('.l4ca:not(.in-panel) > li')){
