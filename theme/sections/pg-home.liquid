{%- comment -%}
  PG Home: PocketEra homepage in the Sleek Mood homepage layout, purple/black.
  Announcement bar + centered-logo header, full-bleed hero with CTA, Best
  Sellers product grid (blocks), split promo banner, image tiles, accordion
  FAQ, and a trust icon row. The site footer renders below as usual.
{%- endcomment -%}

<style>
  .shopify-section-header,
  #shopify-section-header,
  .shopify-section[id*="__header"],
  .shopify-section[id*="nc_announce"],
  .shopify-section[id*="nc-announce"],
  .shopify-section[id*="newsletter-popup"],
  [id*="sticky-add-to-cart"]{display:none !important}
  #content{padding-top:0 !important}

  #pgh{--p:#7A2FA2;--pd:#4A1C66;--ink:#121212;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;color:var(--ink);background:#fff}
  #pgh *{box-sizing:border-box}
  #pgh img{max-width:100%;display:block}
  #pgh a{text-decoration:none;color:inherit}

  .pgh-announce{background:linear-gradient(90deg,#4A1C66,#7A2FA2 50%,#4A1C66);color:#fff;text-align:center;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:11px 16px}
  .pgh-head{background:#fff;border-bottom:1px solid #e9dcf3}
  .pgh-head-in{max-width:1280px;margin:0 auto;padding:18px 24px 10px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}
  .pgh-head svg{width:22px;height:22px;stroke:#121212;fill:none;stroke-width:1.6}
  .pgh-logo{justify-self:center}
  .pgh-logo img{max-height:120px;width:auto;margin:0 auto}
  .pgh-logo-text{font-family:Georgia,serif;font-style:italic;font-weight:700;font-size:42px;line-height:1}
  .pgh-ic{display:flex;gap:18px;justify-self:end;align-items:center}
  .pgh-cart{position:relative}
  .pgh-cart-n{position:absolute;top:-7px;right:-9px;background:var(--p);color:#fff;border-radius:999px;font-size:10px;min-width:16px;height:16px;line-height:16px;text-align:center;padding:0 3px}
  .pgh-nav{display:flex;justify-content:center;gap:34px;padding:12px 16px 16px;flex-wrap:wrap}
  .pgh-nav a{font-size:15px;color:#2b2b2b;text-underline-offset:5px}
  .pgh-nav a:hover{text-decoration:underline;color:var(--p)}
  .pgh-nav a.pgh-on{text-decoration:underline}

  /* Hero */
  .pgh-hero{position:relative;overflow:hidden;min-height:420px;height:66vh;max-height:760px}
  .pgh-hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .pgh-hero:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(26,7,38,.3) 0%,rgba(26,7,38,.35) 55%,rgba(26,7,38,.68) 100%);z-index:1}
  .pgh-hero-in{position:relative;z-index:2;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;text-align:center;padding:0 20px}
  .pgh-hero-eyebrow{color:#E9D5F7;letter-spacing:.3em;font-size:13px;font-weight:600;text-transform:uppercase;text-shadow:0 1px 10px rgba(0,0,0,.5)}
  .pgh-hero h1{color:#fff;font-size:54px;font-weight:700;letter-spacing:-.5px;margin:0;text-shadow:0 2px 22px rgba(0,0,0,.5)}
  .pgh-hero-btn{display:inline-block;border:1.5px solid #fff !important;color:#121212 !important;font-size:15.5px;font-weight:600;padding:15px 40px;background:#fff !important;background-color:#fff !important;border-radius:8px;box-shadow:0 16px 38px -14px rgba(0,0,0,.55);transition:background .15s ease,color .15s ease,transform .15s ease}
  .pgh-hero-btn:hover{transform:translateY(-1px)}
  .pgh-hero-btn:hover{background:#7A2FA2 !important;background-color:#7A2FA2 !important;color:#fff !important;border-color:#7A2FA2 !important}

  /* Best sellers grid */
  .pgh-wrap{max-width:1280px;margin:0 auto;padding:56px 24px 10px}
  .pgh-eyebrow{color:var(--p);font-size:12.5px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;margin-bottom:8px}
  .pgh-h2{font-size:34px;font-weight:700;letter-spacing:-.3px;margin:0 0 30px}
  .pgh-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;max-width:1280px}
  .pgh-card{display:block;transition:transform .25s ease}
  .pgh-card:hover{transform:translateY(-4px)}
  .pgh-card-img{position:relative;background:#1b1426;border-radius:14px;overflow:hidden;box-shadow:0 16px 38px -26px rgba(18,4,28,.5)}
  .pgh-card-img img{aspect-ratio:1/1;object-fit:cover;width:100%;transition:transform .25s ease}
  .pgh-card:hover .pgh-card-img img{transform:scale(1.04)}
  /* the Sale badge wears the bundle tiles' SAVE badge COLOURS (pg-save-badge's
     .pgx-lad-badge): the deep end of the purple family, by request
     (2026-09-11), in the card titles' own type (sentence case, 600, no
     tracking; the badge's uppercase 800 read as a foreign font on this page).
     !important at html-body-id specificity because pg-dark-atc
     (#pgh .pgh-badge{background:#8B44BE !important;border:0 !important}) paints
     this badge from the footer group; that rule is outranked here rather than
     depended on. */
  html body #pgh .pgh-badge,html body .pgh-badge{
    position:absolute !important;left:12px !important;top:12px !important;bottom:auto !important;border-radius:999px !important;
    background:linear-gradient(120deg,#8B44BE 0%,#7A2FA2 45%,#4A1C66 100%) !important;
    color:#F7EDFF !important;border:1px solid rgba(139,68,190,.85) !important;
    font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif !important;font-size:12.5px !important;font-weight:600 !important;letter-spacing:0 !important;text-transform:none !important;
    padding:5px 13px !important;white-space:nowrap !important;box-shadow:0 6px 14px -10px rgba(0,0,0,.85) !important;
    animation:none !important;text-shadow:none !important;
  }
  @media (max-width:600px){html body #pgh .pgh-badge,html body .pgh-badge{font-size:12px !important;padding:5px 11px !important}}
  /* the arrow the product tiles' ADD TO CART carries, as a real span: the
     base theme hides button::after and pg-theme-css kills it outright */
  .pgh-atc .pgh-arr{font-size:17px;line-height:1;font-weight:400}
  /* pgShiftT is declared in pg-theme-css (footer-group); restated here so the
     home page's buttons never depend on that section being present. Same
     three stops, so a double declaration is a no-op. */
  @keyframes pgShiftT{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
  .pgh-atc{position:absolute;right:12px;top:12px;background:#fff;color:#121212;border:0;font-family:inherit;font-size:12.5px;font-weight:500;letter-spacing:0;padding:5px 16px;border-radius:999px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 16px -8px rgba(0,0,0,.35);transition:background .15s ease,color .15s ease}
  .pgh-atc:hover{background:#7A2FA2;color:#fff}
  .pgh-atc[disabled]{opacity:.6;cursor:default}
  .pgh-card-t{font-size:16px;font-weight:500;margin:14px 0 4px;color:#1c1c1c}
  .pgh-card:hover .pgh-card-t{text-decoration:underline;text-underline-offset:4px}
  .pgh-card-p{font-size:16px;font-weight:600;color:var(--p)}
  /* THE STAR RATING ON EVERY CARD (2026-09-22, by request: "on each homepage
     card you should have the stars rated of the product somewhere visually
     clean so people can see"). A pill on the product photo, bottom centre (over the title, by request)
     (moved there and made bigger by request: "add the stars into the product
     photos"): five stars filled to the real average, the average, and the
     review count (the count drops on phones, where cards are two a row). The numbers are the product's own reviews.rating and
     reviews.rating_count metafields, which Judge.me keeps in step, so a card
     never shows a rating its product page does not have. The stars are
     the theme's purple (see the note at .pgh-stars-on). A product with no reviews yet wears a
     "New arrival" pill instead; it never borrows another product's stars. */
  #pgh#pgh .pgh-card-r{position:absolute;left:50%;transform:translateX(-50%);bottom:10px;z-index:2;display:flex;align-items:center;gap:7px;
    padding:7px 12px 7px 10px;border-radius:999px;font-size:15px;line-height:1;white-space:nowrap;color:#E6DFF2;
    background:rgba(11,7,16,.72);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);
    border:1px solid rgba(199,155,234,.38);box-shadow:0 10px 24px -12px rgba(0,0,0,.85)}
  #pgh#pgh .pgh-stars{position:relative;display:inline-block;font-size:21px;line-height:1;letter-spacing:1px;color:rgba(255,255,255,.22)}
  /* PURPLE AND MOVING (2026-09-22, by request: "make the stars purple tho in
     line with theme and dynamic"): the lit stars wear the ADD TO CART
     button's moving purple (the same stops and the same 8s pgShiftT wave),
     lifted a few steps lighter so they still read on the dark cards. Still
     for visitors who ask for reduced motion. */
  #pgh#pgh .pgh-stars-on{position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:#C79BEA;
    background-image:linear-gradient(120deg,#E4C4FF 0%,#B478E0 30%,#8B44BE 50%,#B478E0 70%,#E4C4FF 100%);background-size:240% 240%;
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
    animation:pgShiftT 8s ease-in-out infinite;filter:drop-shadow(0 0 6px rgba(155,75,196,.55))}
  @media (prefers-reduced-motion:reduce){ #pgh#pgh .pgh-stars-on{animation:none} }
  #pgh#pgh .pgh-card-r b{font-weight:700;color:#FFFFFF}
  #pgh#pgh .pgh-card-rn{color:#CFC4DE;font-size:13.5px}
  #pgh#pgh .pgh-card-new{padding:8px 14px;color:#F1E2FF;font-weight:700;letter-spacing:.02em}
  /* two cards a row on a phone: the count gives way so the pill fits */
  @media (max-width:600px){
    #pgh#pgh .pgh-card-r{bottom:8px;gap:5px;padding:6px 10px 6px 8px;font-size:13.5px}
    #pgh#pgh .pgh-stars{font-size:17px;letter-spacing:.5px}
    #pgh#pgh .pgh-card-rn{display:none}
    #pgh#pgh .pgh-card-new{padding:7px 12px;font-size:12.5px}
  }
  /* the price line in the titles' type: pg-theme-css stamps it 800 with
     .01em tracking, which sat oddly beside the 500 titles; 600, untracked */
  html body #pgh .pgh-card-p{font-weight:600 !important;letter-spacing:0 !important}
  /* the page is dark (pg-dark, footer-group): .82 white, not a grey, or the
     struck price vanishes into the card -- "hard to see", by report (2026-09-11) */
  html body #pgh .pgh-card-p s,.pgh-card-p s{color:rgba(255,255,255,.82) !important;font-weight:400 !important;font-size:14px;margin-right:8px;text-decoration-color:rgba(255,255,255,.7)}

  /* Split banner */
  .pgh-split{max-width:1280px;margin:64px auto 0;display:grid;grid-template-columns:44% 1fr;border-radius:20px;overflow:hidden;box-shadow:0 30px 70px -45px rgba(18,4,28,.6)}
  .pgh-split-l{background:linear-gradient(135deg,#101014 0%,#1D1026 100%);color:#fff;padding:72px 56px;display:flex;flex-direction:column;justify-content:center;gap:20px}
  .pgh-split-l h2{font-size:44px;font-weight:700;letter-spacing:-.5px;margin:0;color:#fff !important}
  .pgh-split-l .l1{color:#fff !important}
  .pgh-split-l .l1{font-weight:600;font-size:16.5px}
  .pgh-split-l .l2{color:#c9c9c9;font-size:15.5px;margin-top:4px}
  .pgh-split-btn{display:inline-block;background:#fff !important;background-color:#fff !important;color:#121212 !important;font-weight:600;font-size:15px;padding:14px 34px;border-radius:8px;width:max-content;box-shadow:0 14px 32px -14px rgba(0,0,0,.6);transition:background .15s ease,color .15s ease,transform .15s ease}
  .pgh-split-btn:hover{transform:translateY(-1px)}
  .pgh-split-btn:hover{background:var(--p) !important;background-color:var(--p) !important;color:#fff !important}
  .pgh-split-r{min-height:380px}
  .pgh-split-r img{width:100%;height:100%;object-fit:cover}

  /* Tiles */
  .pgh-tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,300px));gap:20px;justify-content:start}
  @media (min-width: 901px){.pgh-tiles{grid-template-columns:repeat(3,1fr)}}
  .pgh-tile{position:relative;border-radius:18px;overflow:hidden;display:block;box-shadow:0 18px 44px -30px rgba(18,4,28,.55)}
  .pgh-tile img{aspect-ratio:4/3;object-fit:cover;width:100%;transition:transform .25s ease}
  .pgh-tile:hover img{transform:scale(1.04)}
  .pgh-tile:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(18,4,28,0) 45%,rgba(18,4,28,.72))}
  .pgh-tile span{position:absolute;left:22px;bottom:18px;color:#fff;font-size:24px;font-weight:700;z-index:1}

  /* Accordions */
  .pgh-acc{max-width:880px;margin:26px auto 0;padding:0 24px}
  .pgh-acc details{border-bottom:1px solid #e5e5e5}
  .pgh-acc summary{list-style:none;display:flex;align-items:center;font-size:17.5px;font-weight:500;padding:22px 4px;cursor:pointer;transition:color .15s ease}
  .pgh-acc summary:hover{color:var(--p)}
  .pgh-acc summary::-webkit-details-marker{display:none}
  .pgh-acc summary:after{content:"\2304";margin-left:auto;color:var(--p);font-size:18px;line-height:0;transition:transform .15s ease}
  .pgh-acc details[open] summary:after{transform:rotate(180deg)}
  .pgh-acc-body{font-size:15px;line-height:1.65;color:#3a3a3a;padding:0 4px 20px}
  .pgh-acc-body a{color:var(--p);text-decoration:underline;text-underline-offset:3px}
  /* 2026-09-18 (round 2): the homepage trust row, the "Built for gamers"
     banner and the four dropdowns are lifted out of pg-dark's near-black
     fills into vibrant purple-tinted modules with a fading-purple radial
     glow, matching the R36S Pro page. Two ids + !important beat pg-dark
     (footer group, single #pgh). */
  /* trust: one bright rounded module, bigger discs, dividers cut the dead space */
  #pgh#pgh .pgh-trust{width:calc(100% - 32px) !important;max-width:1040px !important;margin:44px auto 56px !important;
    border:1px solid rgba(199,155,234,.34) !important;border-radius:24px !important;
    background:radial-gradient(120% 130% at 50% 0%,rgba(155,75,196,.30),rgba(155,75,196,0) 58%),linear-gradient(180deg,rgba(46,25,68,.72),rgba(24,16,34,.62)) !important;
    box-shadow:0 30px 70px -44px rgba(139,68,190,.9) !important}
  #pgh#pgh .pgh-trust b{color:#fff !important}
  #pgh#pgh .pgh-trust span{color:#CFC4DE !important}
  #pgh#pgh .pgh-tic{width:88px;height:88px;margin:0 auto 16px;border-radius:50%;display:flex;align-items:center;justify-content:center;
    background:linear-gradient(140deg,#B478E0,#7A2FA2 52%,#4A1C66);
    box-shadow:0 16px 34px -14px rgba(155,75,196,.95),0 0 0 7px rgba(155,75,196,.12)}
  #pgh#pgh .pgh-tic svg{width:56px !important;height:56px !important;margin:0 !important;stroke:#fff !important;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;color:#fff}
  @media (min-width:768px){ #pgh#pgh .pgh-trust > div + div{border-left:1px solid rgba(199,155,234,.16)} }
  /* "Built for gamers": one rounded module, the photo bleeding to its edge */
  #pgh#pgh .pgh-split{overflow:hidden;max-width:1120px !important;margin:44px auto 8px !important;
    border:1px solid rgba(199,155,234,.30) !important;border-radius:24px !important;
    background:radial-gradient(100% 130% at 0% 0%,rgba(155,75,196,.24),rgba(155,75,196,0) 55%),linear-gradient(180deg,rgba(40,22,60,.74),rgba(22,16,31,.64)) !important;
    box-shadow:0 34px 80px -48px rgba(139,68,190,.92) !important}
  #pgh#pgh .pgh-split-l{background:transparent !important}
  #pgh#pgh .pgh-split-r img{width:100% !important}
  @media (min-width:768px){ #pgh#pgh .pgh-split-r img{height:100% !important;object-fit:cover !important} }
  /* the four dropdowns: brighter, purple-tinted, glow when open */
  #pgh#pgh .pgh-acc details{border:1.5px solid rgba(199,155,234,.42) !important;border-radius:14px !important;margin:0 0 12px !important;padding:0 18px !important;
    background:linear-gradient(180deg,rgba(52,28,78,.72),rgba(28,18,42,.66)) !important;
    box-shadow:0 16px 34px -24px rgba(139,68,190,.7) !important}
  #pgh#pgh .pgh-acc details[open]{border-color:rgba(199,155,234,.72) !important;box-shadow:0 22px 44px -22px rgba(155,75,196,.95) !important}
  #pgh#pgh .pgh-acc summary{font-family:'Roboto Slab',Georgia,serif !important;font-size:19px !important;font-weight:600 !important;color:#F1EDF7 !important;padding:18px 4px !important;gap:10px}
  #pgh#pgh .pgh-acc summary:after{content:"\25B8" !important;font-size:14px !important;color:#C79BEA !important;line-height:1}
  #pgh#pgh .pgh-acc details[open] summary:after{transform:rotate(90deg) !important}
  #pgh#pgh .pgh-acc-body{font-family:'Roboto Slab',Georgia,serif !important;font-size:15.5px !important;line-height:1.65;color:#F1EDF7 !important;padding:0 4px 20px !important}
  #pgh#pgh .pgh-acc-ic{font-size:18px;line-height:1}
  @media (max-width:600px){ #pgh#pgh .pgh-tic{width:76px;height:76px} #pgh#pgh .pgh-tic svg{width:48px !important;height:48px !important} }

  /* Trust row */
  .pgh-trust{max-width:1232px;margin:56px auto 72px;padding:52px 24px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:26px;text-align:center;background:#faf7fc;border:1px solid #efe3f8;border-radius:20px}
  /* The icons were 44px 1.5-weight outlines in a 46px-padded band, which left
     each cell mostly empty and the marks too thin to read as anything at a
     glance. They are drawn on a 48-unit grid now (see the markup) at 78px, so
     the detail they carry -- wheels with hubs, the shield's inner face, the
     lock's keyhole -- is actually visible, and they fill the row. */
  .pgh-trust svg{width:78px;height:78px;stroke:var(--p);color:var(--p);fill:none;stroke-width:2;
    stroke-linecap:round;stroke-linejoin:round;margin:0 auto 16px;overflow:visible;
    filter:drop-shadow(0 8px 18px rgba(122,47,162,.22))}
  .pgh-trust b{display:block;font-size:17px;margin-bottom:6px}
  .pgh-trust span{font-size:14.5px;color:#5c5c5c}

  @media (max-width: 900px){
    .pgh-logo img{max-height:84px}
    .pgh-logo-text{font-size:34px}
    .pgh-nav{gap:20px;padding-top:8px}
    .pgh-hero{height:56vh;min-height:340px}
    .pgh-hero h1{font-size:32px}
    .pgh-hero-eyebrow{font-size:11px;letter-spacing:.22em}
    .pgh-trust{grid-template-columns:1fr;margin:38px 16px 48px}
    .pgh-trust svg{width:92px;height:92px;margin-bottom:14px}
    .pgh-wrap{padding:38px 16px 8px}
    .pgh-h2{font-size:24px}
    .pgh-grid{grid-template-columns:1fr 1fr;gap:14px}
    .pgh-split{grid-template-columns:1fr;margin-top:38px}
    .pgh-split-l{padding:40px 26px}
    .pgh-split-l h2{font-size:30px}
    .pgh-split-r{min-height:240px}
    .pgh-trust{grid-template-columns:1fr;gap:30px;padding:40px 16px 48px}
    .pgh-trust svg{width:92px;height:92px;margin-bottom:14px}
  }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<div id="pgh">
  <div class="pgh-announce">{{ section.settings.announce_text }}</div>

  <header class="pgh-head">
    <div class="pgh-head-in">
      <a href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/></svg>
      </a>
      <a class="pgh-logo" href="{{ routes.root_url }}" aria-label="Home">
        {%- if section.settings.logo_image -%}
          <img src="{{ section.settings.logo_image | image_url: width: 600 }}" alt="{{ shop.name }}">
        {%- else -%}
          <span class="pgh-logo-text">{{ section.settings.logo_text }}</span>
        {%- endif -%}
      </a>
      <div class="pgh-ic">
        <a href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
        </a>
        <a class="pgh-cart" href="{{ routes.cart_url }}" aria-label="Cart">
          <svg viewBox="0 0 24 24"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
          {%- if cart.item_count > 0 -%}<span class="pgh-cart-n">{{ cart.item_count }}</span>{%- endif -%}
        </a>
      </div>
    </div>
    <nav class="pgh-nav">
      <a class="pgh-on" href="{{ routes.root_url }}">Home</a>
      <a href="/pages/track-order">Track your order</a>
      <a href="/pages/contact">Contact</a>
    </nav>
  </header>

  {%- if section.settings.hero_image -%}
  <div class="pgh-hero">
    <img src="{{ section.settings.hero_image | image_url: width: 2200 }}" alt="{{ section.settings.hero_title | escape }}">
    <div class="pgh-hero-in">
      {%- if section.settings.hero_eyebrow != blank -%}<div class="pgh-hero-eyebrow">{{ section.settings.hero_eyebrow }}</div>{%- endif -%}
      <h1>{{ section.settings.hero_title }}</h1>
      <a class="pgh-hero-btn" href="{{ section.settings.hero_url }}">{{ section.settings.hero_cta }}</a>
    </div>
  </div>
  {%- endif -%}

  <div class="pgh-wrap" id="pg-shop">
    <div class="pgh-eyebrow">{{ section.settings.grid_eyebrow }}</div>
    <h2 class="pgh-h2">{{ section.settings.grid_title }}</h2>
    <div class="pgh-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' -%}
          {%- assign bp = block.settings.product -%}
          {%- if bp != blank -%}
          <a class="pgh-card" href="{{ bp.url }}" {{ block.shopify_attributes }}>
            <div class="pgh-card-img">
              {%- comment -%} the card keeps its product's HERO shot even when the gallery's first image is a lifestyle photo (owner 2026-09-22 wanted the gloves shots first in the reels) {%- endcomment -%}
        {%- assign pgh_img = bp.featured_image -%}
        {%- assign pgh_alt = '' -%}
        {%- if bp.handle == 'pocket-era-r36h' -%}{%- assign pgh_alt = 'Pocket Era R36H in Mystic Purple' -%}{%- elsif bp.handle contains 'pokemon-crystal-ball' -%}{%- assign pgh_file = images['hf_20260812_024500_a42b7718-faf6-4baa-a3b0-a644080b5296.png'] -%}{%- if pgh_file -%}{%- assign pgh_img = pgh_file -%}{%- endif -%}{%- endif -%}
        {%- if pgh_alt != '' -%}{%- assign pgh_hero = bp.images | where: 'alt', pgh_alt | first -%}{%- if pgh_hero -%}{%- assign pgh_img = pgh_hero -%}{%- endif -%}{%- endif -%}
        <img src="{{ pgh_img | image_url: width: 1200 }}" alt="{{ block.settings.label | default: bp.title | escape }}" loading="lazy">
              {%- if bp.compare_at_price > bp.price -%}
                {%- assign pgh_pct = bp.compare_at_price | minus: bp.price | times: 100 | divided_by: bp.compare_at_price -%}
                <span class="pgh-badge">Sale {{ pgh_pct }}% Off</span>
              {%- endif -%}
              {%- assign pgh_rv = bp.metafields.reviews.rating.value.rating | plus: 0 -%}
              {%- assign pgh_rn = bp.metafields.reviews.rating_count.value | plus: 0 -%}
              {%- if pgh_rv > 0 and pgh_rn > 0 -%}
                {%- assign pgh_rw = pgh_rv | times: 20 -%}
                <div class="pgh-card-r" role="img" aria-label="Rated {{ pgh_rv | round: 1 }} out of 5 from {{ pgh_rn }} reviews">
                  <span class="pgh-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;<span class="pgh-stars-on" style="width:{{ pgh_rw }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</span></span>
                  <b aria-hidden="true">{{ pgh_rv | round: 1 }}</b><span class="pgh-card-rn" aria-hidden="true">({{ pgh_rn }})</span>
                </div>
              {%- else -%}
                <div class="pgh-card-r pgh-card-new">New arrival</div>
              {%- endif -%}
              <button type="button" class="pgh-atc" data-variant="{{ bp.selected_or_first_available_variant.id }}">Add to Cart</button>
            </div>
            <div class="pgh-card-t">{{ block.settings.label | default: bp.title }}</div>
            <div class="pgh-card-p">
              {%- if bp.compare_at_price > bp.price -%}<s>{{ bp.compare_at_price | money }}</s>{%- endif -%}
              {{ bp.price | money }}
            </div>
          </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>

  <div class="pgh-wrap">
    <div class="pgh-eyebrow">{{ section.settings.tiles_eyebrow }}</div>
    <h2 class="pgh-h2">{{ section.settings.tiles_title }}</h2>
    <div class="pgh-tiles">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' -%}
          {%- assign bp = block.settings.product -%}
          {%- if bp != blank -%}
          <a class="pgh-tile" href="{{ bp.url }}">
            {%- assign tile_img = block.settings.tile_image | default: bp.featured_image -%}
            <img src="{{ tile_img | image_url: width: 1000 }}" alt="{{ block.settings.label | default: bp.title | escape }}" loading="lazy">
            <span>{{ block.settings.label | default: bp.title }}</span>
          </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="pgh-trust">
    <div>
      {%- comment -%}
        Box van rather than a plain rectangle: cargo body with panel lines, a
        cab with a glazed window, wheels with hubs, and speed lines behind it.
        Drawn on a 48-unit grid so the details survive at 78px.
      {%- endcomment -%}
      <span class="pgh-tic"><svg viewBox="0 0 24 24" role="img" aria-label="Free shipping"><path d="M2.5 7.5h11.5v9H2.5z" fill="rgba(255,255,255,.16)"/><path d="M14 10.5h3.6a1 1 0 0 1 .8.4l2.6 3.3v2.3H14z" fill="rgba(255,255,255,.16)"/><circle cx="6.8" cy="17.6" r="1.8" fill="#fff" stroke="none"/><circle cx="17" cy="17.6" r="1.8" fill="#fff" stroke="none"/><path d="M5.5 10.6h5.5M5.5 13.2h3.5"/></svg></span>
      <b>Free Shipping</b>
      <span>Free tracked shipping on every order</span>
    </div>
    <div>
      {%- comment -%}
        Shield with an inner face so it reads as a crest rather than a blob,
        a heavier tick, and two small sparks for the "money back" idea.
      {%- endcomment -%}
      <span class="pgh-tic"><svg viewBox="0 0 24 24" role="img" aria-label="30-day guarantee"><path d="M12 3l7 2.6v5.6c0 4.6-3 8.2-7 9.8-4-1.6-7-5.2-7-9.8V5.6z" fill="rgba(255,255,255,.16)"/><path d="M8.6 12.2l2.3 2.3 4.6-4.8"/></svg></span>
      <b>30-Day Guarantee</b>
      <span>Money back, no hassle</span>
    </div>
    <div>
      {%- comment -%}
        Padlock with a real keyhole and shank, a highlight along the shackle,
        and two body rivets -- the old one was an empty rounded rectangle.
      {%- endcomment -%}
      <span class="pgh-tic"><svg viewBox="0 0 24 24" role="img" aria-label="Secure checkout"><rect x="5" y="10.5" width="14" height="10" rx="2.4" fill="rgba(255,255,255,.16)"/><path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7"/><circle cx="12" cy="15" r="1.4" fill="#fff" stroke="none"/><path d="M12 16.2v1.8"/></svg></span>
      <b>Secure Checkout</b>
      <span>SSL encrypted payment</span>
    </div>
  </div>

  <div class="pgh-wrap" style="padding-top:0">
    <div class="pgh-split">
      <div class="pgh-split-l">
        <h2>{{ section.settings.split_title }}</h2>
        <div>
          <div class="l1">{{ section.settings.split_line1 }}</div>
          <div class="l2">{{ section.settings.split_line2 }}</div>
        </div>
        <a class="pgh-split-btn" href="{{ section.settings.shop_url }}">{{ section.settings.split_cta }}</a>
      </div>
      <div class="pgh-split-r">
        {%- if section.settings.split_image -%}
          <img src="{{ section.settings.split_image | image_url: width: 1400 }}" alt="{{ section.settings.split_title | escape }}" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="pgh-acc">
    {%- for block in section.blocks -%}
      {%- if block.type == 'accordion' -%}
      <details {{ block.shopify_attributes }}>
        <summary>{{ block.settings.title }}</summary>
        <div class="pgh-acc-body">{{ block.settings.text }}</div>
      </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<script>
(function(){
  if (window.pghAtc) return; window.pghAtc = 1;
  /* Inline-important pill styling: the theme's global button CSS keeps
     winning the cascade, so the Sale-badge look is stamped per element. */
  /* THE PRODUCT TILES' BUTTON, RESTATED. pg-r36s-mobile's .pg-r36-atc (and
     the orb page's .pg-tt-atc): 15px/12px padding, 10px corners, the arrow,
     the same five-stop moving purple at the same 8s. "Add to cart on the
     homepage for each item should have that same dynamic add to cart
     button", by request (2026-09-11); this was a slimmer 13.5px pill. THE
     TYPE IS THE CARD TITLES' (Poppins, sentence case, no tracking, 600):
     the tiles' uppercase 800 with .06em tracking read as a different font
     beside the titles ("that font doesn't match our theme font, like the
     product titles"), so the button keeps the tiles' fill and shape and the
     page's own type. */
  var BASE = {'position': 'static', 'left': 'auto', 'right': 'auto', 'top': 'auto', 'bottom': 'auto', 'transform': 'none', 'display': 'flex', 'align-items': 'center', 'justify-content': 'center', 'gap': '8px', 'width': 'calc(100% - 24px)', 'margin': '10px 12px 14px', 'padding': '15px 12px', 'border': 'none', 'border-radius': '10px', 'background-color': '#7A2FA2', 'background-image': 'linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 30%,#4A1C66 50%,#7A2FA2 70%,#9B4BC4 100%)', 'background-size': '240% 240%', 'color': '#fff', 'font-weight': '600', 'font-size': '15.5px', 'letter-spacing': '0', 'text-transform': 'none', 'line-height': '1.2', 'height': 'auto', 'min-height': '0', 'text-align': 'center', 'box-shadow': '0 14px 30px -12px rgba(139,68,190,.75)', 'animation': 'pgShiftT 8s ease-in-out infinite', 'filter': 'none', 'transition': 'filter .15s ease', 'font-family': "'Poppins','Segoe UI',Helvetica,Arial,sans-serif"};
  function paint(b, hov){
    for (var k in BASE) b.style.setProperty(k, BASE[k], 'important');
    /* hover brightens, as on the tiles; it no longer swaps in a still dark
       fill (which also stuck after a tap on phones, where mouseleave never
       comes) */
    if (hov) b.style.setProperty('filter', 'brightness(1.1)', 'important');
  }
  function styleAtc(){
    document.querySelectorAll('.pgh-atc').forEach(function(b){
      /* our own flag: pg-theme-css's cardAtc() used to set data-pgStyled
         first (it runs before DOMContentLoaded) and this pass then skipped
         every button, so the home page kept the old pill (2026-09-11) */
      if (b.dataset.pgHomeAtc) return;
      b.dataset.pgHomeAtc = '1';
      var card = b.closest('.pgh-card');
      if (card && b.parentElement !== card) card.appendChild(b);
      if (!b.querySelector('.pgh-arr')) b.insertAdjacentHTML('beforeend', '<span class="pgh-arr" aria-hidden="true">\u2192</span>');
      paint(b, false);
      b.addEventListener('mouseenter', function(){ paint(b, true); });
      b.addEventListener('mouseleave', function(){ paint(b, false); });
    });
  }
  if (document.readyState !== 'loading') styleAtc(); else document.addEventListener('DOMContentLoaded', styleAtc);
  setTimeout(styleAtc, 600);
  setInterval(styleAtc, 2000);   /* a later script rebuilding the cards gets the same button */
  document.addEventListener('click', function(e){
    var b = e.target.closest('.pgh-atc');
    if (!b) return;
    e.preventDefault(); e.stopPropagation();
    if (b.disabled) return;
    b.disabled = true;
    var t = b.innerHTML;   /* label + arrow span */
    b.textContent = 'Adding...';
    fetch('/cart/add.js', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({items: [{id: parseInt(b.dataset.variant, 10), quantity: 1}]})}).then(function(r){
      if (!r.ok) throw 0;
      b.disabled = false; b.innerHTML = t;
      if (window.pgOpenCart) { window.pgOpenCart(); } else { window.location.href = '/cart'; }
    }).catch(function(){
      b.disabled = false;
      b.innerHTML = t;
    });
  }, true);
})();

(function(){
  if (window.pghAccIcons) return; window.pghAccIcons = 1;
  /* an emoji leads each accordion title, keyed on its words (2026-09-18, "make
     those 4 dropdowns nicer looking"), the way the product page's read */
  var MAP = [[/about/i, '\uD83C\uDFAE'], [/deliver|ship/i, '\uD83D\uDE9A'], [/review/i, '\u2B50'], [/service|support|contact|help/i, '\uD83D\uDCAC']];
  function icons(){
    document.querySelectorAll('#pgh .pgh-acc summary').forEach(function(s){
      if (s.querySelector('.pgh-acc-ic')) return;
      var t = s.textContent || '', ic = '\uD83D\uDCE6';
      for (var i = 0; i < MAP.length; i++){ if (MAP[i][0].test(t)){ ic = MAP[i][1]; break; } }
      var sp = document.createElement('span'); sp.className = 'pgh-acc-ic'; sp.setAttribute('aria-hidden', 'true'); sp.textContent = ic;
      s.insertBefore(sp, s.firstChild);
    });
  }
  if (document.readyState !== 'loading') icons(); else document.addEventListener('DOMContentLoaded', icons);
  setTimeout(icons, 800);
})();
</script>

{% schema %}
{
  "name": "PG Home",
  "settings": [
    {"type": "image_picker", "id": "logo_image", "label": "Logo image"},
    {"type": "text", "id": "logo_text", "label": "Logo text (used when no image)", "default": "PocketEra"},
    {"type": "text", "id": "announce_text", "label": "Announcement text", "default": "Free shipping on all orders"},
    {"type": "url", "id": "shop_url", "label": "Shop link (nav, buttons)"},
    {"type": "image_picker", "id": "hero_image", "label": "Hero image"},
    {"type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "Retro Gaming, Reimagined"},
    {"type": "text", "id": "hero_title", "label": "Hero title", "default": "Special Offers on New Arrivals"},
    {"type": "text", "id": "hero_cta", "label": "Hero button text", "default": "Shop Now"},
    {"type": "url", "id": "hero_url", "label": "Hero button link"},
    {"type": "text", "id": "grid_eyebrow", "label": "Product grid eyebrow", "default": "Most Loved"},
    {"type": "text", "id": "grid_title", "label": "Product grid title", "default": "Best Sellers"},
    {"type": "text", "id": "split_title", "label": "Banner title", "default": "Built for real gamers."},
    {"type": "text", "id": "split_line1", "label": "Banner line 1", "default": "Your favourite classics. Now in your pocket."},
    {"type": "text", "id": "split_line2", "label": "Banner line 2", "default": "15,000+ retro games, ready to play anywhere."},
    {"type": "text", "id": "split_cta", "label": "Banner button text", "default": "Shop now"},
    {"type": "image_picker", "id": "split_image", "label": "Banner image"},
    {"type": "text", "id": "tiles_eyebrow", "label": "Tiles eyebrow", "default": "Explore"},
    {"type": "text", "id": "tiles_title", "label": "Tiles title", "default": "Collections"}
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {"type": "product", "id": "product", "label": "Product"},
        {"type": "text", "id": "label", "label": "Display name"},
        {"type": "image_picker", "id": "tile_image", "label": "Tile image (optional)"}
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {"type": "text", "id": "title", "label": "Title", "default": "About Us"},
        {"type": "richtext", "id": "text", "label": "Content", "default": "<p>Content</p>"}
      ]
    }
  ],
  "presets": [{"name": "PG Home"}]
}
{% endschema %}
