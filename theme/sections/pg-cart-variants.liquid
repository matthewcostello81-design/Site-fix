{%- comment -%}
  PG Cart Variants: make every multi-variant cart line switchable.

  TWO JOBS.

  (A) Style and unblock the console picker that pg-drawer already builds.

  pg-drawer's vsel() builds a real <select> of every handheld-game-console
  variant on the cart line and, on change, zeroes the old variant and adds the
  new one at the same quantity. Two things stopped it working as a control:

  1. No dropdown affordance. vsel() stamps its look as INLINE `!important`
     styles (height:26px, max-width:96px, border:1px solid #ddd, no chevron), and
     an inline !important declaration outranks every stylesheet rule -- the same
     trap as the cart pills. So the look has to be re-stamped on the element,
     not written in CSS.

  2. Clicking it navigated to the product page. pg-drawer parks the select
     inside `section > p`, and its own rule sets

       #cart .l4ca > li section > p:not(.pg-varp){pointer-events:none}

     with `.pg-varp` re-enabling the one holding the select. Whenever that class
     is missing -- the drawer re-renders its innerHTML on every cart change, and
     the class only gets applied on the pass that CREATES the select -- the click
     falls straight through the select to the line's product link underneath.

  (B) Build the same picker for lines pg-drawer skips.

  vsel() is hard-coded to the console handle, so a Crystal PokeOrb line just
  printed its variant as text ("13 Arceus") with no way to change it. Any line
  whose product has more than one variant now gets a picker built here, in the
  same place and the same style, so the two are indistinguishable to a shopper.

  Lines are matched to cart items BY THE VARIANT NAME PRINTED ON THE LINE, and
  never by position.

  Position is what this used to do -- the Nth rendered line for a handle is the
  Nth cart item for it -- and it is wrong the moment anything reorders the rows.
  pg-chips' liftFree() does exactly that: it moves every free row above the
  first paid one. So after an upsell that hands over free units, the rendered
  order stops matching cart.items, each line is handed its neighbour's item,
  titleP() cannot find a <p> holding THAT item's variant title, and build()
  returns without a picker -- the design goes back to being plain text on every
  affected line. That is the "list of variants is no longer interactive" bug.

  Matching on the printed name fixes it because it is the same evidence build()
  already needs: a line can only get a picker if its variant title is on screen
  to be replaced. Quantity breaks ties when one product holds two lines of the
  SAME variant (a free one and a paid one), and a claimed item is marked used so
  two lines can never both take it.

  The swap posts quantity 0 for the old line key, then adds the chosen variant
  at the same quantity, then hands off to pg-drawer's refresh. Line properties
  are carried over so a free-gift line cannot lose its marker, and single-variant
  products are skipped entirely.
{%- endcomment -%}
<script>
(function(){
  if (window.pgCartVars) return; window.pgCartVars = 1;

  var CHEVRON = "data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='11' height='7' viewBox='0 0 11 7'%3E%3Cpath d='M1 1l4.5 4.5L10 1' fill='none' stroke='%237A2FA2' stroke-width='1.8' stroke-linecap='round'/%3E%3C/svg%3E";

  var STYLE = {
    '-webkit-appearance': 'none',
    '-moz-appearance': 'none',
    'appearance': 'none',
    'position': 'relative',
    'z-index': '6',
    'pointer-events': 'auto',
    'height': '32px',
    'min-height': '32px',
    'width': 'auto',
    'max-width': '100%',
    'padding': '2px 28px 2px 11px',
    'font-size': '13.5px',
    'font-weight': '700',
    'color': '#4A1C66',
    'background-color': '#fff',
    'background-image': 'url("' + CHEVRON + '")',
    'background-repeat': 'no-repeat',
    'background-position': 'right 9px center',
    'border': '1.5px solid rgba(122,47,162,.45)',
    'border-radius': '9px',
    'cursor': 'pointer',
    'box-shadow': '0 2px 8px -4px rgba(74,28,102,.4)'
  };

  function arm(sel){
    if (sel.dataset.pgVar) return;
    sel.dataset.pgVar = '1';

    for (var k in STYLE) sel.style.setProperty(k, STYLE[k], 'important');

    /* the paragraph pg-drawer parks it in must be the clickable one */
    var host = sel.parentElement;
    if (host && host.tagName === 'P'){
      host.classList.add('pg-varp');
      host.style.setProperty('pointer-events', 'auto', 'important');
      host.style.setProperty('position', 'relative', 'important');
      host.style.setProperty('z-index', '6', 'important');
    }

    /* never let the line's product link claim the click */
    ['click', 'mousedown', 'touchstart', 'pointerdown'].forEach(function(ev){
      sel.addEventListener(ev, function(e){ e.stopPropagation(); }, true);
    });
    /* a click that still reached an ancestor anchor would navigate */
    sel.addEventListener('click', function(e){ e.stopPropagation(); });
  }

  /* ---------- picker for the lines pg-drawer leaves as plain text ---------- */

  var PROD = {};      /* handle -> variants, or null while in flight */
  var busy = false;

  /* Products whose variants are an ENTITLEMENT axis, not a style axis.

     The R36S case carries "Free with console" at $0.00 and "Spare case" at
     $13.99. Both are availableForSale and untracked, so nothing in the generic
     build() drops either, and the picker happily offered a shopper holding the
     paid spare a dropdown that swaps it to the free one -- a free case with no
     console, no badge and no error. It bites the other way too: a console
     buyer's earned gift could be switched to "Spare case" and silently charged
     $13.99 for what was advertised as free.

     pg-no-promo intercepts the rail's Add button precisely so that $0.00
     variant is never handed out, and pg-giftguard strips it when unearned;
     this picker was quietly re-opening that door. */
  var NO_PICKER = {'r36s-protective-case-free-gift': 1};

  function variantsFor(handle){
    if (PROD.hasOwnProperty(handle)) return PROD[handle];
    PROD[handle] = null;
    fetch('/products/' + handle + '.js')
      .then(function(r){ return r.json(); })
      .then(function(p){ PROD[handle] = (p && p.variants) || []; })
      .catch(function(){ PROD[handle] = []; });
    return null;
  }

  function handleOf(li){
    var a = li.querySelector('a[href*="/products/"]');
    if (!a) return null;
    var m = (a.getAttribute('href') || '').match(/\/products\/([^/?#]+)/);
    return m ? m[1] : null;
  }

  /* the <p> printing the variant name, which the select replaces */
  /* WHITESPACE-INSENSITIVE, OR THE PICKER NEVER COMES BACK.

     This compared the paragraph's text to the variant title character for
     character. The drawer renders that paragraph across several lines, so its
     textContent is "Transparent Purple\n    / 64G" while the cart item says
     "Transparent Purple / 64G" -- equal to a reader, never equal to ===.

     It went unnoticed while pg-drawer's own vsel() was building the console
     picker. After a size swap the drawer re-renders the row from scratch and
     vsel does not always re-reach it, and this was the fallback that should
     have caught it -- instead the match failed, build() returned, and the row
     was left with no size dropdown at all until a full page reload. Collapsing
     runs of whitespace on both sides makes the fallback actually work. */
  function titleP(li, title){
    if (!title) return null;
    var want = String(title).replace(/\s+/g, ' ').trim();
    var ps = li.querySelectorAll('section p, p');
    for (var i = 0; i < ps.length; i++){
      var t = (ps[i].textContent || '').replace(/\s+/g, ' ').replace(/\s*\/\s*$/, '').trim();
      if (t === want) return ps[i];
    }
    return null;
  }

  /* PACK LABELS SHORT ENOUGH TO NEVER CLIP. A closed <select> truncates its
     text silently: "128GB + 128GB + 128GB" needs ~194px at this font and the
     column is 190px on desktop and less on a phone, so the third size was
     being cut off. "GB" is kept on the last size only: "128 + 128 + 128GB". */
  function compactLabel(t){
    return /\+/.test(t) ? t.replace(/GB(?=\s*\+)/g, '') : t;
  }

  /* A SWAPPED ROW STAYS WHERE IT WAS. The swap is remove-then-add, so the new
     line is the newest, and Shopify lists newest first: the row a shopper just
     changed the size on jumped to the top of the drawer. The visual sequence
     is remembered at swap time (the swapped row by handle, so it survives its
     variant change; the free gift left out, it is pinned first by rule) and
     re-stamped as flex order after every rebuild for as long as the cart holds
     the same set of lines. Add or remove anything and the memo is dropped. */
  var GIFT_V = '49640846426340';
  var PACKISH = {'r36s-duo-pack': 1, 'r36s-trio-pack': 1, 'handheld-game-console': 1};
  var MEMO = null;
  function rowsVisual(){
    return Array.prototype.slice.call(document.querySelectorAll('#cart .l4ca:not(.in-panel) > li, body.template-cart .form-cart .l4ca:not(.in-panel) > li'))
      .sort(function(a, b){ return a.getBoundingClientRect().top - b.getBoundingClientRect().top; });
  }
  function identity(li){
    var a = li.querySelector('a[href*="/products/"]');
    var h = a ? (a.getAttribute('href') || '') : '';
    var handle = (h.match(/\/products\/([^/?#]+)/) || [])[1] || '';
    var v = (h.split('variant=')[1] || '').split('&')[0];
    if (!handle) return null;
    if (v === GIFT_V) return null;                       /* pinned by rule, never stamped */
    return PACKISH[handle] ? handle : handle + ':' + v;
  }
  function remember(){
    MEMO = rowsVisual().map(identity).filter(Boolean);
  }
  function restore(){
    if (!MEMO) return;
    var lis = rowsVisual(), ids = lis.map(identity);
    var have = ids.filter(Boolean).slice().sort().join('|'), want = MEMO.slice().sort().join('|');
    if (have !== want){ MEMO = null; return; }       /* the cart changed: natural order again */
    lis.forEach(function(li, i){
      var id = ids[i]; if (!id) return;
      var n = String(MEMO.indexOf(id) + 1);
      if (li.style.order !== n) li.style.setProperty('order', n, 'important');
    });
  }

  function swap(oldKey, newId, qty, props){
    if (busy) return;
    busy = true;
    remember();
    var body = {id: oldKey, quantity: 0};
    fetch('/cart/change.js', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(body)
    }).then(function(r){
      if (!r || !r.ok) throw new Error('change ' + (r && r.status));
      var line = {id: newId, quantity: qty};
      if (props && Object.keys(props).length) line.properties = props;
      return fetch('/cart/add.js', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({items: [line]})
      });
    }).then(function(r){
      if (!r || !r.ok) throw new Error('add ' + (r && r.status));
      busy = false;
      if (window.pgDrawerRefresh) return window.pgDrawerRefresh();
      window.location.reload();
    }).catch(function(){
      busy = false;
      window.location.reload();
    });
  }

  function build(li, item, variants){
    var p = titleP(li, item.variant_title);
    if (!p || p.querySelector('select')) return;

    var sel = document.createElement('select');
    sel.className = 'pg-vsel';
    variants.forEach(function(v){
      if (v.available === false && v.id !== item.variant_id) return;
      var o = document.createElement('option');
      o.value = v.id;
      /* the size alone, the way pg-drawer's own picker labels it -- a rebuilt
         picker was reading "Transparent Purple / 128G" where the original read
         "128G", so a swap visibly changed the control's wording */
      o.textContent = compactLabel(v.title.indexOf('/') > -1 ? v.title.split('/').pop().trim() : v.title);
      if (v.id === item.variant_id) o.selected = true;
      sel.appendChild(o);
    });
    /* BEST VALUE, FROM THE PRICES, like the product page's Size picker and
       pg-drawer's own console picker: the variant whose cut against its
       compare-at is the deepest (whole percents); a tie marks nothing */
    (function(){
      var bestId = null, bp = 0, tie = false;
      variants.forEach(function(v){
        var cap = parseFloat(v.compare_at_price || 0), pr = parseFloat(v.price || 0);
        var p = cap > pr ? Math.floor((cap - pr) / cap * 100) : 0;
        if (p > bp){ bestId = v.id; bp = p; tie = false; }
        else if (p === bp && bp > 0 && v.id !== bestId) tie = true;
      });
      if (bestId !== null && !tie){
        var bo = sel.querySelector('option[value="' + bestId + '"]');
        if (bo && bo.textContent.indexOf('(Best Value)') === -1) bo.textContent += ' (Best Value)';
      }
    })();
    if (sel.options.length < 2) return;

    sel.addEventListener('change', function(){
      var id = parseInt(sel.value, 10);
      if (!id || id === item.variant_id) return;
      sel.disabled = true;
      swap(item.key, id, item.quantity, item.properties);
    });

    p.textContent = '';
    p.appendChild(sel);
    arm(sel);
  }

  /* A real cart line, not a recommendation row and not the panel's duplicate
     copy of the items. `.l4ca.in-panel` is that duplicate -- every other
     section here excludes it, and matching it put a stray picker in the middle
     of the rail. The quantity stepper is the positive test: only a real line
     has one. */
  function isCartLine(li){
    if (li.closest('.nc-recs, .nc-recs-panel, .pg-unlock')) return false;
    return !!li.querySelector('.semantic-amount input, .input-amount input');
  }

  function qtyOf(li){
    var i = li.querySelector('.semantic-amount input, .input-amount input, input[type=number]');
    return i ? (parseInt(i.value, 10) || 0) : 0;
  }

  /* The cart item this line is actually showing, found by the variant name the
     line prints rather than by where the line sits. `used` stops two lines
     claiming one item, and quantity settles the case where a product holds two
     lines of the same variant -- one free, one paid. */
  function itemForLine(li, hits, used){
    var q = qtyOf(li), fallback = null, i, it;
    for (i = 0; i < hits.length; i++){
      it = hits[i];
      if (used[it.key]) continue;
      if (!titleP(li, it.variant_title)) continue;
      if (it.quantity === q) return it;
      if (!fallback) fallback = it;
    }
    return fallback;
  }

  function grow(){
    var all = document.querySelectorAll(
      '#cart .l4ca:not(.in-panel) > li, body.template-cart .form-cart .l4ca:not(.in-panel) > li');
    var lines = Array.prototype.filter.call(all, isCartLine);
    if (!lines.length) return;

    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      var used = {};
      Array.prototype.forEach.call(lines, function(li){
        if (li.querySelector('.pg-vsel')) return;
        var handle = handleOf(li);
        if (!handle || NO_PICKER[handle]) return;

        var hits = (cart.items || []).filter(function(it){ return it.handle === handle; });
        if (!hits.length) return;

        var item = itemForLine(li, hits, used);
        if (!item) return;                     /* nothing on this line names an item */
        used[item.key] = 1;

        var vs = variantsFor(handle);
        if (!vs || vs.length < 2) return;      /* still loading, or nothing to pick */
        build(li, item, vs);
      });
    }).catch(function(){});
  }

  function pass(){
    try { restore(); } catch(e){}
    document.querySelectorAll('#cart .l4ca:not(.in-panel) .pg-vsel, body.template-cart .form-cart .pg-vsel').forEach(arm);
    grow();
  }

  /* the drawer replaces its innerHTML on every cart change, so the selects are
     new elements each time and have to be re-armed and rebuilt */
  setInterval(pass, 400);

  /* AND IMMEDIATELY, NOT ON THE NEXT TICK.

     A size swap rewrites the whole line list, and waiting up to 400ms for the
     next interval is exactly the window where the row sits there with no size
     picker -- the stutter you see after changing a size in the cart. This
     rebuilds on the mutation itself.

     Coalesced to one pass per frame, and floored at 150ms, because grow()
     reads /cart.js and this endpoint is shared with five other sections that
     already throttle it under load. arm() is DOM-only and safe to run on every
     burst, so the styling never lags even when a rebuild is deferred. */
  /* pg-drawer fires this in the same task as its innerHTML swap, so the size
     pickers are rebuilt in the same paint as the rows rather than up to a
     frame later -- the observer below stays for cart writes that do not come
     through the drawer. */
  document.addEventListener('pg:cart-updated', function(){ try { pass(); restore(); } catch(e){} });

  (function watchCart(){
    var c = document.getElementById('cart');
    if (!c || !window.MutationObserver){ setTimeout(watchCart, 500); return; }
    var queued = false, last = 0;
    /* NOT requestAnimationFrame WHILE THE TAB IS HIDDEN. Chrome never fires
       rAF in a background tab, so a rebuild queued here while the shopper was
       on another tab stayed queued until they came back AND something else
       happened -- measured: a Trio Pack row whose picker vanished after a
       drawer rewrite and only returned when pg:cart-updated was fired by
       hand. A zero-delay timeout runs (throttled, but it runs) when hidden;
       rAF stays for the visible case so the rebuild lands in the same paint. */
    var soon = function(fn){
      if (document.hidden || !window.requestAnimationFrame) return setTimeout(fn, 0);
      requestAnimationFrame(fn);
    };
    new MutationObserver(function(){
      if (queued) return;
      queued = true;
      soon(function(){
        queued = false;
        document.querySelectorAll('#cart .l4ca:not(.in-panel) .pg-vsel').forEach(arm);
        var now = Date.now();
        if (now - last < 150) return;
        last = now;
        pass();
      });
    }).observe(c, {childList: true, subtree: true});
  })();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', pass); else pass();
})();
</script>
{% schema %}
{"name": "PG Cart Variants", "settings": []}
{% endschema %}
