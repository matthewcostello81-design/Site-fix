{%- comment -%}
  PG Cart Variants: make the console's storage picker in the cart usable.

  pg-drawer's vsel() builds a real <select> of every handheld-game-console
  variant on the cart line and, on change, zeroes the old variant and adds the
  new one at the same quantity. Two things stopped it working as a control:

  1. No dropdown affordance. vsel() stamps its look as INLINE `!important`
     styles (height:26px, max-width:96px, border:1px solid #ddd, no chevron), and
     an inline !important declaration outranks every stylesheet rule -- the same
     trap as the cart pills. So the look has to be re-stamped on the element,
     not written in CSS.

  2. Clicking it navigated to the product page. pg-drawer parks the select
     inside `section > p`, and its own rule sets

       #cart .l4ca > li section > p:not(.pg-varp){pointer-events:none}

     with `.pg-varp` re-enabling the one holding the select. Whenever that class
     is missing -- the drawer re-renders its innerHTML on every cart change, and
     the class only gets applied on the pass that CREATES the select -- the click
     falls straight through the select to the line's product link underneath.

  This re-stamps the styling, guarantees the host paragraph is marked and
  clickable, lifts the select onto its own stacking context, and stops click and
  mousedown propagating so the surrounding link can never claim the event.
  mousedown is only stopped, never prevented: preventing it would keep the
  dropdown from opening at all.

  The swap itself is untouched -- it is still pg-drawer's change handler.
{%- endcomment -%}
<script>
(function(){
  if (window.pgCartVars) return; window.pgCartVars = 1;

  var CHEVRON = "data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='11' height='7' viewBox='0 0 11 7'%3E%3Cpath d='M1 1l4.5 4.5L10 1' fill='none' stroke='%237A2FA2' stroke-width='1.8' stroke-linecap='round'/%3E%3C/svg%3E";

  var STYLE = {
    '-webkit-appearance': 'none',
    '-moz-appearance': 'none',
    'appearance': 'none',
    'position': 'relative',
    'z-index': '6',
    'pointer-events': 'auto',
    'height': '32px',
    'min-height': '32px',
    'width': 'auto',
    'max-width': '140px',
    'padding': '2px 28px 2px 11px',
    'font-size': '13.5px',
    'font-weight': '700',
    'color': '#4A1C66',
    'background-color': '#fff',
    'background-image': 'url("' + CHEVRON + '")',
    'background-repeat': 'no-repeat',
    'background-position': 'right 9px center',
    'border': '1.5px solid rgba(122,47,162,.45)',
    'border-radius': '9px',
    'cursor': 'pointer',
    'box-shadow': '0 2px 8px -4px rgba(74,28,102,.4)'
  };

  function arm(sel){
    if (sel.dataset.pgVar) return;
    sel.dataset.pgVar = '1';

    for (var k in STYLE) sel.style.setProperty(k, STYLE[k], 'important');

    /* the paragraph pg-drawer parks it in must be the clickable one */
    var host = sel.parentElement;
    if (host && host.tagName === 'P'){
      host.classList.add('pg-varp');
      host.style.setProperty('pointer-events', 'auto', 'important');
      host.style.setProperty('position', 'relative', 'important');
      host.style.setProperty('z-index', '6', 'important');
    }

    /* never let the line's product link claim the click */
    ['click', 'mousedown', 'touchstart', 'pointerdown'].forEach(function(ev){
      sel.addEventListener(ev, function(e){ e.stopPropagation(); }, true);
    });
    /* a click that still reached an ancestor anchor would navigate */
    sel.addEventListener('click', function(e){ e.stopPropagation(); });
  }

  function pass(){
    document.querySelectorAll('#cart .l4ca .pg-vsel, body.template-cart .form-cart .pg-vsel').forEach(arm);
  }

  /* the drawer replaces its innerHTML on every cart change, so the selects are
     new elements each time and have to be re-armed */
  setInterval(pass, 400);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', pass); else pass();
})();
</script>
{% schema %}
{"name": "PG Cart Variants", "settings": []}
{% endschema %}
