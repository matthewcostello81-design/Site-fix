{%- comment -%}
  PG Cart Header: Pocketera header for the cart page. Hides the native theme
  header/announcement on this template and renders the purple announcement bar,
  centered logo and icons, plus purple/black accent overrides for the native cart.
{%- endcomment -%}
<style>
  .shopify-section-header,
  #shopify-section-header,
  .shopify-section[id*="__header"],
  .shopify-section[id*="nc_announce"],
  .shopify-section[id*="nc-announce"],
  .shopify-section[id*="newsletter-popup"]{display:none !important}
  #content{padding-top:0 !important}

  .pgc-announce{background:#7A2FA2;color:#fff;text-align:center;font-size:13.5px;letter-spacing:.02em;padding:10px 16px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif}
  .pgc-head{background:#fff;border-bottom:1px solid #e9dcf3;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif}
  .pgc-head-in{max-width:1280px;margin:0 auto;padding:14px 24px 8px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}
  .pgc-head svg{width:22px;height:22px;stroke:#121212;fill:none;stroke-width:1.6}
  .pgc-logo{justify-self:center}
  .pgc-logo img{max-height:100px;width:auto;display:block}
  .pgc-ic{display:flex;gap:18px;justify-self:end;align-items:center}
  .pgc-nav{display:flex;justify-content:center;gap:30px;padding:10px 16px 14px;flex-wrap:wrap}
  .pgc-nav a{font-size:15px;color:#2b2b2b;text-decoration:none}
  .pgc-nav a:hover{text-decoration:underline;color:#7A2FA2}
  @media (max-width: 900px){
    .pgc-logo img{max-height:72px}
    .pgc-nav{gap:18px;padding-top:6px}
  }

  /* Purple and black accents for the native cart on this page */
  #content [id*="main-cart"] a:not([class*="button"]):not(.pgc-x){color:#7A2FA2}
  #content [id*="main-cart"] button[name="checkout"],
  #content [id*="main-cart"] .checkout-button,
  #content [id*="main-cart"] [class*="checkout"]{
    background:#121212 !important;background-color:#121212 !important;color:#fff !important;border-color:#121212 !important;
  }
  #content [id*="main-cart"] button[name="checkout"]:hover,
  #content [id*="main-cart"] .checkout-button:hover{
    background:#7A2FA2 !important;background-color:#7A2FA2 !important;
  }
  #content [id*="main-cart"] .old-price{color:#8a8a8a}
  #content [id*="breadcrumbs"] a{color:#7A2FA2}

  /* Premium cart page: white canvas, card items, black checkout */
  body.template-cart,
  body.template-cart #content,
  body.template-cart main{background:#faf9fc !important}
  body.template-cart .form-cart .l4ca > li{background:#fff !important;border:1px solid #e6dcf0 !important;border-radius:16px !important;box-shadow:0 16px 38px -30px rgba(74,28,102,.5) !important}
  body.template-cart button[name="checkout"],
  body.template-cart input[name="checkout"],
  body.template-cart .checkout-button,
  body.template-cart a[href*="/checkout"],
  body.template-cart [class*="checkout"] button{background:#121212 !important;background-image:none !important;background-color:#121212 !important;color:#fff !important;border:none !important;border-radius:10px !important;box-shadow:0 16px 34px -16px rgba(18,18,18,.5) !important;font-weight:700 !important;letter-spacing:.03em !important}
  body.template-cart button[name="checkout"]:hover,
  body.template-cart input[name="checkout"]:hover,
  body.template-cart a[href*="/checkout"]:hover,
  body.template-cart .checkout-button:hover{background:#7A2FA2 !important;background-color:#7A2FA2 !important}
  /* No express-checkout button walls or wallet banners */
  body.template-cart .shopify-payment-button,
  body.template-cart [data-shopify="dynamic-checkout-cart"],
  body.template-cart .additional-checkout-buttons,
  body.template-cart .dynamic-checkout__content,
  #cart .shopify-payment-button,
  #cart [data-shopify="dynamic-checkout-cart"],
  #cart .additional-checkout-buttons{display:none !important}
  body.template-cart ul.l4al li.overlay-lime,
  body.template-cart .l4al .overlay-lime{display:none !important}
  body.template-cart .l4tt li.strong{font-weight:700 !important;font-size:17px !important}
  body.template-cart .f8vl{border-radius:16px}
</style>

<div class="pgc-announce">{{ section.settings.announce_text }}</div>
<header class="pgc-head">
  <div class="pgc-head-in">
    <a class="pgc-x" href="{{ routes.search_url }}" aria-label="Search">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/></svg>
    </a>
    <a class="pgc-logo pgc-x" href="{{ routes.root_url }}" aria-label="Home">
      {%- if section.settings.logo_image -%}
        <img src="{{ section.settings.logo_image | image_url: width: 500 }}" alt="{{ shop.name }}">
      {%- else -%}
        <strong>Pocketera</strong>
      {%- endif -%}
    </a>
    <div class="pgc-ic">
      <a class="pgc-x" href="{{ routes.account_url }}" aria-label="Account">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
      </a>
      <a class="pgc-x" href="{{ routes.cart_url }}" aria-label="Cart">
        <svg viewBox="0 0 24 24"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
      </a>
    </div>
  </div>
  <nav class="pgc-nav">
    <a href="{{ routes.root_url }}">Home</a>
    <a href="/pages/track-order">Track your order</a>
    <a href="/pages/contact">Contact</a>
  </nav>
</header>

{% schema %}
{
  "name": "PG Cart Header",
  "settings": [
    {"type": "image_picker", "id": "logo_image", "label": "Logo image"},
    {"type": "text", "id": "announce_text", "label": "Announcement text", "default": "Free shipping on all orders"}
  ]
}
{% endschema %}
