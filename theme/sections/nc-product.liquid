lass="nc-bcard" {{ b.shopify_attributes }}><div class="nc-bicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg></div><h3>{{ b.settings.heading }}</h3><p>{{ b.settings.text }}</p></div>{%- endfor -%}</div>{%- endif -%}</div>{%- endif -%}
