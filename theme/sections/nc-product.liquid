  {%- if _cmp.size > 0 -%}<div class="nc-block" style="padding-top:0"><div class="nc2-head">{%- if section.settings.cmp_eye != blank -%}<div class="nc-eye">{{ section.settings.cmp_eye }}</div>{%- endif -%}{%- if section.settings.cmp_head != blank -%}<h2 class="nc-h2">{{ section.settings.cmp_head }}</h2>{%- endif -%}{%- if section.settings.cmp_sub != blank -%}<p class="nc-lede">{{ section.settings.cmp_sub }}</p>{%- endif -%}</div><div class="nc2-cmp"><div class="nc2-cmp-row nc2-cmp-head"><div></div><div class="nc2-cmp-ours">{{ section.settings.cmp_ours | default: 'North Cove' }}</div><div class="nc2-cmp-theirs">{{ section.settings.cmp_theirs | default: 'Others' }}</div></div>{%- for b in _cmp -%}<div class="nc2-cmp-row" {{ b.shopify_attributes }}><div class="nc2-cmp-l">{{ b.settings.label }}</div><div class="nc2-cmp-o">{%- if b.settings.ours == 'yes' -%}<span class="nc2-yes">&#10003;</span>{%- elsif b.settings.ours == 'no' -%}<span class="nc2-no">&#10007;</span>{%- else -%}{{ b.settings.ours }}{%- endif -%}</div><div class="nc2-cmp-t">{%- if b.settings.theirs == 'yes' -%}<span class="nc2-yes">&#10003;</span>{%- elsif b.settings.theirs == 'no' -%}<span class="nc2-no">&#10007;</span>{%- else -%}{{ b.settings.theirs }}{%- endif -%}</div></div>{%- endfor -%}</div></div>{%- endif -%}
  {%- if _ba.size > 0 -%}<div class="nc-block" style="padding-top:0"><div class="nc2-head">{%- if section.settings.ba_eye != blank -%}<div class="nc-eye">{{ section.settings.ba_eye }}</div>{%- endif -%}{%- if section.settings.ba_head != blank -%}<h2 class="nc-h2">{{ section.settings.ba_head }}</h2>{%- endif -%}{%- if section.settings.ba_sub != blank -%}<p class="nc-lede">{{ section.settings.ba_sub }}</p>{%- endif -%}</div><div class="nc2-ba"><div class="nc2-ba-col nc2-ba-before nc2-rv"><div class="nc2-ba-h">{{ section.settings.ba_before_label | default: 'Before' }}</div><div class="nc2-ba-media">{%- if section.settings.ba_before_image_url != blank -%}<img src="{{ section.settings.ba_before_image_url }}" alt="Before" loading="lazy">{%- else -%}<div class="nc2-imgslot dark"><span>Before image</span></div>{%- endif -%}</div><ul>{%- for b in _ba -%}{%- if b.settings.side == 'before' -%}<li>{{ b.settings.text }}</li>{%- endif -%}{%- endfor -%}</ul></div><div class="nc2-ba-col nc2-ba-after nc2-rv"><div class="nc2-ba-h">{{ section.settings.ba_after_label | default: 'After' }}</div><div class="nc2-ba-media">{%- if section.settings.ba_after_image_url != blank -%}<img src="{{ section.settings.ba_after_image_url }}" alt="After" loading="lazy">{%- else -%}<div class="nc2-imgslot"><span>After image</span></div>{%- endif -%}</div><ul>{%- for b in _ba -%}{%- if b.settings.side == 'after' -%}<li>{{ b.settings.text }}</li>{%- endif -%}{%- endfor -%}</ul></div></div></div>{%- endif -%}
  {%- if _tl.size > 0 -%}<div class="nc-block" style="padding-top:0"><div class="nc2-head">{%- if section.settings.tl_eye != blank -%}<div class="nc-eye">{{ section.settings.tl_eye }}</div>{%- endif -%}{%- if section.settings.tl_head != blank -%}<h2 class="nc-h2">{{ section.settings.tl_head }}</h2>{%- endif -%}{%- if section.settings.tl_sub != blank -%}<p class="nc-lede">{{ section.settings.tl_sub }}</p>{%- endif -%}</div><div class="nc2-tl"><div class="nc2-tl-axis"><span class="nc2-tl-axisfill" id="nctlfill"></span></div>{%- for b in _tl -%}<div class="nc2-tl-row" {{ b.shopify_attributes }}><div class="nc2-tl-trad"><span class="nc2-tl-tag muted">Without</span><h4>{{ b.settings.trad_title }}</h4><p>{{ b.settings.trad_text }}</p>{%- if b.settings.trad_tag != blank -%}<span class="nc2-chip">{{ b.settings.trad_tag }}</span>{%- endif -%}</div><div class="nc2-tl-node"><span class="nc2-tl-dot"></span><b>{{ b.settings.time }}</b><small>{{ b.settings.label }}</small></div><div class="nc2-tl-nc"><span class="nc2-tl-tag">With {{ section.settings.cmp_ours | default: 'North Cove' }}</span><h4>{{ b.settings.nc_title }}</h4><p>{{ b.settings.nc_text }}</p>{%- if b.settings.nc_tag != blank -%}<span class="nc2-chip ok">&#10003; {{ b.settings.nc_tag }}</span>{%- endif -%}</div></div>{%- endfor -%}</div></div>{%- endif -%}
  {%- if _st.size > 0 -%}<div class="nc-block" style="padding-top:0"><div class="nc2-head">{%- if section.settings.step_eye != blank -%}<div class="nc-eye">{{ section.settings.step_eye }}</div>{%- endif -%}{%- if section.settings.step_head != blank -%}<h2 class="nc-h2">{{ section.settings.step_head }}</h2>{%- endif -%}</div><div class="nc-steps">{%- assign si = 0 -%}{%- for b in _st -%}{%- assign si = si | plus: 1 -%}<div class="nc-step" {{ b.shopify_attributes }}><span class="nc-stepn">{{ si }}</span><h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p></div>{%- endfor -%}</div></div>{%- endif -%}
