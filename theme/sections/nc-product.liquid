{{ 'nc-product.css' | asset_url | stylesheet_tag }}
<style>
  /* 2026-09-23: returns removed site-wide by owner request; the trust strip has 3 items */
  #ncpdp .nc-strip{grid-template-columns:repeat(3,1fr)}
.nc-split{display:flex;gap:46px;align-items:center;flex-wrap:wrap;max-width:1160px;margin:0 auto}.nc-split-text{flex:1 1 0;min-width:300px}.nc-split-img{flex:1 1 0;min-width:300px}.nc-split-img img,.nc-split-img video{width:100%;max-height:520px;aspect-ratio:1/1;border-radius:20px;display:block;object-fit:cover;background:#000}@media(max-width:760px){.nc-split{flex-direction:column}.nc-split-img{display:block!important}.nc-split-img img,.nc-split-img video{width:100%!important;min-height:220px!important;aspect-ratio:4/3;max-height:none;object-fit:cover;display:block!important;visibility:visible!important;opacity:1!important}}
#ncpdp .nc-thumbs{display:none !important}
#ncpdp .nc-accel{margin-top:12px}
#ncpdp .nc-accel .shopify-payment-button__button{border-radius:13px;min-height:48px}
#ncpdp .nc-tier-save{display:inline-block;margin-left:8px;font-style:normal;font-size:11.5px;font-weight:800;color:#2C6E72;background:rgba(44,110,114,.13);padding:2px 9px;border-radius:100px;vertical-align:middle}
#ncpdp #ncprice .nc-was{font-size:.6em!important;color:#9aa7ac!important;font-weight:600!important;margin-left:6px;text-decoration:line-through}
#ncpdp .nc-tier-price s{font-size:.82em!important;color:#9aa7ac!important;font-weight:600!important;text-decoration:line-through}
#ncpdp #ncprice .nc-tier-save{margin-left:8px;vertical-align:middle;font-size:.5em;padding:3px 10px}
#ncpdp #ncsave{display:none !important}
#ncpdp #ncwas{display:none !important}
#ncpdp .nc-h2{font-size:clamp(28px,3.8vw,45px);font-weight:800;letter-spacing:-.02em;line-height:1.05}
#ncpdp .nc-eye{font-weight:800;letter-spacing:.14em;font-size:14px}
#ncpdp .nc2-head{text-align:center;max-width:700px;margin:0 auto 10px}
#ncpdp .nc2-head .nc-eye{color:#C56A2E}
#ncpdp .nc2-head .nc-lede{margin:10px auto 0}
#ncpdp .ncg{position:relative;border:1px solid rgba(15,42,51,.12);border-radius:18px;overflow:hidden;background:linear-gradient(150deg,#fbf8f2,#e7ddcd)}
#ncpdp .ncg-track{display:flex;transition:transform .45s cubic-bezier(.22,.61,.36,1)}
#ncpdp .ncg-slide{flex:0 0 100%;aspect-ratio:1/1}
#ncpdp .ncg-slide img{width:100%;height:100%;object-fit:cover;display:block}
#ncpdp .ncg-vid{width:100%;height:100%;object-fit:cover;display:block;background:#000}
#ncpdp .ncg-arr{position:absolute;top:50%;transform:translateY(-50%);width:46px;height:46px;border:none;border-radius:50%;background:rgba(255,255,255,.95);color:#0F2A33;font-size:22px;line-height:0;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 20px -8px rgba(15,42,51,.5);z-index:3}
#ncpdp .ncg-arr:before,#ncpdp .ncg-arr:after{display:none !important;content:none !important}
#ncpdp .ncg-prev{left:12px}#ncpdp .ncg-next{right:12px}
#ncpdp .ncg-dots{position:absolute;left:0;right:0;bottom:12px;display:flex;gap:6px;justify-content:center;z-index:3}
#ncpdp .ncg-dots span{width:8px;height:8px;border-radius:50%;background:rgba(15,42,51,.28);cursor:pointer;transition:.2s}
#ncpdp .ncg-dots span.on{background:#2C6E72;width:22px;border-radius:5px}
#ncpdp .nc2-imgslot{width:100%;height:100%;min-height:240px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;background:linear-gradient(150deg,#fbf8f2,#e7ddcd);border:1.5px dashed rgba(15,42,51,.25);border-radius:16px;color:#34555E;padding:24px}
#ncpdp .nc2-imgslot span{font-size:13px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:#2C6E72}
#ncpdp .nc2-imgslot small{font-size:12px;font-weight:600;opacity:.75}
#ncpdp .nc2-imgslot.dark{background:linear-gradient(150deg,#e9e1d4,#d8cdb8)}
#ncpdp .nc2-sysd{background:linear-gradient(160deg,#fbf5ea,#ecdfc6);border-radius:24px;padding:clamp(26px,3.4vw,46px);margin-top:6px}
#ncpdp .nc2-sysd-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:stretch}
#ncpdp .nc2-sysd-left{display:flex;flex-direction:column;justify-content:center}
#ncpdp .nc2-sysd-head{margin-bottom:24px}
#ncpdp .nc2-sysd-head .nc-eye{color:#C56A2E}
#ncpdp .nc2-sysd-head .nc-h2{margin:6px 0 0}
#ncpdp .nc2-sysd-head .nc-lede{margin:12px 0 0;max-width:46ch;color:#34555E}
#ncpdp .nc2-sysd-feats{display:grid;gap:22px}
#ncpdp .nc2-sysd-feat{opacity:.4;transition:opacity .3s ease}
#ncpdp .nc2-sysd-feat.on{opacity:1}
#ncpdp .nc2-sysd-feat h4{margin:0 0 5px;display:flex;align-items:center;gap:12px;font-size:clamp(18px,2.1vw,23px);font-weight:800;letter-spacing:-.01em;color:#0F2A33;text-transform:uppercase}
#ncpdp .nc2-sysd-n{flex:none;width:30px;height:30px;border-radius:50%;background:#bcae95;color:#fff;font-size:14px;display:flex;align-items:center;justify-content:center;transition:background .25s}
#ncpdp .nc2-sysd-feat.on .nc2-sysd-n{background:#2C6E72}
#ncpdp .nc2-sysd-feat p{margin:0 0 0 42px;color:#34555E;font-size:15px;line-height:1.55;max-width:42ch}
#ncpdp .nc2-sysd-img{position:relative;align-self:stretch;min-height:480px;border-radius:20px;overflow:hidden;background:#fff;border:1px solid rgba(15,42,51,.1)}
#ncpdp .nc2-sysd-img img{width:100%;height:100%;object-fit:cover}
#ncpdp .nc2-sysd-dot{position:absolute;width:32px;height:32px;border-radius:50%;background:#fff;border:3px solid #bcae95;box-shadow:0 4px 14px rgba(15,42,51,.3);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;color:#8a7e64;z-index:2;opacity:.7;cursor:pointer;transition:transform .25s,opacity .25s,background .25s,color .25s,border-color .25s}
#ncpdp .nc2-sysd-dot.on{opacity:1;background:#2C6E72;border-color:#2C6E72;color:#fff;transform:scale(1.22);box-shadow:0 8px 20px rgba(44,110,114,.55)}
#ncpdp .nc2-sysd-dot.p1{top:15%;left:16%}#ncpdp .nc2-sysd-dot.p2{top:27%;right:13%}#ncpdp .nc2-sysd-dot.p3{bottom:29%;left:13%}#ncpdp .nc2-sysd-dot.p4{bottom:15%;right:18%}
#ncpdp .nc2-cmp{max-width:980px;margin:24px auto 0;border:1px solid rgba(15,42,51,.12);border-radius:22px;overflow:hidden;background:#fff;box-shadow:0 30px 70px -44px rgba(15,42,51,.55)}
#ncpdp .nc2-cmp-row{display:grid;grid-template-columns:1.5fr 1fr 1fr;align-items:center}
#ncpdp .nc2-cmp-row+.nc2-cmp-row{border-top:1px solid rgba(15,42,51,.08)}
#ncpdp .nc2-cmp-l{padding:24px 32px;font-weight:800;color:#0F2A33;font-size:17.5px}
#ncpdp .nc2-cmp-o,#ncpdp .nc2-cmp-t{padding:24px 16px;text-align:center;font-size:17.5px;color:#34555E}
#ncpdp .nc2-cmp-o{background:rgba(44,110,114,.09);font-weight:800;color:#0F2A33}
#ncpdp .nc2-cmp-head>div{padding:22px 16px;font-size:16px;font-weight:800;letter-spacing:.05em;text-transform:uppercase}
#ncpdp .nc2-cmp-ours{background:linear-gradient(135deg,#2C6E72,#1d565a);color:#fff;text-align:center}
#ncpdp .nc2-cmp-theirs{background:#e9e1d4;color:#5b5345;text-align:center}
#ncpdp .nc2-yes{color:#2C6E72;font-weight:900;font-size:27px}
#ncpdp .nc2-no{color:#c2643f;font-weight:900;font-size:24px}
#ncpdp .nc2-ba{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:22px}
#ncpdp .nc2-ba-col{border:1px solid rgba(15,42,51,.12);border-radius:18px;overflow:hidden;background:#fff}
#ncpdp .nc2-ba-after{border-color:rgba(44,110,114,.4);box-shadow:0 22px 50px -36px rgba(44,110,114,.55)}
#ncpdp .nc2-ba-h{padding:15px 20px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;font-size:14.5px;color:#fff}
#ncpdp .nc2-ba-before .nc2-ba-h{background:#9a8f7d}
#ncpdp .nc2-ba-after .nc2-ba-h{background:linear-gradient(135deg,#2C6E72,#3f9d8f)}
#ncpdp .nc2-ba-media{aspect-ratio:1/1!important;margin:14px!important;border-radius:16px!important;overflow:hidden!important;background:#f3eee5!important;display:block!important}
#ncpdp .nc2-ba-media img{width:100%!important;height:100%!important;object-fit:cover!important;object-position:center!important;border-radius:16px!important;display:block!important}
#ncpdp .nc2-ba-col ul{list-style:none;margin:0;padding:4px 22px 24px;display:grid;gap:12px}
#ncpdp .nc2-ba-col li{position:relative;padding-left:28px;font-size:15px;line-height:1.45;color:#34555E}
#ncpdp .nc2-ba-before li:before{content:'—';position:absolute;left:0;color:#b9ad98;font-weight:800}
#ncpdp .nc2-ba-after li{color:#0F2A33;font-weight:600}
#ncpdp .nc2-ba-after li:before{content:'✓';position:absolute;left:0;color:#2C6E72;font-weight:900;font-size:17px}
#ncpdp .nc2-rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.22,.61,.36,1)}
#ncpdp .nc2-rv.in{opacity:1;transform:none}
#ncpdp .nc2-tl{position:relative;margin-top:26px}
#ncpdp .nc2-tl-axis{position:absolute;left:50%;top:18px;bottom:18px;width:3px;transform:translateX(-50%);background:rgba(15,42,51,.12);border-radius:3px;z-index:0}
#ncpdp .nc2-tl-axisfill{position:absolute;left:0;top:0;width:100%;height:0;background:linear-gradient(#2C6E72,#6FB3A8);border-radius:3px;transition:height .15s linear}
#ncpdp .nc2-tl-row{display:grid;grid-template-columns:1fr 130px 1fr;align-items:center;padding:14px 0;position:relative;z-index:1;opacity:.34;transition:opacity .5s ease}
#ncpdp .nc2-tl-row.reached{opacity:1}
#ncpdp .nc2-tl-trad,#ncpdp .nc2-tl-nc{border:1px solid rgba(15,42,51,.1);border-radius:16px;padding:20px 22px}
#ncpdp .nc2-tl-trad{background:#f3eee5}
#ncpdp .nc2-tl-nc{background:#fff;border-left:4px solid #2C6E72;box-shadow:0 18px 38px -26px rgba(15,42,51,.55)}
#ncpdp .nc2-tl-node{text-align:center;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px}
#ncpdp .nc2-tl-dot{width:20px;height:20px;border-radius:50%;background:#bcae95;border:4px solid #fff;box-shadow:0 0 0 3px rgba(15,42,51,.1);transition:transform .3s,box-shadow .3s,background .3s}
#ncpdp .nc2-tl-node b{font-size:16px;color:#0F2A33;font-weight:800}
#ncpdp .nc2-tl-node small{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#34555E}
#ncpdp .nc2-tl-tag{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#2C6E72;margin-bottom:7px}
#ncpdp .nc2-tl-tag.muted{color:#a89c86}
#ncpdp .nc2-tl-trad h4,#ncpdp .nc2-tl-nc h4{margin:0 0 6px;font-size:18px;color:#0F2A33}
#ncpdp .nc2-tl-trad p,#ncpdp .nc2-tl-nc p{margin:0;font-size:14.5px;line-height:1.5;color:#34555E}
#ncpdp .nc2-chip{display:inline-block;margin-top:11px;font-size:12px;font-weight:700;padding:5px 12px;border-radius:100px;background:#ece3d4;color:#897f6b}
#ncpdp .nc2-chip.ok{background:rgba(44,110,114,.13);color:#2C6E72}
@media(max-width:760px){
#ncpdp .nc2-sysd-grid{grid-template-columns:1fr;gap:22px}
#ncpdp .nc2-tl-axis{display:none!important}
#ncpdp .nc2-sysd-left{justify-content:flex-start}
#ncpdp .nc2-sysd-img{min-height:0;aspect-ratio:1/1}
#ncpdp .nc2-sysd-feat{opacity:1}
#ncpdp .nc2-ba{grid-template-columns:1fr}
#ncpdp .nc2-cmp-row{grid-template-columns:1.25fr .87fr .87fr}
#ncpdp .nc2-cmp-l{padding:15px 14px;font-size:14px}
#ncpdp .nc2-cmp-o,#ncpdp .nc2-cmp-t{padding:15px 8px;font-size:14.5px}
}
@media(max-width:600px){
#ncpdp .nc-tiers{gap:10px !important}
#ncpdp .nc-tier{padding:14px 12px 14px 44px !important;gap:6px !important}
#ncpdp .nc-tier-name{font-size:14px !important;line-height:1.3 !important}
#ncpdp .nc-tier-price{font-size:13px !important;line-height:1.35 !important;display:block !important;margin-top:3px !important}
#ncpdp .nc-tier-save,#ncpdp .nc-flag{font-size:10.5px !important}
#ncpdp .nc-tier-row{flex-wrap:wrap !important;row-gap:4px !important}
#ncpdp .nc-tier-sub{font-size:12px !important;line-height:1.35 !important;margin-top:4px !important}
}

/* kept: bigger mobile price + bigger tier prices (no word collisions) */
@media(max-width:600px){
#ncpdp .nc-prices{flex-wrap:wrap!important;align-items:baseline!important;row-gap:6px!important;column-gap:8px!important}
#ncpdp #ncprice,#ncpdp .nc-price{font-size:28px!important;line-height:1.1!important;font-weight:800!important}
#ncpdp #ncprice .nc-now{font-size:1em!important;font-weight:800!important}
#ncpdp #ncprice .nc-was,#ncpdp #ncprice s.nc-was{font-size:.6em!important;margin-left:6px!important}
#ncpdp #ncprice .nc-tier-save{font-size:.5em!important;padding:4px 11px!important;margin-left:8px!important;vertical-align:middle!important;display:inline-block!important}
#ncpdp .nc-tier{padding:14px 12px 14px 46px!important;gap:6px!important}
#ncpdp .nc-tier-row{flex-wrap:wrap!important;row-gap:4px!important;column-gap:8px!important;align-items:baseline!important}
#ncpdp .nc-tier-name{font-size:15.5px!important;line-height:1.3!important}
#ncpdp .nc-tier-price{font-size:15px!important;line-height:1.35!important;display:block!important;width:100%!important;margin-top:4px!important;font-weight:800!important}
#ncpdp .nc-tier-price s{font-size:.82em!important}
#ncpdp .nc-tier-save,#ncpdp .nc-flag{font-size:11.5px!important}
}
#ncpdp .nc2-ba .nc2-ba-col .nc2-ba-media{margin:10px!important;border-radius:16px!important;aspect-ratio:1/1!important;overflow:hidden!important;background:#f3eee5!important;display:block!important}
#ncpdp .nc2-ba .nc2-ba-col .nc2-ba-media img{width:100%!important;height:100%!important;object-fit:cover!important;object-position:center 38%!important;border-radius:16px!important;display:block!important}
@media(max-width:600px){
  #ncpdp .nc-tiers .nc-tier{gap:2px!important}
  #ncpdp .nc-tiers .nc-tier .nc-tier-row{row-gap:2px!important;margin:0!important}
  #ncpdp .nc-tiers .nc-tier .nc-tier-price{margin-top:2px!important}
  #ncpdp .nc-tiers .nc-tier .nc-tier-sub{margin-top:2px!important;line-height:1.3!important}
  #ncpdp .nc-tiers .nc-tier{padding-top:11px!important;padding-bottom:11px!important}
}

@media(max-width:600px){
  #ncpdp .nc-tiers .nc-tier .nc-tier-row{display:flex!important;flex-wrap:wrap!important;align-items:baseline!important;justify-content:flex-start!important;column-gap:8px!important;row-gap:2px!important;margin:0!important}
  #ncpdp .nc-tiers .nc-tier .nc-tier-price{display:inline-block!important;width:auto!important;min-width:0!important;margin-top:0!important}
  #ncpdp .nc-tiers .nc-tier .nc-tier-sub{margin-top:2px!important}
  #ncpdp .nc-tiers .nc-tier{gap:2px!important}
}

@media(max-width:600px){
  #ncpdp .nc-tiers .nc-tier{padding-top:24px!important;padding-bottom:14px!important;padding-right:14px!important}
  #ncpdp .nc-tiers .nc-tier .nc-flag{top:-9px!important;right:12px!important;font-size:10.5px!important;z-index:2!important}
  #ncpdp .nc-tiers .nc-tier .nc-tier-save{font-size:12.5px!important;padding:3px 10px!important}
  #ncpdp #ncprice .nc-tier-save{font-size:.55em!important}
}
@media(max-width:600px){
  #ncpdp .nc-tiers .nc-tier{display:flex!important;flex-wrap:wrap!important;flex-direction:row!important;align-items:baseline!important;column-gap:8px!important;row-gap:2px!important}
  #ncpdp .nc-tiers .nc-tier .nc-tier-row{display:contents!important}
  #ncpdp .nc-tiers .nc-tier .nc-tier-name{order:1!important}
  #ncpdp .nc-tiers .nc-tier .nc-tier-sub{order:2!important;flex-basis:100%!important;width:100%!important;margin:1px 0 0!important}
  #ncpdp .nc-tiers .nc-tier .nc-tier-price{order:3!important;flex-basis:100%!important;width:100%!important;margin:2px 0 0!important}
}
</style>
{%- assign cv = product.selected_or_first_available_variant -%}
{%- assign _hl = section.blocks | where: 'type','highlight' -%}
{%- assign _ti = section.blocks | where: 'type','tier' -%}
{%- assign _be = section.blocks | where: 'type','benefit' -%}
{%- assign _me = section.blocks | where: 'type','meter' -%}
{%- assign _st = section.blocks | where: 'type','step' -%}
{%- assign _bx = section.blocks | where: 'type','boxitem' -%}
{%- assign _sp = section.blocks | where: 'type','spec' -%}
{%- assign _fq = section.blocks | where: 'type','faq' -%}
{%- assign _fe = section.blocks | where: 'type','feature' -%}
{%- assign _cmp = section.blocks | where: 'type','cmp' -%}
{%- assign _ba = section.blocks | where: 'type','ba' -%}
{%- assign _tl = section.blocks | where: 'type','tl' -%}
{%- assign _ncvid = null -%}{%- for _m in product.media -%}{%- if _m.media_type == 'video' and _ncvid == null -%}{%- assign _ncvid = _m -%}{%- endif -%}{%- endfor -%}
{%- assign _ncvidcount = 0 -%}{%- assign _ncvid2 = null -%}{%- for _m in product.media -%}{%- if _m.media_type == 'video' -%}{%- assign _ncvidcount = _ncvidcount | plus: 1 -%}{%- if _ncvidcount == 2 and _ncvid2 == null -%}{%- assign _ncvid2 = _m -%}{%- endif -%}{%- endif -%}{%- endfor -%}
<div id="ncpdp"><div class="nc-wrap">
  <div class="nc-hero">
    <div class="nc-gallery">
      <div class="ncg" id="ncg">
        <div class="ncg-track" id="ncg-track">
          {%- assign ncimgi = 0 -%}{%- for media in product.media -%}{%- if media.media_type == 'video' -%}<div class="ncg-slide"><video class="ncg-vid" controls muted loop autoplay playsinline webkit-playsinline preload="metadata" {% if media.preview_image %}poster="{{ media.preview_image | image_url: width: 1100 }}"{% endif %}>{%- for s in media.sources -%}{%- if s.mime_type contains 'mp4' -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endif -%}{%- endfor -%}{%- for s in media.sources -%}{%- unless s.mime_type contains 'mp4' -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endunless -%}{%- endfor -%}</video></div>{%- elsif media.media_type == 'image' -%}{%- assign ncimgi = ncimgi | plus: 1 -%}<div class="ncg-slide"><img {% if ncimgi == 1 %}id="ncmain"{% endif %} src="{{ media | image_url: width: 1100 }}" alt="{{ product.title | escape }}" loading="lazy"></div>{%- endif -%}{%- endfor -%}
          {%- if product.media.size == 0 -%}<div class="ncg-slide"><div class="nc2-imgslot"><span>Image</span><small>Add product media</small></div></div>{%- endif -%}
        </div>
        {%- if section.settings.sale_tag != blank -%}<span class="nc-tag">{{ section.settings.sale_tag }}</span>{%- endif -%}
        <button type="button" class="ncg-arr ncg-prev" aria-label="Previous" onclick="ncgGo(-1)">&#8249;</button>
        <button type="button" class="ncg-arr ncg-next" aria-label="Next" onclick="ncgGo(1)">&#8250;</button>
        <div class="ncg-dots" id="ncg-dots"></div>
      </div>
    {% comment %}2026-09-23: returns removed site-wide by owner request{% endcomment %}
    <div class="nc-badges"><div class="nc-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg><b>{{ section.settings.b2t | default: 'Free' }}</b><small>{{ section.settings.b2s | default: 'U.S. shipping' }}</small></div><div class="nc-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><b>{{ section.settings.b3t | default: 'Secure' }}</b><small>{{ section.settings.b3s | default: 'Encrypted checkout' }}</small></div></div></div>
    <div class="nc-buybox">
      {%- if section.settings.sold_line != blank -%}<div class="nc-sold"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3L22 9l-5 4.8L18.2 21 12 17.3 5.8 21 7 13.8 2 9l7.1-.7z"/></svg>{{ section.settings.sold_line }}</div>{%- endif -%}
      <h1 class="nc-title">{{ product.title }}</h1>
