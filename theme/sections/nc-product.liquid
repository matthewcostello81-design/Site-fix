  {%- if section.settings.intro_head != blank -%}<div class="nc-block">{%- if section.settings.intro_image_url != blank or _ncvid -%}<div class="nc-split"><div class="nc-split-text">{%- if section.settings.intro_eye != blank -%}<div class="nc-eye">{{ section.settings.intro_eye }}</div>{%- endif -%}<h2 class="nc-h2">{{ section.settings.intro_head }}</h2>{%- if section.settings.intro_text != blank -%}<p class="nc-lede">{{ section.settings.intro_text }}</p>{%- endif -%}</div><div class="nc-split-img">{%- if _ncvid -%}<video class="nc-split-vid" muted loop autoplay playsinline webkit-playsinline preload="auto" poster="{% if _ncvid.preview_image %}{{ _ncvid.preview_image | image_url: width: 1100 }}{% else %}{{ product.featured_image | image_url: width: 1100 }}{% endif %}">{%- for s in _ncvid.sources -%}{%- if s.mime_type contains 'mp4' -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endif -%}{%- endfor -%}{%- for s in _ncvid.sources -%}{%- unless s.mime_type contains 'mp4' -%}<source src="{{ s.url }}" type="{{ s.mime_type }}">{%- endunless -%}{%- endfor -%}</video>{%- else -%}<img src="{{ section.settings.intro_image_url }}" alt="{{ section.settings.intro_head | escape }}" loading="lazy">{%- endif -%}</div></div>{%- else -%}{%- if section.settings.intro_eye != blank -%}<div class="nc-eye">{{ section.settings.intro_eye }}</div>{%- endif -%}<h2 class="nc-h2">{{ section.settings.intro_head }}</h2>{%- if section.settings.intro_text != blank -%}<p class="nc-lede">{{ section.settings.intro_text }}</p>{%- endif -%}{%- endif -%}</div>{%- endif -%}
