</div></div>
<script>
(function(){
var variants={{ product.variants | json }};
var prices={ {% for v in product.variants %}"{{ v.id }}":{{ v.price }}{% unless forloop.last %},{% endunless %}{% endfor %} };
var compareAt={ {% for v in product.variants %}"{{ v.id }}":{{ v.compare_at_price | default: 0 }}{% unless forloop.last %},{% endunless %}{% endfor %} };
var sel={};{% for option in product.options_with_values %}sel[{{ forloop.index }}]={{ option.selected_value | json }};{% endfor %}
var qty=1;function money(c){return "$"+(c/100).toFixed(2);}
var DUO={{ section.settings.duo_pct | default: 10 }},TRIO={{ section.settings.trio_pct | default: 15 }};function bpct(q){return q>=3?TRIO:(q==2?DUO:0);}
function cur(){return variants.find(function(v){return (!sel[1]||v.option1==sel[1])&&(!sel[2]||v.option2==sel[2])&&(!sel[3]||v.option3==sel[3]);});}
function refresh(){var v=cur()||variants[0];document.getElementById("ncvid").value=v.id;document.getElementById("ncqty").value=qty;var u=prices[v.id],ca=compareAt[v.id]||0;var orig=(ca>u)?ca:u;function tot(q){var p=bpct(q);/* Shopify floors the automatic discount PER UNIT, then sums. Rounding the whole line (the old Math.round) under-charged by a cent or two versus the real cart. */return q*(u-Math.floor(u*p/100));}var t=tot(qty);(function(){var pr=document.getElementById("ncprice");if(!pr)return;var isSale=ca>u;var rr=orig*qty,dp=Math.round((1-t/rr)*100);if(qty>=2&&dp>0){pr.innerHTML='<span class="nc-now">'+money(t)+'</span> <s class="nc-was">'+money(rr)+'</s> <em class="nc-tier-save">Save '+dp+'%</em>';}else if(isSale){var bp=Math.round((1-u/ca)*100);pr.innerHTML='<span class="nc-now">'+money(u)+'</span> <s class="nc-was">'+money(ca)+'</s>'+(bp>0?' <em class="nc-tier-save">Save '+bp+'%</em>':'');}else{pr.textContent=money(t);}})();var p=document.getElementById("ncatcp");if(p)p.textContent=money(t);var a=document.getElementById("ncatc");if(a){if(v.available){a.disabled=false;}else{a.disabled=true;a.textContent="Sold out";}}document.querySelectorAll("#ncpdp .nc-tier").forEach(function(x){var q=parseInt(x.dataset.qty)||1;var el=x.querySelector("[data-tp]");if(el){var tt=tot(q),rr=orig*q,dp=Math.round((1-tt/rr)*100);el.innerHTML=(tt<rr?money(tt)+' <s>'+money(rr)+'</s>':money(tt))+((q>=2&&dp>0)?' <em class="nc-tier-save">Save '+dp+'%</em>':'');}});}
window.ncOpt=function(btn){var pos=btn.dataset.pos;btn.parentElement.querySelectorAll(".nc-optbtn").forEach(function(b){b.classList.remove("nc-on")});btn.classList.add("nc-on");sel[pos]=btn.dataset.val;refresh();};
window.ncTier=function(t){document.querySelectorAll("#ncpdp .nc-tier").forEach(function(x){x.classList.remove("nc-on")});t.classList.add("nc-on");qty=parseInt(t.dataset.qty)||1;refresh();};
window.ncAcc=function(btn){var i=btn.parentElement,o=i.classList.contains("nc-open");document.querySelectorAll("#ncpdp .nc-acc-i").forEach(function(x){x.classList.remove("nc-open");x.querySelector(".nc-acc-b").style.maxHeight=null;});if(!o){i.classList.add("nc-open");var b=i.querySelector(".nc-acc-b");b.style.maxHeight=b.scrollHeight+"px";}};
var ncgi=0;function ncgUpd(){var t=document.getElementById('ncg-track');if(!t)return;var n=t.children.length;if(n<1)return;if(ncgi<0)ncgi=n-1;if(ncgi>=n)ncgi=0;t.style.transform='translateX('+(-ncgi*100)+'%)';var d=document.getElementById('ncg-dots');if(d){for(var i=0;i<d.children.length;i++){d.children[i].className=i===ncgi?'on':'';}}var vids=t.querySelectorAll('video');for(var k=0;k<vids.length;k++){try{vids[k].pause();}catch(e){}}var cvv=t.children[ncgi]?t.children[ncgi].querySelector('video'):null;if(cvv){try{cvv.play();}catch(e){}}}
window.ncgGo=function(dir){ncgi+=dir;ncgUpd();};window.ncgSet=function(i){ncgi=i;ncgUpd();};
(function(){var t=document.getElementById('ncg-track'),d=document.getElementById('ncg-dots');if(!t||!d)return;var n=t.children.length;for(var i=0;i<n;i++){var s=document.createElement('span');s.setAttribute('data-i',i);d.appendChild(s);}Array.prototype.forEach.call(d.children,function(s){s.addEventListener('click',function(){window.ncgSet(parseInt(s.getAttribute('data-i'))||0);});});ncgUpd();var sx=null,stage=document.getElementById('ncg');if(stage){stage.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;},{passive:true});stage.addEventListener('touchend',function(e){if(sx==null)return;var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>40){window.ncgGo(dx<0?1:-1);}sx=null;},{passive:true});}})();
(function(){function rv(){var vh=window.innerHeight||document.documentElement.clientHeight;document.querySelectorAll('#ncpdp .nc2-rv:not(.in)').forEach(function(e){var r=e.getBoundingClientRect();if(r.top<vh*0.9&&r.bottom>0){e.classList.add('in');}});}window.addEventListener('scroll',rv,{passive:true});window.addEventListener('resize',rv);rv();setTimeout(rv,300);setTimeout(rv,1000);setTimeout(rv,2200);})();
(function(){var sys=document.querySelector('#ncpdp .nc2-sysd');if(!sys)return;var feats=sys.querySelectorAll('.nc2-sysd-feat');var dots=sys.querySelectorAll('.nc2-sysd-dot');function setA(i){for(var k=0;k<feats.length;k++){feats[k].classList.toggle('on',k===i);}for(var j=0;j<dots.length;j++){dots[j].classList.toggle('on',j===i);}}Array.prototype.forEach.call(feats,function(f,i){f.addEventListener('mouseenter',function(){setA(i);});});Array.prototype.forEach.call(dots,function(dt,i){dt.addEventListener('mouseenter',function(){setA(i);});});setA(0);})();
(function(){var tl=document.querySelector('#ncpdp .nc2-tl');if(!tl)return;var rows=tl.querySelectorAll('.nc2-tl-row');var fill=document.getElementById('nctlfill');function upd(){var vh=window.innerHeight||document.documentElement.clientHeight;var line=vh*0.55;var tr=tl.getBoundingClientRect();var prog=(line-tr.top)/(tr.height||1);prog=Math.max(0,Math.min(1,prog));if(fill)fill.style.height=(prog*100)+'%';for(var i=0;i<rows.length;i++){var b=rows[i].getBoundingClientRect();var c=(b.top+b.bottom)/2;rows[i].classList.toggle('reached',c<=line);}}window.addEventListener('scroll',upd,{passive:true});window.addEventListener('resize',upd);upd();setTimeout(upd,300);setTimeout(upd,1000);})();
(function(){var svs=document.querySelectorAll("#ncpdp .nc-split-vid");if(!svs.length)return;function tryplay(v){v.muted=true;v.setAttribute("muted","");var p=v.play();if(p&&p.catch){p.catch(function(){});}}Array.prototype.forEach.call(svs,function(v){try{v.load();}catch(e){}v.addEventListener("click",function(){tryplay(v);});v.addEventListener("loadeddata",function(){tryplay(v);});});if("IntersectionObserver" in window){var vio=new IntersectionObserver(function(es){es.forEach(function(e){var v=e.target;if(e.isIntersecting){tryplay(v);}else{try{v.pause();}catch(err){}}});},{threshold:.15});Array.prototype.forEach.call(svs,function(v){vio.observe(v);});}var kicked=false;function kick(){if(kicked)return;kicked=true;Array.prototype.forEach.call(svs,function(v){tryplay(v);});}document.addEventListener("touchstart",kick,{once:true,passive:true});setTimeout(function(){Array.prototype.forEach.call(svs,function(v){tryplay(v);});},1200);})();
var f=document.querySelector("#ncpdp .nc-acc-i.nc-open .nc-acc-b");if(f)f.style.maxHeight=f.scrollHeight+"px";
var ms=document.getElementById("ncmeters");if(ms&&"IntersectionObserver" in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;e.target.querySelectorAll(".nc-num").forEach(function(n){var to=parseInt(n.dataset.to)||0,suf=n.dataset.suf||"";n.innerHTML='<span class="nc-val">0</span><span class="nc-suf">'+suf+'</span>';var v=n.querySelector(".nc-val"),t0=0,D=1000;function fr(ts){if(!t0)t0=ts;var q=(ts-t0)/D;if(q>1)q=1;var ez=1-Math.pow(1-q,3);v.textContent=Math.round(to*ez);if(q<1)requestAnimationFrame(fr);}requestAnimationFrame(fr);});e.target.querySelectorAll(".nc-fill").forEach(function(fl){requestAnimationFrame(function(){requestAnimationFrame(function(){fl.style.width=(fl.dataset.w||0)+"%";});});});io.unobserve(e.target);});},{threshold:.3});io.observe(ms);}
refresh();})();
</script>
