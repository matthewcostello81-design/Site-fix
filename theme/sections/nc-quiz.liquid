<script>
(function(){
  var SINGLE='hf_20260731_030140';
  function findIdx(t,match){
    for(var i=0;i<t.children.length;i++){
      var im=t.children[i].querySelector('img');
      if(!im)continue;
      var u=im.currentSrc||im.src||im.getAttribute('src')||'';
      if(u.indexOf(match)>-1)return i;
    }
    return -1;
  }
  function goTo(single){
    var ts=document.querySelectorAll('.ncg-track');
    for(var n=0;n<ts.length;n++){
      var t=ts[n],idx=single?findIdx(t,SINGLE):0;
      if(idx<0)continue;
      try{if(typeof window.ncgSet==='function')window.ncgSet(idx);}catch(e){}
      t.style.transform='translateX('+(-idx*100)+'%)';
      var d=document.getElementById('ncg-dots');
      if(d&&d.children.length){for(var k=0;k<d.children.length;k++){d.children[k].className=(k===idx?'on':'');}}
    }
  }
  function isSingle(v){v=v||'';return /wood roller/i.test(v)&&!/set|piece/i.test(v);}
  function armClicks(){
    document.addEventListener('click',function(e){
      var el=e.target;
      var b=(el&&el.closest)?el.closest('.nc-optbtn'):null;
      if(!b)return;
      var v=b.getAttribute('data-val')||b.textContent||'';
      if(!/wood roller|piece|set/i.test(v))return;
      var single=isSingle(v);
      var go=function(){goTo(single);};
      setTimeout(go,80);setTimeout(go,320);setTimeout(go,720);setTimeout(go,1400);
    },true);
  }
  function initial(){
    var on=document.querySelector('.nc-optbtn.nc-on');
    if(on&&isSingle(on.getAttribute('data-val')||on.textContent||''))goTo(true);
  }
  function arm(){
    if(!document.querySelector('.ncg-track'))return;
    armClicks();
    setTimeout(initial,800);setTimeout(initial,1800);
  }
  if(document.readyState!=='loading')arm();else document.addEventListener('DOMContentLoaded',arm);
})();
</script>
