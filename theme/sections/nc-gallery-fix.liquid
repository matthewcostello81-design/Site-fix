{% comment %}
  Gallery arrow centering, plus video support.
  The aside-pager gallery has no video handling: Shopify video media is emitted as a flat
  poster image (src contains /preview_images/). This swaps that image for a real video that
  autoplays muted and loops.
{% endcomment %}
<style>
@media only screen and (min-width:761px){
  #content .l4pr.aside-pager .swiper-button-nav{top:0!important;bottom:0!important;height:auto!important}
}
#content .l4pr .nc-vid-wrap{position:relative;display:block;width:100%;height:100%;cursor:pointer;overflow:hidden;border-radius:inherit}
#content .l4pr .nc-vid-wrap video{display:block;width:100%;height:100%;object-fit:cover;border-radius:inherit}
#content .l4pr .nc-vid-badge{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:66px;height:66px;border-radius:50%;background:rgba(15,42,51,.55);display:flex;align-items:center;justify-content:center;pointer-events:none;opacity:0;transition:opacity .2s ease}
#content .l4pr .nc-vid-badge:after{content:"";display:block;width:0;height:0;margin-left:5px;border-left:19px solid #fff;border-top:12px solid transparent;border-bottom:12px solid transparent}
#content .l4pr .nc-vid-wrap.is-paused .nc-vid-badge{opacity:1}
@media only screen and (max-width:760px){#content .l4pr .nc-vid-badge{width:54px;height:54px}}
</style>
{% assign nc_vid = null %}
{% for m in product.media %}
  {% if m.media_type == 'video' %}{% assign nc_vid = m %}{% break %}{% endif %}
{% endfor %}
{% if nc_vid %}
<script>
window.NC_PDP_VIDEO = {
  poster: {{ nc_vid.preview_image | image_url: width: 1400 | json }},
  sources: [{% for s in nc_vid.sources %}{"url": {{ s.url | json }}, "type": {{ s.mime_type | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
};
</script>
<script>
(function(){
  if (document.documentElement.getAttribute('data-ncvid')) { return; }
  document.documentElement.setAttribute('data-ncvid','1');
  function build(){
    var d = window.NC_PDP_VIDEO;
    if (!d || !d.sources || !d.sources.length) { return true; }
    var gal = document.querySelector('.l4pr');
    if (!gal) { return false; }
    var slides = gal.querySelectorAll('.swiper-slide');
    if (!slides.length) { return false; }
    var done = false;
    Array.prototype.forEach.call(slides, function(sl){
      if (sl.querySelector('.nc-vid-wrap')) { done = true; return; }
      var img = sl.querySelector('img');
      if (!img) { return; }
      var src = img.currentSrc || img.src || '';
      if (src.indexOf('/preview_images/') === -1) { return; }
      var wrap = document.createElement('div');
      wrap.className = 'nc-vid-wrap';
      var v = document.createElement('video');
      v.setAttribute('playsinline','');
      v.setAttribute('webkit-playsinline','');
      v.setAttribute('muted','');
      v.setAttribute('autoplay','');
      v.setAttribute('loop','');
      v.setAttribute('preload','auto');
      v.muted = true; v.defaultMuted = true; v.loop = true; v.autoplay = true;
      v.poster = d.poster;
      d.sources.forEach(function(s){
        if (!s.type || s.type.indexOf('mp4') === -1) { return; }
        var so = document.createElement('source');
        so.src = s.url; so.type = s.type; v.appendChild(so);
      });
      if (!v.querySelector('source')) { return; }
      var badge = document.createElement('span');
      badge.className = 'nc-vid-badge';
      wrap.appendChild(v); wrap.appendChild(badge);
      wrap.addEventListener('click', function(){
        if (v.paused) { v.play(); wrap.classList.remove('is-paused'); }
        else { v.pause(); wrap.classList.add('is-paused'); }
      });
      v.addEventListener('pause', function(){ wrap.classList.add('is-paused'); });
      v.addEventListener('play', function(){ wrap.classList.remove('is-paused'); });
      img.parentNode.replaceChild(wrap, img);
      var p = v.play();
      if (p && p.catch) { p.catch(function(){ wrap.classList.add('is-paused'); }); }
      done = true;
    });
    return done;
  }
  var n = 0;
  var t = setInterval(function(){ n++; if (build() || n > 60) { clearInterval(t); } }, 250);
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', build); } else { build(); }
})();
</script>
{% endif %}
{% schema %}
{"name":"NC Gallery Fix","settings":[]}
{% endschema %}
