  {%- assign last_keys = 'A369c836cd7ce4340aa718121c1c1c4cdY|Afbf8c368ee5944cdb66de8a124877addK|Ac4b26074951740be8853d2741b582d9b5|A167472bd06f5437da0fcdc9c0215e652h|Ad03e22378241491aa51f507d3b2dbfe0R|A72c7028e97ea40c1939d19d33e6e5ed1x' | split: '|' -%}
  {%- assign shots = 0 -%}
  {%- capture shots_html -%}
    {%- assign seen = '|' -%}
    {%- for r in jm_all -%}
      {%- assign key = '|' | append: r.uuid | append: '|' -%}
      {%- if r.pictures_urls.size > 0 and shots < 12 -%}
        {%- unless seen contains key -%}
          {%- assign seen = seen | append: r.uuid | append: '|' -%}
          {%- assign shots = shots | plus: 1 -%}
