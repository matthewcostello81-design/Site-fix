      {%- assign ob1 = product.images | where: 'alt', 'Crystal PokeOrb – Pikachu' | first -%}{%- if ob1 -%}{%- assign p2_sil_img = ob1 | image_url: width: 1000 -%}{%- endif -%}{%- assign ob2 = product.images | where: 'alt', 'Crystal PokeOrb – Mega Charizard X' | first -%}{%- if ob2 -%}{%- assign p2_hard_img = ob2 | image_url: width: 1000 -%}{%- endif -%}{%- assign ob3 = product.images | where: 'alt', 'Crystal PokeOrb – Eevee' | first -%}{%- if ob3 -%}{%- assign p2_prot_img = ob3 | image_url: width: 1000 -%}{%- endif -%}
<div class="pg-obs-case"><img src="{{ p2_sil_img }}" alt="Crystal Legends Orb, Pikachu" loading="lazy" decoding="async" width="360" height="360"><div><span class="tag">Fan favorite</span><h3>Pikachu</h3><p>The one everybody starts with. Bright yellow under the glow, and the first orb most people end up gifting.</p></div></div>
      <div class="pg-obs-case"><img src="{{ p2_hard_img }}" alt="Crystal Legends Orb, Mega Charizard X" loading="lazy" decoding="async" width="360" height="360"><div><span class="tag">Best seller</span><h3>Mega Charizard X</h3><p>The most ordered orb in the set. Wings spread inside the glass, and the blue-white cycle suits it best.</p></div></div>
      <div class="pg-obs-case"><img src="{{ p2_prot_img }}" alt="Crystal Legends Orb, Eevee" loading="lazy" decoding="async" width="360" height="360"><div><span class="tag">Gift pick</span><h3>Eevee</h3><p>Small, round and impossible to dislike. The orb that goes on a desk at work and stays there.</p></div></div>
    </div>
    <span class="pg-obs-cta" role="button" tabindex="0" data-obs-cta data-obs-max>See the Bundles <span>&rarr;</span></span>
  </section>

  <section class="pg-obs-sec pg-obs-end">
    <span class="pg-obs-eye">Side by side</span>
    <h2>Why the Orb <span>Stands Out.</span></h2>
    <div class="pg-obs-tbl" role="table" aria-label="Crystal Orb compared with a 3rd party seller">
      <div class="pg-obs-row hd" role="row"><div role="columnheader"></div><div class="us" role="columnheader">Crystal Orb</div><div class="them" role="columnheader">3rd Party Seller</div></div>
      {%- assign rows = '3D character floating in solid glass|LED lamp base in the box|Seven-color automatic glow|36 characters to collect|Ships in a protective foam box|Brand new with a 30-day guarantee' | split: '|' -%}
      {%- for row in rows -%}
      <div class="pg-obs-row" role="row"><div role="cell">{{ row }}</div><div class="us" role="cell"><span class="y" aria-label="Yes"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></div><div role="cell"><span class="n" aria-label="No"><svg viewBox="0 0 24 24"><path d="M7 7l10 10M17 7L7 17"/></svg></span></div></div>
      {%- endfor -%}
    </div>
    <span class="pg-obs-cta" role="button" tabindex="0" data-obs-cta>Pick Your Character <span>&rarr;</span></span>
  </section>
</div>

<script>
(function(){
  if (window.pgOrbStory) return; window.pgOrbStory = 1;

  function seat(){
    var src = document.getElementById('pg-obs-src');
    var buy = document.querySelector('#pgx .pgx-buy');
    if (src && buy){
      var ben = src.querySelector('[data-obs="ben"]');
      if (ben){
        var after = buy.querySelector(':scope > .pgx-rating') || buy.querySelector(':scope > .pgx-title');
        if (after) buy.insertBefore(ben, after.nextSibling); else buy.insertBefore(ben, buy.firstChild);
      }
      /* the photo strip follows the bundles: after the Add to cart button and
         its error line where they are still in the column (a desktop), after
         the last tile otherwise. On a phone its flex order does the placing. */
      var shots = src.querySelector('[data-obs="shots"]') || buy.querySelector(':scope > [data-obs="shots"]');
      if (shots){
        var after = buy.querySelector(':scope > #pgx-err') || buy.querySelector(':scope > #pgx-atc');
        if (!after){
          var ts = buy.querySelectorAll(':scope > .pgx-tile');
          after = ts.length ? ts[ts.length - 1] : null;
        }
        if (after){ if (after.nextElementSibling !== shots) buy.insertBefore(shots, after.nextSibling); }
        else if (shots.parentNode !== buy) buy.appendChild(shots);
      }
    }
    trust();
    lower();
    loved();
  }

  /* the loved-by pill reads the page's own rating line, so it follows Judge.me */
  function loved(){
    var pill = document.querySelector('#pgx [data-obs-loved="pill"]');
    var r = document.querySelector('#pgx .pgx-rating strong');
    var l = document.querySelector('#pgx .pgx-rating .pgx-revlink');
    if (!pill || !r || !l) return;
    var n = parseInt((l.textContent || '').replace(/[^\d]/g, ''), 10);
    var txt = 'Rated ' + (r.textContent || '').trim() + '/5' + (n ? ' \u00b7 ' + n + ' reviews' : '');
    if (pill.textContent !== txt) pill.textContent = txt;
  }
  /* the accordions lead the trust block: just before the info box. Skipped
     while they are outside the buy column (pg-acc-place brings them back). */
  function trust(){
    var buy = document.querySelector('#pgx .pgx-buy');
    var acc = document.getElementById('pgx-desc');
    if (!buy || !acc || acc.parentNode !== buy) return;
    var info = buy.querySelector(':scope > .pgx-info');
    if (info && acc.nextElementSibling !== info) buy.insertBefore(acc, info);
  }

  /* product | story | you may also like | reviews. Safe to call any number of
     times: every move is skipped when the node is already in its seat. */
  function lower(){
    var story = document.getElementById('pg-obs');
    var rev = document.querySelector('#pgx #pg-reviews, #pgx .pgx-rev');
    if (!story || !rev || !rev.parentNode) return;
    var host = rev.parentNode;
    var yml = document.querySelector('.pgu-yml');
    var anchor = rev;
    if (yml){
      if (yml.parentNode !== host || yml.nextElementSibling !== rev) host.insertBefore(yml, rev);
      anchor = yml;
    }
    if (story.parentNode !== host || story.nextElementSibling !== anchor) host.insertBefore(story, anchor);
    watch(host);
    var main = document.querySelector('#pgx .pgx-main');
    if (main && main.parentNode) watch(main.parentNode);
  }
  var queued = false;
  function watch(node){
    if (!node || node.pgP2sObs || !window.MutationObserver) return;
    node.pgP2sObs = 1;
    new MutationObserver(function(){
      if (queued) return;
      queued = true;
      setTimeout(function(){ queued = false; try { lower(); } catch (e){} }, 60);
    }).observe(node, {childList: true});
  }

  function toBundles(){
    var t = document.querySelector('#pgx .pgx-bs') || document.querySelector('#pgx .pgx-tile') || document.querySelector('#pgx .pgx-buy');
    if (!t) return;
    try { t.scrollIntoView({behavior: 'smooth', block: 'start'}); } catch (e){ t.scrollIntoView(); }
  }
  document.addEventListener('click', function(e){
    if (e.target && e.target.closest && e.target.closest('[data-obs-cta]')) {
      e.preventDefault();
      /* the accessories chapter's button also selects the Max tile */
      if (e.target.closest('[data-obs-max]')){ var mt = document.querySelector('#pgx .pgx-buy > .pg-ob[data-ob="max"]'); if (mt) mt.click(); }
      toBundles();
    }
  });
  document.addEventListener('keydown', function(e){
    if ((e.key === 'Enter' || e.key === ' ') && e.target && e.target.closest && e.target.closest('[data-obs-cta]')){ e.preventDefault(); toBundles(); }
  });

  /* THE PRICE COMPARISON FOLLOWS THE SELECTED TILE (2026-09-17, "make this
     change based on if they have max bundle or single selected"): the R36
     card's label, price and games line read the tile selected in the buy box,
     so a shopper on the Max Bundle compares $119.99 and 40K games, not the
     single's $74.99. Two consoles say "each". Polled, like the rest of the
     page: the tiles repaint on their own beat and rebuilds are common. */
  function cmpSet(k, v){
    var el = document.querySelector('#pg-obs [data-obs-cmp="' + k + '"]');
    if (el && el.textContent !== v) el.textContent = v;
  }
  function compare(){
    var t = document.querySelector('#pgx .pgx-lad.pgx-sel');
    if (!t) return;
    var ttl = (t.querySelector('.pgx-lad-t') || t.querySelector('b') || {}).textContent || '';
    var m = ttl.match(/Buy\s*(\d+),?\s*Get\s*(\d+)/i);
    var units = m ? (parseInt(m[1],10) + parseInt(m[2],10)) : 1, free = m ? parseInt(m[2],10) : 0;
    var px = t.querySelector('.pgx-lad-px') || t.querySelector('.pgx-duo-px');
    var price = px ? (((px.textContent || '').match(/\$[\d,]+\.\d\d/) || [''])[0]) : '';
    var base = parseFloat(window.__p2sVbase) || 49.99;
    cmpSet('eye', 'Pocket Era');
    if (price) cmpSet('price', price);
    cmpSet('line1', units === 1 ? 'One orb' : units + ' orbs, ' + free + ' of them free');
    cmpSet('games', units === 1 ? 'LED base included' : units + ' LED bases included');
    cmpSet('veye', 'Elsewhere');
    cmpSet('vprice', '~$' + (base * units).toFixed(2));
    cmpSet('vline1', units === 1 ? 'One orb' : units + ' orbs, none free');
    cmpSet('vline2', units === 1 ? 'Base sold separately' : 'Bases sold separately');
  }
  function boot(){ seat(); setTimeout(seat, 500); setTimeout(function(){ trust(); lower(); }, 1600); setTimeout(lower, 3200); compare(); setInterval(compare, 500); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "PG Orb Story",
  "settings": [
    {"type": "text", "id": "gba_model", "label": "Collector figure named in the price comparison", "default": "Game Boy Advance SP"},
    {"type": "text", "id": "gba_price", "label": "Its typical used price, whole dollars (check PriceCharting)", "default": "150"},
    {"type": "text", "id": "gba_price_max", "label": "Used price plus a case, shown against the Max Bundle, whole dollars", "default": "190"},
    {"type": "image_picker", "id": "hero_image", "label": "Photo in Catch the glow (optional)"},
    {"type": "image_picker", "id": "story_image", "label": "Photo beside the price comparison (optional)"}
  ],
  "presets": [{"name": "PG Orb Story"}]
}
{% endschema %}
