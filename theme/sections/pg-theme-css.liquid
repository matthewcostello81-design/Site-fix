<script>
  (function(){
    if (window.pgWire) return; window.pgWire = 1;
    /* Pop-out cart: refresh the drawer section markup, then slide it out */
    window.pgOpenCart = function(){
      var done=function(){ if (window.openPanel) { openPanel('cart'); } else { window.location.href='/cart'; } };
      fetch('/?sections=side-cart').then(function(r){return r.json();}).then(function(j){
        var html=j['side-cart']||'';
        var t=document.createElement('div'); t.innerHTML=html;
        var fresh=t.querySelector('#cart'), cur=document.getElementById('cart');
        if(fresh&&cur){cur.innerHTML=fresh.innerHTML;}
        done();
      }).catch(done);
    };
    document.addEventListener('click', function(e){
      var a=e.target.closest&&e.target.closest('a[href$="/cart"],a[href*="/cart?"]');
      if(!a)return;
      if(a.closest('#cart'))return;
      e.preventDefault(); e.stopPropagation();
      window.pgOpenCart();
    }, true);
    /* Bottom sticky buy bar on product pages */
    function stickyTick(){
      var atc=document.getElementById('pgx-atc');
      var bar=document.getElementById('pg-sticky');
      if(!atc){ if(bar) bar.classList.remove('on'); return; }
      if(!bar){
        bar=document.createElement('div'); bar.id='pg-sticky';
        bar.innerHTML='<div class="pgst-in"><span class="pgst-t"></span><span class="pgst-p"></span><button type="button" class="pgst-b">Add to cart</button></div>';
        document.body.appendChild(bar);
        bar.querySelector('.pgst-b').addEventListener('click',function(){ atc.click(); });
      }
      var h1=document.querySelector('#pgx h1')||document.querySelector('h1');
      if(h1) bar.querySelector('.pgst-t').textContent=h1.textContent.replace(/\s+/g,' ').trim();
      var sel=document.querySelector('.pgx-tile.pgx-sel')||document.querySelector('.pgx-tile');
      if(sel){
        var m=(sel.textContent.match(/\$[0-9][0-9.,]*/g)||[]);
        var pEl=bar.querySelector('.pgst-p');
        if(m.length){ pEl.innerHTML=(m.length>1?'<s>'+m[1]+'</s>':'')+m[0]; }
      }
      var cart=document.getElementById('cart');
      var open=cart&&/(^|\s)toggle(\s|$)/.test(cart.className);
      var r=atc.getBoundingClientRect();
      var out=(r.width===0&&r.height===0)?(window.pageYOffset>500):(r.bottom<0);
      if(out&&!open){ bar.classList.add('on'); } else { bar.classList.remove('on'); }
    }
    setInterval(stickyTick,300);
    /* You may also like: other purchasable products, centered at the page bottom */
    function yml(){
      var gal=document.querySelector('.pgx-gallery');
      if(!gal||document.querySelector('.pgu-yml'))return;
      var cur=(location.pathname.match(/\/products\/([^\/?#]+)/)||[])[1];
      if(!cur)return;
      var skip=['shipping-protection','r36s-protective-case-free-gift','data-frog-protective-bag-for-r36s-retro-video-game-bags-olig-cover-case-for-rg35xx-r35s'];
      fetch('/products.json?limit=50').then(function(r){return r.json();}).then(function(j){
        var ps=(j.products||[]).filter(function(p){var v=(p.variants&&p.variants[0])||{};return p.handle!==cur&&skip.indexOf(p.handle)===-1&&p.images&&p.images.length&&parseFloat(v.price||0)>0;});
        if(!ps.length||document.querySelector('.pgu-yml'))return;
        var d=document.createElement('div'); d.className='pgu-yml';
        d.innerHTML='<div class="pgu-yml-eye">Keep exploring</div><h3>You may also like</h3><div class="pgu-yml-grid">'+
          ps.map(function(p){
            var v=(p.variants&&p.variants[0])||{};
            var now=parseFloat(v.price||0), was=parseFloat(v.compare_at_price||0);
            return '<a href="/products/'+p.handle+'"><img loading="lazy" src="'+p.images[0].src+'" alt=""><div class="t">'+p.title+'</div><div class="p">'+(was>now?'<s>$'+was.toFixed(2)+'</s>':'')+'$'+now.toFixed(2)+'</div></a>';
          }).join('')+'</div>';
        (document.getElementById('pgx')||gal).appendChild(d);
      }).catch(function(){});
    }
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',yml);else yml();
    setTimeout(yml,1200);
    /* Mobile gallery: 1/N counter under the swipe strip */
    function gal(){
      if(!window.matchMedia||!window.matchMedia('(max-width: 900px)').matches)return;
      var g=document.querySelector('#pgx .pgx-gallery');
      if(!g||g.dataset.pgGal)return; g.dataset.pgGal='1';
      var n=g.querySelectorAll('.pgx-hero,[data-pgx-thumb]').length;
      if(n<2)return;
      var c=document.createElement('div'); c.className='pgx-gal-n'; c.textContent='1 / '+n;
      g.parentNode.insertBefore(c,g.nextSibling);
      g.addEventListener('scroll',function(){
        var i=Math.round(g.scrollLeft/(g.scrollWidth/n))+1;
        if(i<1)i=1; if(i>n)i=n;
        c.textContent=i+' / '+n;
      },{passive:true});
    }
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',gal);else gal();
    setTimeout(gal,1000);
  })();
</script>
