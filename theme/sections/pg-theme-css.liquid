<script>
/* ONE CATALOGUE READ PER PAGE, SHARED BY THIS WHOLE FILE.
   Two blocks below each download /products.json?limit=50 -- yml() for "You may
   also like" and pgDuo's build() for the Duo Pack prices -- and each can do it
   more than once:

     - pgDuo's build() runs on a 2500ms interval and guards on
       `first.dataset.pgSingled`, where `first` is
       document.querySelector('#pgx .pgx-tile'). pgLadder inserts its own
       .pgx-lad tiles BEFORE the theme's first tile, so `first` becomes a ladder
       tile that never carried the flag and the guard misses on the pass right
       after the ladder builds.
     - yml() runs at DOMContentLoaded and again at 1200ms, and its
       `document.querySelector('.pgu-yml')` guard is tested BEFORE its own fetch
       resolves, so the second call can start a second download of the same
       catalogue.

   Measured on the orb page with both blocks live: three downloads of the same
   50-product payload (t=27ms, 30ms, 1017ms) per product page view, on mobile
   data. Sharing one in-flight promise takes it to one, with every DOM outcome
   identical -- ladder tiles, the Bundle & Save label, the "You may also like"
   grid and the singling all unchanged.

   The guard is NOT re-pointed at '#pgx .pgx-tile:not(.pgx-lad)', which is the
   more correct reading of `first` and what pgLadder itself uses: that would also
   MOVE the singling, and today pgDuo strips the radio dot from the first LADDER
   tile, which is what is on screen. Changing which tile loses its dot is a
   visible change nobody asked for.

   A FAILED read clears the cache so callers can retry -- caching a rejected
   promise forever would turn one bad response into a permanently missing Duo
   Pack and no "You may also like". */
(function(){
  if (window.pgCatalog) return;
  var CACHE = null;
  window.pgCatalog = function(){
    if (!CACHE){
      CACHE = fetch('/products.json?limit=50').then(function(r){ return r.json(); });
      CACHE.catch(function(){ CACHE = null; });
    }
    return CACHE;
  };
})();
</script>
<script>
  (function(){
    if (window.pgWire) return; window.pgWire = 1;
    /* Pop-out cart: refresh the drawer section markup, then slide it out */
    window.pgOpenCart = function(){
      if (window.pgGiftSync) setTimeout(window.pgGiftSync, 60);
      var done=function(){ if (window.openPanel) { openPanel('cart'); } else { window.location.href='/cart'; } };
      fetch('/?sections=side-cart').then(function(r){return r.json();}).then(function(j){
        var html=j['side-cart']||'';
        var t=document.createElement('div'); t.innerHTML=html;
        var fresh=t.querySelector('#cart'), cur=document.getElementById('cart');
        if(fresh&&cur){cur.innerHTML=fresh.innerHTML;}
        /* SAME CONTRACT AS pgDrawerRefresh. That path announces its swap with
           pg:cart-updated and every drawer section rebuilds on it -- the
           storage picker (pg-cart-variants), the spare-case offer and gift
           cell (pg-cart-tune). This path replaced the same markup silently,
           so a pack added from the product page arrived in the drawer with
           no storage dropdown until some later write happened to fire the
           event. Measured on the Trio Pack: no picker after Add to cart,
           picker within 2.5s of the event being dispatched by hand. */
        try { document.dispatchEvent(new CustomEvent('pg:cart-updated')); } catch(e){}
        done();
      }).catch(done);
    };
    document.addEventListener('click', function(e){
      var a=e.target.closest&&e.target.closest('a[href$="/cart"],a[href*="/cart?"]');
      if(!a)return;
      if(a.closest('#cart'))return;
      e.preventDefault(); e.stopPropagation();
      window.pgOpenCart();
    }, true);
    /* Bottom sticky buy bar on product pages */
    function stickyTick(){
      var atc=document.getElementById('pgx-atc');
      var bar=document.getElementById('pg-sticky');
      if(!atc){ if(bar) bar.classList.remove('on'); return; }
      if(!bar){
        bar=document.createElement('div'); bar.id='pg-sticky';
        bar.innerHTML='<div class="pgst-in"><span class="pgst-t"></span><span class="pgst-p"></span><button type="button" class="pgst-b">Add to cart</button></div>';
        document.body.appendChild(bar);
        bar.querySelector('.pgst-b').addEventListener('click',function(){ atc.click(); });
      }
      var h1=document.querySelector('#pgx h1')||document.querySelector('h1');
      if(h1) bar.querySelector('.pgst-t').textContent=h1.textContent.replace(/\s+/g,' ').trim();
      var sel=document.querySelector('.pgx-tile.pgx-sel')||document.querySelector('.pgx-tile');
      if(sel){
        var m=(sel.textContent.match(/\$[0-9][0-9.,]*/g)||[]);
        var pEl=bar.querySelector('.pgst-p');
        if(m.length){ pEl.innerHTML=(m.length>1?'<s>'+m[1]+'</s>':'')+m[0]; }
      }
      var cart=document.getElementById('cart');
      var open=cart&&/(^|\s)toggle(\s|$)/.test(cart.className);
      var r=atc.getBoundingClientRect();
      var out=(r.width===0&&r.height===0)?(window.pageYOffset>500):(r.bottom<0||r.top>window.innerHeight);
      if(out&&!open){ bar.classList.add('on'); } else { bar.classList.remove('on'); }
    }
    /* Bottom sticky buy bar removed by request. The top 10% OFF cart bar
       (pg-cart-sticky's #pg-cartfab) is the one sticky element that stays.
       stickyTick is kept but never scheduled, and the CSS above pins
       #pg-sticky to display:none in case anything else ever builds it. */
    /* You may also like: every other product, under the gallery stack */
    function yml(){
      var gal=document.querySelector('.pgx-gallery');
      if(!gal||document.querySelector('.pgu-yml'))return;
      var cur=(location.pathname.match(/\/products\/([^\/?#]+)/)||[])[1];
      if(!cur)return;
      window.pgCatalog().then(function(j){
        var ps=(j.products||[]).filter(function(p){var v=(p.variants&&p.variants[0])||{};return p.handle!==cur&&p.images&&p.images.length&&parseFloat(v.price||0)>0;});
        if(!ps.length||document.querySelector('.pgu-yml'))return;
        var d=document.createElement('div'); d.className='pgu-yml';
        d.innerHTML='<div class="pgu-yml-eye">Keep exploring</div><h3>You may also like</h3><div class="pgu-yml-grid">'+
          ps.map(function(p){
            var v=(p.variants&&p.variants[0])||{};
            var now=parseFloat(v.price||0), was=parseFloat(v.compare_at_price||0);
            return '<a href="/products/'+p.handle+'"><img loading="lazy" src="'+p.images[0].src+'" alt=""><div class="t">'+p.title+'</div><div class="p">'+(was>now?'<s>$'+was.toFixed(2)+'</s>':'')+'$'+now.toFixed(2)+'</div></a>';
          }).join('')+'</div>';
        var main=document.querySelector('#pgx .pgx-main');
        if(main&&main.parentElement){
          var qm=document.querySelector('#pgx .pgx-quote[data-pg-moved]');
          var ref=(qm&&qm.parentElement===main.parentElement)?qm.nextSibling:main.nextSibling;
          main.parentElement.insertBefore(d,ref);
        }else{gal.appendChild(d);}
      }).catch(function(){});
    }
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',yml);else yml();
    setTimeout(yml,1200);
  })();
</script>
<script>
