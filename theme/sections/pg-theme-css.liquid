{%- comment -%}
  PG Theme CSS: sitewide Pocketera purple/black overrides.
  Rendered from footer-group so it loads on every page. Paints the footer in the
  logo purple and swaps visible "North Cove" text in the footer to "Pocketera"
  (shop.name itself is untouched so live-site invoicing/emails are unaffected).
{%- endcomment -%}
<style>
  #shopify-section-footer#shopify-section-footer,
  .shopify-section[id$="__footer"].shopify-section[id$="__footer"]{
    background:#7A2FA2 !important;background-color:#7A2FA2 !important;
  }
  #shopify-section-footer#shopify-section-footer [class*="palette-"],
  #shopify-section-footer#shopify-section-footer .module-color-palette,
  .shopify-section[id$="__footer"] [class*="palette-"],
  .shopify-section[id$="__footer"] .module-color-palette{
    background:transparent !important;background-color:transparent !important;
  }
  #shopify-section-footer#shopify-section-footer h1,
  #shopify-section-footer#shopify-section-footer h2,
  #shopify-section-footer#shopify-section-footer h3,
  #shopify-section-footer#shopify-section-footer h4,
  #shopify-section-footer#shopify-section-footer h5,
  #shopify-section-footer#shopify-section-footer p,
  #shopify-section-footer#shopify-section-footer li,
  #shopify-section-footer#shopify-section-footer span,
  #shopify-section-footer#shopify-section-footer label,
  #shopify-section-footer#shopify-section-footer strong,
  #shopify-section-footer#shopify-section-footer div{color:#fff}
  #shopify-section-footer#shopify-section-footer a{color:#EBDCF6}
  #shopify-section-footer#shopify-section-footer a:hover{color:#fff}
  #shopify-section-footer#shopify-section-footer .nc-foot-h{color:#fff !important}
  #shopify-section-footer#shopify-section-footer .nc-foot-links a{color:#EBDCF6 !important}
  #shopify-section-footer#shopify-section-footer .nc-foot-links a:hover{color:#fff !important}
  #shopify-section-footer#shopify-section-footer input[type="email"],
  #shopify-section-footer#shopify-section-footer input[type="text"]{
    background:#fff !important;background-color:#fff !important;color:#1c1c1c !important;border-color:#4A1C66 !important;
  }
  #shopify-section-footer#shopify-section-footer button,
  #shopify-section-footer#shopify-section-footer [class*="button"]{
    background:#121212 !important;background-color:#121212 !important;color:#fff !important;border-color:#121212 !important;
  }

  /* Premium polish, sitewide */
  body{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
  ::selection{background:#7A2FA2;color:#fff}
  .pgx-announce,.pgc-announce{background:linear-gradient(90deg,#4A1C66,#7A2FA2 50%,#4A1C66) !important;text-transform:uppercase;letter-spacing:.08em;font-size:12px !important;font-weight:600}
  #pgx .pgx-hero{border-radius:16px}
  #pgx .pgx-thumbs button{border-radius:14px}
  #pgx .pgx-quote{border-radius:14px}
  #pgx .pgx-tile{border-radius:14px}
  #pgx .pgx-tile.pgx-sel{box-shadow:0 14px 34px -24px rgba(122,47,162,.55)}
  #pgx .pgx-atc{border-radius:10px !important;box-shadow:0 16px 34px -16px rgba(18,18,18,.55)}
  #pgx .pgx-info{border-radius:16px}
  #pgx .pgx-guar{border-radius:10px}
  #pgx .pgx-card{border-radius:14px;box-shadow:0 12px 30px -24px rgba(18,4,28,.4)}
  .pgu-card{box-shadow:0 16px 38px -28px rgba(74,28,102,.5)}
</style>
<script>
  (function(){
    if (window.pgxBrandFix) return; window.pgxBrandFix = 1;
    function fix(){
      var f = document.getElementById('shopify-section-footer') || document.querySelector('.shopify-section[id$="__footer"]');
      if (!f) return;
      var w = document.createTreeWalker(f, NodeFilter.SHOW_TEXT);
      var n;
      while ((n = w.nextNode())){
        if (/North Cove/i.test(n.nodeValue)){
          n.nodeValue = n.nodeValue
            .replace(/North Cove Wellness LLC/gi, 'PocketEra')
            .replace(/North Cove Wellness/gi, 'PocketEra')
            .replace(/North Cove/gi, 'PocketEra');
        }
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fix); else fix();
    setTimeout(fix, 800);
  })();
</script>
{% schema %}
{"name": "PG Theme CSS", "settings": []}
{% endschema %}
