          ['background-color:#16101F','color:#fff','border:1.5px solid rgba(139,68,190,.75)','height:30px','min-height:0','padding:2px 26px 2px 10px','font-size:12.5px','border-radius:8px','width:auto','max-width:140px','line-height:1.2','appearance:none','-webkit-appearance:none','background-repeat:no-repeat','background-position:right 8px center'].forEach(function(kv){
