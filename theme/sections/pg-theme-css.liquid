  #pgx .pgx-acc details[open]{box-shadow:0 12px 28px -20px rgba(74,28,102,.5)}
  /* Cookie banner: theme colors */
  #shopify-pc__banner,#shopify-pc__banner .shopify-pc__banner__dialog{background:linear-gradient(120deg,#F6EFFB,#EEE0F7) !important;color:#2b2b2b !important;border-top:1px solid rgba(122,47,162,.25) !important;box-shadow:0 -12px 32px -22px rgba(74,28,102,.5) !important}
  #shopify-pc__banner p,#shopify-pc__banner span{color:#2b2b2b !important}
  #shopify-pc__banner a{color:#7A2FA2 !important;text-decoration:underline}
  #shopify-pc__banner button{border-radius:999px !important;font-weight:700 !important;letter-spacing:.03em !important}
  #shopify-pc__banner button[id*="accept"],#shopify-pc__banner .shopify-pc__banner__btn-accept{background:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 50%,#4A1C66 100%) !important;background-color:#7A2FA2 !important;color:#fff !important;border:none !important}
