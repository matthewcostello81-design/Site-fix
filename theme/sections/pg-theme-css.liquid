{%- comment -%}
  PG Theme CSS: sitewide Pocketera purple/black overrides.
  Rendered from footer-group so it loads on every page. Paints the footer in the
  logo purple and swaps visible "North Cove" text in the footer to "Pocketera"
  (shop.name itself is untouched so live-site invoicing/emails are unaffected).
{%- endcomment -%}
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@500;700&display=swap" rel="stylesheet">
<style>
  /* Nav links: bigger, bolder, slab font */
  .pgh-nav a,.pgx-nav a,.pgc-nav a,.pgf-nav a{font-family:'Roboto Slab',Georgia,serif !important;font-size:17.5px !important;font-weight:700 !important;color:#4A1C66 !important;letter-spacing:.01em !important}
  .pgh-nav a:hover,.pgx-nav a:hover,.pgc-nav a:hover,.pgf-nav a:hover{color:#7A2FA2 !important}
  #shopify-section-footer#shopify-section-footer,
  .shopify-section[id$="__footer"].shopify-section[id$="__footer"]{
    background:#7A2FA2 !important;background-color:#7A2FA2 !important;
  }
  #shopify-section-footer#shopify-section-footer [class*="palette-"],
  #shopify-section-footer#shopify-section-footer .module-color-palette,
  .shopify-section[id$="__footer"] [class*="palette-"],
  .shopify-section[id$="__footer"] .module-color-palette{
    background:transparent !important;background-color:transparent !important;
  }
  #shopify-section-footer#shopify-section-footer h1,
  #shopify-section-footer#shopify-section-footer h2,
  #shopify-section-footer#shopify-section-footer h3,
  #shopify-section-footer#shopify-section-footer h4,
  #shopify-section-footer#shopify-section-footer h5,
  #shopify-section-footer#shopify-section-footer p,
  #shopify-section-footer#shopify-section-footer li,
  #shopify-section-footer#shopify-section-footer span,
  #shopify-section-footer#shopify-section-footer label,
  #shopify-section-footer#shopify-section-footer strong,
  #shopify-section-footer#shopify-section-footer div{color:#fff}
  #shopify-section-footer#shopify-section-footer a{color:#EBDCF6}
  #shopify-section-footer#shopify-section-footer a:hover{color:#fff}
  #shopify-section-footer#shopify-section-footer .nc-foot-h{color:#fff !important}
  #shopify-section-footer#shopify-section-footer .nc-foot-links a{color:#EBDCF6 !important}
  #shopify-section-footer#shopify-section-footer .nc-foot-links a:hover{color:#fff !important}
  #shopify-section-footer#shopify-section-footer input[type="email"],
  #shopify-section-footer#shopify-section-footer input[type="text"]{
    background:#fff !important;background-color:#fff !important;color:#1c1c1c !important;border-color:#4A1C66 !important;
  }
  #shopify-section-footer#shopify-section-footer button,
  #shopify-section-footer#shopify-section-footer [class*="button"]{
    background:#121212 !important;background-color:#121212 !important;color:#fff !important;border-color:#121212 !important;
  }

  /* Premium polish, sitewide */
  body{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
  /* Purple gradient canvas on every page (stars float above it) */
  html,body,body.template-cart,body.template-cart #content,body.template-cart main,#content,main{background:linear-gradient(160deg,#F8F3FD 0%,#EFE2F9 45%,#E2CDF3 100%) !important;background-attachment:fixed !important}
  /* Full-bleed: the base theme boxes #root in white with 30px side padding */
  #root{padding-left:0 !important;padding-right:0 !important;background:transparent !important;background-color:transparent !important}
  #pgh,#pgx,.pgm{background:transparent !important}
  #pgh .pgh-head,#pgx .pgx-head,.pgc-head{background:rgba(11,7,16,.9) !important;border-bottom:1px solid rgba(168,120,214,.16) !important;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
  .pgh-nav a,.pgx-nav a,.pgc-nav a{color:#E4D9F0 !important}
  .pgh-nav a:hover,.pgx-nav a:hover,.pgc-nav a:hover{color:#C79BEA !important}
  .pgh-logo img,.pgx-logo img,.pgc-logo img{mix-blend-mode:screen !important;filter:none !important}
  .pgh-ic svg,.pgx-ic svg,.pgc-ic svg{stroke:#EFE8F7 !important}
  .pgh-ic a:hover svg,.pgx-ic a:hover svg,.pgc-ic a:hover svg{stroke:#C79BEA !important}
  .pgh-cart-n{background:#C79BEA !important;color:#1A0B28 !important;border-color:#8B44BE !important}
  .pgh-head .pg-search,.pgx-head .pg-search,.pgc-head .pg-search{background:rgba(255,255,255,.06) !important;border-color:rgba(168,120,214,.28) !important}
  .pgh-head .pg-search input,.pgx-head .pg-search input,.pgc-head .pg-search input{color:#EFE8F7 !important}
  .pgh-head .pg-search input::placeholder,.pgx-head .pg-search input::placeholder,.pgc-head .pg-search input::placeholder{color:#9384A8 !important}
  .pgh-head .pg-search svg,.pgx-head .pg-search svg,.pgc-head .pg-search svg{stroke:#9384A8 !important}
  .pgf-head,.pgf-nav{background:rgba(11,7,16,.9) !important;border-bottom-color:rgba(168,120,214,.16) !important}
  .pgf-head img{mix-blend-mode:screen !important}
  .pgf-nav a{color:#E4D9F0 !important}
  /* Logo PNG has a white box baked in; multiply melts it into the tinted bar */
  .pgh-logo img,.pgx-logo img,.pgc-logo img,.pgf-head img{mix-blend-mode:multiply}
  #pgh .pgh-trust{background:rgba(255,255,255,.65) !important;border-color:rgba(122,47,162,.18) !important}
  /* Accordions: outlined dark purple boxes */
  #pgh .pgh-acc{border-top:0 !important}
  #pgh .pgh-acc details{border:1.5px solid #4A1C66 !important;border-bottom:1.5px solid #4A1C66 !important;border-radius:12px;margin-bottom:12px;padding:0 18px;background:rgba(255,255,255,.78)}
  #pgh .pgh-acc details[open]{box-shadow:0 12px 28px -20px rgba(74,28,102,.5)}
  #pgh .pgh-acc summary{padding:18px 2px}
  ::selection{background:#7A2FA2;color:#fff}
  button[name="checkout"]{background:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 50%,#4A1C66 100%) !important;background-color:#7A2FA2 !important;color:#fff !important;border:none !important;border-radius:999px !important;font-weight:700 !important;letter-spacing:.05em !important;text-transform:uppercase !important;box-shadow:0 14px 30px -12px rgba(122,47,162,.6) !important}
  button[name="checkout"]:hover{background:linear-gradient(120deg,#7A2FA2 0%,#4A1C66 100%) !important;background-color:#4A1C66 !important}
  html body button[name="checkout"]::before,html body button[name="checkout"]::after{display:none !important;content:none !important;background:none !important;animation:none !important;opacity:0 !important}

  /* NC header/tabs are gone everywhere; PG headers or the fallback below replace them */
  .shopify-section-header,
  #shopify-section-header,
  .shopify-section[id*="__header"],
  .shopify-section[id*="nc_announce"],
  .shopify-section[id*="nc-announce"]{display:none !important}
  #content{padding-top:0 !important}
  .pgf-announce{background:linear-gradient(90deg,#4A1C66,#7A2FA2 50%,#4A1C66);color:#fff;text-align:center;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:11px 16px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif}
  .pgf-head{background:#fff;border-bottom:1px solid #e9dcf3;text-align:center;padding:14px 16px 6px}
  .pgf-head img{max-height:88px;width:auto;display:inline-block}
  .pgf-nav{display:flex;justify-content:center;gap:26px;padding:8px 16px 14px;flex-wrap:wrap;background:#fff;border-bottom:1px solid #e9dcf3;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif}
  .pgf-nav a{font-size:15px;color:#2b2b2b;text-decoration:none}
  .pgf-nav a:hover{color:#7A2FA2;text-decoration:underline}

  /* Homepage: centered, balanced layout */
  #pgh .pgh-eyebrow,#pgh .pgh-h2{text-align:center}
  /* Hero removed; Best Sellers leads the page */
  #pgh .pgh-hero{display:none !important}
  #pgh .pgh-wrap{padding-top:34px}
  #pgh .pgh-grid{display:flex !important;flex-wrap:wrap;justify-content:center;gap:22px}
  #pgh .pgh-grid .pgh-card{width:calc(50% - 11px);max-width:100%}
  #pgh .pgh-card-t,#pgh .pgh-card-p{text-align:center}
  /* Card ATC: same pill look as the Sale badge, top right of the image */
  #pgh .pgh-badge{top:12px !important;bottom:auto !important}
  #pgh .pgh-atc{position:static !important;left:auto !important;right:auto !important;top:auto !important;bottom:auto !important;transform:none !important;display:block !important;width:calc(100% - 24px) !important;margin:10px 12px 14px !important;padding:11px 16px !important;border:none !important;border-radius:999px !important;background-image:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 30%,#4A1C66 50%,#7A2FA2 70%,#9B4BC4 100%) !important;background-color:#7A2FA2 !important;background-size:240% 240% !important;animation:pgShiftT 5s ease-in-out infinite !important;color:#fff !important;font-weight:700 !important;font-size:13.5px !important;letter-spacing:.05em !important;text-transform:uppercase !important;line-height:1.2 !important;height:auto !important;min-height:0 !important;box-shadow:0 10px 24px -12px rgba(122,47,162,.7) !important;text-align:center !important}
  #pgh .pgh-atc:hover{background:#4A1C66 !important;background-color:#4A1C66 !important;color:#fff !important;transform:none !important}
  /* Banner Shop now button removed per request */
  #pgh .pgh-split-btn{display:none !important}
  /* Collections tiles removed per request */
  #pgh .pgh-wrap:has(.pgh-tiles){display:none !important}
  @media(max-width:900px){
    #pgh .pgh-grid .pgh-card{width:calc(50% - 11px)}
  }
  .pgx-announce,.pgc-announce{text-transform:uppercase;letter-spacing:.08em;font-size:12px !important;font-weight:600}
  /* Announcement bar: animated purple gradient sweeping in from both sides */
  @keyframes pgAnnounceSweep{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
  .pgh-announce,.pgx-announce,.pgc-announce,.pgf-announce{background:linear-gradient(90deg,#2E0E44 0%,#6B2894 22%,#C08BE8 50%,#6B2894 78%,#2E0E44 100%) !important;background-size:220% 100% !important;animation:pgAnnounceSweep 7s ease-in-out infinite}
  #pgx .pgx-hero{border-radius:16px}
  #pgx .pgx-thumbs button{border-radius:14px}
  #pgx .pgx-quote{border-radius:14px}
  #pgx .pgx-tile{border-radius:14px}
  #pgx .pgx-tile{background:#fff !important}
  #pgx .pgx-tile.pgx-sel{box-shadow:0 14px 34px -24px rgba(122,47,162,.55)}
  /* Review carousel next: purple circle, white arrow */
  #pgx .pgx-quote-next{width:44px !important;height:44px !important;min-width:44px !important;min-height:0 !important;flex:none !important;border-radius:50% !important;background:#7A2FA2 !important;background-color:#7A2FA2 !important;background-image:none !important;color:#fff !important;border:none !important;font-size:24px !important;line-height:1 !important;padding:0 0 3px !important;margin-left:auto !important;display:flex !important;align-items:center !important;justify-content:center !important;box-shadow:0 10px 22px -10px rgba(122,47,162,.6) !important;animation:none !important;text-transform:none !important}
  #pgx .pgx-quote-next:hover{background:#4A1C66 !important;background-color:#4A1C66 !important}
  #pgx .pgx-atc{display:flex !important;align-items:center !important;justify-content:center !important;text-align:center !important;width:100% !important;max-width:100% !important;margin:16px auto 6px !important;border-radius:999px !important;background-image:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 30%,#4A1C66 50%,#7A2FA2 70%,#9B4BC4 100%) !important;background-size:240% 240% !important;animation:pgShiftT 5s ease-in-out infinite !important;background-color:#7A2FA2 !important;color:#fff !important;box-shadow:0 16px 34px -14px rgba(122,47,162,.65);text-transform:uppercase;letter-spacing:.06em !important;font-weight:700 !important;float:none !important}
  #pgx .pgx-atc:hover{background:#4A1C66 !important;background-color:#4A1C66 !important}
  #pgx .pgx-atc span{display:inline-block;width:auto}
  #pgx .pgx-info{margin:16px auto !important;width:100% !important}
  #pgx .pgx-tile-opts .pgx-plus{align-self:center !important;margin-top:14px}
  #pgx .pgx-info{border-radius:16px;border-color:rgba(122,47,162,.35) !important;background:linear-gradient(180deg,#fff,#faf6fd);box-shadow:0 0 0 1px rgba(122,47,162,.08),0 0 28px rgba(122,47,162,.22),0 18px 44px -24px rgba(122,47,162,.5)}
  #pgx .pgx-info-ic{box-shadow:0 0 16px rgba(122,47,162,.35)}
  #pgx .pgx-guar{border-radius:12px;justify-content:center !important;text-align:center;font-size:15px !important;font-weight:800 !important;padding:13px 18px !important;background:linear-gradient(120deg,#FFFFFF,#F4EAFB) !important;color:#7A2FA2 !important;letter-spacing:.01em;box-shadow:0 0 0 1px rgba(122,47,162,.3),0 14px 30px -18px rgba(122,47,162,.55)}
  #pgx .pgx-guar:before{width:11px !important;height:11px !important;background:#7A2FA2 !important}
  #pgx .pgx-card{border-radius:14px;box-shadow:0 12px 30px -24px rgba(18,4,28,.4)}
  .pgu-card{box-shadow:0 16px 38px -28px rgba(74,28,102,.5)}
  /* round 2 batch */
  /* native multi/bundle tiles retired; single (and lamp ladder) only */
  #pgx .pgx-tile[data-pgx-tile]:not([data-pgx-tile="single"]):not(.pgx-lad){display:none !important}

  body.template-index .pgf-stars{display:none !important}
  #pgh .pgh-wrap:has(.pgh-grid) .pgh-eyebrow{font-size:14px !important;letter-spacing:.26em !important}
  #pgh .pgh-wrap:has(.pgh-grid) .pgh-h2{font-size:46px !important;line-height:1.15 !important}
  .pgh-tw{position:relative;display:inline-block}
  .pgh-tw i{position:absolute;display:block;clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);animation:pgfTwinkle 3.2s ease-in-out infinite;opacity:.7;filter:drop-shadow(0 0 7px rgba(180,120,224,.9));pointer-events:none}
  /* unified price typography (PocketBoy duo style) */
  #pgx .pgx-tile-price,#pgx .pgx-tile-price *,.pgx-lad-px b,.pgx-duo-px b,.pgst-p,.pgu-yml-grid .p,#pgh .pgh-card-p,#cart .nc-lsave-now,.pgm-price,.pgm-total{font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif !important;font-weight:800 !important;letter-spacing:.01em}
  #pgx .pgx-tile:not(.pgx-lad):not(.pgx-duo) .pgx-tile-price{font-size:19px !important}
  #pgx .pgx-tile-price .pgx-sstrike,#pgx .pgx-tile-price s,#pgx .pgx-tile-price .old-price{font-size:12.5px !important;font-weight:400 !important}
  /* custom image dropdown */
  .pg-drop{position:relative;display:inline-block;min-width:160px}
  .pg-drop-h{display:flex;align-items:center;gap:8px;background:#16101F;border:1.5px solid rgba(139,68,190,.75);border-radius:10px;padding:4px 10px 4px 6px;cursor:pointer;color:#fff;font-size:13px;font-weight:600}
  .pg-drop-h img,.pg-drop-r img{width:30px;height:30px;border-radius:7px;object-fit:cover;flex:none;background:#0D0714}
  .pg-drop-h b{margin-left:auto;color:#C79BEA;font-size:11px;font-weight:400}
  .pg-drop-l{display:none;position:absolute;top:calc(100% + 4px);left:0;min-width:100%;max-height:250px;overflow:auto;background:#16101F;border:1.5px solid rgba(139,68,190,.75);border-radius:12px;z-index:60;box-shadow:0 18px 40px -18px rgba(0,0,0,.85)}
  .pg-drop.on .pg-drop-l{display:block}
  .pg-drop-r{display:flex;align-items:center;gap:9px;padding:7px 10px;cursor:pointer;color:#fff;font-size:13px;white-space:nowrap}
  .pg-drop-r:hover{background:rgba(139,68,190,.28)}
  #cart .pg-drop-h,#cart .pg-drop-l{background:#fff;color:#333;border-color:#ddd}
  #cart .pg-drop-r{color:#333}
  #cart .pg-drop-r:hover{background:#f3ebfa}
  /* Poke Ball tier ladder */
  .pgx-lad{position:relative}
  .pgx-lad-badge{position:absolute;top:-13px;right:14px;background:#0D0714;color:#fff !important;font-size:11.5px;font-weight:800;letter-spacing:.04em;padding:5px 14px;border-radius:999px;border:1px solid rgba(139,68,190,.6)}
  .pgx-lad-head{display:flex;align-items:flex-start;gap:12px}
  .pgx-lad-t{flex:1;min-width:0}
  .pgx-lad-t b{font-size:18px;font-weight:800}
  .pgx-lad-chip{display:inline-block;background-image:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 30%,#4A1C66 50%,#7A2FA2 70%,#9B4BC4 100%);background-size:240% 240%;animation:pgShiftT 5s ease-in-out infinite;color:#fff !important;font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;margin-left:8px;vertical-align:2px;white-space:nowrap}
  .pgx-lad-save{font-size:13.5px;font-weight:700;color:#C79BEA !important;margin-top:3px}
  .pgx-lad-px{text-align:right}
  .pgx-lad-px b{display:block;font-size:19px;font-weight:800}
  .pgx-lad-px s{display:block;font-size:12.5px;color:rgba(255,255,255,.55) !important;font-weight:400}
  .pgx-lad-picks{margin-top:12px;display:none}
  .pgx-tile.pgx-sel .pgx-lad-picks{display:block}
  .pgx-lad-picks .lbl{font-size:12.5px;color:rgba(255,255,255,.7) !important;margin-bottom:6px}
  .pgx-lad-row{display:flex;align-items:center;gap:10px;margin-bottom:8px}
  .pgx-lad-row > img{width:44px;height:44px;object-fit:cover;border-radius:8px;flex:none;background:#0D0714}
  .pgx-lad-selw{display:flex;align-items:center;gap:7px;background:#16101F;border:1.5px solid rgba(139,68,190,.75);border-radius:10px;padding:3px 4px 3px 7px}
  .pgx-lad-selw img{width:30px;height:30px;border-radius:7px;object-fit:cover;flex:none}
  /* Duo pack tile */
  .pgx-bs{display:flex;align-items:center;gap:14px;margin:20px 0 12px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;font-size:15px;color:#fff}
  .pgx-bs:before,.pgx-bs:after{content:"";flex:1;height:2px;background:rgba(139,68,190,.4);border-radius:2px}
  .pgx-tile[data-pg-singled] .pgx-tile-row{align-items:flex-start}
  .pgx-storage-lb{font-size:12.5px;color:rgba(255,255,255,.7) !important;margin:12px 0 5px}
  .pgx-storage{font-size:13px;padding:6px 10px;border-radius:8px;border:1px solid rgba(139,68,190,.5);background:#16101F;color:#fff !important;font-family:inherit}
  .pgx-sstrike{display:block;font-size:12.5px;color:rgba(255,255,255,.55) !important;font-weight:400;text-decoration:line-through;text-align:right}

  .pgx-tile.pgx-duo{position:relative;margin-top:26px}
  .pgx-duo-ribbon{position:absolute;top:-13px;right:14px;background-image:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 30%,#4A1C66 50%,#7A2FA2 70%,#9B4BC4 100%);background-size:240% 240%;animation:pgShiftT 5s ease-in-out infinite;color:#fff !important;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:5px 14px;border-radius:999px;box-shadow:0 8px 18px -8px rgba(122,47,162,.8)}
  .pgx-duo-head{display:flex;align-items:flex-start;gap:12px}
  .pgx-duo-dot{flex:none;width:20px;height:20px;border-radius:50%;border:2px solid #8B44BE;margin-top:3px;position:relative}
  .pgx-tile.pgx-sel .pgx-duo-dot:after{content:"";position:absolute;inset:3px;border-radius:50%;background:#9B4BC4}
  .pgx-duo-t{flex:1;min-width:0}
  .pgx-duo-t b{display:block;font-size:17px;font-weight:800}
  .pgx-duo-t small{display:block;font-size:13.5px;font-weight:600;color:#C79BEA !important;margin-top:2px}
  .pgx-duo-px{text-align:right}
  .pgx-duo-px b{display:block;font-size:19px;font-weight:800}
  .pgx-duo-px s{display:block;font-size:12.5px;color:rgba(255,255,255,.55) !important;font-weight:400}
  .pgx-duo-body{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid rgba(139,68,190,.4);border-radius:12px;margin-top:14px;overflow:visible}
  .pgx-duo-u{padding:14px 10px;text-align:center}
  .pgx-duo-u:first-child{border-right:1px solid rgba(139,68,190,.35)}
  .pgx-duo-u img{width:74px;height:74px;object-fit:cover;border-radius:10px;display:block;margin:0 auto 8px}
  .pgx-duo-u .n{font-size:13.5px;font-weight:700;margin-bottom:4px}
  .pgx-duo-u .pp{font-size:14px;font-weight:800;margin-bottom:8px}
  .pgx-duo-u .pp s{font-size:11.5px;color:rgba(255,255,255,.5) !important;font-weight:400;margin-left:5px}
  .pgx-duo-u select{font-size:12.5px;padding:4px 8px;border-radius:8px;border:1px solid rgba(139,68,190,.5);background:#16101F;color:#fff;font-family:inherit}
  .pgx-duo-plus{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:30px;height:30px;border-radius:50%;background:#7A2FA2;color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:700;box-shadow:0 6px 14px -6px rgba(0,0,0,.6);z-index:2}

  .pgh-announce,.pgx-announce,.pgc-announce,.pgf-announce{overflow:hidden !important;padding-left:0 !important;padding-right:0 !important}
  .pg-marq{display:inline-flex !important;flex-wrap:nowrap !important;white-space:nowrap !important;width:max-content !important;animation:pgMarqScroll 45s linear infinite !important;will-change:transform}
  .pg-marq > span{display:inline-block !important;white-space:nowrap !important;padding:0 20px}
  @keyframes pgMarqScroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
