  #shopify-section-header,
  .shopify-section[id*="__header"],
  .shopify-section[id*="nc_announce"],
  .shopify-section[id*="nc-announce"]{display:none !important}
  #content{padding-top:0 !important}
  .pgf-announce{background:linear-gradient(90deg,#4A1C66,#7A2FA2 50%,#4A1C66);color:#fff;text-align:center;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:11px 16px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif}
  .pgf-head{background:#fff;border-bottom:1px solid #e9dcf3;text-align:center;padding:14px 16px 6px}
  .pgf-head img{max-height:88px;width:auto;display:inline-block}
  .pgf-nav{display:flex;justify-content:center;gap:26px;padding:8px 16px 14px;flex-wrap:wrap;background:#fff;border-bottom:1px solid #e9dcf3;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif}
  .pgf-nav a{font-size:15px;color:#2b2b2b;text-decoration:none}
  .pgf-nav a:hover{color:#7A2FA2;text-decoration:underline}

  /* Homepage: centered, balanced layout */
  #pgh .pgh-eyebrow,#pgh .pgh-h2{text-align:center}
  /* Hero removed; Best Sellers leads the page */
  #pgh .pgh-hero{display:none !important}
  #pgh .pgh-wrap{padding-top:34px}
  #pgh .pgh-grid{display:flex !important;flex-wrap:wrap;justify-content:center;gap:22px}
  #pgh .pgh-grid .pgh-card{width:calc(50% - 11px);max-width:100%}
  #pgh .pgh-card-t,#pgh .pgh-card-p{text-align:center}
  /* Card ATC: same pill look as the Sale badge, top right of the image */
  #pgh .pgh-badge{top:12px !important;bottom:auto !important}
  #pgh .pgh-atc{position:absolute !important;left:auto !important;right:12px !important;top:12px !important;bottom:auto !important;transform:none !important;background:#fff !important;background-color:#fff !important;background-image:none !important;color:#121212 !important;border:1px solid #e2e2e2 !important;border-radius:999px !important;font-size:12.5px !important;font-weight:500 !important;line-height:1.4 !important;padding:5px 16px !important;margin:0 !important;width:auto !important;min-width:0 !important;height:auto !important;min-height:0 !important;text-transform:none !important;letter-spacing:0 !important;box-shadow:0 6px 16px -8px rgba(0,0,0,.35) !important;animation:none !important}
  #pgh .pgh-atc:hover{background:#7A2FA2 !important;background-color:#7A2FA2 !important;color:#fff !important;border-color:#7A2FA2 !important;transform:none !important}
  /* Banner Shop now button removed per request */
  #pgh .pgh-split-btn{display:none !important}
  /* Collections tiles removed per request */
  #pgh .pgh-wrap:has(.pgh-tiles){display:none !important}
  @media(max-width:900px){
    #pgh .pgh-grid .pgh-card{width:calc(50% - 11px)}
  }
  .pgx-announce,.pgc-announce{text-transform:uppercase;letter-spacing:.08em;font-size:12px !important;font-weight:600}
  /* Announcement bar: animated purple gradient sweeping in from both sides */
  @keyframes pgAnnounceSweep{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
  .pgh-announce,.pgx-announce,.pgc-announce,.pgf-announce{background:linear-gradient(90deg,#4A1C66 0%,#7A2FA2 20%,#9B4BC4 50%,#7A2FA2 80%,#4A1C66 100%) !important;background-size:220% 100% !important;animation:pgAnnounceSweep 7s ease-in-out infinite}
  #pgx .pgx-hero{border-radius:16px}
  #pgx .pgx-thumbs button{border-radius:14px}
  #pgx .pgx-quote{border-radius:14px}
