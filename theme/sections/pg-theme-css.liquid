<script>
(function(){
  if (window.pgDuo) return; window.pgDuo = 1;
  var VARS = null, BUSY = false;
  function money(n){ return '$' + n.toFixed(2); }
  function duoDisc(p1, p2, v1, v2){
    /* 2nd console 25% off, matching the "R36S - 2nd Console 25% Off" automatic discount */
    return Math.round(p2 * 25) / 100;
  }
  function calc(tile){
    if (!VARS) return;
    var sels = tile.querySelectorAll('select');
    var v1 = VARS.filter(function(v){ return String(v.id) === sels[0].value; })[0];
    var v2 = VARS.filter(function(v){ return String(v.id) === sels[1].value; })[0];
    if (!v1 || !v2) return;
    var disc = duoDisc(v1.p, v2.p, v1.id, v2.id);
    var total = v1.p + v2.p - disc;
    var orig = (v1.c || v1.p) + (v2.c || v2.p);
    tile.querySelector('.pgx-duo-px b').textContent = money(total);
    tile.querySelector('.pgx-duo-px s').textContent = money(orig);
    var u2 = tile.querySelectorAll('.pgx-duo-u .pp');
    u2[0].innerHTML = money(v1.p);
    u2[1].innerHTML = money(Math.max(0, v2.p - disc)) + '<s>' + money(v2.p) + '</s>';
    var pct = Math.round(disc / v2.p * 100);
    tile.querySelector('.pgx-duo-t small').textContent = '2nd R36S = Extra ' + pct + '% OFF!';
  }
  function build(){
    var m = location.pathname.match(/\/products\/([^\/?#]+)/);
    if (!m) return;
    var isR36 = m[1] === 'handheld-game-console';
    var first = document.querySelector('#pgx .pgx-tile');
    if (!first || !first.parentElement) return;
    if (first.dataset.pgSingled && (!isR36 || document.querySelector('.pgx-duo'))) return;
    fetch('/products.json?limit=50').then(function(r){ return r.json(); }).then(function(j){
      var p = (j.products || []).filter(function(x){ return x.handle === m[1]; })[0];
      if (!p) return;
      var img = (p.images && p.images[0] && p.images[0].src) || '';
      VARS = (p.variants || []).map(function(v){ return {id: v.id, t: (v.title.indexOf('/') > -1 ? v.title.split('/').pop() : v.title).replace(/^\s+|\s+$/g, ''), p: parseFloat(v.price || 0), c: parseFloat(v.compare_at_price || 0)}; });
      if (VARS.length < 1) return;
      var opts = VARS.map(function(v){ return '<option value="' + v.id + '">' + v.t + '</option>'; }).join('');
      if (isR36 && !document.querySelector('.pgx-duo')){
      var tile = document.createElement('div');
      tile.className = 'pgx-tile pgx-duo';
      tile.setAttribute('data-pgx-duo', '1');
      tile.setAttribute('role', 'radio');
      tile.setAttribute('aria-checked', 'false');
      tile.setAttribute('tabindex', '0');
      tile.innerHTML = '<span class="pgx-duo-ribbon">Limited Time Deal</span>'
        + '<div class="pgx-duo-head"><span class="pgx-duo-dot"></span>'
        + '<div class="pgx-duo-t"><b>Duo Pack <span class="pgx-lad-chip">+ FREE Case</span></b><small>2nd R36S = Extra 25% OFF!</small></div>'
        + '<div class="pgx-duo-px"><b></b><s></s></div></div>'
        + '<div class="pgx-duo-body" style="border:1px solid rgba(139,68,190,.5);border-radius:12px"><span class="pgx-duo-plus">+</span>'
        + '<div class="pgx-duo-u" style="border-right:1px solid rgba(139,68,190,.45)"><img src="' + img + '" alt=""><div class="n">R36S</div><div class="pp"></div><select aria-label="Version 1">' + opts + '</select></div>'
        + '<div class="pgx-duo-u"><img src="' + img + '" alt=""><div class="n">R36S</div><div class="pp"></div><select aria-label="Version 2">' + opts + '</select></div></div>';
      first.parentElement.insertBefore(tile, first.nextSibling);
      calc(tile);
      }
      if (!document.querySelector('.pgx-bs')){
        var bs = document.createElement('div');
        bs.className = 'pgx-bs';
        bs.innerHTML = '<span>Bundle &amp; Save</span>';
        first.parentElement.insertBefore(bs, first);
      }
      if (!first.dataset.pgSingled){
        first.dataset.pgSingled = '1';
        var od = first.querySelector('.pgx-duo-dot');
        if (od) od.remove();
        if (isR36){
          var nm = first.querySelector('.pgx-tile-name') || first.querySelector('.pgx-tile-row b, .pgx-tile-row h3');
          if (nm && !nm.querySelector('.pgx-lad-chip')) nm.insertAdjacentHTML('beforeend', ' <span class="pgx-lad-chip">+ FREE Case</span>');
        }
        var priceBox = first.querySelector('.pgx-tile-price');
        if (priceBox && !priceBox.querySelector('.pgx-sstrike') && VARS[0] && VARS[0].c > VARS[0].p){
          var ss = document.createElement('s');
          ss.className = 'pgx-sstrike';
          ss.textContent = money(VARS[0].c);
          priceBox.appendChild(ss);
        }
        var haveSel = first.querySelector('.pgx-tile-opts select');
        var pills = haveSel ? [] : Array.prototype.slice.call(first.querySelectorAll('.pgx-tile-opts button, .pgx-tile-opts [role="button"], .pgx-tile-opts span'));
        if (pills.length > 1 && !first.querySelector('.pgx-storage')){
          var lb = document.createElement('div');
          lb.className = 'pgx-storage-lb';
          lb.textContent = 'Storage';
          var sl = document.createElement('select');
          sl.className = 'pgx-storage';
          sl.setAttribute('aria-label', 'Storage');
          pills.forEach(function(pl, i){
            var o = document.createElement('option');
            o.value = String(i);
            o.textContent = pl.textContent.replace(/^\s+|\s+$/g, '');
            sl.appendChild(o);
          });
          sl.addEventListener('click', function(e){ e.stopPropagation(); });
          sl.addEventListener('change', function(){
            var pl = pills[parseInt(sl.value, 10)];
            if (pl) pl.click();
            var vv = VARS.filter(function(v){ return v.t === sl.options[sl.selectedIndex].textContent; })[0];
            var st2 = first.querySelector('.pgx-sstrike');
            if (vv && st2 && vv.c > vv.p) st2.textContent = money(vv.c);
          });
          var opts2 = first.querySelector('.pgx-tile-opts');
          opts2.parentElement.insertBefore(lb, opts2);
          opts2.parentElement.insertBefore(sl, opts2);
        }
      }
      var duoSels = tile.querySelectorAll('select');
      duoSels.forEach(function(sel){
        sel.addEventListener('click', function(e){ e.stopPropagation(); });
        sel.addEventListener('change', function(){
          duoSels.forEach(function(o){ if (o !== sel && o.value !== sel.value) o.value = sel.value; });
          calc(tile);
        });
      });
      tile.addEventListener('click', function(){
        document.querySelectorAll('#pgx .pgx-tile.pgx-sel').forEach(function(t){ t.classList.remove('pgx-sel'); t.setAttribute('aria-checked', 'false'); });
        tile.classList.add('pgx-sel');
        tile.setAttribute('aria-checked', 'true');
      });
      document.addEventListener('click', function(e){
        var other = e.target.closest('#pgx .pgx-tile');
        if (other && other !== tile && tile.classList.contains('pgx-sel')){
          tile.classList.remove('pgx-sel');
          tile.setAttribute('aria-checked', 'false');
        }
      }, true);
      document.addEventListener('click', function(e){
        var b = e.target.closest('.pgx-atc');
        if (!b || !tile.classList.contains('pgx-sel') || BUSY) return;
        e.preventDefault();
        e.stopPropagation();
        BUSY = true;
        var sels = tile.querySelectorAll('select');
        var id1 = parseInt(sels[0].value, 10), id2 = parseInt(sels[1].value, 10);
        var items = id1 === id2 ? [{id: id1, quantity: 2}] : [{id: id1, quantity: 1}, {id: id2, quantity: 1}];
        fetch('/cart/add.js', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({items: items})})
          .then(function(){ BUSY = false; if (window.pgOpenCart) window.pgOpenCart(); })
          .catch(function(){ BUSY = false; });
      }, true);
    }).catch(function(){});
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', build); else build();
  setTimeout(build, 1000); setInterval(function(){ build(); }, 2500);
})();
</script>
<script>
(function(){
  if (window.pgLadder) return; window.pgLadder = 1;
  var BUSY = false;
  function money(n){ return '$' + n.toFixed(2); }
  function build(){
    var m = location.pathname.match(/\/products\/([^\/?#]+)/);
    var LADDER = ['pokemon-crystal', 'wall-art'];
    if (!m || !LADDER.some(function(k){ return m[1].indexOf(k) !== -1; })) return;
    if (!window.pgDrop) return;
    if (document.querySelector('.pgx-lad')) return;
    var first = document.querySelector('#pgx .pgx-tile:not(.pgx-lad)');
    if (!first || !first.parentElement) return;
    fetch('/products/' + m[1] + '.js').then(function(r){ return r.json(); }).then(function(p){
      if (!p || !p.variants || document.querySelector('.pgx-lad')) return;
      var unit = (p.variants[0].price || 0) / 100;
      var VOPTS = p.variants.filter(function(v){ return v.available !== false; }).map(function(v){
        return {id: v.id, t: v.title, img: (v.featured_image && v.featured_image.src) || (p.images && p.images[0]) || ''};
      });
      if (!unit || !VOPTS.length) return;
      var host = first.parentElement;
      var natives = Array.prototype.slice.call(host.querySelectorAll('.pgx-tile:not(.pgx-lad)'));
      natives.forEach(function(t){ t.style.setProperty('display', 'none', 'important'); });
      var TIERS = [
        {n: 1, f: 0, bases: 1, badge: '', title: 'Buy 1', sub: 'Standard price + FREE LED Base'},
        {n: 2, f: 0, h: 1, bases: 3, badge: 'Most Popular &#128293;', title: 'Buy 2, 3rd 50% OFF', sub: ''},
        {n: 4, f: 1, bases: 5, badge: '', title: 'Buy 4, Get 1 FREE', sub: ''},
        {n: 6, f: 2, bases: 8, badge: 'Best Deal!', title: 'Buy 6, Get 2 FREE', sub: ''}
      ];
      var tiles = [];
      TIERS.forEach(function(T, ti){
        var half = T.h || 0;
        var pay = (T.n + half * 0.5) * unit, save = (T.f + half * 0.5) * unit, full = (T.n + T.f + half) * unit;
        var pct = Math.round(save / full * 100);
        var tile = document.createElement('div');
        tile.className = 'pgx-tile pgx-lad' + (ti === 0 ? ' pgx-sel' : '');
        tile.setAttribute('role', 'radio');
        tile.setAttribute('aria-checked', ti === 0 ? 'true' : 'false');
        tile.setAttribute('tabindex', '0');
        tile.setAttribute('data-pg-tier', String(ti));
        var chips = T.bases > 1 ? '<span class="pgx-lad-chip">+' + T.bases + (m[1].indexOf('wall-art') !== -1 ? ' PRINTS' : ' FREE LED Bases') + '</span>' : '';
        var saveLn = (T.f > 0 || half > 0) ? '<div class="pgx-lad-save">YOU SAVE ' + money(save) + ' (' + pct + '% OFF)</div>' : '<div class="pgx-lad-save">' + T.sub + '</div>';
        tile.innerHTML = (T.badge ? '<span class="pgx-lad-badge">' + T.badge + '</span>' : '')
          + '<div class="pgx-lad-head"><span class="pgx-duo-dot"></span>'
          + '<div class="pgx-lad-t"><b>' + T.title + '</b>' + chips + saveLn + '</div>'
          + '<div class="pgx-lad-px"><b>' + money(pay) + '</b>' + ((T.f > 0 || half > 0) ? '<s>' + money(full) + '</s>' : (unit < ((p.variants[0].compare_at_price || 0) / 100) ? '<s>' + money((p.variants[0].compare_at_price) / 100) + '</s>' : '')) + '</div></div>'
          + '<div class="pgx-lad-picks"><div class="lbl">' + (m[1].indexOf('wall-art') !== -1 ? 'Choose your prints' : 'Choose your Poke Balls') + '</div></div>';
        var picks = tile.querySelector('.pgx-lad-picks');
        var total = T.n + T.f + half;
        for (var i = 0; i < total; i++){
          var row = document.createElement('div');
          row.className = 'pgx-lad-row';
          row.appendChild(window.pgDrop(VOPTS, VOPTS[i % VOPTS.length].id, null));
          picks.appendChild(row);
        }
        host.insertBefore(tile, first);
        tiles.push(tile);
        tile.addEventListener('click', function(){
          tiles.forEach(function(t2){ t2.classList.remove('pgx-sel'); t2.setAttribute('aria-checked', 'false'); t2.dataset.pgTp = ''; });
          tile.classList.add('pgx-sel');
          tile.setAttribute('aria-checked', 'true');
        });
      });
      document.addEventListener('click', function(e){
        var b = e.target.closest('.pgx-atc');
        if (!b || BUSY) return;
        var sel = document.querySelector('.pgx-lad.pgx-sel');
        if (!sel) return;
        e.preventDefault();
        e.stopPropagation();
        BUSY = true;
        var counts = {};
        sel.querySelectorAll('.pgx-lad-picks .pg-drop').forEach(function(d2){
          var vv = d2.pgValue();
          counts[vv] = (counts[vv] || 0) + 1;
        });
        var items = Object.keys(counts).map(function(k){ return {id: parseInt(k, 10), quantity: counts[k]}; });
        fetch('/cart/add.js', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({items: items})})
          .then(function(){ BUSY = false; if (window.pgOpenCart) window.pgOpenCart(); })
          .catch(function(){ BUSY = false; });
      }, true);
    }).catch(function(){});
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', build); else build();
  setTimeout(build, 1200); setInterval(build, 3000);
})();
</script>
