{%- comment -%}
  PG Theme CSS: sitewide Pocketera purple/black overrides.
  Rendered from footer-group so it loads on every page. Paints the footer in the
  logo purple and swaps visible "North Cove" text in the footer to "Pocketera"
  (shop.name itself is untouched so live-site invoicing/emails are unaffected).
{%- endcomment -%}
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@500;700&display=swap" rel="stylesheet">
<style>
  /* Nav links: bigger, bolder, slab font */
  .pgh-nav a,.pgx-nav a,.pgc-nav a,.pgf-nav a{font-family:'Roboto Slab',Georgia,serif !important;font-size:17.5px !important;font-weight:700 !important;color:#4A1C66 !important;letter-spacing:.01em !important}
  .pgh-nav a:hover,.pgx-nav a:hover,.pgc-nav a:hover,.pgf-nav a:hover{color:#7A2FA2 !important}
  #shopify-section-footer#shopify-section-footer,
  .shopify-section[id$="__footer"].shopify-section[id$="__footer"]{
    background:#7A2FA2 !important;background-color:#7A2FA2 !important;
  }
  #shopify-section-footer#shopify-section-footer [class*="palette-"],
  #shopify-section-footer#shopify-section-footer .module-color-palette,
  .shopify-section[id$="__footer"] [class*="palette-"],
  .shopify-section[id$="__footer"] .module-color-palette{
    background:transparent !important;background-color:transparent !important;
  }
  #shopify-section-footer#shopify-section-footer h1,
  #shopify-section-footer#shopify-section-footer h2,
  #shopify-section-footer#shopify-section-footer h3,
  #shopify-section-footer#shopify-section-footer h4,
  #shopify-section-footer#shopify-section-footer h5,
  #shopify-section-footer#shopify-section-footer p,
  #shopify-section-footer#shopify-section-footer li,
  #shopify-section-footer#shopify-section-footer span,
  #shopify-section-footer#shopify-section-footer label,
  #shopify-section-footer#shopify-section-footer strong,
  #shopify-section-footer#shopify-section-footer div{color:#fff}
  #shopify-section-footer#shopify-section-footer a{color:#EBDCF6}
  #shopify-section-footer#shopify-section-footer a:hover{color:#fff}
  #shopify-section-footer#shopify-section-footer .nc-foot-h{color:#fff !important}
  #shopify-section-footer#shopify-section-footer .nc-foot-links a{color:#EBDCF6 !important}
  #shopify-section-footer#shopify-section-footer .nc-foot-links a:hover{color:#fff !important}
  #shopify-section-footer#shopify-section-footer input[type="email"],
  #shopify-section-footer#shopify-section-footer input[type="text"]{
    background:#fff !important;background-color:#fff !important;color:#1c1c1c !important;border-color:#4A1C66 !important;
  }
  #shopify-section-footer#shopify-section-footer button,
  #shopify-section-footer#shopify-section-footer [class*="button"]{
    background:#121212 !important;background-color:#121212 !important;color:#fff !important;border-color:#121212 !important;
  }

  /* Premium polish, sitewide */
  body{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
  /* Purple gradient canvas on every page (stars float above it) */
  html,body,body.template-cart,body.template-cart #content,body.template-cart main,#content,main{background:linear-gradient(160deg,#F8F3FD 0%,#EFE2F9 45%,#E2CDF3 100%) !important;background-attachment:fixed !important}
  #pgh,#pgx,.pgm{background:transparent !important}
  #pgh .pgh-head,#pgx .pgx-head,.pgc-head{background:rgba(243,233,251,.88) !important;border-bottom:1px solid rgba(122,47,162,.16) !important;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
  .pgf-head,.pgf-nav{background:rgba(243,233,251,.88) !important;border-bottom-color:rgba(122,47,162,.16) !important}
  /* Logo PNG has a white box baked in; multiply melts it into the tinted bar */
  .pgh-logo img,.pgx-logo img,.pgc-logo img,.pgf-head img{mix-blend-mode:multiply}
  #pgh .pgh-trust{background:rgba(255,255,255,.65) !important;border-color:rgba(122,47,162,.18) !important}
  /* Accordions: outlined dark purple boxes */
  #pgh .pgh-acc{border-top:0 !important}
  #pgh .pgh-acc details{border:1.5px solid #4A1C66 !important;border-bottom:1.5px solid #4A1C66 !important;border-radius:12px;margin-bottom:12px;padding:0 18px;background:rgba(255,255,255,.78)}
  #pgh .pgh-acc details[open]{box-shadow:0 12px 28px -20px rgba(74,28,102,.5)}
  #pgh .pgh-acc summary{padding:18px 2px}
  ::selection{background:#7A2FA2;color:#fff}
  button[name="checkout"]{background:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 50%,#4A1C66 100%) !important;background-color:#7A2FA2 !important;color:#fff !important;border:none !important;border-radius:999px !important;font-weight:700 !important;letter-spacing:.05em !important;text-transform:uppercase !important;box-shadow:0 14px 30px -12px rgba(122,47,162,.6) !important}
  button[name="checkout"]:hover{background:linear-gradient(120deg,#7A2FA2 0%,#4A1C66 100%) !important;background-color:#4A1C66 !important}
  html body button[name="checkout"]::before,html body button[name="checkout"]::after{display:none !important;content:none !important;background:none !important;animation:none !important;opacity:0 !important}

  /* NC header/tabs are gone everywhere; PG headers or the fallback below replace them */
  .shopify-section-header,
  #shopify-section-header,
  .shopify-section[id*="__header"],
  .shopify-section[id*="nc_announce"],
  .shopify-section[id*="nc-announce"]{display:none !important}
  #content{padding-top:0 !important}
  .pgf-announce{background:linear-gradient(90deg,#4A1C66,#7A2FA2 50%,#4A1C66);color:#fff;text-align:center;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:11px 16px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif}
  .pgf-head{background:#fff;border-bottom:1px solid #e9dcf3;text-align:center;padding:14px 16px 6px}
  .pgf-head img{max-height:88px;width:auto;display:inline-block}
  .pgf-nav{display:flex;justify-content:center;gap:26px;padding:8px 16px 14px;flex-wrap:wrap;background:#fff;border-bottom:1px solid #e9dcf3;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif}
  .pgf-nav a{font-size:15px;color:#2b2b2b;text-decoration:none}
  .pgf-nav a:hover{color:#7A2FA2;text-decoration:underline}

  /* Homepage: centered, balanced layout */
  #pgh .pgh-eyebrow,#pgh .pgh-h2{text-align:center}
  /* Hero removed; Best Sellers leads the page */
  #pgh .pgh-hero{display:none !important}
  #pgh .pgh-wrap{padding-top:34px}
  #pgh .pgh-grid{display:flex !important;flex-wrap:wrap;justify-content:center;gap:22px}
  #pgh .pgh-grid .pgh-card{width:calc(50% - 11px);max-width:100%}
  #pgh .pgh-card-t,#pgh .pgh-card-p{text-align:center}
  /* Card ATC: same pill look as the Sale badge, top right of the image */
  #pgh .pgh-badge{top:12px !important;bottom:auto !important}
  #pgh .pgh-atc{position:absolute !important;left:auto !important;right:12px !important;top:12px !important;bottom:auto !important;transform:none !important;background:#fff !important;background-color:#fff !important;background-image:none !important;color:#121212 !important;border:1px solid #e2e2e2 !important;border-radius:999px !important;font-size:12.5px !important;font-weight:500 !important;line-height:1.4 !important;padding:5px 16px !important;margin:0 !important;width:auto !important;min-width:0 !important;height:auto !important;min-height:0 !important;text-transform:none !important;letter-spacing:0 !important;box-shadow:0 6px 16px -8px rgba(0,0,0,.35) !important;animation:none !important}
  #pgh .pgh-atc:hover{background:#7A2FA2 !important;background-color:#7A2FA2 !important;color:#fff !important;border-color:#7A2FA2 !important;transform:none !important}
  /* Banner Shop now button removed per request */
  #pgh .pgh-split-btn{display:none !important}
  /* Collections tiles removed per request */
  #pgh .pgh-wrap:has(.pgh-tiles){display:none !important}
  @media(max-width:900px){
    #pgh .pgh-grid .pgh-card{width:calc(50% - 11px)}
  }
  .pgx-announce,.pgc-announce{text-transform:uppercase;letter-spacing:.08em;font-size:12px !important;font-weight:600}
  /* Announcement bar: animated purple gradient sweeping in from both sides */
  @keyframes pgAnnounceSweep{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
  .pgh-announce,.pgx-announce,.pgc-announce,.pgf-announce{background:linear-gradient(90deg,#4A1C66 0%,#7A2FA2 20%,#9B4BC4 50%,#7A2FA2 80%,#4A1C66 100%) !important;background-size:220% 100% !important;animation:pgAnnounceSweep 7s ease-in-out infinite}
  #pgx .pgx-hero{border-radius:16px}
  #pgx .pgx-thumbs button{border-radius:14px}
  #pgx .pgx-quote{border-radius:14px}
  #pgx .pgx-tile{border-radius:14px}
  #pgx .pgx-tile{background:#fff !important}
  #pgx .pgx-tile.pgx-sel{box-shadow:0 14px 34px -24px rgba(122,47,162,.55)}
  /* Review carousel next: purple circle, white arrow */
  #pgx .pgx-quote-next{width:44px !important;height:44px !important;min-width:44px !important;min-height:0 !important;flex:none !important;border-radius:50% !important;background:#7A2FA2 !important;background-color:#7A2FA2 !important;background-image:none !important;color:#fff !important;border:none !important;font-size:24px !important;line-height:1 !important;padding:0 0 3px !important;margin-left:auto !important;display:flex !important;align-items:center !important;justify-content:center !important;box-shadow:0 10px 22px -10px rgba(122,47,162,.6) !important;animation:none !important;text-transform:none !important}
  #pgx .pgx-quote-next:hover{background:#4A1C66 !important;background-color:#4A1C66 !important}
  #pgx .pgx-atc{display:flex !important;align-items:center !important;justify-content:center !important;text-align:center !important;width:100% !important;max-width:100% !important;margin:16px auto 6px !important;border-radius:999px !important;background:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 55%,#5E2380 100%) !important;background-color:#7A2FA2 !important;color:#fff !important;box-shadow:0 16px 34px -14px rgba(122,47,162,.65);text-transform:uppercase;letter-spacing:.06em !important;font-weight:700 !important;float:none !important}
  #pgx .pgx-atc:hover{background:#4A1C66 !important;background-color:#4A1C66 !important}
  #pgx .pgx-atc span{display:inline-block;width:auto}
  #pgx .pgx-info{margin:16px auto !important;width:100% !important}
  #pgx .pgx-tile-opts .pgx-plus{align-self:center !important;margin-top:14px}
  #pgx .pgx-info{border-radius:16px;border-color:rgba(122,47,162,.35) !important;background:linear-gradient(180deg,#fff,#faf6fd);box-shadow:0 0 0 1px rgba(122,47,162,.08),0 0 28px rgba(122,47,162,.22),0 18px 44px -24px rgba(122,47,162,.5)}
  #pgx .pgx-info-ic{box-shadow:0 0 16px rgba(122,47,162,.35)}
  #pgx .pgx-guar{border-radius:10px}
  #pgx .pgx-card{border-radius:14px;box-shadow:0 12px 30px -24px rgba(18,4,28,.4)}
  .pgu-card{box-shadow:0 16px 38px -28px rgba(74,28,102,.5)}

  /* Header: full-width bar, larger search + icons pushed to the edges */
  .pgh-head-in,.pgx-head-in,.pgc-head-in{max-width:none !important;padding-left:40px !important;padding-right:40px !important}
  .pgh-ic,.pgx-ic,.pgc-ic{gap:24px !important}
  .pgh-ic svg,.pgx-ic svg,.pgc-ic svg{width:27px !important;height:27px !important}
  .pgh-cart-n{min-width:18px !important;height:18px !important;line-height:18px !important;font-size:11px !important}

  /* Kill the theme's dark button overlay pseudo-elements on all PG buttons */
  html body .pgh-atc::before,html body .pgh-atc::after,
  html body .pgm-qty button::before,html body .pgm-qty button::after,
  html body .pgm-del::before,html body .pgm-del::after,
  html body .pgm-rec-add::before,html body .pgm-rec-add::after,
  html body .pgm-co::before,html body .pgm-co::after,
  html body .pgx-quote-next::before,html body .pgx-quote-next::after,
  html body .pgu-btn::before,html body .pgu-btn::after{display:none !important;content:none !important;background:none !important;animation:none !important;opacity:0 !important}

  /* Side stars: light purple, fading, on every PG page */
  .pgf-stars{position:fixed;top:0;bottom:0;width:230px;pointer-events:none;z-index:30}
  .pgf-stars.l{left:0}
  .pgf-stars.r{right:0}
  .pgf-stars i{position:absolute;display:block;background:#B478E0;clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);animation:pgfTwinkle 3.2s ease-in-out infinite;opacity:.5;filter:drop-shadow(0 0 6px rgba(155,75,196,.8))}
  @keyframes pgfTwinkle{0%,100%{opacity:.35;transform:scale(.7)}50%{opacity:1;transform:scale(1.3)}}
  @media(max-width:1100px){.pgf-stars{display:none}}

  /* Inline header search box with product dropdown (replaces the /search link) */
  .pg-search{position:relative;display:flex;align-items:center;gap:9px;background:#fff;border:1px solid #ddd;border-radius:999px;padding:12px 18px;width:300px;max-width:46vw;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif}
  .pg-search:focus-within{border-color:#7A2FA2;box-shadow:0 0 0 3px rgba(122,47,162,.12)}
  .pg-search svg{width:19px;height:19px;stroke:#555;fill:none;stroke-width:1.8;flex:none}
  .pg-search input{border:none !important;outline:none !important;background:transparent !important;font-size:14.5px;width:100%;padding:0 !important;margin:0 !important;color:#121212;box-shadow:none !important;min-height:0 !important;height:auto !important}
  .pg-search-dd{display:none;position:absolute;top:calc(100% + 8px);left:0;width:330px;max-width:82vw;background:#fff;border:1px solid #e9dcf3;border-radius:14px;box-shadow:0 24px 54px -24px rgba(18,4,28,.45);padding:8px;z-index:99}
  .pg-search-dd.on{display:block}
  .pg-search-dd a{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:10px;text-decoration:none;color:#121212}
  .pg-search-dd a:hover{background:#f6effb}
  .pg-search-dd img{width:40px;height:40px;border-radius:8px;object-fit:cover;flex:none;background:#f4f4f4}
  .pg-search-dd span{flex:1;min-width:0;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .pg-search-dd b{font-size:13px;color:#7A2FA2;flex:none}
  .pg-search-none{padding:12px;font-size:13px;color:#666}
  @media(max-width:900px){.pg-search{width:150px;padding:8px 12px}.pg-search input{font-size:13px}}
</style>
<script>
  (function(){
    if (window.pgxBrandFix) return; window.pgxBrandFix = 1;
    function fix(){
      var f = document.getElementById('shopify-section-footer') || document.querySelector('.shopify-section[id$="__footer"]');
      if (!f) return;
      var w = document.createTreeWalker(f, NodeFilter.SHOW_TEXT);
      var n;
      while ((n = w.nextNode())){
        if (/North Cove/i.test(n.nodeValue)){
          n.nodeValue = n.nodeValue
            .replace(/North Cove Wellness LLC/gi, 'PocketEra')
            .replace(/North Cove Wellness/gi, 'PocketEra')
            .replace(/North Cove/gi, 'PocketEra');
        }
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fix); else fix();
    setTimeout(fix, 800);
  })();
</script>
<script>
  (function(){
    if (window.pgSearch) return; window.pgSearch = 1;
    var ALLOW = ['handheld-game-console', 'data-frog-protective-bag-for-r36s-retro-video-game-bags-olig-cover-case-for-rg35xx-r35s', 'pokemon-crystal-ball-3d-pikachu-gengar-mewtwo-night-light-lamp-pokeball-3d-glass-pokemon-crystal-ball-statue-kids-birthday-gift'];
    function widget(){
      document.querySelectorAll('.pgh-head-in > a[aria-label="Search"], .pgx-head-in > a[aria-label="Search"], .pgc-head-in > a[aria-label="Search"]').forEach(function(a){
        var w = document.createElement('div');
        w.className = 'pg-search';
        w.innerHTML = '<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/></svg>'
          + '<input type="text" placeholder="Search here..." aria-label="Search products">'
          + '<div class="pg-search-dd"></div>';
        a.replaceWith(w);
        var input = w.querySelector('input');
        var dd = w.querySelector('.pg-search-dd');
        var t;
        input.addEventListener('keydown', function(e){
          if (e.key === 'Enter') e.preventDefault();
          if (e.key === 'Escape'){ dd.classList.remove('on'); input.blur(); }
        });
        input.addEventListener('input', function(){
          clearTimeout(t);
          var q = input.value.trim();
          if (q.length < 2){ dd.classList.remove('on'); dd.innerHTML = ''; return; }
          t = setTimeout(function(){
            fetch('/search/suggest.json?q=' + encodeURIComponent(q) + '&resources[type]=product&resources[limit]=10')
              .then(function(r){ return r.json(); })
              .then(function(d){
                var items = ((d.resources && d.resources.results && d.resources.results.products) || []).filter(function(p){
                  return ALLOW.some(function(h){ return (p.url || '').indexOf(h) > -1; });
                });
                if (!items.length){
                  dd.innerHTML = '<div class="pg-search-none">No matching products</div>';
                } else {
                  dd.innerHTML = items.map(function(p){
                    var img = (p.featured_image && p.featured_image.url) || p.image || '';
                    return '<a href="' + p.url + '">'
                      + (img ? '<img src="' + img + '" alt="">' : '')
                      + '<span>' + p.title + '</span>'
                      + (p.price ? '<b>$' + p.price + '</b>' : '')
                      + '</a>';
                  }).join('');
                }
                dd.classList.add('on');
              }).catch(function(){});
          }, 250);
        });
        document.addEventListener('click', function(e){ if (!w.contains(e.target)) dd.classList.remove('on'); });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', widget); else widget();
    setTimeout(widget, 900);
  })();
</script>
<script>
  (function(){
    if (window.pgStars) return; window.pgStars = 1;
    function stars(){
      if (document.querySelector('.pgf-stars')) return;
      var L = [[10,34,16,0],[18,62,10,.6],[27,20,13,1.4],[36,52,20,2.1],[45,30,10,.9],[54,64,15,1.8],[63,24,11,.3],[72,50,18,2.6],[81,34,11,1.1],[90,58,14,2.9]];
      var R = [[12,56,15,.4],[21,26,10,1.6],[30,66,18,2.3],[39,36,11,.8],[48,60,10,1.9],[57,28,16,.1],[66,58,11,2.8],[75,32,20,1.2],[84,56,11,.5],[92,30,14,2.4]];
      var cols = ['#B478E0', '#C9A6E8', '#9B4BC4'];
      function side(cls, arr){
        var d = document.createElement('div');
        d.className = 'pgf-stars ' + cls;
        d.setAttribute('aria-hidden', 'true');
        d.innerHTML = arr.map(function(s, i){
          return '<i style="top:' + s[0] + '%;left:' + s[1] + '%;width:' + s[2] + 'px;height:' + s[2] + 'px;animation-delay:' + s[3] + 's;background:' + cols[i % 3] + '"></i>';
        }).join('');
        document.body.appendChild(d);
      }
      side('l', L); side('r', R);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', stars); else stars();
    setTimeout(stars, 900);
  })();
</script>
<script>
  (function(){
    if (window.pgFallbackHead) return; window.pgFallbackHead = 1;
    function head(){
      if (document.querySelector('.pgh-head,.pgx-head,.pgc-head,[data-pgf-head]')) return;
      var c = document.getElementById('content') || document.body;
      var d = document.createElement('div');
      d.setAttribute('data-pgf-head', '1');
      d.innerHTML = '<div class="pgf-announce">Free shipping on all orders</div>'
        + '<div class="pgf-head"><a href="/"><img src="https://cdn.shopify.com/s/files/1/0815/5706/1860/files/Gemini_Generated_Image_utaycgutaycgutay.png" alt="PocketEra"></a></div>'
        + '<nav class="pgf-nav"><a href="/">Home</a><a href="/pages/track-order">Track your order</a><a href="/pages/contact">Contact</a></nav>';
      c.insertBefore(d, c.firstChild);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', head); else head();
    setTimeout(head, 600);
  })();
</script>
