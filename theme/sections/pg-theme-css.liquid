    if (window.pgxBrandFix) return; window.pgxBrandFix = 1;
    function fix(){
      var f = document.getElementById('shopify-section-footer') || document.querySelector('.shopify-section[id$="__footer"]');
      if (!f) return;
      var w = document.createTreeWalker(f, NodeFilter.SHOW_TEXT);
      var n;
      while ((n = w.nextNode())){
        if (/North Cove/i.test(n.nodeValue)){
          n.nodeValue = n.nodeValue
            .replace(/North Cove Wellness LLC/gi, 'PocketEra')
            .replace(/North Cove Wellness/gi, 'PocketEra')
            .replace(/North Cove/gi, 'PocketEra');
        }
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fix); else fix();
    setTimeout(fix, 800);
  })();
</script>
<script>
  (function(){
    if (window.pgSearch) return; window.pgSearch = 1;
    var ALLOW = ['handheld-game-console', 'data-frog-protective-bag-for-r36s-retro-video-game-bags-olig-cover-case-for-rg35xx-r35s', 'pokemon-crystal-ball-3d-pikachu-gengar-mewtwo-night-light-lamp-pokeball-3d-glass-pokemon-crystal-ball-statue-kids-birthday-gift'];
    function widget(){
      document.querySelectorAll('.pgh-head-in > a[aria-label="Search"], .pgx-head-in > a[aria-label="Search"], .pgc-head-in > a[aria-label="Search"]').forEach(function(a){
        var w = document.createElement('div');
        w.className = 'pg-search';
        w.innerHTML = '<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/></svg>'
          + '<input type="text" placeholder="Search" aria-label="Search products">'
          + '<div class="pg-search-dd"></div>';
        var hostIn = a.closest('.pgh-head-in,.pgx-head-in,.pgc-head-in');
        var navEl = (hostIn && hostIn.querySelector('nav')) || document.querySelector('.pgx-nav,.pgh-nav,.pgc-nav');
        if (navEl){ navEl.insertBefore(w, navEl.firstChild); a.remove(); } else { a.replaceWith(w); }
        var input = w.querySelector('input');
        var dd = w.querySelector('.pg-search-dd');
        var t;
        input.addEventListener('keydown', function(e){
          if (e.key === 'Enter') e.preventDefault();
          if (e.key === 'Escape'){ dd.classList.remove('on'); input.blur(); }
        });
        input.addEventListener('input', function(){
          clearTimeout(t);
          var q = input.value.trim();
          if (q.length < 2){ dd.classList.remove('on'); dd.innerHTML = ''; return; }
          t = setTimeout(function(){
            fetch('/search/suggest.json?q=' + encodeURIComponent(q) + '&resources[type]=product&resources[limit]=10')
              .then(function(r){ return r.json(); })
              .then(function(d){
                var items = ((d.resources && d.resources.results && d.resources.results.products) || []).filter(function(p){
                  return ALLOW.some(function(h){ return (p.url || '').indexOf(h) > -1; });
                });
                if (!items.length){
                  dd.innerHTML = '<div class="pg-search-none">No matching products</div>';
                } else {
                  dd.innerHTML = items.map(function(p){
                    var img = (p.featured_image && p.featured_image.url) || p.image || '';
                    return '<a href="' + p.url + '">'
                      + (img ? '<img src="' + img + '" alt="">' : '')
                      + '<span>' + p.title + '</span>'
                      + (p.price ? '<b>$' + p.price + '</b>' : '')
                      + '</a>';
                  }).join('');
                }
                dd.classList.add('on');
              }).catch(function(){});
          }, 250);
        });
        document.addEventListener('click', function(e){ if (!w.contains(e.target)) dd.classList.remove('on'); });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', widget); else widget();
    setTimeout(widget, 900);
  })();
</script>
<script>
  (function(){
    if (window.pgStars) return; window.pgStars = 1;
    var P=[[34,16,0],[62,10,.6],[20,13,1.4],[52,20,2.1],[30,10,.9],[64,15,1.8],[24,11,.3],[50,18,2.6],[34,11,1.1],[58,14,2.9]];
    var cols=['#B478E0','#C9A6E8','#9B4BC4'];
    var lastH=0;
    function docH(){var st=document.querySelectorAll('.pgf-stars'),i;for(i=0;i<st.length;i++)st[i].style.display='none';var b=document.body,e=document.documentElement;var h=Math.max(b.scrollHeight,e.scrollHeight,e.clientHeight);for(i=0;i<st.length;i++)st[i].style.display='';return h;}
    function build(){
      var H=docH(); lastH=H;
      ['l','r'].forEach(function(cls,side){
        var d=document.querySelector('.pgf-stars.'+cls);
        if(!d){d=document.createElement('div');d.className='pgf-stars '+cls;d.setAttribute('aria-hidden','true');document.body.appendChild(d);}
        d.style.height=H+'px';
        var html='',step=120,n=Math.ceil(H/step);
        for(var i=0;i<n;i++){
          var p=P[(i+side*3)%P.length];
          var top=i*step+((i*37+side*53)%76);
          var left=p[0]+((i*29)%26)-13; if(left<4)left=4; if(left>76)left=76;
          html+='<i style="top:'+top+'px;left:'+left+'%;width:'+p[1]+'px;height:'+p[1]+'px;animation-delay:'+(((i%7)*0.45)+(p[2]%1))+'s;background:'+cols[i%3]+'"></i>';
        }
        d.innerHTML=html;
      });
    }
    function tick(){var H=docH(); if(Math.abs(H-lastH)>200) build();}
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',build);else build();
    setTimeout(build,900); setInterval(tick,1500);
    window.addEventListener('resize',function(){setTimeout(build,250);});
  })();
</script>
