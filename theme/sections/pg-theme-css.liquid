  .pgh-ic,.pgx-ic,.pgc-ic{gap:24px !important}
  .pgh-ic svg,.pgx-ic svg,.pgc-ic svg{width:34px !important;height:34px !important}
  /* Person and bag icons: white with a soft purple glow so they read on the tint */
