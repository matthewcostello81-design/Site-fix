     price, so the derivation went stale the moment the singles were repriced:
     the tile advertised $131.23 for a pack the till charged $135.98. Showing a
     price checkout will not honor is the one thing this store must never do,
     so the figure is read from the pack product itself and the tile and the
     till cannot disagree again.

     Keyed on the SORTED pair, so 64+128 and 128+64 resolve to one entry. The
     duo carried a duplicate 128GB+64GB variant priced $2.50 apart from its
     twin; sorting means a mixed pack can only ever find the survivor. */
  var PACK = null;
  function sizeOf(v){ return /128/.test(v.t) ? '128' : '64'; }
  function packKey(){
    return Array.prototype.slice.call(arguments).sort().join('|');
  }
  function loadPack(j, handle){
    var dp = (j.products || []).filter(function(x){ return x.handle === handle; })[0];
    if (!dp) return null;
    var out = {};
    (dp.variants || []).forEach(function(v){
      var sizes = String(v.title).match(/\d+(?=GB)/g);
      if (!sizes || !sizes.length) return;
      /* FIRST MATCH WINS. The duo's retired 128GB+64GB duplicate sits after
         the surviving 64GB+128GB in variant order and keys identically once
         sorted; an unguarded write let the retired id overwrite the survivor. */
      if (out[packKey.apply(null, sizes)]) return;
      out[packKey.apply(null, sizes)] = {
        p: parseFloat(v.price || 0),
        c: parseFloat(v.compare_at_price || 0),
        id: v.id
      };
    });
    return out;
  }
  /* BEST DEAL, FROM THE PRICES. The pack whose saving against its compare-at
     is the deeper (for the sizes picked right now, re-read on every change)
     carries "Best Deal"; a tie labels neither. By request (2026-09-11):
     "based on pricing".

     MOST POPULAR, FROM THE ORDERS. It cannot be computed in the browser, so
     it is a section setting (Customize > footer > PG Theme CSS), set from
     the order book and moved by hand as sales move. Set to the single
     console on 2026-09-11: since launch 14 orders held one console (11 of
     them the 128G), 3 held two, none held three -- the Duo had carried the
     label unearned. "Only where it's earned", by request. A tile that is
     the best deal keeps that label; the two never stack. */
  var MOST_POPULAR = '{{ section.settings.most_popular | default: "single" }}';
  function labelPacks(){
    var onR36 = location.pathname.indexOf('/products/handheld-game-console') !== -1;
    var packs = Array.prototype.slice.call(document.querySelectorAll('#pgx .pgx-tile.pgx-duo'));
    var single = onR36 ? document.querySelector('#pgx .pgx-tile[data-pgx-tile="single"]') : null;
    if (!packs.length && !single) return;
    var best = null, bestPct = 0, tie = false;
    packs.forEach(function(t){
      var pc = Math.floor(parseFloat(t.dataset.pgPct || '0') * 100);   /* whole percents, as the SAVE pill prints */
      if (pc > bestPct){ best = t; bestPct = pc; tie = false; }
      else if (pc === bestPct && pc > 0 && t !== best) tie = true;
    });
    var mp = null;
    if (MOST_POPULAR === 'single') mp = single;
    else if (MOST_POPULAR === 'duo') mp = packs.filter(function(t){ return !t.classList.contains('pgx-trio'); })[0] || null;
    else if (MOST_POPULAR === 'trio') mp = packs.filter(function(t){ return t.classList.contains('pgx-trio'); })[0] || null;
    function put(t, txt){
      var r = t.querySelector('.pgx-duo-ribbon');
      if (!r && !txt) return;
      if (!r){ r = document.createElement('span'); r.className = 'pgx-duo-ribbon'; t.insertBefore(r, t.firstChild); }
      if (r.textContent !== txt) r.textContent = txt;
      /* the corner the SAVE pill is NOT in: measured, so the two never
         overlap whichever section positions SAVE */
      var b = t.querySelector('.pgx-lad-badge');
      if (txt && b){
        var br = b.getBoundingClientRect(), tr = t.getBoundingClientRect();
        if (br.width && tr.width){
          var saveOnRight = (br.left + br.width / 2) > (tr.left + tr.width / 2);
          var side = saveOnRight ? 'left' : 'right';
          if (r.dataset.pgSide !== side){
            r.dataset.pgSide = side;
            r.style.setProperty(side, '14px', 'important');
            r.style.setProperty(saveOnRight ? 'right' : 'left', 'auto', 'important');
          }
        }
      }
    }
    packs.forEach(function(t){ put(t, (!tie && t === best) ? 'Best Deal' : (t === mp ? 'Most Popular' : '')); });
    if (single) put(single, mp === single ? 'Most Popular' : '');
  }
  function calc(tile){
    if (!VARS) return;
    /* one picker per console: two on the duo, three on the trio */
    var sels = tile.querySelectorAll('select');
    var vs = Array.prototype.map.call(sels, function(s){ return VARS.filter(function(v){ return String(v.id) === s.value; })[0]; });
    if (vs.length < 2 || vs.some(function(v){ return !v; })) return;
    var pack = PACK ? PACK[packKey.apply(null, vs.map(sizeOf))] : null;
    var sep = vs.reduce(function(a, v){ return a + v.p; }, 0);      /* the singles at today's live prices */
    var total = pack ? pack.p : sep;
    var orig = (pack && pack.c) ? pack.c : vs.reduce(function(a, v){ return a + (v.c || v.p); }, 0);
    /* NO SURCHARGE ON THE 128GB OPTION. A "+$13.00 each" hint was tried on
       the picker and pulled the same day: it foregrounds the upgrade as a cost
       rather than as storage, and the longer option text widened every
       <select> to 140px, which pushed both pack bodies past the tile edge at
       375px. The tile total repricing the instant a size changes is the
       signal, and it needs no copy. */
    tile.querySelector('.pgx-duo-px b').textContent = money(total);
    tile.querySelector('.pgx-duo-px s').textContent = money(orig);
    var dsv = tile.querySelector('[data-pg-duosave]');
    /* FLOOR, NEVER ROUND. Rounding a 32.5% saving up to 33% advertises a
       discount the shopper does not receive. Flooring means the delivered
       percentage always meets or beats the badge, on every configuration. */
    if (dsv && orig > total) dsv.textContent = 'SAVE ' + Math.floor((orig - total) / orig * 100) + '%';
    tile.dataset.pgPct = orig > total ? String((orig - total) / orig) : '0';
    labelPacks();
    /* ONE PRICE PER TILE. The per-unit figures went out with the BXGY: there is
       no longer a discounted console and a full-price one, only a pack price,
       so printing a struck price under each unit invented a split that does not
       exist and did not add up to the total above it. Each unit keeps its
       picker and nothing else. */
    Array.prototype.forEach.call(tile.querySelectorAll('.pgx-duo-u .pp'), function(pp){ pp.innerHTML = ''; });
    /* ONE REFERENCE PRICE PER TILE. This line used to read "Sold separately
       $149.98" (the singles' live prices) beside a badge computed against the
       $199.98 compare-at total: two references, and a shopper doing the maths
       on the first one got 9%, not the 32% on the badge. The struck total is
       the one reference now (it is the sum of the $99.99 / $119.99 each single
       shows struck), so the sub-line carries no second number. */
    tile.querySelector('.pgx-duo-t small').textContent = (vs.length === 3 ? 'Three consoles, one price' : 'Two consoles, one price');
  }
  function build(){
    var m = location.pathname.match(/\/products\/([^\/?#]+)/);
    if (!m) return;
    var isR36 = m[1] === 'handheld-game-console';
    var first = document.querySelector('#pgx .pgx-tile');
    if (!first || !first.parentElement) return;
    if (first.dataset.pgSingled && (!isR36 || document.querySelector('.pgx-duo'))) return;
    window.pgCatalog().then(function(j){
      var p = (j.products || []).filter(function(x){ return x.handle === m[1]; })[0];
      if (!p) return;
      var duoMap = loadPack(j, 'r36s-duo-pack') || {}, trioMap = loadPack(j, 'r36s-trio-pack') || {};
      PACK = {};
      Object.keys(duoMap).forEach(function(k){ PACK[k] = duoMap[k]; });
      Object.keys(trioMap).forEach(function(k){ PACK[k] = trioMap[k]; });
      var img = (p.images && p.images[0] && p.images[0].src) || '';
      VARS = (p.variants || []).map(function(v){ return {id: v.id, t: (v.title.indexOf('/') > -1 ? v.title.split('/').pop() : v.title).replace(/^\s+|\s+$/g, ''), p: parseFloat(v.price || 0), c: parseFloat(v.compare_at_price || 0)}; });
      if (VARS.length < 1) return;
      /* Default both Duo Pack slots to the 64G variant. Without an explicit
         selection the browser takes the first option, which is the 128G one,
         so the pack opened at the dearer configuration. */
      var duoDef = VARS.filter(function(v){ return /(^|\D)64/.test(v.t); })[0] || VARS[0];
      var opts = VARS.map(function(v){ return '<option value="' + v.id + '"' + (v.id === duoDef.id ? ' selected' : '') + '>' + v.t + '</option>'; }).join('');
      /* BOTH SLOTS ARE FREE AGAIN. The lock existed only because Shopify's
         BXGY decided which unit got the 25% and always picked the cheaper one.
         The pack is its own product now, priced per configuration, so nothing
         is decided at checkout and any pairing can be offered honestly. */
      if (isR36 && !document.querySelector('.pgx-duo')){
      var tile = document.createElement('div');
      tile.className = 'pgx-tile pgx-duo';
      tile.setAttribute('data-pgx-duo', '1');
      tile.setAttribute('role', 'radio');
      tile.setAttribute('aria-checked', 'false');
      tile.setAttribute('tabindex', '0');
      /* one label per pack, opposite the SAVE pill, by request (2026-09-11);
         labelPacks() below fills them from the live SAVE % */
      tile.innerHTML = '<span class="pgx-lad-badge" data-pg-duosave></span><span class="pgx-duo-ribbon"></span>'
        + '<div class="pgx-duo-head"><span class="pgx-duo-dot"></span>'
        + '<div class="pgx-duo-t"><b>Duo Pack <span class="pgx-lad-chip">+ FREE Case</span></b><small></small></div>'
        + '<div class="pgx-duo-px"><b></b><s></s></div></div>'
        + '<div class="pgx-duo-body" style="border:1px solid rgba(139,68,190,.5);border-radius:12px"><span class="pgx-duo-plus">+</span>'
        + '<div class="pgx-duo-u" style="border-right:1px solid rgba(139,68,190,.45)"><img src="' + img + '" alt=""><div class="n">R36S</div><div class="pp"></div><select aria-label="Version 1">' + opts + '</select></div>'
        + '<div class="pgx-duo-u"><img src="' + img + '" alt=""><div class="n">R36S</div><div class="pp"></div><select aria-label="Version 2">' + opts + '</select></div></div>';
      first.parentElement.insertBefore(tile, first.nextSibling);
      calc(tile);
      }
      /* THE TRIO PACK: the duo's parts with a third slot. It wears .pgx-duo as
         well as .pgx-trio so every rule that already keys on the duo -- the
         collapsed body when unselected, the ribbon, the one pack-owning add
         handler in pg-r36s-mobile -- applies unchanged; .pgx-trio carries only
         the differences (three columns, two joiners, two spares). */
      if (isR36 && !document.querySelector('.pgx-trio')){
      var after = document.querySelector('#pgx .pgx-tile.pgx-duo') || first;
      var trio = document.createElement('div');
      trio.className = 'pgx-tile pgx-duo pgx-trio';
      trio.setAttribute('data-pgx-trio', '1');
      trio.setAttribute('role', 'radio');
      trio.setAttribute('aria-checked', 'false');
      trio.setAttribute('tabindex', '0');
      var unit = function(n){ return '<div class="pgx-duo-u"><img src="' + img + '" alt=""><div class="n">R36S</div><div class="pp"></div><select aria-label="Version ' + n + '">' + opts + '</select></div>'; };
      trio.innerHTML = '<span class="pgx-lad-badge" data-pg-duosave></span><span class="pgx-duo-ribbon"></span>'
        + '<div class="pgx-duo-head"><span class="pgx-duo-dot"></span>'
        + '<div class="pgx-duo-t"><b>Trio Pack <span class="pgx-lad-chip">+ FREE Case</span></b><small></small></div>'
        + '<div class="pgx-duo-px"><b></b><s></s></div></div>'
        + '<div class="pgx-duo-body" style="border:1px solid rgba(139,68,190,.5);border-radius:12px"><span class="pgx-duo-plus p1">+</span><span class="pgx-duo-plus p2">+</span>'
        + unit(1) + unit(2) + unit(3) + '</div>';
      after.parentElement.insertBefore(trio, after.nextSibling);
      calc(trio);
      }
      /* the tier notes, one per tile; the bottom deal note is retired on this page */
      if (isR36){
        var noteFor = function(t, html){
          if (!t || t.querySelector('.pgx-tier-note')) return;
          var n = document.createElement('div');
          n.className = 'pgx-tier-note';
          n.innerHTML = html;
          /* under the pickers, ahead of the spare-case add-on row pgTileAdd appends later */
          var body = t.querySelector('.pgx-duo-body'), tadd = t.querySelector('.pg-tadd');
          if (body && body.parentNode === t) t.insertBefore(n, body.nextSibling);
          else if (tadd && tadd.parentNode === t) t.insertBefore(n, tadd);   /* the single: above its add-on row too */
          else t.appendChild(n);
        };
        noteFor(first, '<b>One R36S + FREE Case</b>, plus an extra <b>10% off</b> at checkout.');
        noteFor(document.querySelector('#pgx .pgx-tile.pgx-duo:not(.pgx-trio)'), '<b>Duo Pack + FREE Case</b>, plus an extra <b>10% off</b> at checkout.');
        noteFor(document.querySelector('#pgx .pgx-tile.pgx-trio'), '<b>Trio Pack + FREE Case</b>, plus an extra <b>10% off</b> at checkout.');
        var pgx = document.getElementById('pgx');
        if (pgx) pgx.setAttribute('data-pg-tiernotes', '1');
      }
      if (!document.querySelector('.pgx-bs')){
        var bs = document.createElement('div');
        bs.className = 'pgx-bs';
        bs.innerHTML = '<span>Bundle &amp; Save</span>';
        first.parentElement.insertBefore(bs, first);
      }
      if (!first.dataset.pgSingled){
        first.dataset.pgSingled = '1';
        var od = first.querySelector('.pgx-duo-dot');
        if (od) od.remove();
        if (isR36){
          var nm = first.querySelector('.pgx-tile-name') || first.querySelector('.pgx-tile-row b, .pgx-tile-row h3');
          if (nm && !nm.querySelector('.pgx-lad-chip')) nm.insertAdjacentHTML('beforeend', ' <span class="pgx-lad-chip">+ FREE Case</span>');
          if (!first.querySelector('.pgx-lad-badge') && VARS[0] && VARS[0].c > VARS[0].p){
            var sb2 = document.createElement('span');
            sb2.className = 'pgx-lad-badge';
            sb2.setAttribute('data-pg-singlesave', '1');
            sb2.textContent = 'SAVE ' + Math.floor((VARS[0].c - VARS[0].p) / VARS[0].c * 100) + '%';
            first.appendChild(sb2);
          }
        }
        var priceBox = first.querySelector('.pgx-tile-price');
        if (priceBox && !priceBox.querySelector('.pgx-sstrike') && VARS[0] && VARS[0].c > VARS[0].p){
          var ss = document.createElement('s');
          ss.className = 'pgx-sstrike';
          ss.textContent = money(VARS[0].c);
          priceBox.appendChild(ss);
        }
        var haveSel = first.querySelector('.pgx-tile-opts select');
        var pills = haveSel ? [] : Array.prototype.slice.call(first.querySelectorAll('.pgx-tile-opts button, .pgx-tile-opts [role="button"], .pgx-tile-opts span'));
        if (pills.length > 1 && !first.querySelector('.pgx-storage')){
          var lb = document.createElement('div');
          lb.className = 'pgx-storage-lb';
          lb.textContent = 'Storage';
          var sl = document.createElement('select');
          sl.className = 'pgx-storage';
          sl.setAttribute('aria-label', 'Storage');
          pills.forEach(function(pl, i){
            var o = document.createElement('option');
            o.value = String(i);
            o.textContent = pl.textContent.replace(/^\s+|\s+$/g, '');
            sl.appendChild(o);
          });
          sl.addEventListener('click', function(e){ e.stopPropagation(); });
          sl.addEventListener('change', function(){
            var pl = pills[parseInt(sl.value, 10)];
            if (pl) pl.click();
            var vv = VARS.filter(function(v){ return v.t === sl.options[sl.selectedIndex].textContent; })[0];
            var st2 = first.querySelector('.pgx-sstrike');
            if (vv && st2 && vv.c > vv.p) st2.textContent = money(vv.c);
            var bd2 = first.querySelector('[data-pg-singlesave]');
            if (bd2 && vv && vv.c > vv.p) bd2.textContent = 'SAVE ' + Math.floor((vv.c - vv.p) / vv.c * 100) + '%';
          });
          var opts2 = first.querySelector('.pgx-tile-opts');
          opts2.parentElement.insertBefore(lb, opts2);
          opts2.parentElement.insertBefore(sl, opts2);
        }
      }
      /* ONE WIRING FOR EVERY PACK TILE. The duo and the trio get the same
         three bindings: storage pickers recalculate their own tile, a tap
         selects the tile, and a tap on any other tile deselects it. */
      var wire = function(t){
        t.querySelectorAll('select').forEach(function(sel){
          sel.addEventListener('click', function(e){ e.stopPropagation(); });
          /* THE SLOTS ARE INDEPENDENT. An earlier build copied the changed
             select's value onto the others, so a mixed pack could not be
             built at all; calc() reads every picker on its own. */
          sel.addEventListener('change', function(){ calc(t); });
        });
        t.addEventListener('click', function(){
          document.querySelectorAll('#pgx .pgx-tile.pgx-sel').forEach(function(x){ x.classList.remove('pgx-sel'); x.setAttribute('aria-checked', 'false'); });
          t.classList.add('pgx-sel');
          t.setAttribute('aria-checked', 'true');
        });
        document.addEventListener('click', function(e){
          var other = e.target.closest('#pgx .pgx-tile');
          if (other && other !== t && t.classList.contains('pgx-sel')){
            t.classList.remove('pgx-sel');
            t.setAttribute('aria-checked', 'false');
          }
        }, true);
      };
      if (typeof tile !== 'undefined' && tile) wire(tile);
      if (typeof trio !== 'undefined' && trio) wire(trio);
      /* NO ADD-TO-CART HANDLER HERE, ON PURPOSE. This section used to post the
         two CONSOLE variants the pickers held -- one line at quantity 2, or two
         lines at 1 -- which bills $149.98 for a pack the tile prices at
         $135.98. It only ever stayed silent because pg-r36s-mobile takes the
         click first in the window capture phase and posts the ONE pack line
         that matches the tile; if that handler ever failed to run, this one
         would have charged the shopper a price the page never showed. A dead
         button is the safer failure, so there is one owner and it lives in
         pg-r36s-mobile. */
    }).catch(function(){});
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', build); else build();
  setTimeout(build, 1000); setInterval(function(){ build(); }, 2500);
})();
</script>
<script>
(function(){
  if (window.pgLadder) return; window.pgLadder = 1;
  var BUSY = false;
  function money(n){ return '$' + n.toFixed(2); }
  function build(){
    var m = location.pathname.match(/\/products\/([^\/?#]+)/);
    /* Ladder on every product except the console (its own Duo Pack) and the
       cart-only add-ons. New products get it automatically - but each one
       needs matching BXGY discounts or the page promises a price checkout
       will not honour. */
    /* the packs are sold from the console page; their own pages redirect there
       (product.redirect-console) and must never grow this ladder, whose tiers
       mirror discounts the packs do not carry */
    var NO_LADDER = ['handheld-game-console', 'shipping-protection', 'r36s-protective-case-free-gift', 'r36s-duo-pack', 'r36s-trio-pack'];
    if (!m || NO_LADDER.indexOf(m[1]) !== -1) return;
    if (!window.pgDrop) return;
    if (document.querySelector('.pgx-lad')) return;
    var first = document.querySelector('#pgx .pgx-tile:not(.pgx-lad)');
    if (!first || !first.parentElement) return;
    fetch('/products/' + m[1] + '.js').then(function(r){ return r.json(); }).then(function(p){
      if (!p || !p.variants || document.querySelector('.pgx-lad')) return;
      var unit = (p.variants[0].price || 0) / 100;
      var VOPTS = p.variants.filter(function(v){ return v.available !== false; }).map(function(v){
        return {id: v.id, t: v.title, img: (v.featured_image && v.featured_image.src) || (p.images && p.images[0]) || ''};
      });
      if (!unit || !VOPTS.length) return;
      var host = first.parentElement;
      var natives = Array.prototype.slice.call(host.querySelectorAll('.pgx-tile:not(.pgx-lad)'));
      natives.forEach(function(t){ t.style.setProperty('display', 'none', 'important'); });
      /* The free LED base ships with the crystal orb only. On any other product
         — wall art especially — it promised something the order never contains. */
      var SUB1 = m[1].indexOf('pokemon-crystal') !== -1 ? 'Standard price + FREE LED Base' : 'Standard price';
      var TIERS = [
        {n: 1, f: 0, bases: 1, badge: '', title: 'Buy 1', sub: SUB1},
        {n: 1, f: 0, h: 1, hp: 0.25, bases: 2, badge: 'Most Popular &#128293;', title: 'Duo Pack &mdash; 2nd 25% OFF', sub: ''},
        {n: 2, f: 0, h: 1, hp: 0.5, bases: 3, badge: '', title: 'Trio Pack &mdash; 3rd 50% OFF', sub: ''},
        {n: 4, f: 1, bases: 5, badge: 'Best Deal!', title: 'Quad Pack &mdash; +1 FREE', sub: ''}
      ];
      var tiles = [];
      TIERS.forEach(function(T, ti){
        var half = T.h || 0, hp = (T.hp == null ? 0.5 : T.hp);
        var pay = (T.n + half * (1 - hp)) * unit, save = (T.f + half * hp) * unit, full = (T.n + T.f + half) * unit;
        var pct = Math.round(save / full * 100);
        var tile = document.createElement('div');
        tile.className = 'pgx-tile pgx-lad' + (ti === 0 ? ' pgx-sel' : '');
        tile.setAttribute('role', 'radio');
        tile.setAttribute('aria-checked', ti === 0 ? 'true' : 'false');
        tile.setAttribute('tabindex', '0');
        tile.setAttribute('data-pg-tier', String(ti));
        var chips = T.bases > 1 ? '<span class="pgx-lad-chip">+' + T.bases + (m[1].indexOf('pokemon-crystal') !== -1 ? ' FREE LED Bases' : (m[1].indexOf('wall-art') !== -1 ? ' PRINTS' : ' ITEMS')) + '</span>' : '';
        /* R36S-style phrasing: name the unit that gets the deal, e.g.
           "2nd Orb = Extra 25% OFF!" rather than a dollar total. */
        var NOUN = m[1].indexOf('pokemon-crystal') !== -1 ? 'Orb' : (m[1].indexOf('wall-art') !== -1 ? 'Print' : 'Item');
        function ord(k){ return k + (k === 1 ? 'st' : k === 2 ? 'nd' : k === 3 ? 'rd' : 'th'); }
        var note = '';
        if (half > 0) note = ord(T.n + 1) + ' ' + NOUN + ' = Extra ' + Math.round(hp * 100) + '% OFF!';
        else if (T.f > 0) note = ord(T.n + 1) + ' ' + NOUN + ' = FREE!';
        var saveLn = note ? '<div class="pgx-lad-save">' + note + '</div>' : '<div class="pgx-lad-save">' + T.sub + '</div>';
        tile.innerHTML = (T.badge ? '<span class="pgx-lad-badge">' + T.badge + '</span>' : '')
          + '<div class="pgx-lad-head"><span class="pgx-duo-dot"></span>'
          + '<div class="pgx-lad-t"><b>' + T.title + '</b>' + chips + saveLn + '</div>'
          + '<div class="pgx-lad-px"><b>' + money(pay) + '</b>' + ((T.f > 0 || half > 0) ? '<s>' + money(full) + '</s>' : (unit < ((p.variants[0].compare_at_price || 0) / 100) ? '<s>' + money((p.variants[0].compare_at_price) / 100) + '</s>' : '')) + '</div></div>'
          + '<div class="pgx-lad-picks"><div class="lbl">' + (m[1].indexOf('pokemon-crystal') !== -1 ? 'Choose your Poke Balls' : (m[1].indexOf('wall-art') !== -1 ? 'Choose your prints' : 'Choose your options')) + '</div></div>';
        var picks = tile.querySelector('.pgx-lad-picks');
        var total = T.n + T.f + half;
        /* One design to choose from means one picker with a x N badge, not
           N identical dropdowns. */
        var rows = VOPTS.length > 1 ? total : 1;
        tile.dataset.pgMul = String(rows === 1 ? total : 1);
        for (var i = 0; i < rows; i++){
          var row = document.createElement('div');
          row.className = 'pgx-lad-row';
          row.appendChild(window.pgDrop(VOPTS, VOPTS[i % VOPTS.length].id, null));
          if (rows === 1 && total > 1){
            var xb = document.createElement('b');
            xb.textContent = '\u00d7' + total;
            xb.style.cssText = 'margin-left:10px;font-size:15px;font-weight:700;color:#C79BEA;align-self:center';
            row.appendChild(xb);
          }
          picks.appendChild(row);
        }
        host.insertBefore(tile, first);
        tiles.push(tile);
        tile.addEventListener('click', function(){
          tiles.forEach(function(t2){ t2.classList.remove('pgx-sel'); t2.setAttribute('aria-checked', 'false'); t2.dataset.pgTp = ''; });
          tile.classList.add('pgx-sel');
          tile.setAttribute('aria-checked', 'true');
        });
      });
      document.addEventListener('click', function(e){
        var b = e.target.closest('.pgx-atc');
        if (!b || BUSY) return;
        var sel = document.querySelector('.pgx-lad.pgx-sel');
        if (!sel) return;
        e.preventDefault();
        e.stopPropagation();
        BUSY = true;
        var counts = {};
        var mul = parseInt(sel.dataset.pgMul || '1', 10) || 1;
        sel.querySelectorAll('.pgx-lad-picks .pg-drop').forEach(function(d2){
          var vv = d2.pgValue();
          counts[vv] = (counts[vv] || 0) + mul;
        });
        var items = Object.keys(counts).map(function(k){ return {id: parseInt(k, 10), quantity: counts[k]}; });
        fetch('/cart/add.js', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({items: items})})
          .then(function(){ BUSY = false; if (window.pgOpenCart) window.pgOpenCart(); })
          .catch(function(){ BUSY = false; });
      }, true);
    }).catch(function(){});
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', build); else build();
  setTimeout(build, 1200); setInterval(build, 3000);
})();
</script>
<style>
  /* ---- In-tile add-on row (frame on the wall art, spare case on the console).
     A clickable checkbox box that lives INSIDE the selected buy tile, under
     the pickers, offering the add-on at qty = the units in that tile, with
     the real compare-at total struck through. Spans, never <button> - the
     theme paints buttons with a dark ::before overlay. ---- */
  #pgx .pg-tadd{
    display:none;
    align-items:center;gap:8px;
    margin-top:9px;padding:5px 8px;
    border:1px solid rgba(168,120,214,.32);border-radius:10px;
    background:#1C1428;cursor:pointer;
    -webkit-user-select:none;user-select:none;
  }
  /* badge room + anchor: the SAVE pills sit half above the tile edge */
  #pgx .pgx-tile{position:relative}
  #pgx .pgx-tile[data-pg-singled]:has(> .pgx-lad-badge){margin-top:20px}
  #pgx .pgx-tile.pgx-sel .pg-tadd{display:flex}
  #pgx .pg-tadd.on{border-color:#8B44BE;box-shadow:0 0 0 3px rgba(139,68,190,.18)}
  #pgx .pg-tadd-ck{
    flex:none;width:15px;height:15px;border-radius:4px;
    border:2px solid #8B44BE;background:#0D0714;position:relative;
  }
  #pgx .pg-tadd.on .pg-tadd-ck{background:linear-gradient(120deg,#9B4BC4,#7A2FA2 60%,#4A1C66)}
  #pgx .pg-tadd.on .pg-tadd-ck:after{
    content:"";position:absolute;left:50%;top:50%;width:4px;height:8px;
    border:solid #fff;border-width:0 2px 2px 0;
    /* the tick's visual centre sits below its box centre once rotated, so it
       is lifted a touch past the geometric middle */
    transform:translate(-50%,-62%) rotate(45deg);
  }
  #pgx .pg-tadd img{width:24px;height:24px;flex:none;border-radius:6px;object-fit:cover;background:#0D0714}
  #pgx .pg-tadd-t{flex:1;min-width:0;font-size:11.5px;font-weight:700;color:#E4DBEF;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #pgx .pg-tadd-p{flex:none;font-size:12.5px;font-weight:800;color:#C79BEA;white-space:nowrap}
  #pgx .pg-tadd-p s{color:rgba(255,255,255,.42);font-weight:400;font-size:10.5px;margin-right:4px}
  @media (max-width:600px){
    #pgx .pg-tadd{gap:7px;padding:5px 7px}
    #pgx .pg-tadd img{width:22px;height:22px}
    #pgx .pg-tadd-t{font-size:10.5px}
    #pgx .pg-tadd-p{font-size:11.5px}
  }
  /* the frame row runs a size up from the case row, per the owner */
  #pgx .pg-tadd.pg-tadd-frame{gap:9px;padding:6px 9px}
  #pgx .pg-tadd.pg-tadd-frame img{width:28px;height:28px;border-radius:7px}
  #pgx .pg-tadd.pg-tadd-frame .pg-tadd-t{font-size:12.5px}
  #pgx .pg-tadd.pg-tadd-frame .pg-tadd-p{font-size:13.5px}
  #pgx .pg-tadd.pg-tadd-frame .pg-tadd-p s{font-size:11px}
  @media (max-width:600px){
    #pgx .pg-tadd.pg-tadd-frame{padding:6px 8px}
    #pgx .pg-tadd.pg-tadd-frame img{width:25px;height:25px}
    #pgx .pg-tadd.pg-tadd-frame .pg-tadd-t{font-size:11.5px}
    #pgx .pg-tadd.pg-tadd-frame .pg-tadd-p{font-size:12.5px}
  }
  /* the standalone case tile is superseded by the in-tile row - one pitch */
  #pgx .pgx-case{display:none !important}
  /* THE REVIEW ROTATOR MUST NOT RESIZE THE PAGE.
     pg-landing rotates the review inside .pgx-quote on a timer
     (`setInterval(nextQuote, 6000)`) and the box was sized by whatever review it
     happened to be showing. Measured at 390px against the wall art's own
     Judge.me reviews: 94px for a 51-character review, 176px for a 183-character
     one. An 82px swing, every six seconds, with the shopper touching nothing.

     It lands where it hurts most: pg-mobile's quoteUp() parks this box directly
     under .pgx-rating, ABOVE the price, the variant picker and ADD TO CART, so
     the whole buy box slid up and down on a six-second cycle. That is the
     "the screen keeps adjusting on its own" report.

     The space is RESERVED rather than the rotation slowed: the box takes the
     height of a three-line review and the text is clamped to three lines, so
     every quote renders at exactly that height. The clamp alone was not enough
     -- a long REVIEWER NAME wraps to a second line and still pushed it to 130px
     -- so the name is held to one line and the height is fixed rather than
     merely floored. Re-measured across all eight reviews at 390px and 430px:
     113px for every one, 0px of movement.

     THIS LIVES HERE, not in nc-pgx-style, whose header calls it "PDP polish
     overrides for pg-landing" and which is the obvious home -- but that section
     is registered in no section group and in no product template, so it never
     renders and a rule placed there is dead. pg-theme-css is in footer-group,
     so it loads on every page, and it already styles .pgx-quote directly above.

     .pgx-quote[data-pg-moved] (line ~433) is the copy moveQuote() drops further
     down the page; it is a different, non-rotating context and keeps its own
     sizing, so the fixed height is scoped away from it. */
  #pgx .pgx-quote:not([data-pg-moved]){height:113px;box-sizing:border-box;overflow:hidden}
  #pgx .pgx-quote:not([data-pg-moved]) .pgx-quote-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #pgx .pgx-quote:not([data-pg-moved]) .pgx-quote-txt{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}
</style>
<script>
(function(){
  if (window.pgTileAdd) return; window.pgTileAdd = 1;

  /* Per-product add-on config. Prices in cents and REAL: unit is what
     checkout charges, cap is the variant's live compareAtPrice - the struck
     figure is cap x qty, never invented at render time. If either price
     moves in admin, move it here too. */
  var ADDONS = {
    'lenticular-poster': {
      cls: 'pg-tadd-frame',
      variant: 49688364613860,
      img: 'https://cdn.shopify.com/s/files/1/0815/5706/1860/files/blackframe_120x.png?v=1787284280',
      unit: 1499, cap: 2799,
      one: 'Add the matching frame',
      many: 'Add a frame per print'
    },
    'handheld-game-console': {
      variant: 49640879063268,
      img: 'https://cdn.shopify.com/s/files/1/0815/5706/1860/files/hf_20260810_234744_eb2ec102-427d-4c23-94f0-453e70014817.png?v=1786422962&width=120',
      unit: 1399, cap: 2499,
      one: 'Add a spare protective case',
      many: 'Add a spare case for each console'
    }
  };
  function cfg(){
    var m = location.pathname.match(/\/products\/([^\/?#]+)/);
    if (!m) return null;
    for (var k in ADDONS){ if (m[1].indexOf(k) !== -1) return ADDONS[k]; }
    return null;
  }
  var C = cfg();
  if (!C) return;

  function money(c){ return '$' + (c / 100).toFixed(2); }

  /* units the tile sells: the duo tile is fixed at 2; ladder tiles carry one
     picker per unit (times data-pg-mul on single-design products); a bare
     native tile is 1 */
  function unitsOf(tile){
    /* SPARES NEEDED, NOT CONSOLES SOLD. The Duo Pack ships two consoles AND a
       free case, so the shopper needs ONE more case, not two -- this offered
       "a spare case for each console" at $27.98 next to a pack that already
       includes one. One case, $13.99. */
    if (tile.classList.contains('pgx-trio')) return 2;   /* three consoles, one free case */
    if (tile.classList.contains('pgx-duo')) return 1;
    var d = tile.querySelectorAll('.pgx-lad-picks .pg-drop').length;
    var mul = parseInt(tile.dataset.pgMul || '1', 10) || 1;
    return d ? d * mul : 1;
  }

  /* one row per tile, appended once and re-priced on every pass - the theme
     rebuilds tiles, so this settles rather than assumes */
  function pass(){
    document.querySelectorAll('#pgx .pgx-tile').forEach(function(tile){
      if (!tile.getClientRects().length) return;   /* natives hidden by pgLadder */
      var row = tile.querySelector('.pg-tadd');
      if (!row){
        row = document.createElement('div');
        row.className = 'pg-tadd' + (C.cls ? ' ' + C.cls : '');
        row.setAttribute('role', 'checkbox');
        row.setAttribute('aria-checked', 'false');
        row.setAttribute('tabindex', '0');
        row.innerHTML = '<span class="pg-tadd-ck" aria-hidden="true"></span>'
          + '<img alt="" src="' + C.img + '">'
          + '<span class="pg-tadd-t"></span>'
          + '<span class="pg-tadd-p"><s></s><b></b></span>';
        tile.appendChild(row);
      }
      var n = unitsOf(tile);
      var t = row.querySelector('.pg-tadd-t');
      var txt = n > 1 ? C.many : C.one;
      /* THE DUO TILE SAYS WHY IT IS ONLY ASKING FOR ONE. The pack ships two
         consoles and a free case, so the offer covers the second console only.
         Without saying so the row reads like a mistake next to a two-console
         pack -- one case, one price, no explanation. */
      if (tile.classList.contains('pgx-trio')) txt = 'Add 2 spare protective cases';
      if (tile.classList.contains('pgx-duo')) txt = txt + ' (1 Comes Free)';
      if (t.textContent !== txt) t.textContent = txt;
      var s = row.querySelector('.pg-tadd-p s'), b = row.querySelector('.pg-tadd-p b');
      var sTxt = money(C.cap * n), bTxt = money(C.unit * n);
      if (s.textContent !== sTxt) s.textContent = sTxt;
      if (b.textContent !== bTxt) b.textContent = bTxt;
    });
  }

  /* toggle. Capture phase and stopPropagation: a click on the row must not
     fall through to the tile's own click handler chain twice, and must never
     reach the pickers. Toggling still SELECTS the tile first if it was not,
     so a tap on an unselected tile's row does both things the shopper meant. */
  document.addEventListener('click', function(e){
    var row = e.target && e.target.closest && e.target.closest('#pgx .pg-tadd');
    if (!row) return;
    e.stopPropagation();
    var tile = row.closest('.pgx-tile');
    if (tile && !tile.classList.contains('pgx-sel')) tile.click();
    var on = !row.classList.contains('on');
    row.classList.toggle('on', on);
    row.setAttribute('aria-checked', on ? 'true' : 'false');
  }, true);
  document.addEventListener('keydown', function(e){
    if (e.key !== ' ' && e.key !== 'Enter') return;
    var row = e.target && e.target.closest && e.target.closest('#pgx .pg-tadd');
    if (!row) return;
    e.preventDefault();
    row.click();
  }, true);

  /* ride along with ADD TO CART: the tile handlers (pg-landing, pgLadder,
     the duo tile) post their own items; this posts the add-on shortly after
     and refreshes the drawer so the new line is on screen. */
  var busy = false;
  document.addEventListener('click', function(e){
    var b = e.target && e.target.closest && e.target.closest('.pgx-atc');
    if (!b || busy) return;
    /* the VISIBLE selected tile: on ladder pages the hidden native single
       still wears .pgx-sel from its initial render */
    var sel = Array.prototype.slice.call(document.querySelectorAll('#pgx .pgx-tile.pgx-sel'))
      .filter(function(t){ return t.getClientRects().length; })[0];
    if (!sel) return;
    var row = sel.querySelector('.pg-tadd.on');
    if (!row) return;
    var qty = unitsOf(sel);
    busy = true;
    setTimeout(function(){
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        credentials: 'same-origin',
        body: JSON.stringify({items: [{id: C.variant, quantity: qty}]})
      }).then(function(){
        busy = false;
        if (window.pgDrawerRefresh){ try { window.pgDrawerRefresh(); return; } catch(err){} }
        if (window.pgOpenCart) window.pgOpenCart();
      }).catch(function(){ busy = false; });
    }, 900);
  }, true);

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', pass);
  else pass();
  setInterval(pass, 800);
})();

/* The frame and the case are add-ons, not catalogue items: no link anywhere
   on the site (cart lines included) may open their product pages. Hrefs are
   stripped as they appear, and a capture-phase blocker catches the window
   between a drawer rebuild and the next sweep. Their PDPs also carry the
   redirect template server-side. */
(function(){
  if (window.pgNoAddonLinks) return; window.pgNoAddonLinks = 1;
  var MARKS = ['30x40cm-frame', 'r36s-protective-case'];
  function strip(){
    for (var i = 0; i < MARKS.length; i++){
      document.querySelectorAll('a[href*="' + MARKS[i] + '"]').forEach(function(a){
        /* href STAYS: pg-drawer, pg-chips and pg-frame-add all identify these
           lines by it. Only the navigation is disabled. */
        a.style.setProperty('pointer-events', 'none', 'important');
        a.style.setProperty('cursor', 'default', 'important');
        a.style.setProperty('text-decoration', 'none', 'important');
      });
    }
  }
  document.addEventListener('click', function(e){
    var a = e.target && e.target.closest && e.target.closest('a[href*="30x40cm-frame"], a[href*="r36s-protective-case"]');
    if (a){ e.preventDefault(); e.stopPropagation(); }
  }, true);
  /* A PACK LINE IN THE CART LINKS TO THE CONSOLE PAGE. The href itself is
     left alone -- pg-cart-tune, pg-drawer and pg-cart-variants all identify a
     pack row by it -- so only the navigation is redirected. Without this the
     tap landed on the pack's own product page, which grew the generic
     four-tier ladder ("five different bundle deals"). The pack pages also
     carry product.redirect-console server-side, for links this cannot see. */
  document.addEventListener('click', function(e){
    var a = e.target && e.target.closest && e.target.closest('a[href*="/products/r36s-duo-pack"], a[href*="/products/r36s-trio-pack"]');
    if (!a) return;
    e.preventDefault(); e.stopPropagation();
    window.location.href = '/products/handheld-game-console';
  }, true);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', strip);
  else strip();
  setInterval(strip, 900);
})();
</script>
{% schema %}
{"name": "PG Theme CSS", "settings": [
  {"type": "select", "id": "most_popular", "label": "'Most Popular' pill (console tiles)", "info": "Set from the order book; the single console led 14 orders to 3 at 2026-09-11. Best Deal is worked out from the prices and never stacks with it.",
   "options": [{"value": "none", "label": "None"}, {"value": "single", "label": "Single console"}, {"value": "duo", "label": "Duo Pack"}, {"value": "trio", "label": "Trio Pack"}], "default": "single"}
]}
