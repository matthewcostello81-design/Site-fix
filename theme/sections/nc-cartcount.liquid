{% comment %} Cart badge + PDP arrows + product-card media bg matched to hero cream. Global via overlay-group. 2026-09-22: removed the North Cove sale % patch, summer-sale banner, bands thumb swaps and birchwood picker fix. They ran on every change anywhere in the page (a scan of every element and a layout read of every image each time), which is a large part of why the site was slow on phones, and nothing on Pocket Era uses them. The badge refresh after a drawer change now waits 1.5s and runs once per burst, instead of fetching /cart.js 120ms after every single change. {% endcomment %}<style>.ncg-arr{line-height:1 !important;font-size:24px !important;display:flex !important;align-items:center !important;justify-content:center !important;text-align:center !important}.icon-cart[data-nccb]{position:relative!important}.nc-cc-badge{position:absolute;top:-7px;right:-9px;min-width:17px;height:17px;padding:0 4px;box-sizing:border-box;display:none;align-items:center;justify-content:center;background:#C85C22;color:#fff!important;-webkit-text-fill-color:#fff;font-size:10.5px;font-weight:800;line-height:1;border-radius:100px;font-family:inherit;pointer-events:none}.nc-cc-badge.is-on{display:flex}#root .l4cl li.product-card figure,#root ul.l4cl>li.product-card figure{background:rgb(242,239,231)!important;border-radius:16px 16px 0 0!important;overflow:hidden!important}.nch-pthumb{background:rgb(242,239,231)!important}</style><script>!function(){var last=null,busy=false;function paint(n){var icons=document.querySelectorAll('.icon-cart');icons.forEach(function(i){if(i.closest('.product-card'))return;i.setAttribute('data-nccb','1');var b=i.querySelector(':scope > .nc-cc-badge');if(!b){b=document.createElement('span');b.className='nc-cc-badge';b.setAttribute('aria-hidden','true');i.appendChild(b);}if(n>0){b.textContent=n>99?'99+':String(n);b.classList.add('is-on');}else{b.textContent='';b.classList.remove('is-on');}});}function refresh(){if(busy)return;busy=true;fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json()}).then(function(c){var n=(c&&typeof c.item_count==='number')?c.item_count:0;last=n;paint(n);busy=false;}).catch(function(){busy=false;});}function paintCached(){if(last!==null)paint(last);}var cart=document.getElementById('cart');if(cart){try{var dq=0;new MutationObserver(function(){paintCached();if(!dq)dq=setTimeout(function(){dq=0;refresh();},1500);}).observe(cart,{childList:true,subtree:true});}catch(e){}}if(window.openPanel){var o=window.openPanel;window.openPanel=function(){var r=o.apply(this,arguments);setTimeout(refresh,120);return r;};}document.addEventListener('submit',function(e){var f=e.target;if(f&&f.getAttribute&&(f.getAttribute('action')||'').indexOf('/cart')>-1){setTimeout(refresh,400);setTimeout(refresh,1200);}},true);if(document.readyState!=='loading')refresh();else document.addEventListener('DOMContentLoaded',refresh);setTimeout(refresh,900);setTimeout(refresh,2400);}();</script>{% schema %}{"name":"NC Cart Count","settings":[],"presets":[{"name":"NC Cart Count"}]}{% endschema %}