{% comment %} Cart badge + PDP arrows + sale % patch + summer-sale banner v6 + birchwood picker fix + bands thumb swaps + product-card media bg matched to hero cream. Global via overlay-group. {% endcomment %}<style>.ncg-arr{line-height:1 !important;font-size:24px !important;display:flex !important;align-items:center !important;justify-content:center !important;text-align:center !important}.icon-cart[data-nccb]{position:relative!important}.nc-cc-badge{position:absolute;top:-7px;right:-9px;min-width:17px;height:17px;padding:0 4px;box-sizing:border-box;display:none;align-items:center;justify-content:center;background:#C85C22;color:#fff!important;-webkit-text-fill-color:#fff;font-size:10.5px;font-weight:800;line-height:1;border-radius:100px;font-family:inherit;pointer-events:none}.nc-cc-badge.is-on{display:flex}#root .l4cl li.product-card figure,#root ul.l4cl>li.product-card figure{background:rgb(242,239,231)!important;border-radius:16px 16px 0 0!important;overflow:hidden!important}.nch-pthumb{background:rgb(242,239,231)!important}</style><script>!function(){var last=null,busy=false;function paint(n){var icons=document.querySelectorAll('.icon-cart');icons.forEach(function(i){if(i.closest('.product-card'))return;i.setAttribute('data-nccb','1');var b=i.querySelector(':scope > .nc-cc-badge');if(!b){b=document.createElement('span');b.className='nc-cc-badge';b.setAttribute('aria-hidden','true');i.appendChild(b);}if(n>0){b.textContent=n>99?'99+':String(n);b.classList.add('is-on');}else{b.textContent='';b.classList.remove('is-on');}});}function refresh(){if(busy)return;busy=true;fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json()}).then(function(c){var n=(c&&typeof c.item_count==='number')?c.item_count:0;last=n;paint(n);busy=false;}).catch(function(){busy=false;});}function paintCached(){if(last!==null)paint(last);}var cart=document.getElementById('cart');if(cart){try{new MutationObserver(function(){paintCached();setTimeout(refresh,120);}).observe(cart,{childList:true,subtree:true});}catch(e){}}if(window.openPanel){var o=window.openPanel;window.openPanel=function(){var r=o.apply(this,arguments);setTimeout(refresh,120);return r;};}document.addEventListener('submit',function(e){var f=e.target;if(f&&f.getAttribute&&(f.getAttribute('action')||'').indexOf('/cart')>-1){setTimeout(refresh,400);setTimeout(refresh,1200);}},true);if(document.readyState!=='loading')refresh();else document.addEventListener('DOMContentLoaded',refresh);setTimeout(refresh,900);setTimeout(refresh,2400);}();</script><script>(function(){var LIFE='https://cdn.shopify.com/s/files/1/0815/5706/1860/files/nc-bands-clean-v2.png?v=1785509186';var PLATE='https://cdn.shopify.com/s/files/1/0815/5706/1860/files/nc-bands-clean-v2.png?v=1785509186';var V6='https://cdn.shopify.com/s/files/1/0815/5706/1860/files/summer-sale-hero-v7.jpg?v=1785457318';function p(){document.querySelectorAll('.nc-ann-item,.nc-promo__lab').forEach(function(e){var t=e.textContent;if(/(37|40)%/.test(t))e.textContent=t.replace(/(37|40)%/g,'50%');});var all=document.querySelectorAll('body *');for(var i=0;i<all.length;i++){var el=all[i];if(el.children.length===0&&el.textContent&&/^UP TO \d+% OFF$/.test(el.textContent.trim())&&el.textContent.trim()!=='UP TO 50% OFF'){el.textContent='UP TO 50% OFF';}}var bn=document.querySelectorAll('.nc-collhero .nc-ed__img--full img, img[src*="summer-sale-hero"]');for(var b=0;b<bn.length;b++){var im=bn[b];var s=im.getAttribute('src')||'';if(s.indexOf('summer-sale-hero-v7')>-1)continue;im.removeAttribute('srcset');im.removeAttribute('data-srcset');im.setAttribute('src',V6);im.setAttribute('data-ncbn','1');}document.querySelectorAll('.nch-pcard').forEach(function(c){if(c.textContent.indexOf('5-Level')>-1){var im2=c.querySelector('img');if(im2&&(im2.currentSrc||im2.src).indexOf('nc-bands-clean')===-1){im2.removeAttribute('srcset');im2.removeAttribute('data-srcset');im2.src=LIFE;}}});document.querySelectorAll('img').forEach(function(im3){var s3=im3.currentSrc||im3.src||'';if(s3.indexOf('nc-bands-clean')>-1)return;var r=im3.getBoundingClientRect();if(!(r.width>0&&r.width<=200))return;var host=im3.parentElement;var hit=false;for(var k=0;k<5&&host;k++){if((host.textContent||'').indexOf('5-Level Resistance Band Set')>-1&&host.textContent.length<800){hit=true;break;}host=host.parentElement;}if(hit&&!im3.closest('.nch-pcard')){im3.removeAttribute('srcset');im3.removeAttribute('data-srcset');im3.src=PLATE;}});}if(document.readyState!=='loading')p();else document.addEventListener('DOMContentLoaded',p);setTimeout(p,300);setTimeout(p,1000);setTimeout(p,2600);setTimeout(p,5000);try{new MutationObserver(function(m){var skip=m.every(function(x){return x.type==='attributes';});if(!skip)p();}).observe(document.body,{childList:true,subtree:true});}catch(e){}})();</script><script>(function(){var TT='4-Piece Set + Gift';var NEW='Full set — 4 birchwood tools + a surprise mystery gift';function fix(){document.querySelectorAll('.nc-od-t').forEach(function(e){if(e.textContent.trim()==='5 Piece Set')e.textContent=TT;});document.querySelectorAll('.nc-od-d').forEach(function(e){if(e.textContent.indexOf('5 birchwood shapes')>-1)e.textContent=NEW;});document.querySelectorAll('.nc-optbtn').forEach(function(btn){if(!btn.querySelector('.nc-od-t')&&btn.textContent.trim()===TT){btn.innerHTML='<b class="nc-od-t">'+TT+'</b><i class="nc-od-d">'+NEW+'</i>';}else if(btn.querySelector('.nc-od-t')&&btn.querySelector('.nc-od-t').textContent.trim()===TT&&!btn.querySelector('.nc-od-d')){var d=document.createElement('i');d.className='nc-od-d';d.textContent=NEW;btn.appendChild(d);}});document.querySelectorAll('select option').forEach(function(o){if(o.textContent.indexOf('5 Piece Set')>-1)o.textContent=o.textContent.replace('5 Piece Set',TT);});var bs=Array.prototype.slice.call(document.querySelectorAll('.nc-optbtn'));if(bs.length>1&&bs.some(function(b){return b.querySelector('.nc-od-d');})){var par=bs[0].parentElement;if(par){par.style.setProperty('display','flex','important');par.style.setProperty('gap','12px','important');par.style.setProperty('align-items','stretch','important');}bs.forEach(function(b){b.style.setProperty('flex','1 1 0','important');b.style.setProperty('width','auto','important');b.style.setProperty('display','flex','important');b.style.setProperty('flex-direction','column','important');b.style.setProperty('justify-content','flex-start','important');b.style.setProperty('padding-top','15px','important');b.style.setProperty('align-items','center','important');b.style.setProperty('text-align','center','important');b.style.setProperty('box-sizing','border-box','important');Array.prototype.forEach.call(b.children,function(c){c.style.setProperty('text-align','center','important');});b.style.removeProperty('height');});var mx=0;bs.forEach(function(b){if(b.offsetHeight>mx)mx=b.offsetHeight;});bs.forEach(function(b){b.style.setProperty('height',mx+'px','important');});}}if(document.readyState!=='loading')fix();else document.addEventListener('DOMContentLoaded',fix);setTimeout(fix,400);setTimeout(fix,1200);setTimeout(fix,3000);try{new MutationObserver(function(m){var skip=m.every(function(x){return x.type==='attributes'&&x.attributeName==='style';});if(!skip)fix();}).observe(document.body,{childList:true,subtree:true,attributes:true,attributeFilter:['style']});}catch(e){}})();</script>{% schema %}{"name":"NC Cart Count","settings":[],"presets":[{"name":"NC Cart Count"}]}{% endschema %}