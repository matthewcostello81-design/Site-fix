      <div class="pg-rhs-feat"><span class="ic"><svg viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"/></svg></span><h3>Quad-Core Processor</h3><p>Runs everything from 8-bit classics to PS1 smoothly.</p></div>
      <div class="pg-rhs-feat"><span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="12.5" rx="2"/><path d="M8.5 20.5h7M12 17v3.5"/></svg></span><h3>Bright 3.5 Inch Screen</h3><p>Sharp, bright 640x480 IPS display.</p></div>
      <div class="pg-rhs-feat"><span class="ic"><svg viewBox="0 0 24 24"><path d="M7 3h7.5L19 7.5V20a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M9.5 3v3.5M12.5 3v3.5"/><path d="M12.5 11.5v6M9.5 14.5h6"/></svg></span><h3>Two Card Slots</h3><p>One runs the system, one holds your games. Updates never touch your saves.</p></div>
      <div class="pg-rhs-feat"><span class="ic"><svg viewBox="0 0 24 24"><rect x="2.5" y="8" width="16.5" height="8.5" rx="2"/><path d="M21.5 11v2.5M11.5 9.8l-2.4 2.9h3.2l-2.2 2.6"/></svg></span><h3>3000mAh Battery</h3><p>About 5 hours of play. Charges over USB-C.</p></div>
    </div>
  </section>

  <section class="pg-rhs-sec">
    <span class="pg-rhs-eye">In the Max Bundle</span>
    <h2>Three Accessories. <span>Every One Included.</span></h2>
    <p class="pg-rhs-lead">All three come in the Max Bundle and the Duo Max Bundle, or add any of them to the Single&nbsp;Device.</p>
    <div class="pg-rhs-cases">
      <div class="pg-rhs-case"><img src="{{ p2_sil_img }}" alt="R36H Pro silicone daily case" loading="lazy" decoding="async" width="360" height="360"><div><span class="tag">Included</span><h3>Silicone Daily Case</h3><p>A soft silicone sleeve with a lanyard that stays on the console. Grippy in the hand, shrugs off scratches and drops.</p></div></div>
      <div class="pg-rhs-case"><img src="{{ p2_hard_img }}" alt="R36H Pro hard shell travel case" loading="lazy" decoding="async" width="360" height="360"><div><span class="tag">Included</span><h3>Hard Shell Travel Case</h3><p>A zip-up hard shell for the bag. Holds the console, its cable and your microSD cards, and takes the knocks so the console does not.</p></div></div>
      <div class="pg-rhs-case"><img src="{{ p2_prot_img }}" alt="R36H Pro tempered glass screen protector" loading="lazy" decoding="async" width="360" height="360"><div><span class="tag">Included</span><h3>Tempered Glass Screen Protector</h3><p>Real glass over the 3.5 inch screen, with a cloth and a wipe to fit it clean.</p></div></div>
    </div>
    <span class="pg-rhs-cta" role="button" tabindex="0" data-rhs-cta data-rhs-max>Get the Max Bundle <span>&rarr;</span></span>
  </section>

  <section class="pg-rhs-sec pg-rhs-end">
    <span class="pg-rhs-eye">Side by side</span>
    <h2>Why the R36H Pro <span>Stands Out.</span></h2>
    <div class="pg-rhs-tbl" role="table" aria-label="R36H Pro compared with a {{ section.settings.gba_model | escape }}">
      <div class="pg-rhs-row hd" role="row"><div role="columnheader"></div><div class="us" role="columnheader">R36H Pro</div><div class="them" role="columnheader">{{ section.settings.gba_model }}</div></div>
      {%- assign rows = 'Up to 20,000 games preloaded|3.5 inch backlit IPS screen|Rechargeable battery|Games included in the box|20+ systems in one device|Two joysticks, four shoulder buttons|Plays on your TV over HDMI|Two microSD slots: system and games|Brand new with a 30-day guarantee' | split: '|' -%}
      {%- for row in rows -%}
      <div class="pg-rhs-row" role="row"><div role="cell">{{ row }}</div><div class="us" role="cell"><span class="y" aria-label="Yes"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></div><div role="cell"><span class="n" aria-label="No"><svg viewBox="0 0 24 24"><path d="M7 7l10 10M17 7L7 17"/></svg></span></div></div>
      {%- endfor -%}
    </div>
    <span class="pg-rhs-cta" role="button" tabindex="0" data-rhs-cta>Choose Your Bundle <span>&rarr;</span></span>
  </section>
</div>

<script>
(function(){
  if (window.pgR36hStory) return; window.pgR36hStory = 1;

  function seat(){
    var src = document.getElementById('pg-rhs-src');
    var buy = document.querySelector('#pgx .pgx-buy');
    if (src && buy){
      var ben = src.querySelector('[data-rhs="ben"]');
      if (ben){
        var after = buy.querySelector(':scope > .pgx-rating') || buy.querySelector(':scope > .pgx-title');
        if (after) buy.insertBefore(ben, after.nextSibling); else buy.insertBefore(ben, buy.firstChild);
      }
      /* the photo strip follows the bundles: after the Add to cart button and
         its error line where they are still in the column (a desktop), after
         the last tile otherwise. On a phone its flex order does the placing. */
      var shots = src.querySelector('[data-rhs="shots"]') || buy.querySelector(':scope > [data-rhs="shots"]');
      if (shots){
        var after = buy.querySelector(':scope > #pgx-err') || buy.querySelector(':scope > #pgx-atc');
        if (!after){
          var ts = buy.querySelectorAll(':scope > .pgx-tile');
          after = ts.length ? ts[ts.length - 1] : null;
        }
        if (after){ if (after.nextElementSibling !== shots) buy.insertBefore(shots, after.nextSibling); }
        else if (shots.parentNode !== buy) buy.appendChild(shots);
      }
    }
    trust();
    lower();
    loved();
  }

  /* the loved-by pill reads the page's own rating line, so it follows Judge.me */
  function loved(){
    var pill = document.querySelector('#pgx [data-rhs-loved="pill"]');
    var r = document.querySelector('#pgx .pgx-rating strong');
    var l = document.querySelector('#pgx .pgx-rating .pgx-revlink');
    if (!pill || !r || !l) return;
    var n = parseInt((l.textContent || '').replace(/[^\d]/g, ''), 10);
    var txt = 'Rated ' + (r.textContent || '').trim() + '/5' + (n ? ' \u00b7 ' + n + ' reviews' : '');
    if (pill.textContent !== txt) pill.textContent = txt;
  }
  /* the accordions lead the trust block: just before the info box. Skipped
     while they are outside the buy column (pg-acc-place brings them back). */
  function trust(){
    var buy = document.querySelector('#pgx .pgx-buy');
    var acc = document.getElementById('pgx-desc');
    if (!buy || !acc || acc.parentNode !== buy) return;
    var info = buy.querySelector(':scope > .pgx-info');
    if (info && acc.nextElementSibling !== info) buy.insertBefore(acc, info);
  }

  /* product | story | you may also like | reviews. Safe to call any number of
     times: every move is skipped when the node is already in its seat. */
  function lower(){
    var story = document.getElementById('pg-rhs');
    var rev = document.querySelector('#pgx #pg-reviews, #pgx .pgx-rev');
    if (!story || !rev || !rev.parentNode) return;
    var host = rev.parentNode;
    var yml = document.querySelector('.pgu-yml');
    var anchor = rev;
    if (yml){
      if (yml.parentNode !== host || yml.nextElementSibling !== rev) host.insertBefore(yml, rev);
      anchor = yml;
    }
    if (story.parentNode !== host || story.nextElementSibling !== anchor) host.insertBefore(story, anchor);
    watch(host);
    var main = document.querySelector('#pgx .pgx-main');
    if (main && main.parentNode) watch(main.parentNode);
  }
  var queued = false;
  function watch(node){
    if (!node || node.pgP2sObs || !window.MutationObserver) return;
    node.pgP2sObs = 1;
    new MutationObserver(function(){
      if (queued) return;
      queued = true;
      setTimeout(function(){ queued = false; try { lower(); } catch (e){} }, 60);
    }).observe(node, {childList: true});
  }

  function toBundles(){
    var t = document.querySelector('#pgx .pgx-bs') || document.querySelector('#pgx .pgx-tile') || document.querySelector('#pgx .pgx-buy');
    if (!t) return;
    try { t.scrollIntoView({behavior: 'smooth', block: 'start'}); } catch (e){ t.scrollIntoView(); }
  }
  document.addEventListener('click', function(e){
    if (e.target && e.target.closest && e.target.closest('[data-rhs-cta]')) {
      e.preventDefault();
      /* the accessories chapter's button also selects the Max tile */
      if (e.target.closest('[data-rhs-max]')){ var mt = document.querySelector('#pgx .pgx-buy > .pg-rh[data-rh="max"]'); if (mt) mt.click(); }
      toBundles();
    }
  });
  document.addEventListener('keydown', function(e){
    if ((e.key === 'Enter' || e.key === ' ') && e.target && e.target.closest && e.target.closest('[data-rhs-cta]')){ e.preventDefault(); toBundles(); }
  });

  /* THE PRICE COMPARISON FOLLOWS THE SELECTED TILE (2026-09-17, "make this
     change based on if they have max bundle or single selected"): the R36
     card's label, price and games line read the tile selected in the buy box,
     so a shopper on the Max Bundle compares $119.99 and 40K games, not the
     single's $74.99. Two consoles say "each". Polled, like the rest of the
     page: the tiles repaint on their own beat and rebuilds are common. */
  function cmpSet(k, v){
    var el = document.querySelector('#pg-rhs [data-rhs-cmp="' + k + '"]');
    if (el && el.textContent !== v) el.textContent = v;
  }
  function compare(){
    var t = document.querySelector('#pgx .pgx-buy > .pgx-tile.pg-rh.pgx-sel');
    if (!t) return;
    var kind = t.getAttribute('data-rh');
    var two = kind === 'duo' || (kind === 'single' && t.getAttribute('data-rh-qty') === '2');
    var big = kind === 'max' || kind === 'duo';
    var now = t.querySelector('[data-rh-now]');
    var price = now ? (now.textContent || '').replace(/^\s+|\s+$/g, '') : '';
    cmpSet('eye', kind === 'max' ? 'R36H Pro Max' : kind === 'duo' ? 'R36H Pro Duo Max' : two ? 'R36H Pro Duo' : 'R36H Pro');
    /* the first line tells the bundles apart (2026-09-17, "something that differentiates it from the first one") */
    cmpSet('line1', kind === 'max' ? 'One Max console' : kind === 'duo' ? 'Two Max consoles' : two ? 'Two new consoles' : 'New, 20+ systems');
    if (price) cmpSet('price', price);
    cmpSet('games', (big ? '40K games' : '15,000+ games') + (two ? ' each' : ''));
    /* the vintage card keeps pace (2026-09-18, "put up the competitor price
       accordingly too"): two consoles double the used-handheld figure from the
       section setting; the Max points out the kit the used one lacks */
    if (!window.__p2sVbase){
      var vp = document.querySelector('#pg-rhs [data-rhs-cmp="vprice"]');
      window.__p2sVbase = (vp && parseInt((vp.textContent || '').replace(/[^\d]/g, ''), 10)) || 150;
      window.__p2sVmax = (vp && parseInt(vp.getAttribute('data-rhs-vmax') || '', 10)) || Math.round(window.__p2sVbase * 1.27);
    }
    /* the Max is matched against a used handheld PLUS a case (2026-09-18, "update pricing on left if max was selected"); the Duo doubles it */
    var vb = big ? window.__p2sVmax : window.__p2sVbase;
    cmpSet('veye', two ? 'Vintage handhelds' : 'Vintage handheld');
    cmpSet('vprice', '~$' + (two ? vb * 2 : vb));
    cmpSet('vline1', two ? (big ? 'Two used, two cases' : 'Two used, no games') : (big ? 'Used, plus a case' : 'Used, one system'));
    cmpSet('vline2', two ? (big ? 'No games' : 'One system each') : 'No games');
  }
  function boot(){ seat(); setTimeout(seat, 500); setTimeout(function(){ trust(); lower(); }, 1600); setTimeout(lower, 3200); compare(); setInterval(compare, 500); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "PG R36H Pro Story",
  "settings": [
    {"type": "text", "id": "gba_model", "label": "Vintage handheld named in the price comparison and the chart", "default": "Game Boy Advance"},
    {"type": "text", "id": "gba_price", "label": "Its typical used price, whole dollars (check PriceCharting)", "default": "150"},
    {"type": "text", "id": "gba_price_max", "label": "Used price plus a case, shown against the Max Bundle, whole dollars", "default": "190"},
    {"type": "image_picker", "id": "hero_image", "label": "Photo in Your childhood, upgraded (optional)"},
    {"type": "image_picker", "id": "story_image", "label": "Photo beside the price comparison (optional)"}
  ],
  "presets": [{"name": "PG R36H Pro Story"}]
}
{% endschema %}
