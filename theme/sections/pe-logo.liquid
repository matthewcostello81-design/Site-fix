{%- comment -%}
  PE Logo: swaps every header mark to the vector Pocket Era badge and repairs
  the two flanking wordmarks.

  This section loads from header-group, which renders BEFORE the pg-* layers in
  footer-group, so every rule here is written one level more specific than the
  rule it replaces (html body ...). Specificity is compared before source order,
  so these win regardless of load position. The flicker keyframe is renamed
  rather than redefined, because same-name @keyframes resolve by source order,
  not specificity.
{%- endcomment -%}
{%- assign pe_mark = 'pe-badge.svg' | asset_url -%}
<style data-pe-logo>
/* ---------------- the mark ----------------
   The previous art was a raster PNG with a black box baked in, which is why
   pg-theme-css and pg-dark both blend it with mix-blend-mode:screen. The
   replacement is a transparent vector, so screen blending would only wash it
   out against the rgba(11,7,16,.9) header bar. */
html body .pgh-logo img,
html body .pgx-logo img,
html body .pgc-logo img,
html body .pgf-head img,
html body img.nc-dlogo,
html body img.nc-foot-emblem{
  content:url("{{ pe_mark }}") !important;
  mix-blend-mode:normal !important;
  filter:drop-shadow(0 0 13px rgba(180,120,224,.42)) drop-shadow(0 0 34px rgba(139,68,190,.26)) !important;
}
html body .pgh-logo img,
html body .pgx-logo img{max-height:124px !important;width:auto !important}
html body .pgc-logo img{max-height:104px !important;width:auto !important}
html body .pgf-head img{max-height:96px !important;width:auto !important}
@media(max-width:900px){
  html body .pgh-logo img,
  html body .pgx-logo img{max-height:88px !important}
  html body .pgc-logo img{max-height:76px !important}
  html body .pgf-head img{max-height:76px !important}
}

/* ---------------- flanking wordmarks ----------------
   Three things were making these hard to read:
   1. letter-spacing:-.11em pulled the glyphs into each other. Press Start 2P
      already carries its own spacing, so natural tracking is the match.
   2. clamp(18px,1.7vw,30px) produces fractional sizes. Press Start 2P is drawn
      on an 8px grid and only lands on whole device pixels at multiples of 8 --
      anything else gets resampled and blurs. Fixed 24/32px instead.
   3. The glow's first shadow was 12px at .9 alpha, which bled over the
      letterforms. Tighter and lighter keeps the edges. */
html body a.pg-wordmark{
  top:50% !important;
  transform:translateY(-50%);
  font-size:24px !important;
  letter-spacing:0 !important;
  line-height:1.2 !important;
  text-shadow:0 0 6px rgba(246,219,255,.5),0 0 17px rgba(199,155,234,.38),0 0 40px rgba(139,68,190,.26) !important;
  animation-name:peFlash !important;
}
@media(min-width:1440px){html body a.pg-wordmark{font-size:32px !important}}
/* ---------------- wordmark sizing (wins over pg-mobile) ----------------
   pg-mobile hides the logo art and promotes the injected text wordmark to be
   the brand mark, stretching it with transform:scaleY(2.6). That rule is
   `html body a.pg-wordmark` + !important and loads later, so it currently wins
   the ties above. Repeating the class (a.pg-wordmark.pg-wordmark) buys one
   more specificity point, which beats source order.

   1. 2.6 -> 2.21 makes the mark 15% shorter. Only the vertical scale changes,
      so the width and letterforms are exactly as before, just less stretched.
   2. The size then comes down 10% on both axes: pg-mobile's
      clamp(40px,4.6vw,78px) -> clamp(36px,4.14vw,70px). Scaling the font
      rather than the transform keeps the height-to-width ratio set above, so
      the mark simply gets smaller rather than differently proportioned.
   3. white-space:nowrap keeps "Pocket Era" on a single line -- on narrow
      phones it was wrapping to two. Nowrap alone would overflow (the header
      box is overflow:hidden), so under 560px the size is also capped to a
      share of the viewport: the mark is ~9.8em wide, and 7.6vw keeps it
      around 75% of the screen with room for the gutters. */
html body a.pg-wordmark.pg-wordmark{
  transform:scaleY(2.21) !important;
  white-space:nowrap !important;
  font-size:clamp(36px,4.14vw,70px) !important;
  /* 4. Kerning lives in pg-wordmark, not here. letter-spacing is the only
        lever CSS offers on a plain text node and it moves EVERY glyph, so
        every value that pulled the T toward POCKET also crushed P O C K E
        together. pg-wordmark splits the T into its own span and gives it a
        margin, which moves it alone. */
}
@media(min-width:1440px){
  html body a.pg-wordmark.pg-wordmark{font-size:70px !important}
}
@media(max-width:560px){
  html body a.pg-wordmark.pg-wordmark{font-size:min(27px,7.6vw) !important}
}
/* the old pgFlash dipped to .45 opacity twice every 3.2s, which read as the
   name blinking out. Same rhythm, much shallower. */
@keyframes peFlash{
  0%,100%{opacity:1}
  6%{opacity:.74}
  8%{opacity:1}
  11%{opacity:.88}
  13%{opacity:1}
  46%{opacity:1}
  48%{opacity:.8}
  50%{opacity:1}
}
</style>
<script data-pe-logo>
(function(){
  if (window.peLogo) return; window.peLogo = 1;
  var SRC = {{ pe_mark | json }};
  var SEL = '.pgh-logo img,.pgx-logo img,.pgc-logo img,.pgf-head img,img.nc-dlogo,img.nc-foot-emblem';
  /* content:url above already handles the visual swap. This rewrites src too so
     the retired art stops being fetched and alt text stays correct. pg-drawer
     and pg-footer re-assign src from their own settings on a delay, so this
     re-asserts a few times rather than running once. */
  function swap(){
    document.querySelectorAll(SEL).forEach(function(i){
      if (i.getAttribute('src') === SRC) return;
      i.setAttribute('src', SRC);
      i.alt = 'Pocket Era';
      i.removeAttribute('srcset');
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', swap); else swap();
  [400, 900, 1600, 2800].forEach(function(t){ setTimeout(swap, t); });
})();
</script>
<style>
  /* ---- THE MOBILE HEADER DOES NOT MOVE ---- (home-page CLS fix)
     Measured on a 393x852 iPhone viewport: the homepage loaded with a
     cumulative layout shift of 1.83, essentially all of it the header stack
     changing height while it settles -- the theme's logo image is swapped for
     the injected mark, Press Start 2P arrives and re-metrics the nav, and the
     announcement marquee is rebuilt. Each change re-seated everything below
     by up to ~190px, three times in half a second. The product pages measure
     0.00 -- only the home header churns.

     So on phones the three header bands are clamped to the heights they
     settle at anyway (announcement 36px, header-inner 114px, nav 33px), with
     the overflow hidden the header already uses. Whatever the scripts and
     fonts do inside those boxes, the page below them never moves again:
     re-measured 1.83 -> per the run after this block landed. Desktop is left
     alone -- its header was not the problem and its widths vary more. */
  /* The product pages' pgx header settles at the same numbers as pgh --
     measured announce 35.8 / head 146.8 / head-in 114 / nav 31.8 -- and showed
     the identical churn (pgx-main bouncing 139 -> 128 -> 350 -> 183 while the
     header settled), so both families are clamped alike. The pgc/pgf headers
     on the content templates are NOT clamped: they carry the big scaled
     wordmark and were not measured, and clamping an unmeasured header risks
     clipping it -- those pages are also not on the buying path. */
  @media (max-width:760px){
    html body .pgh-announce,html body .pgx-announce{
      height:36px !important;overflow:hidden !important}
    html body .pgh-head,html body .pgx-head{
      height:147px !important;min-height:0 !important;overflow:hidden !important}
    html body .pgh-head-in,html body .pgx-head-in{
      height:114px !important;min-height:0 !important;overflow:hidden !important}
    html body .pgh-nav,html body .pgx-nav{
      height:33px !important;overflow:hidden !important}
    html body .pgh-logo,html body .pgx-logo{
      min-height:0 !important}
  }
</style>
<style>
  /* ---- THE LOAD CURTAIN ---- (no boxes may jump while the page dresses)
     This theme is styled in layers: the base theme paints first, and the
     Pocket Era styling lives in sections at the END of the document, so a
     streaming first paint shows the base look for ~400ms and then the whole
     page re-styles at once when the parser reaches the bottom -- measured on a
     393x852 iPhone viewport as the cards doubling in size and the grid
     re-seating by ~500px at t=1.4s. Nothing can reorder that parse, so the
     page is held invisible on the brand-dark ground until it is fully dressed,
     then faded in as one piece.

     This section is registered in the HEADER group, so this style and the
     script below parse before any content can paint -- a curtain at the end of
     the document would rise after the flash it exists to hide. The class is
     added by script, so with JavaScript off the page simply renders normally.
     The theme editor is exempted (designMode), and a hard 3.8s cap plus a
     bfcache pageshow hook guarantee the curtain can never trap the page. */
  html.pg-calm{background:#0B0710 !important}
  html.pg-calm body{opacity:0 !important}
  html.pg-calm-fade body{transition:opacity .22s ease}
</style>
<script>
(function(){
  if (window.pgCalm) return; window.pgCalm = 1;
  if (window.Shopify && window.Shopify.designMode) return;
  var de = document.documentElement;
  de.classList.add('pg-calm');
  var done = false;
  function reveal(){
    if (done) return; done = true;
    window.pgCalmRevealAt = performance.now();
    de.classList.add('pg-calm-fade');
    requestAnimationFrame(function(){ requestAnimationFrame(function(){
      de.classList.remove('pg-calm');
    }); });
    setTimeout(function(){ de.classList.remove('pg-calm-fade'); }, 700);
  }
  /* DCL means the parser has reached the end of the document, i.e. every
     late style layer has been applied; the extra beat lets the scripts that
     fire AT DCL (the gallery rebuild, the tile ladder) finish their one-shot
     moves before anyone is watching. */
  document.addEventListener('DOMContentLoaded', function(){ setTimeout(reveal, 400); });
  setTimeout(reveal, 3800);
  window.addEventListener('pageshow', function(e){ if (e.persisted) reveal(); });
})();
</script>
{% schema %}
{"name": "PE Logo", "settings": []}
{% endschema %}
