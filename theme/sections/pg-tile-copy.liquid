{%- comment -%}
  PG Tile Copy: bundle tile wording and pricing.

  1. The first tile reads "Single Item" rather than "Buy 1". The Buy 1 / Duo /
     Trio / Quad ladder is assembled at runtime by one of the large pg-* layers,
     so this relabels the rendered tile rather than rewriting the builder. It is
     deliberately narrow: only text nodes inside #pgx bundle tiles whose entire
     trimmed value is exactly "Buy 1", so prices, chips and sentences that merely
     contain those characters are untouched.

  2. The 2-pack tile is restated as the offer that actually exists.

     pg-landing prices that tile from a single `bundle_pct` setting -- a flat
     percentage off the pair, set to 10 -- and captions it "10% OFF". No such
     discount has ever existed. The shop now runs one offer per product, Buy 2
     Get 1 Free, and it pays out on the THIRD unit: two in the cart earn
     nothing at all.

     So the tile no longer claims a discount on the pair. It quotes two units
     at the real price against two at MSRP -- read from the tile's own size
     selects, so it stays correct when the two units are different variants --
     and the caption points the shopper at the free third one instead.

     KNOWN GAP, deliberately left rather than guessed at: this tile still adds
     TWO units. Making it add three needs pg-landing's builder and its
     add-to-cart path changed, not just the wording, and pg-landing is a 35KB
     shared section. Until that is done the third unit is added from the cart,
     where pg-unlock's row offers it for free at exactly the right moment.

     The proper home for this is pg-landing's own paint(), replacing bundle_pct
     with a second-unit percentage. It lives here because pg-landing is a 35KB
     shared section and this is the same class of override the file already does.

  3. A one-line qualifier under the tiles.

     The tiles stop at two units, so the offer's payout is off-screen. The note
     states it plainly -- buy 2, the 3rd is free, taken off at checkout -- so a
     shopper reading only the tiles still learns the actual deal. The cart's own
     breakdown then shows exactly what landed, and the two agree.
{%- endcomment -%}
<style>
  #pgx .pgx-deal-note{
    margin:2px 0 12px !important;
    font-size:12.5px;
    line-height:1.45;
    color:#A99BC0;
    text-align:center;
  }
  #pgx .pgx-deal-note b{color:#C79BEA;font-weight:700}
</style>
<script>
(function(){
  if (window.pgTileCopy) return; window.pgTileCopy = 1;

  var FROM = /^buy\s*1$/i;
  var TO = 'Single Item';
  var TILES = '#pgx .pgx-tile, #pgx [class*="pgx-lad"]';
  var NOTE = 'Buy 2, get your <b>3rd free</b> &mdash; the free one comes off automatically at checkout.';

  function swapIn(root){
    if (!root || root.nodeType !== 1) return;
    var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
    var hits = [], n;
    while ((n = walker.nextNode())){
      if (FROM.test((n.nodeValue || '').trim())) hits.push(n);
    }
    hits.forEach(function(t){ t.nodeValue = t.nodeValue.replace(/buy\s*1/i, TO); });
    return hits.length > 0;
  }

  function money(c){ return '$' + (c / 100).toFixed(2); }

  var variants = null;
  function vdata(){
    if (variants) return variants;
    var el = document.getElementById('pgx-vdata');
    if (!el) return null;
    try { variants = JSON.parse(el.textContent); } catch(e){ variants = null; }
    return variants;
  }

  function bySize(sz){
    var vs = vdata();
    if (!vs || !vs.length) return null;
    for (var i = 0; i < vs.length; i++){ if (vs[i].size === sz) return vs[i]; }
    return vs[0];
  }

  function pickedIn(tile, name){
    var s = tile.querySelector('[data-pgx-size="' + name + '"]');
    var vs = vdata();
    return bySize(s ? s.value : (vs && vs[0] ? vs[0].size : null));
  }

  /* Only writes when the value actually changes, so the MutationObserver that
     calls back into pass() cannot drive this into a loop. */
  function put(el, text){
    if (el && el.textContent !== text) el.textContent = text;
  }

  function bundle(){
    var tile = document.querySelector('#pgx [data-pgx-tile="double"]');
    if (!tile) return;
    var a = pickedIn(tile, 'd1'), b = pickedIn(tile, 'd2');
    if (!a || !b) return;

    /* The pair itself carries no discount any more -- the offer is Buy 2 Get 1
       Free, which pays out on the THIRD unit. So the tile quotes two units at
       the real price against two at MSRP, and the caption points at the free
       one rather than inventing a percentage off the pair. */
    var pair = a.price + b.price;
    var retail = (a.cap > a.price ? a.cap : a.price) + (b.cap > b.price ? b.cap : b.price);

    put(tile.querySelector('.pgx-tile-sub'),
        'Buy 2, get your 3rd FREE - add the 3rd in your cart');
    put(tile.querySelector('[data-pgx-double-now]'), money(pair));
    put(tile.querySelector('[data-pgx-double-was]'), money(retail));

    if (!tile.dataset.pgBundle){
      tile.dataset.pgBundle = '1';
      tile.querySelectorAll('[data-pgx-size]').forEach(function(s){
        /* pg-landing's own paint() also fires on change and would put the flat
           bundle_pct price back, so re-run after it */
        s.addEventListener('change', function(){ setTimeout(bundle, 0); });
      });
    }
  }

  function note(){
    var root = document.getElementById('pgx');
    if (!root || root.querySelector('.pgx-deal-note')) return;
    /* only where a ladder is actually offered */
    if (!root.querySelector('.pgx-tile, [class*="pgx-lad"]')) return;
    var atc = root.querySelector('.pgx-atc');
    if (!atc || !atc.parentNode) return;
    var p = document.createElement('p');
    p.className = 'pgx-deal-note';
    p.innerHTML = NOTE;
    atc.parentNode.insertBefore(p, atc);
  }

  function pass(){
    document.querySelectorAll(TILES).forEach(function(tile){
      if (tile.dataset.pgCopy) return;
      if (swapIn(tile)) tile.dataset.pgCopy = '1';
    });
    bundle();
    note();
  }

  function boot(){
    pass();
    var root = document.getElementById('pgx');
    if (root){
      try { new MutationObserver(pass).observe(root, {childList: true, subtree: true}); } catch(e){}
    }
    setInterval(pass, 1500);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
{% schema %}
{"name": "PG Tile Copy", "settings": []}
{% endschema %}
