{%- comment -%}
  PG Gallery Mobile: give the phone the same thumbnail carousel as desktop, and
  stop the hero and video being cropped square.

  pg-landing builds the carousel only above 900px:

    @media (min-width: 901px){ .pgx-thumbwrap .pgx-thumbs{display:flex;...
                               overflow-x:auto;scroll-snap-type:x mandatory} }
    @media (max-width: 900px){ .pgx-thumbwrap{display:contents}
                               html body .pgx-tharrow{display:none !important} }

  With `display:contents` the wrapper disappears and `.pgx-thumbs` falls back to
  its base rule -- a two-column grid that just keeps growing downwards -- and the
  arrows are hidden outright.

  This section restores the carousel under 900px. Every rule is anchored on the
  #pgx id so it outranks pg-landing's `html body .pgx-tharrow` !important rules
  (an id beats three elements/classes) without needing to load in any particular
  order.

  The arrows keep their meaning: pg-landing's thUpd() only ever un-hides them
  above 901px, so the script below re-runs the same scrollWidth test for small
  screens and manages the [hidden] attribute itself. thUpd() runs on init, on
  resize and once at 600ms -- not on an interval -- so this settles rather than
  fights, and it is re-applied on the same events plus a couple of late passes.
{%- endcomment -%}
<style>
@media (max-width:900px){
  /* ---------------- hero and video: stop the square crop ----------------
     pg-mobile force-fits both to a 1:1 box with object-fit:cover:

       .pgx-hero img{aspect-ratio:1/1;object-fit:cover}
       .pgx-vid video{aspect-ratio:1/1;object-fit:cover}

     That was aimed at tall photos towering over the page, but it cuts anything
     that is not square -- on the PokeOrb the wide product shot loses an orb off
     each side and the top of the row, and the clip gets cropped into its own
     subject. Letting them keep their natural ratio shows the whole frame; the
     media is width-constrained anyway, so nothing towers.

     .pgx-hero's #f6f6f6 backdrop goes transparent with it, since with contain
     any spare space would otherwise read as light grey bars on the dark page. */
  #pgx .pgx-hero{background:transparent !important}
  #pgx .pgx-hero img{
    aspect-ratio:auto !important;
    height:auto !important;
    object-fit:contain !important;
    width:100% !important
  }
  #pgx .pgx-vid video{
    aspect-ratio:auto !important;
    height:auto !important;
    max-height:none !important;
    object-fit:contain !important;
    width:100% !important
  }

  /* ---------------- let the column shrink below the filmstrip ----------------
     The strip below is a nowrap flex row, so its min-content width is the whole
     un-wrapped filmstrip. .pgx-main's `1fr` column is really minmax(auto,1fr),
     and that `auto` floor is the item's min-content -- so the column stretched
     to fit the filmstrip (~970px on a 390px phone) and carried the hero, the
     video, the buy column and the accordions out past the screen with it.
     #root and body both clip overflow-x, so the page could not be scrolled
     across: it was simply cut off. A zero floor lets the column take the
     viewport width and the strip scrolls inside its own box, which is the point
     of making it a carousel in the first place. */
  #pgx .pgx-main{grid-template-columns:minmax(0,1fr) !important}
  #pgx .pgx-gallery,
  #pgx .pgx-buy{min-width:0 !important}

  /* Bring the wrapper back so the arrows have something to anchor to. */
  #pgx .pgx-thumbwrap{display:block !important;position:relative !important;margin-top:14px !important}

  /* Horizontal, snapping strip. */
  #pgx .pgx-thumbwrap .pgx-thumbs{
    display:flex !important;flex-wrap:nowrap !important;
    overflow-x:auto !important;scroll-behavior:smooth;
    scroll-snap-type:x mandatory;
    scrollbar-width:none;-ms-overflow-style:none;
    gap:10px !important;margin-top:0 !important;
    -webkit-overflow-scrolling:touch
  }
  #pgx .pgx-thumbwrap .pgx-thumbs::-webkit-scrollbar{display:none}

  /* ONE ORB AT A TIME. The strip used to show two thumbs per view
     (flex:0 0 calc(50% - 5px)) and snapped two at a time, which read as a jumpy
     carousel, and the overlaid arrows sat on top of the orbs. Make each thumb
     take the full width so exactly one orb is in view and every swipe advances
     by one, and drop the arrows on mobile -- the strip is swiped, and nothing
     should cover the orb. */
  #pgx .pgx-thumbwrap .pgx-thumbs button{
    flex:0 0 100% !important;scroll-snap-align:center
  }
  #pgx .pgx-thumbwrap .pgx-tharrow{display:none !important}
}
</style>
<script>
(function(){
  if (window.pgGalMob) return; window.pgGalMob = 1;

  function upd(){
    var tw = document.querySelector('#pgx .pgx-thumbwrap');
    if (!tw) return;
    if (!window.matchMedia('(max-width: 900px)').matches) return;
    var th = tw.querySelector('.pgx-thumbs');
    if (!th) return;
    var can = th.scrollWidth > th.clientWidth + 4;
    tw.querySelectorAll('.pgx-tharrow').forEach(function(a){ a.hidden = !can; });
  }

  function boot(){
    upd();
    window.addEventListener('resize', upd);
    /* pg-landing's own thUpd() re-hides them at 600ms on its init pass; these
       land after it. */
    [300, 800, 1600, 3000].forEach(function(t){ setTimeout(upd, t); });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
{% schema %}
{"name": "PG Gallery Mobile", "settings": []}
{% endschema %}
