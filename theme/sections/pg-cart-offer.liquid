        if (paidAdded === 0){
          title = 'Add your FREE ' + nths(n + 1, n + need) + ' ' + L.name + (need > 1 ? 's' : '');
          sub = '';   /* the title already says it, by request */
        } else {
          title = 'Buy ' + paidAdded + ' more, get ' + freeAdded + ' FREE';
          sub = '';
        }
        was = unit * need; now = unit * paidAdded;
        btn = 'Add ' + need + ' to cart' + (freeAdded ? ', ' + freeAdded + ' FREE' : '');
      } else {
        need = 1; paidAdded = 1; freeAdded = 0; plain = true;   /* no free unit to promise: the family is done */
        title = cross ? 'Add a Crystal Legends ' + L.name : 'Add another ' + L.name;
        sub = '';   /* the note under the cards names the extra 5% */
        was = cap || unit; now = unit; btn = 'Add to cart';
      }
      /* ONLY UNITS AT THE HELD LINE'S PRICE. The Power Ball sells a 6,000mAh
         and a 12,000mAh at different prices, and a Buy X Get Y makes the
         CHEAPEST qualifying unit the free one, so a card that priced the
         add-on off the held 12,000mAh and then let the shopper pick 6,000mAh
         balls would print a total the till never charges. The picker offers
         the capacity already in the cart; the orb and the prints have one
         price, so nothing changes for them. */
      var opts = pr.variants.filter(function(v){ return v.available && (!lines.length || v.price === unit); }).map(function(v){ return {id: String(v.id), t: v.title, img: v.img}; });
      var heldHere = held[handle] || {};
