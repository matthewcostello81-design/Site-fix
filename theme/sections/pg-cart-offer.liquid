      return {
        kind: 'add', key: 'ladder:' + handle + ':' + n + ':' + need, handle: handle, need: need, single: opts.length < 2 ? opts[0] : null,
        img: thumb(((picks[0] && opts.filter(function(x){ return String(x.id) === String(picks[0].value); })[0]) || {}).img || pr.image), imgPick0: true, /* the picture is the FIRST pick's own orb / print (owner 2026-09-22: "it should show the picture of the orb next to the name") */ title: title, sub: sub, was: was, now: now, picks: picks, btn: btn, plain: plain };
    });
  }
  function orbOffer(t, cross){ return ladderOffer(H.orb, t.orbUnits, t.orb, t.held, !!cross); }

  /* THE LAMP LADDER (by request, 2026-09-12: "add upsells for the goku lamp
     in the cart; based on how many they have it should upsell another and
     another so they get the best pricing per lamp, including the extra 5%;
     when they have 3 that is the max discount, so advertise the game boy
     after that"). The lamp page sells Single / Duo Pack / Trio Pack
     (pg-dbz-tiles: $42.99 against a $59.99 compare-at, Duo $77.98, Trio
     $104.97 since 2026-09-13 -- the base came down from $59.99 and the
     owner set the rungs at "38.99 a lamp for the duo, 34.99 for the trio"),
     and the till carries the packs as two automatic amount-off discounts on
     the lamp product: "DBZ Lamp - 2 Pack $77.98" is $4.00 off EACH lamp from
     2 lamps, "DBZ Lamp - 3 Pack $104.97" is $8.00 off EACH lamp from 3.
     Both are product-class and, measured in a real cart (2026-09-12), they
     do not stack: three lamps carried the 3 Pack amount off each and
     nothing from the 2 Pack. From 3 lamps every lamp is $34.99 before the
     5% and a 4th changes nothing per lamp, so the ladder tops out at 3.
     Hence: one lamp held, the 2nd is offered; two held, the 3rd; three or
     more, the family is done and, with no console in the cart, the R36S is
     offered in its place (plain, so a real deal from any other family
     outranks it; the orb cross-sell stays the last resort).

     THE FIGURE IS THE ONE THE CART LINE WILL SHOW. The price line is the
     per-lamp price at the next rung, net of the 5%: net(38.99) = $37.05 on
     the 2nd-lamp card, net(34.99) = $33.25 on the 3rd-lamp card, against the
     lamp's compare-at (the worked figures below date from a 39.99 duo). A first cut printed the MARGINAL cost instead (the
     cart total after minus before: $35.15 for the 2nd lamp), and the owner
     caught the problem before it shipped (2026-09-13): the pack amount
     comes off EVERY lamp, so the new lamp's line in the cart read $38.00
     while the card had said $35.15, and "people are going to think they
     paid more than advertised". Now the card, the new line and the old
     lines all say the same figure, and the sub line says why the old
     lines moved: "Your 1st lamp drops to $38.00 too". The 5% is taken off
     the cart total and spread over the lines, so a line can read a cent
     UNDER the card (two lamps at 39.99: 7998 less 399 = lines of 38.00 and
     37.99), never over. The amounts come off EACH lamp, so a unit reprice
     in the admin moves every figure here on its own; only the two amounts
     are fixed, mirrored in pg-dbz-tiles' OFF, and both are the only thing
     to change if the admin discounts change. */
  var LAMP_OFF = {2: 400, 3: 800};   /* cents off each lamp: from 2 lamps, from 3 lamps; = pg-dbz-tiles' OFF */
  function lampUnitAt(u, n){ return u - (n >= 3 ? LAMP_OFF[3] : (n >= 2 ? LAMP_OFF[2] : 0)); }
  function lampOffer(t){
    var n = t.lampUnits;
    if (!n) return Promise.resolve(null);
    if (n >= 3) return t.consoles ? Promise.resolve(null) : consoleCross(t);
    return product(H.lamp).then(function(pr){
      if (!pr) return null;
      var unitV = null;
      pr.variants.forEach(function(v){ if (String(v.id) === String(t.lamp[0].variant_id)) unitV = v; });
      var u = unitV ? unitV.price : (pr.variants[0] ? pr.variants[0].price : 0);
      var cap = unitV ? unitV.cap : (pr.variants[0] ? pr.variants[0].cap : 0);
      if (!u) return null;
      var eachGross = lampUnitAt(u, n + 1);   /* what every lamp's line will carry; priceHtml nets it */
      if (eachGross <= 0 || eachGross >= u) return null;
      var each = net(eachGross);
      var opts = pr.variants.filter(function(v){ return v.available; }).map(function(v){ return {id: String(v.id), t: v.title, img: v.img}; });
      if (!opts.length) return null;
      var heldHere = t.held[H.lamp] || {};
      var fresh = opts.filter(function(o){ return !heldHere[o.id]; });
      var first = (fresh.length ? fresh : opts)[0];
      return {
        kind: 'add', key: 'lamp:' + n, handle: H.lamp, need: 1, single: opts.length < 2 ? opts[0] : null, imgFollows: true,
        img: thumb(first.img || pr.image),
        title: n === 1 ? 'Add a 2nd Lamp: the Duo Pack' : 'Add a 3rd Lamp: the Trio Pack',
        sub: (n === 1 ? 'Your 1st lamp drops to ' : 'Your first 2 lamps drop to ') + money(each) + ' too',
        was: cap || u, now: eachGross,
        picks: opts.length > 1 ? [{label: 'Character for the new one', options: opts, value: first.id}] : [],
        btn: n === 1 ? 'Add the 2nd Lamp' : 'Add the 3rd Lamp'
      };
    });
  }
  /* THE R36S, OFFERED PLAIN once a family is at the top of its ladder (the
     lamps at three: "advertise the game boy after that") and no console is
     in the cart yet. The GB picker is the product page's (64GB first,
     "(Best Value)" on the deeper cut) and the price line follows the pick;
     pg-giftguard puts the free case in beside it, as on any console add. */
  function consoleCross(t){
    return product(H.con).then(function(con){
      if (!con) return null;
      var byId = {}; con.variants.forEach(function(v){ byId[String(v.id)] = v; });
      var opts = [];
      gbOpts(con).forEach(function(g){
        var id = null; Object.keys(SIZE_OF).forEach(function(k){ if (SIZE_OF[k] === g.id) id = k; });
        var v = id ? byId[id] : null;
        if (v && v.available) opts.push({id: String(v.id), t: g.t, price: v.price, cap: v.cap, img: v.img});
      });
      if (!opts.length) return null;
      var v0 = opts[0];
      return {
        kind: 'add', key: 'cross:' + H.con, handle: H.con, need: 1, single: opts.length < 2 ? opts[0] : null, plain: true, imgFollows: true,
        img: thumb(v0.img || con.image), title: 'Add an R36S Handheld', sub: 'Free protective case included',
        was: v0.cap || v0.price, now: v0.price, btn: 'Add to cart',
        picks: opts.length > 1 ? [{label: 'GB', options: opts, value: v0.id}] : []
      };
    });
  }

  /* the families in the cart, the one the shopper added last first. /cart.js
     lists lines newest first; a line of an unknown handle names no family.
     FREE LINES DO NOT COUNT: the free case is put in by pg-giftguard a beat
     after the console, so it would name the console family "newest" over an
     orb the shopper had just added (the card swapped in front of them), and a
     cart holding only the free case, mid-way through emptying, would name the
     console family with no console in it and fall to the orb cross-sell (a
     "random orb upsell" that popped up and vanished). A Buy X Get Y free orb
     is a line the shopper added and keeps its say. */
  var FAMILY = {};
  FAMILY[H.con] = FAMILY[H.duo] = FAMILY[H.trio] = FAMILY[H.kase] = 'console';
  FAMILY[H.orb] = 'orb'; FAMILY[H.wall] = 'wall'; FAMILY[H.lamp] = 'lamp'; FAMILY[H.ball] = 'ball';
  function familiesByRecency(cart){
    var out = [];
    (cart.items || []).forEach(function(it){
      if (!gross(it)) return;
      var f = FAMILY[it.handle || ''];
      if (f && out.indexOf(f) === -1) out.push(f);
    });
    return out;
  }
  function familyOffer(f, t){
    if (f === 'console') return consoleOffer(t);
    if (f === 'orb') return orbOffer(t, false);
    if (f === 'wall') return ladderOffer(H.wall, t.wallUnits, t.wall, t.held, false);
    if (f === 'lamp') return lampOffer(t);
    if (f === 'ball') return ladderOffer(H.ball, t.ballUnits, t.ball, t.held, false);
    return Promise.resolve(null);
  }
  function offersFor(cart){
    RATE = readRate(cart);
    var t = tally(cart);
    var fams = familiesByRecency(cart);
    if (!fams.length) return Promise.resolve([]);
    return Promise.all(fams.map(function(f){ return familyOffer(f, t); })).then(function(list){
      /* ONE CARD. The newest family's deal; failing that, the next family's;
         a plain "add another" only when no family has a deal left; and with no
         orbs held, a Crystal Legends Orb as the last resort. */
      var deal = null, plain = null;
      list.forEach(function(o){
        if (!o) return;
        if (!o.plain && !deal) deal = o;
        if (o.plain && !plain) plain = o;
      });
      if (deal) return [deal];
      if (plain) return [plain];
      if (!t.orbUnits) return orbOffer(t, true).then(function(o){ return o ? [o] : []; });
      return [];
    });
  }

  /* ---------------- the card ---------------- */
  /* the price line: struck compare-at, the net figure, the SAVE chip on it */
  function priceHtml(was, now0){
    var now = now0 || 0;      /* the product price; the 5% is the totals box's (2026-09-19 evening) */
    var save = pct(was, now);
    return (was > now ? '<s>' + money(was) + '</s>' : '') + (now === 0 ? 'FREE' : money(now)) +
      (save ? '<i class="pg-offer-sv">Save ' + save + '%</i>' : '');
  }
  function card(o){
    var el = document.createElement('div');
    el.className = 'pg-offer';
    el.setAttribute('data-offer', o.key);
    el.setAttribute('data-picks', String((o.picks || []).length));   /* a one-picker card lays out in two columns, see the CSS */
    /* the TITLE of every card is Title Case ("the title of the upsell in
       cart, every word", by request); the orb card is Title Case throughout */
    var T = o.handle === H.orb ? tc : function(x){ return x; };
    var picks = '';
    (o.picks || []).forEach(function(p, i){
      picks += '<label class="pg-offer-pick' + (p.free ? ' is-free' : '') + '"><span' + (p.free ? ' class="is-free"' : '') + '>' + esc(T(p.label)) + '</span><select data-i="' + i + '">';
      p.options.forEach(function(op){ picks += '<option value="' + esc(op.id) + '"' + (String(op.id) === String(p.value) ? ' selected' : '') + '>' + esc(op.t) + '</option>'; });
      picks += '</select></label>';
    });
    /* every card says so itself ("state it in the upsell", by request) */
    var inc = RATE > 0 ? 'Extra ' + Math.round(RATE * 100) + '% off included' : '';
    /* a checkbox row (2026-09-19): the tick, the picture, title and price; the
       sub line and "Extra 5% off included" are out ("too many words"); the
       button stays for the click code but is not shown */
    el.setAttribute('role', 'checkbox'); el.setAttribute('aria-checked', 'false'); el.setAttribute('tabindex', '0');
    el.innerHTML =
      '<span class="pg-offer-ck" aria-hidden="true"></span>' +
      '<img alt="" width="40" height="40" decoding="sync" src="' + esc(o.img || '') + '">' +
      '<div class="pg-offer-t"><b>' + esc(tc(o.title)) + '</b>' +
        '<span class="pg-offer-px">' + priceHtml(o.was, o.now) + '</span></div>' +
      '<div class="pg-offer-picks">' + picks + '</div>' +
      '<button type="button" class="pg-offer-add" tabindex="-1">' + esc(T(o.btn)) + '<span class="arr">→</span></button>';
    void inc;
    el.pgOffer = o;
    return el;
  }

  function slotFor(c){
    var list = c.querySelector('.l4ca:not(.in-panel)');
    if (!list) return null;
    var slot = c.querySelector('#pg-unlock-slot');
    if (!slot){
      slot = document.createElement('div');
      slot.id = 'pg-unlock-slot';
      /* BELOW the items since 2026-09-19 (see pg-cart-mobile placeUnlock) */
      list.parentNode.insertBefore(slot, list.nextSibling);
    }
    return slot;
  }

  /* A PICK LIVES ON THE OFFER, WITH ITS PRICE. The drawer is rebuilt by every
     refresh (the free case landing, a Shipping Protection toggle, a size
     switch), which throws the card away; heal() repaints it from the offer
     object, so the shopper's GB or design pick, and the price line that goes
     with it, must be stored there or the card comes back at the default
     (and a pack card came back printing the default pack's price with the
     picked GB selected, a figure the till would not charge). */
  function applyPick(o, i, val){
    var p = o && o.picks && o.picks[i]; if (!p) return;
    if (p.options && !p.options.some(function(op){ return String(op.id) === String(val); })) return;
    p.value = val;
    /* an option that carries its own price (the console cross-sell's GB) or
       its own photo (a lamp character) reprices / re-pictures the card */
    var op = null; (p.options || []).forEach(function(x){ if (String(x.id) === String(val)) op = x; });
    if (op && op.price){ o.was = op.cap || op.price; o.now = op.price; }
    if (op && op.img && (o.imgFollows || (o.imgPick0 && i === 0))) o.img = thumb(op.img);
    if (o.kind === 'pack' && o.pack){
      var v = packBySizes(o.pack, o.packSizes.concat([val]));
      if (v){ o.was = v.cap || v.price; o.now = v.price; if (v.img) o.img = thumb(v.img); }
    }
  }
  function paint(offers){
    var c = document.getElementById('cart');
    if (!c) return;
    var slot = slotFor(c);
    if (!slot) return;
    var want = {};
    /* the node cached on the offer is dropped first: a drawer rebuild throws
       the cards away, and a repaint from lastOffers that still trusted o.el
       would reuse the detached node and insert nothing */
    offers.forEach(function(o){ o.el = null; want[o.key] = o; });
    slot.querySelectorAll('.pg-offer').forEach(function(el){
      var k = el.getAttribute('data-offer');
      if (!want[k] || el.classList.contains('is-done')){ el.parentNode.removeChild(el); return; }
      want[k].el = el;   /* same offer: keep it, and whatever the shopper picked */
      el.querySelectorAll('.pg-offer-pick select').forEach(function(s, i){ if (s.value) applyPick(want[k], i, s.value); });
    });
    var prev = null;
    offers.forEach(function(o, i){
      var el = o.el || card(o);
      el.style.order = String(-10 + i);   /* ahead of the hidden rows */
      if (!o.el){
        if (prev && prev.nextSibling) slot.insertBefore(el, prev.nextSibling);
        else if (prev) slot.appendChild(el);
        else slot.insertBefore(el, slot.firstChild);
      }
      prev = el;
    });
    if (window.pgPlaceUnlock){ try { window.pgPlaceUnlock(); } catch(e){} }
  }

  /* ---------------- watching ---------------- */
  var busy = false, again = false, watch = null, lastSig = null, seenSig = null, force = false;
  var gen = 0;   /* bumped by every write of ours; a read from before the write is discarded */
  var expect = null;   /* what our last write must have done before a read is trusted */
  function reflects(cart){
    if (!expect) return true;
    if (Date.now() > expect.until){ expect = null; return true; }
    var items = cart.items || [];
    var has = !expect.has || items.some(function(it){ return String(it.variant_id) === String(expect.has); });
    var gone = !(expect.gone || []).some(function(id){ return items.some(function(it){ return ident(it) === id; }); });
    /* and the cart must differ from the one the tapped card was built from:
       an 'add another' of a variant already held would otherwise pass on a
       stale snapshot (the variant is present in it too) */
    var moved = expect.notSig == null || sig(cart) !== expect.notSig;
    if (has && gone && moved){ expect = null; return true; }
    return false;
  }
  function sig(cart){ return (cart.items || []).map(function(it){ return it.variant_id + 'x' + it.quantity; }).join(','); }
  var healSig = null;
  function read(){
    if (busy){ again = true; return; }
    var c = document.getElementById('cart');
    if (!c) return;
    busy = true;
    var g = gen;
    clearTimeout(watch);
    watch = setTimeout(function(){ busy = false; }, 8000);
    fetch('/cart.js', {headers: {'X-Requested-With': 'XMLHttpRequest'}}).then(function(r){ return r.json(); }).then(function(cart){
      if (g !== gen) return;   /* fetched before our write landed: the queued read has the real cart */
      if (!reflects(cart)){ setTimeout(read, 400); return; }   /* a cached or in-flight snapshot from before our write: keep the done card, read again */
      var s = sig(cart);
      if (!c.querySelector('.l4ca:not(.in-panel)')){
        /* the drawer shows no line list. With lines in the cart that is the
           side-cart section caught in its empty render (see swapIn): ask
           pg-drawer for a fresh one, once per cart state, and read again
           when it lands (pg:cart-updated) */
        if ((cart.items || []).length && healSig !== s && window.pgDrawerRefresh){ healSig = s; try { window.pgDrawerRefresh(); } catch(e){} }
        return;
      }
      if (s === lastSig && document.querySelector('#cart .pg-offer, #cart #pg-unlock-slot')){
        /* unchanged: only make sure the cards are still standing (a drawer
           rebuild replaces #cart's innerHTML wholesale) */
        if (!document.querySelector('#cart .pg-offer') && lastOffers && lastOffers.length) paint(lastOffers);
        return;
      }
      if (!force && lastSig !== null && s !== seenSig){ seenSig = s; setTimeout(read, 600); return; }   /* a change is seen once, then confirmed */
      force = false; seenSig = s;
      return offersFor(cart).then(function(offers){ lastSig = s; lastOffers = offers; paint(offers); });
    }).catch(function(){}).then(function(){ clearTimeout(watch); busy = false; if (again){ again = false; schedule(0); } });
  }
  var lastOffers = null;
  var q = null;
  function schedule(ms){ if (q) return; q = setTimeout(function(){ q = null; read(); }, ms || 150); }

  /* ---------------- adding ---------------- */
  var adding = false;
  function post(url, body){
    return fetch(url, {method: 'POST', headers: {'Content-Type': 'application/json'}, credentials: 'same-origin', body: JSON.stringify(body)})
      .then(function(r){ if (!r || !r.ok) throw new Error('write ' + (r && r.status)); return r; });
  }
  function perform(o, el){
    var sels = el.querySelectorAll('.pg-offer-pick select');
    if (o.kind === 'add'){
      var items = [];
      if (o.items) items = o.items;
      else if (o.single) items = [{id: parseInt(o.single.id, 10), quantity: o.need}];
      else sels.forEach(function(s){ var id = parseInt(s.value, 10); if (id) items.push({id: id, quantity: 1}); });
      if (!items.length) return Promise.reject(new Error('nothing to add'));
      o.expectHas = items[0].id; o.expectGone = [];
      return post('/cart/add.js', {items: items});
    }
    if (o.kind === 'pack' || o.kind === 'switch'){
      var v = o.variant;
      if (o.kind === 'pack'){
        var size = sels[0] ? sels[0].value : '64';
        v = packBySizes(o.pack, o.packSizes.concat([size]));
      }
      if (!v) return Promise.reject(new Error('no pack variant'));
      o.expectHas = v.id; o.expectGone = o.lines.map(ident);
      return swapIn(o, v.id);
    }
    return Promise.reject(new Error('unknown offer'));
  }
  /* THE PACK GOES IN FIRST; THE LINES IT REPLACES COME OUT AFTER. The first
     cut took the old lines out and then put the pack in, and for the beat in
     between the cart held nothing but the free case: pg-giftguard pulled the
     case (no console to earn it), the drawer's watchers re-rendered the
     side-cart section in its EMPTY state, and a Duo to Trio upgrade "made the
     whole cart go blank" (by report, 2026-09-11). In this order the cart is
     never empty and never without a console. A retry after a failed removal
     never adds a second pack: the add is remembered on the offer.

     AND THE LINES COME OUT BY THE KEY THEY HAVE NOW, NOT THE ONE THE CARD SAW.
     Measured on the live theme (2026-09-11), one 64GB console plus its free
     case, tap "Upgrade to the Duo Pack": the pack went in (200), and the
     console's line key had CHANGED in that same write -- Shopify spreads the
     order-level 10% across the lines again, the console's price moved
     67.50 -> 67.49, and the key hash moved with it. The key captured when
     the card was built was dead: change.js answered 400 three times, and the
     single stayed beside the pack ("adds duo pack but keeps the original
     r36", by report). A line key on this store is only good until the next
     cart write, so nothing is removed by a remembered key any more: the cart
     is read again after the pack goes in, each source line is found by what
     it IS (variant plus properties), taken out by the key it carries at that
     moment, and the cart is read once more to make sure none survived (up to
     three rounds). Before anything is written, the same read checks that the
     source lines are still there at the quantity the card was built from; if
     the cart moved under the card (a size switch, a quantity bump), the tap
     is refused and the card rebuilt, rather than a pack going in beside a
     console it was never meant to replace. */
  function ident(it){
    var p = it.properties || {}, out = [];
    Object.keys(p).sort().forEach(function(k){ out.push(k + '=' + p[k]); });
    return String(it.variant_id) + '|' + out.join('&');
  }
  function readCart(){
    return fetch('/cart.js', {headers: {'X-Requested-With': 'XMLHttpRequest'}, credentials: 'same-origin', cache: 'no-store'})
      .then(function(r){ if (!r || !r.ok) throw new Error('read ' + (r && r.status)); return r.json(); });
  }
  function wanted(o){ var w = {}; (o.lines || []).forEach(function(it){ w[ident(it)] = it.quantity; }); return w; }
  function sourcesIn(cart, o){
    var w = wanted(o);
    return (cart.items || []).filter(function(it){ return w[ident(it)] != null; });
  }
  function removeSources(o, passes){
    return readCart().then(function(cart){
      var found = sourcesIn(cart, o);
      if (!found.length) return;                                   /* all gone: done */
      if (passes <= 0) throw new Error('source line still in cart');
      var chain = Promise.resolve();
      found.forEach(function(it){
        chain = chain.then(function(){
          /* a miss here (the key moved again) is caught by the next read */
          return post('/cart/change.js', {id: it.key, quantity: 0}).catch(function(){});
        });
      });
      return chain.then(function(){ return removeSources(o, passes - 1); });
    });
  }
  function swapIn(o, variantId){
    var start = readCart().then(function(cart){
      /* NEVER A SECOND PACK. Every swap card is only shown for a cart that
         holds none of the pack it offers (consoleOffer's guards), so a pack
         variant already in the cart at this point is our own earlier add
         whose removal round failed and was retried: the add is skipped and
         only the removal is retried. The o.added flag used to carry this,
         but a drawer rebuild between the failure and the retry hands the
         card a fresh offer object without it. */
      var already = (cart.items || []).some(function(it){ return String(it.variant_id) === String(variantId); });
      if (already){ o.added = true; return; }
      var found = sourcesIn(cart, o), w = wanted(o);
      var same = found.length === o.lines.length && found.every(function(it){ return w[ident(it)] === it.quantity; });
      if (!same) throw new Error('cart changed');
      return post('/cart/add.js', {items: [{id: variantId, quantity: 1}]}).then(function(){ o.added = true; });
    });
    return start.then(function(){ return removeSources(o, 3); });
  }
  document.addEventListener('click', function(e){
    if (!e.target || !e.target.closest) return;
    var btn = e.target.closest('#cart .pg-offer-add');
    if (!btn) return;
    e.preventDefault(); e.stopPropagation();
    if (e.stopImmediatePropagation) e.stopImmediatePropagation();
    if (adding) return;
    var el = btn.closest('.pg-offer'), o = el && el.pgOffer;
    if (!o) return;
    adding = true;
    var label = btn.innerHTML, sigAtTap = lastSig;   /* the cart this card was built from */
    btn.disabled = true; btn.textContent = 'Adding…'; el.classList.add('is-busy');
    perform(o, el).then(function(){
      /* SMOOTH. The card is not pulled out here (the slot collapsed, the
         drawer rebuilt, and the next card popped in a second or two later:
         "slight glitching and a delay", by report). It stays put, marked
         done, and the fresh read swaps it for the next offer in one paint;
         paint() never reuses a done card. lastOffers is dropped so a drawer
         rebuild in between heals to nothing rather than to the stale card. */
      adding = false; force = true; lastSig = null; lastOffers = null; gen++;
      expect = {has: o.expectHas, gone: o.expectGone || [], notSig: sigAtTap, until: Date.now() + 8000};
      el.classList.add('is-done'); el.classList.remove('is-busy'); el.setAttribute('aria-checked', 'true');
      btn.textContent = 'Added \u2713';
      read();
      if (window.pgDrawerRefresh){ try { Promise.resolve(window.pgDrawerRefresh()).then(function(){ schedule(50); }, function(){ schedule(50); }); } catch(x){ schedule(50); } }
      else schedule(50);
      setTimeout(read, 1500);
    }).catch(function(e){
      adding = false; el.classList.remove('is-busy');
      btn.disabled = false; btn.innerHTML = label;
      btn.textContent = 'Try again';
      if (o.added && window.pgDrawerRefresh){ try { window.pgDrawerRefresh(); } catch(x){} }   /* the pack went in: the drawer must show it */
      /* the card no longer matched the cart: rebuild it from a fresh read */
      if (/cart changed/.test(String(e && e.message))){ force = true; lastSig = null; lastOffers = null; schedule(0); }
    });
  }, true);
  /* a tap inside the card must not fall through to the theme's drawer handlers */
  document.addEventListener('click', function(e){
    if (e.target && e.target.closest && e.target.closest('#cart .pg-offer-pick')) e.stopPropagation();
  }, true);
  /* THE ROW IS THE BUTTON (2026-09-19): a tap anywhere on the card that is not
     a picker or the (hidden) button itself clicks the button, so the add /
     swap path above runs unchanged; Enter and Space do the same */
  function rowTap(e){
    if (!e.target || !e.target.closest) return;
    if (e.target.closest('#cart .pg-offer-pick') || e.target.closest('#cart .pg-offer-add')) return;
    var el = e.target.closest('#cart .pg-offer');
    if (!el || el.classList.contains('is-done')) return;
    e.preventDefault(); e.stopPropagation();
    var btn = el.querySelector('.pg-offer-add');
    if (btn && !btn.disabled) btn.click();
  }
  document.addEventListener('click', rowTap, true);
  document.addEventListener('keydown', function(e){
    if (e.key !== 'Enter' && e.key !== ' ') return;
    if (e.target && e.target.closest && e.target.closest('#cart .pg-offer') && !e.target.closest('#cart .pg-offer-pick')) rowTap(e);
  }, true);
  /* THE PACK CARD REPRICES AS THE GB IS PICKED. The price was set once when
     the card was built, for the default size, and a shopper choosing 128GB
     kept reading the 64GB figure (by report, 2026-09-11). The pack variant
     that holds the consoles plus the picked one is looked up again and the
     price line rewritten; perform() reads the same picker, so what is
     printed is what is added. */
  document.addEventListener('change', function(e){
    var sel = e.target && e.target.closest && e.target.closest('#cart .pg-offer-pick select');
    if (!sel) return;
    var el = sel.closest('.pg-offer'), o = el && el.pgOffer;
    if (!o) return;
    var pi = parseInt(sel.getAttribute('data-i'), 10);
    applyPick(o, pi, sel.value);
    /* el.pgOffer and lastOffers diverge after a re-read keeps the card (paint()
       keeps the element, not the object): write the pick to both */
    (lastOffers || []).forEach(function(x){ if (x !== o && x.key === o.key) applyPick(x, pi, sel.value); });
    if (o.kind !== 'pack' || !o.pack){
      var p0 = o.picks && o.picks[pi], op0 = null;
      ((p0 && p0.options) || []).forEach(function(x){ if (String(x.id) === String(sel.value)) op0 = x; });
      if (op0 && op0.price){ var px0 = el.querySelector('.pg-offer-px'); if (px0) px0.innerHTML = priceHtml(op0.cap || op0.price, op0.price); }
      if (op0 && op0.img && (o.imgFollows || (o.imgPick0 && pi === 0))){ var im0 = el.querySelector('img'); if (im0) im0.src = thumb(op0.img); }
      return;
    }
    var v = packBySizes(o.pack, o.packSizes.concat([sel.value]));
    var px = el.querySelector('.pg-offer-px');
    if (!v || !px) return;
    px.innerHTML = priceHtml(v.cap || v.price, v.price);
    if (v.img){ var im = el.querySelector('img'); if (im) im.src = thumb(v.img); }
  }, true);

  /* the standing card, put straight back after a drawer rebuild: no fetch,
     no frame without it */
  /* is a line of that product still in the rendered list? */
  function domHas(handle){ return !!document.querySelector('#cart .l4ca:not(.in-panel) > li a[href*="/products/' + handle + '"]'); }
  /* a card whose product has left the list goes NOW, in the same frame as the
     rebuild, not 200ms later when the read answers */
  function prune(){
    var empty = !document.querySelector('#cart .l4ca:not(.in-panel) > li');
    document.querySelectorAll('#cart .pg-offer').forEach(function(el){
      var o = el.pgOffer;
      if (empty || (o && String(o.key).indexOf('cross:') !== 0 && o.handle && !domHas(o.handle))){ if (el.parentNode) el.parentNode.removeChild(el); }
    });
  }
  function heal(){
    var c = document.getElementById('cart');
    prune();
    if (!c || !lastOffers || !lastOffers.length) return;
    if (c.querySelector('.pg-offer') || !c.querySelector('.l4ca:not(.in-panel)')) return;
    /* NOT when the family the card sells to has just left the list (owner,
       2026-09-19 evening: deleting the orbs flashed their card back for a
       beat before the read took it away: "when you exit out the orbs the
       upsell like flashes on the screen, dont do that"); the fresh read
       paints whatever is right next */
    var still = lastOffers.every(function(o){ return String(o.key).indexOf('cross:') === 0 || !o.handle || domHas(o.handle); });
    if (still) paint(lastOffers);
  }
  function boot(){
    read();
    /* pg-drawer fires this synchronously right after it swaps the drawer's
       HTML, so healing here lands in the same frame as the rebuild; the
       observer below is a beat later, and the re-read confirms */
    document.addEventListener('pg:cart-updated', function(){ heal(); schedule(120); });
    if (window.MutationObserver){
      var mo = null;
      var hook = function(){
        var c = document.getElementById('cart');
        if (!c || c.pgOfferObs) return;
        c.pgOfferObs = 1;
        new MutationObserver(function(){ heal(); schedule(150); }).observe(c, {childList: true, subtree: true});
      };
      hook();
      mo = new MutationObserver(hook);
      mo.observe(document.documentElement, {childList: true, subtree: true});
    }
    /* SPEED (2026-09-22, "I can barely load the site"): the event and the
       observer above already read on every drawer change, so the timed read is
       a backstop only: every 10s (was 4s), skipped while the tab is hidden,
       and once at once when the shopper comes back to the tab. */
    setInterval(function(){ if (!document.hidden) read(); }, 10000);
    document.addEventListener('visibilitychange', function(){ if (!document.hidden) read(); });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
