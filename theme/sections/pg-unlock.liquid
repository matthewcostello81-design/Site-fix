{%- comment -%}
  PG Unlock: cart prompt for the next rung of a product's own BXGY ladder.

  Read from the shop's live automatic discounts, so every message below is a
  real offer rather than invented copy:

    PokeOrb  - Buy 2 Get 1 Free ........ buy 2, next 1 free
    Wall Art - Buy 2 Get 1 Free ........ buy 2, next 1 free
    R36S     - 2nd Console 25% Off ..... buy 1, next 1 at 25% off

  The orb and wall-art ladders used to run three rungs -- 2nd at 25%, 3rd at
  50%, 5th free -- priced off a $32.99 / $39.99 unit. They are now a single
  Buy 2 Get 1 Free on a $34.99 orb and a $44.99 print, because one offer a
  shopper can hold in their head advertises better than a three-step ladder,
  and because the percentage tiers never survived being read at a glance. The
  four superseded discounts are deactivated in the admin, so nothing else can
  win at checkout and contradict this row.

  ONE CLICK TAKES THE WHOLE OFFER. The rung is the quantity that EARNS the
  discount and the free unit is the one after it, so Buy 2 Get 1 Free is only
  real once the cart holds three. The button therefore adds however many units
  that takes, not one:

      1 orb ..... Add 2 more, get 1 FREE   (pay for 1 more)   -> cart of 3
      2 orbs .... Add your FREE 3rd Orb    (costs nothing)    -> cart of 3
      3 orbs .... offer taken, no row

  Adding a single unit from one orb landed the shopper on two, with nothing
  discounted yet and a second prompt still to go -- the offer read as further
  away after they had acted on it. The console keeps its own shape: one rung
  at 25% off the second, one unit to add.

  The unit added is the same variant already in the cart, so the shopper gets
  another of the thing they chose rather than the product default.

  STACKING. Every one of these BXGYs used to carry combinesWith.productDiscounts
  = false, which is the setting behind the old "only one automatic discount per
  order" behaviour -- a cart with a console and several orbs got whichever single
  discount was worth most, and the other offers silently did nothing. The live
  discounts are now marked combinable (product, order and shipping), so a free
  3rd orb, a free 3rd print, a free case and 25% off a second console can all
  land on the same order.

  The blanket "10% Off (2+ Items)" discount is deliberately NOT combinable. It
  applies to everything in the cart, so stacking it on top of every ladder rung
  compounds fast; left as it is, Shopify picks between it and the ladders.

  The copy here still says "applied at checkout" for the rung being offered and
  never claims a total, which stays correct either way.
{%- endcomment -%}
<style>
  #cart .pg-unlock{
    display:flex;align-items:center;gap:12px;
    margin:10px 0 4px;padding:11px 13px;
    border:1px solid rgba(122,47,162,.3);border-radius:14px;
    background:linear-gradient(120deg,#F8F3FC,#F1E7F8);
    box-shadow:0 12px 30px -24px rgba(74,28,102,.45);
    font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;
  }
  #cart .pg-unlock img{width:52px;height:52px;border-radius:10px;object-fit:cover;flex:none;background:#efe4f8}
  #cart .pg-unlock-t{flex:1;min-width:0}
  #cart .pg-unlock-t b{display:block;font-size:13.5px;line-height:1.3;color:#3B1553}
  #cart .pg-unlock-t small{display:block;font-size:11.5px;line-height:1.35;color:#6E5C80;margin-top:2px}
  #cart .pg-unlock-tag{
    display:inline-block;margin-top:4px;padding:3px 9px;border-radius:999px;
    font-size:11px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;
    color:#fff;background:linear-gradient(120deg,#9B4BC4,#7A2FA2);
  }
  #cart .pg-unlock-add{
    flex:none;border:1.5px solid #7A2FA2 !important;background:#fff !important;
    background-image:none !important;color:#7A2FA2 !important;
    border-radius:999px !important;padding:9px 18px !important;
    font-family:inherit;font-weight:800;font-size:13px;cursor:pointer;
    animation:none !important;transition:background .15s ease,color .15s ease;
  }
  #cart .pg-unlock-add::before,#cart .pg-unlock-add::after{display:none !important;content:none !important}
  #cart .pg-unlock-add:hover{background:linear-gradient(120deg,#9B4BC4,#7A2FA2) !important;color:#fff !important}
  #cart .pg-unlock-add[disabled]{opacity:.6;cursor:default}
  @media(max-width:600px){
    #cart .pg-unlock{flex-wrap:wrap;gap:10px}
    #cart .pg-unlock-t{flex:1 1 60%}
    #cart .pg-unlock-add{flex:1 1 auto;order:4}
  }
</style>
<script>
(function(){
  if (window.pgUnlock) return; window.pgUnlock = 1;

  /* handle -> { name, rungs: { qtyAlreadyInCart: {pct, nth} } } */
  var LADDERS = {
    /* Orbs and wall art both run a single Buy 2 Get 1 Free, so there is exactly
       one rung: with 2 in the cart, the next one is free. offers() works out
       how many units the shopper is short of holding the free one and the
       button adds all of them at once. */
    'pokemon-crystal-ball-3d-pikachu-gengar-mewtwo-night-light-lamp-pokeball-3d-glass-pokemon-crystal-ball-statue-kids-birthday-gift': {
      name: 'Crystal PokeOrb',
      rungs: {2: {pct: 100, nth: '3rd'}}
    },
    'anime-pokemon-3d-lenticular-poster-charizard-squirtle-bulbasaur-come-alive-with-amazing-3d-effects-wall-art-printwithout-frame': {
      name: 'Heroic Holographic Wall Art',
      rungs: {2: {pct: 100, nth: '3rd'}}
    },
    'handheld-game-console': {
      name: 'PocketBoy R36',
      rungs: {1: {pct: 25, nth: '2nd'}}
    }
  };

  var busy = false;
  var lastKey = '';

  function money(c){ return '$' + (c / 100).toFixed(2); }

  /* ---------------- one line per variant ----------------

     A cart can end up holding the same variant on several separate lines --
     1 + 1 + 2 of the same orb, each with its own stepper and trash can. It
     happens when units arrive by different routes (the product page's bundle
     tile, this upsell, a manual add) and the line properties do not match
     exactly, since Shopify only folds an add into an existing line when the
     variant AND the properties are identical.

     The ladder was never wrong -- offers() sums across lines, so four orbs
     counted as four -- but the cart read as though the shopper had bought
     three unrelated things, and clicking Add grew whichever line happened to
     be first rather than the one they were looking at.

     So duplicates are merged: the first line takes the combined quantity and
     the rest are zeroed. Free-gift lines are excluded, because a $0.00 gift is
     not a purchased unit and merging it would fold a free item into a paid
     line at full price.

     Guarded by `merging` so the 900ms tick cannot start a second merge while
     the first is still in flight, and it returns true to tell render() to stop
     and wait -- drawing rows from a cart that is about to change would flash
     the wrong offer. */
  var merging = false;
  var merges = 0;            /* merges attempted this page load */
  var mergedVariants = {};   /* variant ids already merged once */
  var MAX_MERGES = 4;

  function consolidate(cart){
    if (merging) return false;

    /* CONVERGENCE GUARD -- read this before removing it.

       Merging fights anything that legitimately wants a variant on two lines.
       A BXGY allocation is exactly that: when Shopify discounts one unit of
       four, it can hold the discounted unit on its own line. Merge them and
       Shopify splits them again on the next cart read, this fires again on the
       next 900ms tick, and the cart thrashes -- quantities jumping, a request
       every tick, which is what "bugging hard" looks like from the outside.

       Two brakes. A variant is merged AT MOST ONCE per page load: if it comes
       back split, that is Shopify asserting a split we should not overrule, so
       it is left alone. And MAX_MERGES caps total attempts regardless, so no
       combination of products can turn this into a request loop. */
    if (merges >= MAX_MERGES) return false;

    var byVariant = {};
    (cart.items || []).forEach(function(it){
      if (it.properties && it.properties._free_gift) return;
      (byVariant[it.variant_id] = byVariant[it.variant_id] || []).push(it);
    });

    var dupes = null;
    Object.keys(byVariant).forEach(function(v){
      if (dupes) return;
      if (byVariant[v].length < 2) return;
      if (mergedVariants[v]) return;   /* already merged once; Shopify re-split it */
      dupes = byVariant[v];
      mergedVariants[v] = 1;
    });
    if (!dupes) return false;
    merges++;

    var total = dupes.reduce(function(n, it){ return n + it.quantity; }, 0);
    var keep = dupes[0];
    var drop = dupes.slice(1);

    merging = true;
    var chain = change(keep.key, total);
    drop.forEach(function(it){
      chain = chain.then(function(){ return change(it.key, 0); });
    });
    chain.then(function(){
      merging = false;
      lastKey = '';
      if (window.pgDrawerRefresh) return window.pgDrawerRefresh();
    }).then(function(){
      render();
    }).catch(function(){
      merging = false;
    });
    return true;
  }

  function change(key, qty){
    return fetch('/cart/change.js', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({id: key, quantity: qty})
    });
  }

  /* One row per ladder product with a rung still ahead of it. `away` is how
     many more units it takes to reach that rung: 0 means the shopper is on it
     and one click earns the discount. */
  function offers(cart){
    var byHandle = {};
    (cart.items || []).forEach(function(it){
      if (!LADDERS[it.handle]) return;
      /* the free gift line is not a purchased unit and must not count */
      if (it.properties && it.properties._free_gift) return;
      var h = byHandle[it.handle] || (byHandle[it.handle] = {qty: 0, item: it});
      h.qty += it.quantity;
    });
    var out = [];
    Object.keys(byHandle).forEach(function(handle){
      var rec = byHandle[handle];
      var rungs = LADDERS[handle].rungs;
      var rung = rungs[rec.qty];
      var away = 0;

      var at = rec.qty;                     /* the rung's own quantity */

      if (!rung){
        /* nearest rung still ahead of this quantity */
        var best = null;
        Object.keys(rungs).forEach(function(k){
          var q = parseInt(k, 10);
          if (q > rec.qty && (best === null || q < best)) best = q;
        });
        if (best === null) return;          /* ladder exhausted, nothing to say */
        rung = rungs[best];
        at = best;
        away = best - rec.qty;
      }

      /* ONE CLICK TAKES THE WHOLE OFFER.
         The rung is the quantity that EARNS the discount; the discounted unit
         is the one after it. Buy 2 Get 1 Free earns at 2 and pays out on the
         3rd, so the cart has to reach 3 -- and a shopper holding one orb was
         being told to "add 1 more", which lands them on 2 with nothing yet
         discounted and a second prompt to go. `need` is the whole distance:
         two units from one orb, one from two, and the button adds that many
         so the free one is always a single click away. */
      var need = (at + 1) - rec.qty;
      if (need < 1) return;

      out.push({
        handle: handle,
        name: LADDERS[handle].name,
        variant: rec.item.variant_id,
        /* the line to grow, and what it currently holds -- see the click
           handler for why the button raises this rather than posting an add */
        key: rec.item.key,
        lineQty: rec.item.quantity,
        /* the product's TOTAL across every line it sits on. When it differs
           from lineQty the product is split, and growing one line by `need`
           would not add `need` units to the cart. */
        totalQty: rec.qty,
        image: rec.item.image,
        price: rec.item.price,
        rung: rung,
        away: away,
        need: need
      });
    });
    return out;
  }

  function row(o){
    var el = document.createElement('div');
    el.className = 'pg-unlock';
    el.setAttribute('data-pg-unlock', o.handle);
    var free = o.rung.pct === 100;
    var after = free ? 'free' : money(Math.round(o.price * (100 - o.rung.pct) / 100));
    var img = o.image ? String(o.image).replace(/(\.[a-z]+)(\?|$)/i, '_120x$1$2') : '';

    var title, note;
    if (free){
      if (o.need === 1){
        title = 'Add your FREE ' + o.rung.nth + ' ' + o.name;
        note = 'You already qualify - this one costs nothing';
      } else {
        /* SAY IT THE WAY THE SHOPPER EXPERIENCES IT.
           This read "Add 2 more, get 1 FREE" to someone holding one orb, which
           is arithmetically right -- the cart has to reach three before the
           BXGY pays out -- and reads as though the offer moved further away
           the moment they bought one. What actually happens is that they pay
           for one more orb and two more arrive. That is the sentence. */
        var pay = o.need - 1;
        title = 'Buy ' + pay + ' more, get 1 FREE';
        /* no product name here: it pluralises badly on "Heroic Holographic
           Wall Art", and the row already names the product in the image and
           the title above it */
        note = 'Adds ' + o.need + ' to your cart - you only pay for ' + pay;
      }
    } else {
      title = 'Add a ' + o.rung.nth + ' ' + o.name;
      note = 'Get it for ' + after + ' instead of ' + money(o.price) + ', applied at checkout';
    }

    el.innerHTML =
      '<img alt="" src="' + img + '">' +
      '<div class="pg-unlock-t">' +
        '<b>' + title + '</b>' +
        '<small>' + note + '</small>' +
        '<span class="pg-unlock-tag">' + (free ? 'Free' : o.rung.pct + '% off') + '</span>' +
      '</div>' +
      '<button type="button" class="pg-unlock-add" data-v="' + o.variant +
        '" data-k="' + (o.key || '') + '" data-q="' + o.lineQty +
        '" data-t="' + o.totalQty + '" data-n="' + o.need + '">Add</button>';
    return el;
  }

  function render(){
    var c = document.getElementById('cart');
    if (!c) return;
    var list = c.querySelector('.l4ca:not(.in-panel)');
    if (!list) return;
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      /* merge split lines first; if that fires, it re-renders when it lands */
      if (consolidate(cart)) return;
      var offs = offers(cart);
      /* `away` is part of the key: going from 3 orbs to 4 keeps the same rung
         and variant, and without it the row would keep the "add 1 more" copy
         after the shopper has already arrived */
      var key = offs.map(function(o){ return o.handle + ':' + o.rung.nth + ':' + o.need + ':' + o.variant; }).join('|');
      if (key === lastKey && c.querySelector('.pg-unlock')) return;
      lastKey = key;
      c.querySelectorAll('.pg-unlock').forEach(function(el){ el.parentNode.removeChild(el); });
      if (!offs.length) return;
      /* At the TOP of the cart, above the line items. It used to sit below
         them, anchored on the recommendation rail, where a cart of three or
         four products pushed it off the first screen -- and an offer nobody
         scrolls to is an offer nobody takes. */
      offs.forEach(function(o){
        var el = row(o);
        if (list.parentNode) list.parentNode.insertBefore(el, list);
      });
    }).catch(function(){});
  }

  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('.pg-unlock-add');
    if (!btn || busy) return;
    e.preventDefault(); e.stopPropagation();
    busy = true;
    btn.disabled = true;
    btn.textContent = 'Adding...';

    /* Raise the quantity on the line that is already there, rather than
       posting an add.

       Shopify only merges an added item into an existing line when the variant
       AND the line properties match exactly. The wall art line was picking up
       a fresh line on every click -- one for the 2nd print, another for the
       3rd -- because whatever put the first one in the cart attached line
       properties this button does not send. Changing the known line key by
       quantity + 1 cannot split, whatever properties that line carries.

       add.js stays as the fallback for the case where the key has gone stale
       (the cart changed in another tab, say); a stale key makes change.js a
       no-op, so the response is checked for the line actually growing. */
    var key = btn.getAttribute('data-k');
    var qty = parseInt(btn.getAttribute('data-q'), 10) || 0;
    var vid = parseInt(btn.getAttribute('data-v'), 10);
    /* how many units this offer needs -- 2 from a single orb, 1 from a pair */
    var need = parseInt(btn.getAttribute('data-n'), 10) || 1;
    var total = parseInt(btn.getAttribute('data-t'), 10) || qty;

    /* SPLIT LINES. The offer counts every unit of the product; the button
       grows ONE line. When the two disagree the product is on more than one
       line, and raising that line to qty + need adds the right number to the
       line but the wrong number to the cart -- which is how a click meant to
       add one console added two. Post a plain add instead: it is exactly
       `need` units, whatever the lines look like. */
    var split = total !== qty;

    function addNew(){
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({items: [{id: vid, quantity: need}]})
      });
    }

    var req = (key && !split)
      ? fetch('/cart/change.js', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({id: key, quantity: qty + need})
        }).then(function(r){
          if (!r.ok) return addNew();
          return r.json().then(function(cart){
            var grew = (cart.items || []).some(function(it){
              return it.key === key && it.quantity > qty;
            });
            return grew ? r : addNew();
          });
        })
      : addNew();

    req.then(function(r){
      if (!r || !r.ok) throw 0;
      lastKey = '';
      busy = false;
      if (window.pgDrawerRefresh) return window.pgDrawerRefresh();
    }).then(function(){
      render();
    }).catch(function(){
      busy = false;
      btn.disabled = false;
      btn.textContent = 'Try again';
    });
  }, true);

  setInterval(render, 900);
  render();
})();
</script>
{% schema %}
{"name": "PG Unlock", "settings": []}
{% endschema %}
