{%- comment -%}
  PG Unlock: cart prompt for the next rung of a product's own BXGY ladder.

  Read from the shop's live automatic discounts, so every message below is a
  real offer rather than invented copy:

    PokeOrb  - 2nd Orb 25% Off ......... buy 1, next 1 at 25% off
    PokeOrb  - Buy 2 Get 1 Free ........ buy 2, next 1 free
    PokeOrb  - Buy 4 Get 1 Free ........ buy 4, next 1 free
    Wall Art - 2nd Print 25% Off ....... buy 1, next 1 at 25% off
    Wall Art - 3rd Print 50% Off ....... buy 2, next 1 at 50% off
    Wall Art - Buy 4 Get 1 Free ........ buy 4, next 1 free
    R36S     - 2nd Console 25% Off ..... buy 1, next 1 at 25% off

  (PokeOrb also has a 3rd-at-50%-off, but Buy 2 Get 1 Free covers the same rung
  at 100% off, so the free one is what gets offered there.)

  A row only appears when adding exactly ONE more unit earns a discount on that
  unit -- the rung is reachable in a single click, so the prompt is never a
  promise about something two steps away. At quantities between rungs the row
  says how many more units the next rung takes.

  LAYOUT NOTE: the styles below are stamped onto the elements as inline
  `!important` declarations rather than left to the stylesheet. The cart's own
  CSS carries rules like `#cart img{width:100%}` that outrank a plain class
  selector, which collapsed this row into a full-bleed image with the copy
  squeezed out of view. Inline wins that fight outright, and every render pass
  re-stamps in case something else repaints the row.

  NOTE for whoever picks this up: Shopify applies only ONE automatic discount to
  an order. These ladders cannot stack with each other or with the free-case
  BXGY, so a cart holding a console and two orbs gets the single best one, not
  both. The copy here deliberately says "applied at checkout" for the rung being
  offered and never claims a total.
{%- endcomment -%}
<script>
(function(){
  if (window.pgUnlock) return; window.pgUnlock = 1;

  /* handle -> { name, rungs: { qtyAlreadyInCart: {pct, nth} } } */
  var LADDERS = {
    'pokemon-crystal-ball-3d-pikachu-gengar-mewtwo-night-light-lamp-pokeball-3d-glass-pokemon-crystal-ball-statue-kids-birthday-gift': {
      name: 'Crystal PokeOrb',
      rungs: {1: {pct: 25, nth: '2nd'}, 2: {pct: 100, nth: '3rd'}, 4: {pct: 100, nth: '5th'}}
    },
    'anime-pokemon-3d-lenticular-poster-charizard-squirtle-bulbasaur-come-alive-with-amazing-3d-effects-wall-art-printwithout-frame': {
      name: 'Holographic Wall Art',
      rungs: {1: {pct: 25, nth: '2nd'}, 2: {pct: 50, nth: '3rd'}, 4: {pct: 100, nth: '5th'}}
    },
    'handheld-game-console': {
      name: 'PocketBoy R36',
      rungs: {1: {pct: 25, nth: '2nd'}}
    }
  };

  /* ---------- inline style stamping ---------- */

  var S = {
    box:  {'display':'block','width':'100%'},
    row:  {'display':'flex','align-items':'center','gap':'12px','width':'100%',
           'box-sizing':'border-box','margin':'10px 0 4px','padding':'11px 13px',
           'border':'1px solid rgba(122,47,162,.3)','border-radius':'14px',
           'background':'linear-gradient(120deg,#F8F3FC,#F1E7F8)',
           'box-shadow':'0 12px 30px -24px rgba(74,28,102,.45)',
           'font-family':"'Poppins','Segoe UI',Helvetica,Arial,sans-serif",
           'list-style':'none','float':'none','position':'relative'},
    img:  {'width':'52px','height':'52px','min-width':'52px','max-width':'52px',
           'border-radius':'10px','object-fit':'cover','flex':'0 0 auto',
           'background':'#efe4f8','display':'block','margin':'0','padding':'0'},
    txt:  {'flex':'1 1 auto','min-width':'0','display':'block','text-align':'left',
           'margin':'0','padding':'0'},
    ttl:  {'display':'block','font-size':'13.5px','line-height':'1.3','color':'#3B1553',
           'font-weight':'800','margin':'0','white-space':'normal'},
    note: {'display':'block','font-size':'11.5px','line-height':'1.35','color':'#6E5C80',
           'margin':'2px 0 0','white-space':'normal'},
    tag:  {'display':'inline-block','margin':'4px 0 0','padding':'3px 9px','border-radius':'999px',
           'font-size':'11px','font-weight':'800','letter-spacing':'.04em',
           'text-transform':'uppercase','color':'#fff',
           'background':'linear-gradient(120deg,#9B4BC4,#7A2FA2)'},
    add:  {'flex':'0 0 auto','width':'auto','min-width':'0','border':'1.5px solid #7A2FA2',
           'background':'#fff','background-image':'none','color':'#7A2FA2',
           'border-radius':'999px','padding':'9px 18px','font-family':'inherit',
           'font-weight':'800','font-size':'13px','cursor':'pointer','animation':'none',
           'position':'static','margin':'0','line-height':'1.2','text-transform':'none',
           'letter-spacing':'0','box-shadow':'none','transform':'none'}
  };

  function st(el, map){
    if (!el) return el;
    for (var k in map) if (map.hasOwnProperty(k)) el.style.setProperty(k, map[k], 'important');
    return el;
  }

  function narrow(){ return window.innerWidth <= 600; }

  /* On a phone the row wraps: copy beside the thumbnail, button on its own
     line underneath at full width. */
  function stampRow(el){
    st(el, S.row);
    if (narrow()){
      el.style.setProperty('flex-wrap','wrap','important');
      el.style.setProperty('row-gap','10px','important');
    } else {
      el.style.setProperty('flex-wrap','nowrap','important');
    }
    st(el.querySelector('img'), S.img);
    var t = el.querySelector('.pg-unlock-t');
    st(t, S.txt);
    if (narrow() && t) t.style.setProperty('flex','1 1 40%','important');
    st(el.querySelector('.pg-unlock-b'), S.ttl);
    st(el.querySelector('.pg-unlock-s'), S.note);
    st(el.querySelector('.pg-unlock-tag'), S.tag);
    var b = el.querySelector('.pg-unlock-add');
    st(b, S.add);
    if (narrow() && b){
      b.style.setProperty('flex','1 1 100%','important');
      b.style.setProperty('width','100%','important');
      b.style.setProperty('order','4','important');
    }
  }

  function stampAll(){
    document.querySelectorAll('#cart .pg-unlock').forEach(stampRow);
  }

  var busy = false;
  var lastKey = '';

  function money(c){ return '$' + (c / 100).toFixed(2); }

  /* One row per ladder product that still has a rung ahead of it.

     A cart sitting exactly ON a rung gets the actionable offer -- one click
     earns the discount. A cart BETWEEN rungs (3 orbs, say) used to get nothing
     at all, which reads as the upsell vanishing, so it now gets the same row
     stating how many more it takes to reach the next rung. The button adds one
     unit either way, and the copy never claims a discount that click will not
     earn. */
  function offers(cart){
    var byHandle = {};
    (cart.items || []).forEach(function(it){
      if (!LADDERS[it.handle]) return;
      /* the free gift line is not a purchased unit and must not count */
      if (it.properties && it.properties._free_gift) return;
      var h = byHandle[it.handle] || (byHandle[it.handle] = {qty: 0, item: it});
      h.qty += it.quantity;
    });
    var out = [];
    Object.keys(byHandle).forEach(function(handle){
      var rec = byHandle[handle];
      var rungs = LADDERS[handle].rungs;
      var rung = rungs[rec.qty];
      var away = 0;

      if (!rung){
        /* nearest rung still ahead of this quantity */
        var best = null;
        Object.keys(rungs).forEach(function(k){
          var q = parseInt(k, 10);
          if (q > rec.qty && (best === null || q < best)) best = q;
        });
        if (best === null) return;          /* ladder exhausted, nothing to say */
        rung = rungs[best];
        away = best - rec.qty;
      }

      out.push({
        handle: handle,
        name: LADDERS[handle].name,
        variant: rec.item.variant_id,
        image: rec.item.image,
        price: rec.item.price,
        rung: rung,
        away: away
      });
    });
    return out;
  }

  function row(o){
    var el = document.createElement('div');
    el.className = 'pg-unlock';
    el.setAttribute('data-pg-unlock', o.handle);
    var free = o.rung.pct === 100;
    var after = free ? 'free' : money(Math.round(o.price * (100 - o.rung.pct) / 100));
    var img = o.image ? String(o.image).replace(/(\.[a-z]+)(\?|$)/i, '_120x$1$2') : '';

    var title, note;
    if (o.away === 0){
      title = 'Add a ' + o.rung.nth + ' ' + o.name;
      note = (free ? 'Your ' + o.rung.nth + ' one is free' : 'Get it for ' + after + ' instead of ' + money(o.price)) +
             ', applied at checkout';
    } else {
      title = 'Add ' + o.away + ' more ' + o.name + (o.away > 1 ? 's' : '');
      note = 'Then your ' + o.rung.nth + ' is ' + (free ? 'free' : o.rung.pct + '% off') + ', applied at checkout';
    }

    el.innerHTML =
      '<img alt="" src="' + img + '">' +
      '<div class="pg-unlock-t">' +
        '<span class="pg-unlock-b">' + title + '</span>' +
        '<span class="pg-unlock-s">' + note + '</span>' +
        '<span class="pg-unlock-tag">' + (free ? o.rung.nth + ' free' : o.rung.nth + ' ' + o.rung.pct + '% off') + '</span>' +
      '</div>' +
      '<button type="button" class="pg-unlock-add" data-v="' + o.variant + '">Add</button>';
    stampRow(el);
    return el;
  }

  /* Where the rows belong: the top of the cart body, directly above the items
     card -- the same place the desktop drawer puts it. The rail (.nc-recs /
     .nc-recs-panel) moves between breakpoints, so anchoring on the items list
     keeps the rows in one predictable spot at every width.

     They go inside one wrapper rather than being inserted individually: with
     two loose rows, each pass saw the other as "not directly above the list"
     and moved it, so the pair swapped places every tick forever. */
  function host(list){
    if (!list || !list.parentNode) return null;
    var box = document.querySelector('#cart .pg-unlock-box');
    if (!box){
      box = document.createElement('div');
      box.className = 'pg-unlock-box';
    }
    st(box, S.box);
    if (box.nextSibling !== list) list.parentNode.insertBefore(box, list);
    return box;
  }

  function itemsList(c){
    return c.querySelector('.l4ca:not(.in-panel)') || c.querySelector('.l4ca');
  }

  function render(){
    var c = document.getElementById('cart');
    if (!c) return;
    var list = itemsList(c);
    if (!list) return;
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      var offs = offers(cart);
      var box = host(list);
      if (!box) return;
      var key = offs.map(function(o){ return o.handle + ':' + o.rung.nth + ':' + o.away + ':' + o.variant; }).join('|');
      if (key === lastKey && box.children.length === offs.length){
        stampAll();
        return;
      }
      lastKey = key;
      box.innerHTML = '';
      offs.forEach(function(o){ box.appendChild(row(o)); });
    }).catch(function(){});
  }

  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('.pg-unlock-add');
    if (!btn || busy) return;
    e.preventDefault(); e.stopPropagation();
    busy = true;
    btn.disabled = true;
    btn.style.setProperty('opacity','.6','important');
    btn.textContent = 'Adding...';
    fetch('/cart/add.js', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({items: [{id: parseInt(btn.getAttribute('data-v'), 10), quantity: 1}]})
    }).then(function(r){
      if (!r.ok) throw 0;
      lastKey = '';
      busy = false;
      if (window.pgDrawerRefresh) return window.pgDrawerRefresh();
    }).then(function(){
      render();
    }).catch(function(){
      busy = false;
      btn.disabled = false;
      btn.style.setProperty('opacity','1','important');
      btn.textContent = 'Try again';
    });
  }, true);

  window.addEventListener('resize', stampAll);
  setInterval(render, 900);
  render();
})();
</script>
{% schema %}
{"name": "PG Unlock", "settings": []}
{% endschema %}
