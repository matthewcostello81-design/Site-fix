{%- comment -%}
  PG Unlock: cart prompt for the next rung of a product's own BXGY ladder.

  Read from the shop's live automatic discounts, so every message below is a
  real offer rather than invented copy:

    PokeOrb  - 2nd Orb 25% Off ......... buy 1, next 1 at 25% off
    PokeOrb  - 3rd Orb 50% Off ......... buy 2, next 1 at 50% off
    PokeOrb  - Buy 4 Get 1 Free ........ buy 4, next 1 free
    Wall Art - 2nd Print 25% Off ....... buy 1, next 1 at 25% off
    Wall Art - 3rd Print 50% Off ....... buy 2, next 1 at 50% off
    Wall Art - Buy 4 Get 1 Free ........ buy 4, next 1 free
    R36S     - 2nd Console 25% Off ..... buy 1, next 1 at 25% off

  Both ladders now read 25 / 50 / free-at-the-5th, which is what the product
  pages advertise. A second orb discount, "Buy 2 Get 1 Free - Crystal PokeOrb",
  used to sit on the SAME rung as the 3rd-at-50% and paid out more, and since
  Shopify applies only one automatic discount and takes the largest, checkout
  handed the 3rd orb over free no matter what this row said. That discount has
  been deactivated so the offer here and the charge at checkout agree.

  A cart sitting ON a rung gets the actionable offer -- one click earns the
  discount. A cart BETWEEN rungs gets the same row pointed at the next rung
  ahead, saying how many more units it takes:

      1 orb ..... Add a 2nd Crystal PokeOrb - 25% off
      2 orbs .... Add a 3rd Crystal PokeOrb - 50% off
      3 orbs .... Add 1 more, then your 5th is free
      4 orbs .... Add a 5th Crystal PokeOrb - free
      5 orbs .... ladder exhausted, no row

  Without the between-rungs case the upsell went silent at 3, which reads as
  the offer disappearing right after the shopper took one. The button adds a
  single unit either way, and the copy never claims a discount that click will
  not actually earn.

  The unit added is the same variant already in the cart, so the shopper gets
  another of the thing they chose rather than the product default.

  NOTE for whoever picks this up: Shopify applies only ONE automatic discount to
  an order. These ladders cannot stack with each other or with the free-case
  BXGY, so a cart holding a console and two orbs gets the single best one, not
  both. The copy here deliberately says "applied at checkout" for the rung being
  offered and never claims a total.
{%- endcomment -%}
<style>
  #cart .pg-unlock{
    display:flex;align-items:center;gap:12px;
    margin:10px 0 4px;padding:11px 13px;
    border:1px solid rgba(122,47,162,.3);border-radius:14px;
    background:linear-gradient(120deg,#F8F3FC,#F1E7F8);
    box-shadow:0 12px 30px -24px rgba(74,28,102,.45);
    font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;
  }
  #cart .pg-unlock img{width:52px;height:52px;border-radius:10px;object-fit:cover;flex:none;background:#efe4f8}
  #cart .pg-unlock-t{flex:1;min-width:0}
  #cart .pg-unlock-t b{display:block;font-size:13.5px;line-height:1.3;color:#3B1553}
  #cart .pg-unlock-t small{display:block;font-size:11.5px;line-height:1.35;color:#6E5C80;margin-top:2px}
  #cart .pg-unlock-tag{
    display:inline-block;margin-top:4px;padding:3px 9px;border-radius:999px;
    font-size:11px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;
    color:#fff;background:linear-gradient(120deg,#9B4BC4,#7A2FA2);
  }
  #cart .pg-unlock-add{
    flex:none;border:1.5px solid #7A2FA2 !important;background:#fff !important;
    background-image:none !important;color:#7A2FA2 !important;
    border-radius:999px !important;padding:9px 18px !important;
    font-family:inherit;font-weight:800;font-size:13px;cursor:pointer;
    animation:none !important;transition:background .15s ease,color .15s ease;
  }
  #cart .pg-unlock-add::before,#cart .pg-unlock-add::after{display:none !important;content:none !important}
  #cart .pg-unlock-add:hover{background:linear-gradient(120deg,#9B4BC4,#7A2FA2) !important;color:#fff !important}
  #cart .pg-unlock-add[disabled]{opacity:.6;cursor:default}
  @media(max-width:600px){
    #cart .pg-unlock{flex-wrap:wrap;gap:10px}
    #cart .pg-unlock-t{flex:1 1 60%}
    #cart .pg-unlock-add{flex:1 1 auto;order:4}
  }
</style>
<script>
(function(){
  if (window.pgUnlock) return; window.pgUnlock = 1;

  /* handle -> { name, rungs: { qtyAlreadyInCart: {pct, nth} } } */
  var LADDERS = {
    'pokemon-crystal-ball-3d-pikachu-gengar-mewtwo-night-light-lamp-pokeball-3d-glass-pokemon-crystal-ball-statue-kids-birthday-gift': {
      name: 'Crystal PokeOrb',
      rungs: {1: {pct: 25, nth: '2nd'}, 2: {pct: 50, nth: '3rd'}, 4: {pct: 100, nth: '5th'}}
    },
    'anime-pokemon-3d-lenticular-poster-charizard-squirtle-bulbasaur-come-alive-with-amazing-3d-effects-wall-art-printwithout-frame': {
      name: 'Heroic Holographic Wall Art',
      rungs: {1: {pct: 25, nth: '2nd'}, 2: {pct: 50, nth: '3rd'}, 4: {pct: 100, nth: '5th'}}
    },
    'handheld-game-console': {
      name: 'PocketBoy R36',
      rungs: {1: {pct: 25, nth: '2nd'}}
    }
  };

  var busy = false;
  var lastKey = '';

  function money(c){ return '$' + (c / 100).toFixed(2); }

  /* ---------------- one line per variant ----------------

     A cart can end up holding the same variant on several separate lines --
     1 + 1 + 2 of the same orb, each with its own stepper and trash can. It
     happens when units arrive by different routes (the product page's bundle
     tile, this upsell, a manual add) and the line properties do not match
     exactly, since Shopify only folds an add into an existing line when the
     variant AND the properties are identical.

     The ladder was never wrong -- offers() sums across lines, so four orbs
     counted as four -- but the cart read as though the shopper had bought
     three unrelated things, and clicking Add grew whichever line happened to
     be first rather than the one they were looking at.

     So duplicates are merged: the first line takes the combined quantity and
     the rest are zeroed. Free-gift lines are excluded, because a $0.00 gift is
     not a purchased unit and merging it would fold a free item into a paid
     line at full price.

     Guarded by `merging` so the 900ms tick cannot start a second merge while
     the first is still in flight, and it returns true to tell render() to stop
     and wait -- drawing rows from a cart that is about to change would flash
     the wrong offer. */
  var merging = false;

  function consolidate(cart){
    if (merging) return false;

    var byVariant = {};
    (cart.items || []).forEach(function(it){
      if (it.properties && it.properties._free_gift) return;
      (byVariant[it.variant_id] = byVariant[it.variant_id] || []).push(it);
    });

    var dupes = null;
    Object.keys(byVariant).forEach(function(v){
      if (!dupes && byVariant[v].length > 1) dupes = byVariant[v];
    });
    if (!dupes) return false;

    var total = dupes.reduce(function(n, it){ return n + it.quantity; }, 0);
    var keep = dupes[0];
    var drop = dupes.slice(1);

    merging = true;
    var chain = change(keep.key, total);
    drop.forEach(function(it){
      chain = chain.then(function(){ return change(it.key, 0); });
    });
    chain.then(function(){
      merging = false;
      lastKey = '';
      if (window.pgDrawerRefresh) return window.pgDrawerRefresh();
    }).then(function(){
      render();
    }).catch(function(){
      merging = false;
    });
    return true;
  }

  function change(key, qty){
    return fetch('/cart/change.js', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({id: key, quantity: qty})
    });
  }

  /* One row per ladder product with a rung still ahead of it. `away` is how
     many more units it takes to reach that rung: 0 means the shopper is on it
     and one click earns the discount. */
  function offers(cart){
    var byHandle = {};
    (cart.items || []).forEach(function(it){
      if (!LADDERS[it.handle]) return;
      /* the free gift line is not a purchased unit and must not count */
      if (it.properties && it.properties._free_gift) return;
      var h = byHandle[it.handle] || (byHandle[it.handle] = {qty: 0, item: it});
      h.qty += it.quantity;
    });
    var out = [];
    Object.keys(byHandle).forEach(function(handle){
      var rec = byHandle[handle];
      var rungs = LADDERS[handle].rungs;
      var rung = rungs[rec.qty];
      var away = 0;

      if (!rung){
        /* nearest rung still ahead of this quantity */
        var best = null;
        Object.keys(rungs).forEach(function(k){
          var q = parseInt(k, 10);
          if (q > rec.qty && (best === null || q < best)) best = q;
        });
        if (best === null) return;          /* ladder exhausted, nothing to say */
        rung = rungs[best];
        away = best - rec.qty;
      }

      out.push({
        handle: handle,
        name: LADDERS[handle].name,
        variant: rec.item.variant_id,
        /* the line to grow, and what it currently holds -- see the click
           handler for why the button raises this rather than posting an add */
        key: rec.item.key,
        lineQty: rec.item.quantity,
        image: rec.item.image,
        price: rec.item.price,
        rung: rung,
        away: away
      });
    });
    return out;
  }

  function row(o){
    var el = document.createElement('div');
    el.className = 'pg-unlock';
    el.setAttribute('data-pg-unlock', o.handle);
    var free = o.rung.pct === 100;
    var after = free ? 'free' : money(Math.round(o.price * (100 - o.rung.pct) / 100));
    var img = o.image ? String(o.image).replace(/(\.[a-z]+)(\?|$)/i, '_120x$1$2') : '';

    var title, note;
    if (o.away === 0){
      title = 'Add a ' + o.rung.nth + ' ' + o.name;
      note = (free ? 'Your ' + o.rung.nth + ' one is free' : 'Get it for ' + after + ' instead of ' + money(o.price)) +
             ', applied at checkout';
    } else {
      title = 'Add ' + o.away + ' more ' + o.name + (o.away > 1 ? 's' : '');
      note = 'Then your ' + o.rung.nth + ' is ' + (free ? 'free' : o.rung.pct + '% off') + ', applied at checkout';
    }

    el.innerHTML =
      '<img alt="" src="' + img + '">' +
      '<div class="pg-unlock-t">' +
        '<b>' + title + '</b>' +
        '<small>' + note + '</small>' +
        '<span class="pg-unlock-tag">' + (free ? 'Free' : o.rung.pct + '% off') + '</span>' +
      '</div>' +
      '<button type="button" class="pg-unlock-add" data-v="' + o.variant +
        '" data-k="' + (o.key || '') + '" data-q="' + o.lineQty + '">Add</button>';
    return el;
  }

  function render(){
    var c = document.getElementById('cart');
    if (!c) return;
    var list = c.querySelector('.l4ca:not(.in-panel)');
    if (!list) return;
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
      /* merge split lines first; if that fires, it re-renders when it lands */
      if (consolidate(cart)) return;
      var offs = offers(cart);
      /* `away` is part of the key: going from 3 orbs to 4 keeps the same rung
         and variant, and without it the row would keep the "add 1 more" copy
         after the shopper has already arrived */
      var key = offs.map(function(o){ return o.handle + ':' + o.rung.nth + ':' + o.away + ':' + o.variant; }).join('|');
      if (key === lastKey && c.querySelector('.pg-unlock')) return;
      lastKey = key;
      c.querySelectorAll('.pg-unlock').forEach(function(el){ el.parentNode.removeChild(el); });
      if (!offs.length) return;
      /* directly under the cart items, above the recommendation rail */
      var anchor = c.querySelector('.nc-recs') || list.nextSibling;
      offs.forEach(function(o){
        var el = row(o);
        if (anchor && anchor.parentNode) anchor.parentNode.insertBefore(el, anchor);
        else list.parentNode.appendChild(el);
      });
    }).catch(function(){});
  }

  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('.pg-unlock-add');
    if (!btn || busy) return;
    e.preventDefault(); e.stopPropagation();
    busy = true;
    btn.disabled = true;
    btn.textContent = 'Adding...';

    /* Raise the quantity on the line that is already there, rather than
       posting an add.

       Shopify only merges an added item into an existing line when the variant
       AND the line properties match exactly. The wall art line was picking up
       a fresh line on every click -- one for the 2nd print, another for the
       3rd -- because whatever put the first one in the cart attached line
       properties this button does not send. Changing the known line key by
       quantity + 1 cannot split, whatever properties that line carries.

       add.js stays as the fallback for the case where the key has gone stale
       (the cart changed in another tab, say); a stale key makes change.js a
       no-op, so the response is checked for the line actually growing. */
    var key = btn.getAttribute('data-k');
    var qty = parseInt(btn.getAttribute('data-q'), 10) || 0;
    var vid = parseInt(btn.getAttribute('data-v'), 10);

    function addNew(){
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({items: [{id: vid, quantity: 1}]})
      });
    }

    var req = key
      ? fetch('/cart/change.js', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({id: key, quantity: qty + 1})
        }).then(function(r){
          if (!r.ok) return addNew();
          return r.json().then(function(cart){
            var grew = (cart.items || []).some(function(it){
              return it.key === key && it.quantity > qty;
            });
            return grew ? r : addNew();
          });
        })
      : addNew();

    req.then(function(r){
      if (!r || !r.ok) throw 0;
      lastKey = '';
      busy = false;
      if (window.pgDrawerRefresh) return window.pgDrawerRefresh();
    }).then(function(){
      render();
    }).catch(function(){
      busy = false;
      btn.disabled = false;
      btn.textContent = 'Try again';
    });
  }, true);

  setInterval(render, 900);
  render();
})();
</script>
{% schema %}
{"name": "PG Unlock", "settings": []}
{% endschema %}
