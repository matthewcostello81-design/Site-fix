    .pg-fsps-lead{font-size:15px}
    .pg-fsps-split{grid-template-columns:1fr;gap:24px;text-align:center}
    .pg-fsps-split h2,.pg-fsps-split .pg-fsps-lead{margin-left:auto;margin-right:auto}
    .pg-fsps-math{text-align:left;gap:10px}
    .pg-fsps-math div{padding:14px 12px}
    .pg-fsps-math small{font-size:10.5px;letter-spacing:.06em}
    .pg-fsps-math em{font-size:12px}
    .pg-fsps-math .go{font-size:11px;letter-spacing:.06em}
    .pg-fsps-grid{grid-template-columns:1fr 1fr;gap:12px;margin-top:26px}
    .pg-fsps-feat{padding:24px 8px 22px;border-radius:20px}
    .pg-fsps-feat .ic{width:60px;height:60px;margin-bottom:12px;border-radius:17px}
    .pg-fsps-feat .ic svg{width:46px;height:46px}
    .pg-fsps-feat h3{font-size:clamp(20px,5.8vw,24px);margin-bottom:6px}
    .pg-fsps-feat p{font-size:13.5px;line-height:1.45}
    .pg-fsps-cases{grid-template-columns:1fr;gap:12px;margin-top:22px}
    .pg-fsps-case{grid-template-columns:96px minmax(0,1fr);gap:13px;padding:13px}
    .pg-fsps-case img{width:96px;height:96px}
    .pg-fsps-case h3{font-size:15px}
    .pg-fsps-case p{font-size:12.5px}
    .pg-fsps-tbl{margin-top:26px}
    .pg-fsps-row > div{font-size:13px;padding:12px 6px}
    .pg-fsps-row.hd > div{font-size:12.5px;padding:13px 6px}
    .pg-fsps-cta{display:flex;width:100%;margin-top:28px;padding:16px 12px}
  }
  /* phones: the bold label only, in two short lines under a big icon. The
     second line is a bare text node, so it is hidden by zeroing the span's
     type and giving the label its size back. */
  @media (max-width:600px){
    #pgx .pg-fsps-ben{gap:6px}
    #pgx .pg-fsps-ben li{gap:8px}
