    <div class="pg-fsps-grid">
      <div class="pg-fsps-feat"><span class="ic"><svg viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"/></svg></span><h3>Quad-Core</h3><p>H700 chip runs 8-bit to PS1 and N64.</p></div>
      <div class="pg-fsps-feat"><span class="ic"><svg viewBox="0 0 24 24"><path d="M7 3h7.5L19 7.5V20a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M9.5 3v3.5M12.5 3v3.5"/><path d="M12.5 11.5v6M9.5 14.5h6"/></svg></span><h3>Your Games</h3><p>Drag and drop your files, up to 512GB.</p></div>
      <div class="pg-fsps-feat"><span class="ic"><svg viewBox="0 0 24 24"><path d="M4 13.2L7.2 3.5h9.6l-3.2 9.7z"/><path d="M7.1 11l1.9-5.6h5.6L12.7 11z"/><rect x="3" y="13.2" width="13.3" height="7.3" rx="1.8"/><path d="M6.6 16.9h3M8.1 15.4v3"/><circle cx="13.2" cy="16.9" r=".9" fill="#fff" stroke="none"/><path d="M19.5 6.5l2 1.3-2 1.3M21.5 7.8h-3.3"/></svg></span><h3>Flip Open</h3><p>Magnetic lid sleeps and wakes the console.</p></div>
      <div class="pg-fsps-feat"><span class="ic"><svg viewBox="0 0 24 24"><rect x="2.5" y="8" width="16.5" height="8.5" rx="2"/><path d="M21.5 11v2.5M11.5 9.8l-2.4 2.9h3.2l-2.2 2.6"/></svg></span><h3>3300mAh</h3><p>Up to 8 hours of play, USB-C fast charge.</p></div>
    </div>
  </section>

  {%- if sil or hard or prot -%}
  <section class="pg-fsps-sec">
    <span class="pg-fsps-eye">Protect it</span>
    <h2>Three Add-ons. <span>Protect It Every Day, and on the Road.</span></h2>
    <p class="pg-fsps-lead">All three come in the Max Package, or add any of them to the Single Device&nbsp;bundle.</p>
    <div class="pg-fsps-cases">
      {%- if sil -%}
      <div class="pg-fsps-case">
        <img src="{{ sil.featured_image | image_url: width: 360 }}" alt="{{ sil.title | escape }}" loading="lazy" decoding="async" width="360" height="360">
        <div><span class="tag">Daily</span><h3>Silicone Daily Case</h3><p>A soft silicone sleeve with a lanyard that stays on the console. Grippy in the hand, shrugs off scratches and drops, and the lid still flips.</p><div class="px">{%- if sil.compare_at_price > sil.price -%}<s>{{ sil.compare_at_price | money }}</s>{%- endif -%}{{ sil.price | money }}</div></div>
      </div>
      {%- endif -%}
      {%- if hard -%}
      <div class="pg-fsps-case">
        <img src="{{ hard.featured_image | image_url: width: 360 }}" alt="{{ hard.title | escape }}" loading="lazy" decoding="async" width="360" height="360">
        <div><span class="tag">Travel</span><h3>Hard Shell Travel Case</h3><p>A zip-up hard shell for the bag. Holds the console, its USB-C cable and your microSD cards, and takes the knocks so the console does not.</p><div class="px">{%- if hard.compare_at_price > hard.price -%}<s>{{ hard.compare_at_price | money }}</s>{%- endif -%}{{ hard.price | money }}</div></div>
      </div>
      {%- endif -%}
      {%- if prot -%}
      <div class="pg-fsps-case">
        {%- if prot.featured_image -%}<img src="{{ prot.featured_image | image_url: width: 360 }}" alt="{{ prot.title | escape }}" loading="lazy" decoding="async" width="360" height="360">{%- else -%}<img src="{{ 'pe-r36pro2-protector.jpg' | file_url }}" alt="Tempered glass screen protector" loading="lazy" decoding="async" width="360" height="360">{%- endif -%}
        <div><span class="tag">Screen</span><h3>Tempered Glass Screen Protector</h3><p>Real glass over the 3.5 inch screen, with a cloth and a wipe to fit it clean. Scratches stop at the glass.</p><div class="px">{%- if prot.compare_at_price > prot.price -%}<s>{{ prot.compare_at_price | money }}</s>{%- endif -%}{{ prot.price | money }}</div></div>
      </div>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  <section class="pg-fsps-sec pg-fsps-end">
    <span class="pg-fsps-eye">Side by side</span>
    <h2>Why the Flip SP <span>Stands Out.</span></h2>
    <div class="pg-fsps-tbl" role="table" aria-label="Flip SP compared with a vintage handheld">
      <div class="pg-fsps-row hd" role="row"><div role="columnheader"></div><div class="us" role="columnheader">Flip SP</div><div class="them" role="columnheader">Vintage Handheld</div></div>
      {%- assign rows = 'Games included in the box|30+ systems in one device|Add your own games by microSD|Save anywhere, even mid-level|Flips shut to protect the screen|Expandable storage, up to 512GB|Plays on your TV over HDMI|Brand new with a 30-day guarantee' | split: '|' -%}
      {%- for row in rows -%}
      <div class="pg-fsps-row" role="row"><div role="cell">{{ row }}</div><div class="us" role="cell"><span class="y" aria-label="Yes"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></div><div role="cell"><span class="n" aria-label="No"><svg viewBox="0 0 24 24"><path d="M7 7l10 10M17 7L7 17"/></svg></span></div></div>
      {%- endfor -%}
    </div>
    <span class="pg-fsps-cta" role="button" tabindex="0" data-fsps-cta>Choose Your Bundle <span>&rarr;</span></span>
  </section>
</div>

<script>
(function(){
  if (window.pgFlipStory) return; window.pgFlipStory = 1;

  function seat(){
    var src = document.getElementById('pg-fsps-src');
    var buy = document.querySelector('#pgx .pgx-buy');
    if (src && buy){
      var ben = src.querySelector('[data-fsps="ben"]');
      if (ben){
        var after = buy.querySelector(':scope > .pgx-rating') || buy.querySelector(':scope > .pgx-title');
        if (after) buy.insertBefore(ben, after.nextSibling); else buy.insertBefore(ben, buy.firstChild);
      }
      /* the photo strip follows the bundles: after the Add to cart button and
         its error line where they are still in the column (a desktop), after
         the last tile otherwise. On a phone its flex order does the placing. */
      var shots = src.querySelector('[data-fsps="shots"]') || buy.querySelector(':scope > [data-fsps="shots"]');
      if (shots){
        var after = buy.querySelector(':scope > #pgx-err') || buy.querySelector(':scope > #pgx-atc');
        if (!after){
          var ts = buy.querySelectorAll(':scope > .pgx-tile');
          after = ts.length ? ts[ts.length - 1] : null;
        }
        if (after){ if (after.nextElementSibling !== shots) buy.insertBefore(shots, after.nextSibling); }
        else if (shots.parentNode !== buy) buy.appendChild(shots);
      }
    }
    trust();
    lower();
    loved();
  }

  /* the loved-by pill reads the page's own rating line, so it follows Judge.me */
  function loved(){
    var pill = document.querySelector('#pgx [data-fsps-loved="pill"]');
    var r = document.querySelector('#pgx .pgx-rating strong');
    var l = document.querySelector('#pgx .pgx-rating .pgx-revlink');
    if (!pill || !r || !l) return;
    var n = parseInt((l.textContent || '').replace(/[^\d]/g, ''), 10);
    var txt = 'Rated ' + (r.textContent || '').trim() + '/5' + (n ? ' \u00b7 ' + n + ' reviews' : '');
    if (pill.textContent !== txt) pill.textContent = txt;
  }
  /* the accordions lead the trust block: just before the info box. Skipped
     while they are outside the buy column (pg-acc-place brings them back). */
  function trust(){
    var buy = document.querySelector('#pgx .pgx-buy');
    var acc = document.getElementById('pgx-desc');
    if (!buy || !acc || acc.parentNode !== buy) return;
    var info = buy.querySelector(':scope > .pgx-info');
    if (info && acc.nextElementSibling !== info) buy.insertBefore(acc, info);
  }

  /* product | story | you may also like | reviews. Safe to call any number of
     times: every move is skipped when the node is already in its seat. */
  function lower(){
    var story = document.getElementById('pg-fsps');
    var rev = document.querySelector('#pgx #pg-reviews, #pgx .pgx-rev');
    if (!story || !rev || !rev.parentNode) return;
    var host = rev.parentNode;
    var yml = document.querySelector('.pgu-yml');
    var anchor = rev;
    if (yml){
      if (yml.parentNode !== host || yml.nextElementSibling !== rev) host.insertBefore(yml, rev);
      anchor = yml;
    }
    if (story.parentNode !== host || story.nextElementSibling !== anchor) host.insertBefore(story, anchor);
    watch(host);
    var main = document.querySelector('#pgx .pgx-main');
    if (main && main.parentNode) watch(main.parentNode);
  }
  var queued = false;
  function watch(node){
    if (!node || node.pgFspsObs || !window.MutationObserver) return;
    node.pgFspsObs = 1;
    new MutationObserver(function(){
      if (queued) return;
      queued = true;
      setTimeout(function(){ queued = false; try { lower(); } catch (e){} }, 60);
    }).observe(node, {childList: true});
  }

  function toBundles(){
    var t = document.querySelector('#pgx .pgx-bs') || document.querySelector('#pgx .pgx-tile') || document.querySelector('#pgx .pgx-buy');
    if (!t) return;
    try { t.scrollIntoView({behavior: 'smooth', block: 'start'}); } catch (e){ t.scrollIntoView(); }
  }
  document.addEventListener('click', function(e){
    if (e.target && e.target.closest && e.target.closest('[data-fsps-cta]')) { e.preventDefault(); toBundles(); }
  });
  document.addEventListener('keydown', function(e){
    if ((e.key === 'Enter' || e.key === ' ') && e.target && e.target.closest && e.target.closest('[data-fsps-cta]')){ e.preventDefault(); toBundles(); }
  });

  /* THE PRICE COMPARISON FOLLOWS THE SELECTED TILE (from the Pro 2,
     2026-09-17, "make this change based on if they have max bundle or single
     selected"): the Flip SP card's label, price and games line read the tile
     selected in the buy box, so a shopper on the Max Package compares $129.99
     and both cases, not the single's $104.99. Two consoles say "each". This
     page has three tiles: the Single (qty 1, or 2 in Duo Pack mode), the Duo Max and the
     Max. Polled, like the rest of the page: the tiles repaint on their own
     beat and rebuilds are common. */
  function cmpSet(k, v){
    var el = document.querySelector('#pg-fsps [data-fsps-cmp="' + k + '"]');
    if (el && el.textContent !== v) el.textContent = v;
  }
  function compare(){
    var t = document.querySelector('#pgx .pgx-buy > .pgx-tile.pg-fsp.pgx-sel');
    if (!t) return;
    var kind = t.getAttribute('data-fsp');
    var two = kind === 'duo' || (kind === 'single' && t.getAttribute('data-fsp-qty') === '2');
    var big = kind === 'max' || kind === 'duo';
    var now = t.querySelector('[data-fsp-now]');
    var price = now ? (now.textContent || '').replace(/^\s+|\s+$/g, '') : '';
    cmpSet('eye', kind === 'duo' ? 'Flip SP Duo Max' : big ? 'Flip SP Max' : two ? 'Flip SP Duo' : 'Flip SP');
    /* the first line tells the bundles apart (2026-09-17, "something that differentiates it from the first one") */
    cmpSet('line1', kind === 'duo' ? 'Two Max consoles' : big ? 'Console plus both cases' : two ? 'Two new consoles' : 'New, 30+ systems');
    if (price) cmpSet('price', price);
    cmpSet('games', '5,000+ games' + (two ? ' each' : ''));
    /* the vintage card keeps pace (2026-09-18, "put up the competitor price
       accordingly too"): two consoles double the used-handheld figure from the
       section setting; the Max points out the case the used one lacks */
    if (!window.__fspsVbase){
      var vp = document.querySelector('#pg-fsps [data-fsps-cmp="vprice"]');
      window.__fspsVbase = (vp && parseInt((vp.textContent || '').replace(/[^\d]/g, ''), 10)) || 150;
      window.__fspsVmax = (vp && parseInt(vp.getAttribute('data-fsps-vmax') || '', 10)) || Math.round(window.__fspsVbase * 1.27);
    }
    /* the Max is matched against a used handheld PLUS a case (2026-09-18, "update pricing on left if max was selected"); the Duo Pack doubles the plain figure */
    var vb = big ? window.__fspsVmax : window.__fspsVbase;
    cmpSet('veye', two ? 'Vintage handhelds' : 'Vintage handheld');
    cmpSet('vprice', '~$' + (two ? vb * 2 : vb));
    cmpSet('vline1', two ? (big ? 'Two used, two cases' : 'Two used, no games') : (big ? 'Used, plus a case' : 'Used, one system'));
    cmpSet('vline2', two ? (big ? 'No games' : 'One system each') : 'No games');
  }
  function boot(){ seat(); setTimeout(seat, 500); setTimeout(function(){ trust(); lower(); }, 1600); setTimeout(lower, 3200); compare(); setInterval(compare, 500); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "PG Flip SP Story",
  "settings": [
    {"type": "text", "id": "gba_model", "label": "Vintage handheld named in the price comparison", "default": "Game Boy Advance SP"},
    {"type": "text", "id": "gba_price", "label": "Its typical used price, whole dollars (check PriceCharting)", "default": "150"},
    {"type": "text", "id": "gba_price_max", "label": "Used price plus a case, shown against the Max Package, whole dollars", "default": "190"},
    {"type": "image_picker", "id": "hero_image", "label": "Photo in Your childhood, upgraded (optional; else the in-hand shot)"},
    {"type": "image_picker", "id": "story_image", "label": "Photo beside the price comparison (optional; else Clear Blue)"}
  ],
  "presets": [{"name": "PG Flip SP Story"}]
}
{% endschema %}
