  .pg-fsps-feat h3{margin:0 0 8px;font-family:inherit;font-size:34px;line-height:1.1;font-weight:800;letter-spacing:-.01em;text-wrap:balance;
    background:linear-gradient(100deg,#fff 0%,#D9B3F5 25%,#fff 50%,#D9B3F5 75%,#fff 100%);background-size:200% 100%;background-position:0% 50%;
