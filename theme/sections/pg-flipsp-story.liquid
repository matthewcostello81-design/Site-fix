  {%- comment -%} no hand-sorted photo order for this product yet (the Pro 2's lists named its own review photos): both empty, every shot gets order 50 {%- endcomment -%}
  {%- assign lead_keys = '' | split: '|' -%}
  {%- assign last_keys = '' | split: '|' -%}
  {%- assign shots = 0 -%}
  {%- capture shots_html -%}
    {%- assign seen = '|' -%}
    {%- for r in jm_all -%}
      {%- assign key = '|' | append: r.uuid | append: '|' -%}
      {%- if r.pictures_urls.size > 0 and shots < 12 -%}
        {%- unless seen contains key -%}
          {%- assign seen = seen | append: r.uuid | append: '|' -%}
          {%- assign shots = shots | plus: 1 -%}
          {%- assign pic = r.pictures_urls.first -%}
          {%- if r.body != blank -%}{%- assign r_text = r.body -%}{%- else -%}{%- assign r_text = r.body_html | strip_html | strip -%}{%- endif -%}
          {%- assign r_stars = r.rating | plus: 0 -%}
          {%- assign pic_url = pic.compact | default: pic.huge | default: pic.original | default: pic.small -%}
          {%- assign ord = 50 -%}
          {%- for k in lead_keys -%}{%- if pic_url contains k -%}{%- assign ord = forloop.index -%}{%- endif -%}{%- endfor -%}
          {%- for k in last_keys -%}{%- if pic_url contains k -%}{%- assign ord = forloop.index | plus: 80 -%}{%- endif -%}{%- endfor -%}
          <a class="pg-fsps-shot" href="#pg-reviews" style="order:{{ ord }}">
            <img src="{{ pic_url }}" alt="Customer photo from {{ r.reviewer_name | default: 'a verified buyer' | escape }}" loading="lazy" decoding="async" referrerpolicy="no-referrer" width="400" height="500">
            <span class="pg-fsps-cap">
              <span class="st">{%- for s in (1..5) -%}{%- if s <= r_stars -%}&#9733;{%- else -%}&#9734;{%- endif -%}{%- endfor -%}</span>
              <span class="nm">{{ r.reviewer_name | default: 'Verified buyer' | escape }}</span>
              {%- if r_text != blank -%}<span class="tx">{{ r_text | escape }}</span>{%- endif -%}
            </span>
          </a>
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if shots > 2 -%}
  <div class="pg-fsps-shots" data-fsps="shots">
    <div class="pg-fsps-loved"><span class="pg-fsps-loved-pill"><span class="st" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span data-fsps-loved="pill">{%- if jm and jm.average_rating -%}Rated {{ jm.average_rating | times: 1.0 | round: 1 }}/5 &middot; {{ jm.number_of_reviews }} reviews{%- else -%}Rated by verified buyers{%- endif -%}</span></span><h3>Loved by Gamers<span>Just Like You</span></h3></div>
    <div class="pg-fsps-shots-h"><b>Buyer Reviews</b><span>Swipe &rarr;</span></div>
    <div class="pg-fsps-rail">{{ shots_html }}</div>
