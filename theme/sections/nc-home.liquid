#nc-home .nch-seal svg{width:32px;height:32px}
#nc-home .nch-promise h2{font-size:clamp(24px,3vw,34px);font-weight:800;margin-bottom:12px}
#nc-home .nch-promise p{color:var(--ink-soft);font-size:16.5px;max-width:48ch;margin:0 auto;line-height:1.55}
#nc-home .nch-news{padding:62px 24px 30px}
#nc-home .nch-news-in{background:linear-gradient(135deg,#2C6E72,#1d4a52);border-radius:26px;padding:clamp(32px,4vw,52px);display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center}
#nc-home .nch-news-text h2{color:#fff;font-size:clamp(23px,2.6vw,32px);font-weight:800;margin-bottom:10px}
#nc-home .nch-news-text p{color:rgba(244,239,231,.85);font-size:15.5px;line-height:1.55;margin:0}
#nc-home .nch-news-form{display:flex;gap:10px}
#nc-home .nch-news-form input{flex:1;min-width:0;padding:15px 18px;border-radius:12px;border:none;font-size:15px;background:#fff;color:var(--ink)}
#nc-home .nch-news-form button{border:none;background:var(--ember);color:#fff;font-weight:700;font-size:15px;padding:0 24px;border-radius:12px;cursor:pointer;transition:.18s}
#nc-home .nch-news-form button:hover{background:var(--ember-dark)}
@media(prefers-reduced-motion:reduce){#nc-home *{animation:none!important;transition:none!important}#nc-home .nch-reveal{opacity:1;transform:none}}
@media(max-width:900px){
#nc-home .nch-hero-in{grid-template-columns:1fr;gap:30px;padding:44px 22px 50px}
#nc-home .nch-hero-bg{display:none}
#nc-home .nch-hero-media{aspect-ratio:4/3}
#nc-home .nch-hf{max-width:none}
{% comment %}2026-09-23: returns removed site-wide by owner request{% endcomment %}
#nc-home .nch-strip-in{grid-template-columns:1fr;gap:14px}
#nc-home .nch-block{padding:46px 22px}
#nc-home .nch-cats{grid-template-columns:1fr;gap:14px}
#nc-home .nch-grid4{grid-template-columns:1fr 1fr;gap:12px}
#nc-home .nch-explain-in{grid-template-columns:1fr;gap:24px}
#nc-home .nch-cmp{overflow-x:auto}
#nc-home .nch-finder-in{grid-template-columns:1fr;gap:16px}
#nc-home .nch-finder-form{flex-direction:column;align-items:stretch}
#nc-home .nch-finder-btn{justify-content:center}
#nc-home .nch-sel{min-width:0}
#nc-home .nch-bens{grid-template-columns:1fr 1fr;gap:12px}
#nc-home .nch-state-in{grid-template-columns:1fr;gap:24px}
#nc-home .nch-steps{grid-template-columns:repeat(2,1fr)}
#nc-home .nch-contact-in{flex-direction:column;align-items:flex-start}
#nc-home .nch-news-in{grid-template-columns:1fr;gap:18px}
#nc-home .nch-head.nch-row{flex-direction:row}
}
@media(max-width:560px){
#nc-home .nch-hf{grid-template-columns:repeat(2,1fr);gap:14px}
#nc-home .nch-bens{grid-template-columns:1fr}
#nc-home .nch-steps{grid-template-columns:1fr}
#nc-home .nch-pcard{width:220px}
#nc-home .nch-news-form{flex-direction:column}
#nc-home .nch-news-form button{padding:14px}
#nc-home .nch-cmp-prod img{max-width:130px}
}

/* NC desktop fixes: tighten Shop-the-collection band (issue 11) + make Bestsellers row fill width (issue 12) */
@media (min-width:750px){
  #nc-home .nch-block:has(.nch-cats){padding-top:36px!important;padding-bottom:36px!important}
  #nc-home .nch-cats{gap:16px}
  #nc-home .nch-cat-media{aspect-ratio:4/3}
  #nc-home .nch-rail{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;overflow:visible;scroll-snap-type:none}
  #nc-home .nch-rail .nch-pcard{width:auto;flex:initial;scroll-snap-align:none}
}

/* NC hero: MOBILE ONLY. Stack single-column with the video ABOVE the title. Desktop keeps the original side-by-side 2-column grid (grid-template-columns:1.02fr .98fr) defined above. */
@media (max-width:900px){
#nc-home .nch-hero-in{grid-template-columns:1fr;justify-items:center;text-align:center}
#nc-home .nch-hero-media{order:-1;width:100%}
#nc-home .nch-hero-text{order:0;width:100%}
#nc-home .nch-hero-text .nch-hf,#nc-home .nch-hero-text .nch-h1,#nc-home .nch-hero-text .nch-lede{margin-left:auto;margin-right:auto}
#nc-home .nch-hero-text .nch-cta,#nc-home .nch-hero-text .nch-hero-trust{justify-content:center}
}
</style>

<script>
(function(){
var root=document.getElementById('nc-home');if(!root)return;
function reveal(){
  var els=root.querySelectorAll('.nch-reveal');
  if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in');});return;}
  var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:.12});
  els.forEach(function(e,i){e.style.transitionDelay=((i%4)*60)+'ms';io.observe(e);});
}
function drag(){
  root.querySelectorAll('.nch-rail[data-drag]').forEach(function(r){
    var down=false,sx=0,sl=0,moved=false;
    r.addEventListener('pointerdown',function(e){down=true;moved=false;sx=e.clientX;sl=r.scrollLeft;});
    r.addEventListener('pointermove',function(e){if(!down)return;var d=e.clientX-sx;if(Math.abs(d)>5){moved=true;r.classList.add('nch-drag');}r.scrollLeft=sl-d;});
    function end(){down=false;r.classList.remove('nch-drag');}
    r.addEventListener('pointerup',end);r.addEventListener('pointercancel',end);r.addEventListener('pointerleave',end);
    r.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(e){if(moved){e.preventDefault();}});});
  });
}
function herovid(){
  var st=document.getElementById('nch-vstack');if(!st)return;
  var vids=Array.prototype.slice.call(st.querySelectorAll('.nch-vid'));if(vids.length<2){if(vids[0]){vids[0].play().catch(function(){});}return;}
  var dotsWrap=document.getElementById('nch-vdots');var dots=[];
  vids.forEach(function(v,i){v.play().catch(function(){});if(dotsWrap){var s=document.createElement('span');if(i===0)s.className='on';s.addEventListener('click',function(){show(i);});dotsWrap.appendChild(s);dots.push(s);}});
  var idx=0,timer=null;
  function show(n){vids[idx].classList.remove('on');if(dots[idx])dots[idx].className='';idx=(n+vids.length)%vids.length;vids[idx].classList.add('on');if(dots[idx])dots[idx].className='on';try{vids[idx].currentTime=0;vids[idx].play();}catch(e){}reset();}
  function reset(){if(timer)clearTimeout(timer);timer=setTimeout(function(){show(idx+1);},3500);}
  reset();
}
function finder(){
  var b=document.getElementById('nchf-go');if(!b)return;
  b.addEventListener('click',function(){
    var a=document.getElementById('nchf-area');
    var h=a&&a.value?a.value:'';
    if(h){location.href=h;}else{location.href='/collections/massage-recovery-1';}
  });
}
function go(){reveal();drag();herovid();finder();}
if(document.readyState!=='loading'){go();}else{document.addEventListener('DOMContentLoaded',go);}
})();
</script>

