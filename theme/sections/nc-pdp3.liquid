#ncpdp .nc2-sysd-dot.p3{top:58% !important;left:32% !important;right:auto !important;bottom:auto !important}
#ncpdp .nc2-sysd-dot.p4{top:61% !important;left:58% !important;right:auto !important;bottom:auto !important}
