  #ncpdp .nc2-tl .nc2-tl-node{flex-direction:column !important;align-items:flex-start !important;justify-content:center !important;gap:2px !important;margin-bottom:10px !important;text-align:left !important}
  #ncpdp .nc2-tl .nc2-tl-node b{background:#0F2A33 !important;color:#fff !important;padding:4px 12px !important;border-radius:100px !important;font-size:12.5px !important;box-shadow:0 5px 13px -5px rgba(15,42,51,.5) !important}
  #ncpdp .nc2-tl .nc2-tl-node small{background:transparent !important;padding:0 !important;border-radius:0 !important;box-shadow:none !important;color:#7a8a86 !important;font-weight:700 !important;font-size:12px !important;letter-spacing:.02em !important}
