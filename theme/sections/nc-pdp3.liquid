#ncpdp video{transform:translateZ(0) !important;backface-visibility:hidden !important}
</style>
<script>
(function(){
  function qbIcons(){return;}
  function fixCopy(){var e=document.querySelectorAll('#ncpdp .nc2-sysd .nc-lede');for(var i=0;i<e.length;i++){if(/hover the numbers/i.test(e[i].textContent))e[i].textContent=e[i].textContent.replace(/hover the numbers to see /i,'See ');}}
  function loopVids(){var v=document.querySelectorAll('#ncpdp video, #nc-home video, section#nc-home video, .shopify-section video');for(var i=0;i<v.length;i++){(function(x){if(!x._ncmp4){var mp4=null;x.querySelectorAll('source').forEach(function(s){if((s.getAttribute('type')||'').indexOf('mp4')>-1&&!mp4)mp4=s.getAttribute('src');});if(mp4&&(x.currentSrc||'').indexOf('.mp4')<0){x._ncmp4=1;x.setAttribute('src',mp4);x.load();}}x.loop=true;x.muted=true;x.defaultMuted=true;x.setAttribute('loop','');x.setAttribute('muted','');x.setAttribute('playsinline','');x.setAttribute('webkit-playsinline','');x.setAttribute('autoplay','');x.setAttribute('preload','auto');x.removeAttribute('controls');if(!x._ncl){x._ncl=1;x.addEventListener('ended',function(){try{x.currentTime=0;}catch(e){}var q=x.play();if(q&&q.catch)q.catch(function(){});});}var p=x.play();if(p&&p.catch)p.catch(function(){});})(v[i]);}}
  function vidsInView(){var vs=document.querySelectorAll('#ncpdp video, #nc-home video, section#nc-home video, .shopify-section video');if(!vs.length)return;if(!window.IntersectionObserver){return;}if(window.__ncVIO){vs.forEach(function(v){if(!v.__ncObs){v.__ncObs=1;window.__ncVIO.observe(v);}});return;}window.__ncVIO=new IntersectionObserver(function(es){es.forEach(function(en){var v=en.target;if(en.isIntersecting&&en.intersectionRatio>=0.5){v.muted=true;v.setAttribute('muted','');v.setAttribute('playsinline','');v.setAttribute('webkit-playsinline','');var p=v.play();if(p&&p.catch)p.catch(function(){});}else{try{v.pause();}catch(e){}}});},{threshold:[0,0.5,1]});vs.forEach(function(v){if(!v.__ncObs){v.__ncObs=1;window.__ncVIO.observe(v);}});}
  function introOrder(){
    var mob=window.matchMedia('(max-width:760px)').matches,sp=document.querySelectorAll('#ncpdp .nc-split');
    for(var i=0;i<sp.length;i++){var s=sp[i];if(s.querySelector('.nc-acc'))continue;var txt=s.querySelector('.nc-split-text'),media=s.querySelector('.nc-split-img,.nc-split-vid'),lede=s.querySelector('.nc-lede');if(!txt||!media||!lede)continue;
      if(mob){if(s.lastElementChild!==lede)s.appendChild(lede);}else{if(lede.parentElement!==txt)txt.appendChild(lede);}}
  }
  function railFade(){
    var body=document.querySelector('#ncpdp .nc-body');if(!body)return;var rail=body.querySelector('.nc-rail');if(!rail)return;
    rail.style.height='';rail.style.bottom='';rail.style.overflow='';rail.style.alignSelf='';rail.style.transition='opacity .35s ease';
    var tl=body.querySelector('.nc2-tl');if(!tl){rail.style.opacity='';return;}
    var blk=tl.closest('.nc-block')||tl;var top=blk.getBoundingClientRect().top;var vh=window.innerHeight||document.documentElement.clientHeight;
    rail.style.opacity=top<=vh*0.6?'0':'1';
  }
  function setFinder(id,txt){
    var s=document.getElementById(id);if(!s)return;
    try{if(s.options&&s.options.length)s.options[0].text=txt;}catch(e){}
    var w=s.nextElementSibling;
    if(w&&w.classList&&w.classList.contains('bv_mainselect')){
      var at=w.querySelector('.bv_atual');
      if(at&&at.className.indexOf('done')<0){var sl=at.querySelector('.sl_inner');if(sl){sl.textContent=txt;}else{at.textContent=txt;}}
      var li=w.querySelector('.bv_ul_inner .li:not(.nofocus) .text');if(li){li.textContent=txt;}
    }
  }
  function homeFix(){setFinder('nchf-area','Where does it hurt?');setFinder('nchf-goal','What kind of relief do you want?');}
  function moveBadges(){var pdp=document.getElementById('ncpdp');if(!pdp)return;var b=pdp.querySelector('.nc-badges'),bb=pdp.querySelector('.nc-buybox');if(b&&bb&&!b.dataset.ncMoved){b.dataset.ncMoved='1';bb.appendChild(b);}}
  function buildCmp(){
    var tbl=document.querySelector('#nc-home .nch-cmp-tbl');if(!tbl||tbl.getAttribute('data-nc5'))return;
    var P=[
      {h:'/products/octa-massage-gun-8-head-percussion-massager',i:'https://cdn.shopify.com/s/files/1/0815/5706/1860/files/hf_20260607_012734_2daa4442-fd03-423e-ac8c-bedda99f997d.png?v=1781762872',n:'Octa Massage Gun',p:'$99.99'},
      {h:'/products/vibrating-electric-foam-roller',i:'https://cdn.shopify.com/s/files/1/0815/5706/1860/files/hf_20260701_011815_ec5f7076-5775-46a7-8ea1-18c53a63cf09.png?v=1782871268',n:'Vibrating Foam Roller',p:'$89.99'},
      {h:'/products/electric-heating-pad-adjustable-heat-auto-shut-off',i:'https://cdn.shopify.com/s/files/1/0815/5706/1860/files/hf_20260629_234618_9dc60363-90d5-4566-884a-742726d0ccdc.png?v=1782776922',n:'Electric Heating Pad',p:'$64.99'},
      {h:'/products/foot-therapy-air-wave-massager-for-leg-feet',i:'https://cdn.shopify.com/s/files/1/0815/5706/1860/files/foot-therapy-air-wave-massager-secondary_fdc7ad09-f736-4c8c-ad6a-9b8be68c2b57.png?v=1782695347',n:'Leg &amp; Foot Massager',p:'$159.99'},
      {h:'/products/heated-compression-wrap-knee-elbow-comfort',i:'https://cdn.shopify.com/s/files/1/0815/5706/1860/files/hf_20260607_013202_b24259d9-8363-43d0-ae3a-034e1b4c5275.png?v=1780796642',n:'Knee &amp; Joint Wrap',p:'$84.99'}
    ];
    var R=[
      ['Best for',['Deep muscle knots','Warm-up &amp; rolling','Back &amp; body warmth','Legs &amp; feet','Knees &amp; joints']],
      ['Massage type',['Percussion','Vibration','Radiant heat','Air compression','Heat &amp; compression']],
      ['Soothing heat',['y','n','y','y','y']],
      ['Cordless',['y','y','n','n','y']],
      ['Hands-free',['n','n','y','y','y']],
      ['Travel-friendly',['y','y','y','n','y']]
    ];
    var Y=`<span class='nch-cmp-yes'>&#10003;</span>`,N=`<span class='nch-cmp-no'>&#8211;</span>`;
    var h=`<div class='nch-cmp-row nch-cmp-head'><div class='nch-cmp-lbl'></div>`;
    for(var i=0;i<P.length;i++){h+=`<a class='nch-cmp-prod' href='${P[i].h}'><img src='${P[i].i}' alt='${P[i].n}' loading='lazy'><b>${P[i].n}</b><span>${P[i].p}</span></a>`;}
    h+=`</div>`;
    for(var r=0;r<R.length;r++){h+=`<div class='nch-cmp-row'><div class='nch-cmp-lbl'>${R[r][0]}</div>`;var v=R[r][1];for(var c=0;c<v.length;c++){h+=`<div>${v[c]==='y'?Y:(v[c]==='n'?N:v[c])}</div>`;}h+=`</div>`;}
    tbl.innerHTML=h;tbl.setAttribute('data-nc5','1');
  }
  function go(){try{fixCopy();loopVids();vidsInView();introOrder();railFade();homeFix();buildCmp();moveBadges();qbIcons();}catch(e){}}
  if(document.readyState!=='loading')go();else document.addEventListener('DOMContentLoaded',go);
  window.addEventListener('scroll',function(){try{railFade();}catch(e){}},{passive:true});
  window.addEventListener('resize',function(){try{introOrder();railFade();}catch(e){}});
  window.addEventListener('load',function(){try{go();}catch(e){}});
  setTimeout(go,600);setTimeout(go,1500);setTimeout(function(){homeFix();buildCmp();moveBadges();qbIcons();},2500);
})();
</script>
