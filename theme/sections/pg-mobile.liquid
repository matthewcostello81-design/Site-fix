{%- comment -%}
  PG Mobile: mobile polish + late-loading hotfix layer for the dark PocketEra
  skin. Loads last from footer-group so it wins every tie.
{%- endcomment -%}
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
/* Neon "Pocket Era" wordmark, top-left of every header (text only, no logo) */
.pgx-head,.pgh-head,.pgc-head,.pgf-head{position:relative}
.pg-wordmark{position:absolute;top:30px;left:30px;z-index:5;font-family:'Press Start 2P',monospace;font-size:17px;line-height:1.4;color:#F6DBFF;text-decoration:none;letter-spacing:.04em;text-shadow:0 0 10px rgba(246,196,255,.85),0 0 26px rgba(199,110,255,.6),0 0 52px rgba(139,68,190,.45);transition:text-shadow .2s ease}
.pg-wordmark:hover{text-shadow:0 0 12px rgba(246,196,255,1),0 0 32px rgba(199,110,255,.8),0 0 64px rgba(139,68,190,.6)}
@media(max-width:1100px){.pg-wordmark{display:none}}
</style>
<style>
/* ---------- sitewide hotfixes (not mobile-specific) ---------- */
/* Split banner: cap the height, the natural image ratio made it enormous */
#pgh .pgh-split-r{min-height:0 !important;height:420px !important;overflow:hidden}
#pgh .pgh-split-r img{width:100% !important;height:100% !important;object-fit:cover !important}
#pgh .pgh-split-l{padding:48px 48px !important}
/* Gallery video tile: square cover crop, no letterbox bars */
.pgx-vid video{aspect-ratio:1/1 !important;height:auto !important;max-height:none !important;object-fit:cover !important;width:100% !important}
/* Split banner is clickable through to the R36S page */
#pgh .pgh-split{cursor:pointer}
/* Accordions: same width and gutters as the split banner above them */
#pgh .pgh-acc{max-width:1280px !important;width:100%;margin:26px auto 0 !important;padding:0 24px !important;box-sizing:border-box}
/* Best Sellers heading: matching soft purple letter glow */
#pgh .pgh-h2{text-shadow:0 0 14px rgba(180,120,224,.6),0 0 34px rgba(139,68,190,.5),0 0 70px rgba(139,68,190,.35) !important}
/* Product cards: soft purple glow fading outward, brighter on hover */
#pgh .pgh-card{border-radius:16px;box-shadow:0 0 0 1px rgba(168,120,214,.22),0 0 26px rgba(139,68,190,.26),0 24px 60px -28px rgba(139,68,190,.55) !important;transition:box-shadow .25s ease,transform .25s ease}
#pgh .pgh-card:hover{box-shadow:0 0 0 1px rgba(199,155,234,.42),0 0 36px rgba(139,68,190,.44),0 26px 70px -24px rgba(139,68,190,.7) !important}

@media(max-width:900px){
  /* iOS ignores background-attachment:fixed and repaints badly; scroll + a
     solid dark html behind everything keeps overscroll areas black */
  html{background:#0B0710 !important}
  html,body,#content,main,
  body.template-cart,body.template-cart #content,body.template-cart main{background-attachment:scroll !important}
  html,body{overflow-x:hidden !important;max-width:100vw}
}
@media(max-width:760px){
  #pgh .pgh-split-r{height:240px !important}
}
@media(max-width:560px){
  /* 16px inputs stop iOS Safari from zooming the page on focus */
  .pg-search input,
  #content form[action*='contact'] input:not([type='checkbox']):not([type='radio']):not([type='submit']),
  #content form[action*='contact'] textarea,
  #shopify-section-footer input[type='email'],
  #shopify-section-footer input[type='text']{font-size:16px !important}

  /* comfortable thumb targets in the cart */
  .pgm-qty button{width:36px !important;height:34px !important;font-size:18px !important}
  .pgm-qty span{min-width:32px !important;font-size:14.5px !important}
  .pgm-del{padding:8px !important;font-size:16px !important}
  .pgm-vsel{padding:8px 30px 8px 13px !important;font-size:13px !important;max-width:150px !important}
  .pgm-rec-add{padding:11px 18px !important}
  .pgm-co{padding:16px 20px !important}

  /* homepage cards: tight, even gutters */
  .pgh-wrap{padding-left:14px !important;padding-right:14px !important}
  #pgh .pgh-atc{width:calc(100% - 24px) !important;margin:6px 12px 14px !important;padding:13px 16px !important}
  #pgh .pgh-card-t{font-size:15.5px !important;margin:11px 0 5px !important}
  #pgh .pgh-card-p{font-size:15px !important}

  /* header: keep logo, search and icons on one tidy line */
  .pgh-head-in,.pgx-head-in,.pgc-head-in{padding-left:14px !important;padding-right:14px !important}
  .pgh-ic,.pgx-ic,.pgc-ic{gap:14px !important}

  /* product page: gallery dots and buy bar clear of the thumb */
  #pg-sticky{padding-bottom:calc(10px + env(safe-area-inset-bottom)) !important}
  .pgm-sum{padding-bottom:calc(14px + env(safe-area-inset-bottom)) !important}

  /* footer: stack cleanly */
  #shopify-section-footer .nc-foot-links{gap:22px 34px !important}
  #shopify-section-footer button,#shopify-section-footer [class*='button']{width:100% !important;margin-top:8px !important}
}
</style>

<script>
(function(){
  if (window.pgHotfix) return; window.pgHotfix = 1;
  /* Announcement marquee: authoritative message list (Summer Sale + countdown,
     no retired offers). Rebuilds over whatever the base layer rendered. */
  var MSGS=['Free shipping on all orders','30-day money back guarantee','Free R36S case with purchase of device','15,000+ classic games preloaded'];
  function marq(){
    document.querySelectorAll('.pgh-announce,.pgx-announce,.pgc-announce,.pgf-announce').forEach(function(el){
      if (el.dataset.pgMarq2) return; el.dataset.pgMarq2 = '1';
      var half = MSGS.map(function(m){ return '<span>'+m+' ✦</span>'; }).join('');
      el.innerHTML = '<div class="pg-marq">'+half+half+'</div>';
    });
  }
  /* Rolling 15-minute sale countdown; persists per visitor, restarts on expiry */
  function cd(){
    var els = document.querySelectorAll('.pg-cd');
    if (!els.length) return;
    var end = 0;
    try{ end = parseInt(localStorage.getItem('pgCdEnd')||'0',10); }catch(e){}
    var now = Date.now();
    if (!end || end < now){ end = now + 900000; try{ localStorage.setItem('pgCdEnd', String(end)); }catch(e){} }
    var s = Math.max(0, Math.floor((end-now)/1000));
    var t = Math.floor(s/60)+':'+('0'+(s%60)).slice(-2);
    els.forEach(function(e){ e.textContent = t; });
  }
  /* The whole split banner links to the R36S product page */
  document.addEventListener('click', function(e){
    var sp = e.target.closest('.pgh-split');
    if (sp && !e.target.closest('a.pgh-split-btn')){
      e.preventDefault(); e.stopPropagation();
      window.location.href = '/products/handheld-game-console';
    }
  }, true);
  /* Gallery video: force looping playback even if attributes get stripped */
  function vloop(){
    document.querySelectorAll('.pgx-vid video').forEach(function(v){
      if (v.dataset.pgLoop) return; v.dataset.pgLoop = '1';
      v.loop = true; v.muted = true; v.setAttribute('playsinline','');
      v.addEventListener('ended', function(){ v.currentTime = 0; v.play(); });
      if (v.paused) { var p = v.play(); if (p && p.catch) p.catch(function(){}); }
    });
  }
  /* Inject the wordmark into each PG header */
  function wordmark(){
    document.querySelectorAll('.pgx-head,.pgh-head,.pgc-head,.pgf-head').forEach(function(h){
      if (h.querySelector('.pg-wordmark')) return;
      var a = document.createElement('a');
      a.className = 'pg-wordmark'; a.href = '/'; a.textContent = 'Pocket Era';
      h.appendChild(a);
    });
  }
  function boot(){ marq(); cd(); vloop(); wordmark(); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  setTimeout(boot, 1400);
  setTimeout(boot, 2600);
  setInterval(cd, 1000);
})();
</script>

{% schema %}
{"name": "PG Mobile", "settings": []}
{% endschema %}
