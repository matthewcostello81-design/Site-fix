ateElement('a');a.className='nc-herogift';a.href='/collections/best-sellers';a.innerHTML="<span class='nc-herogift__ic' aria-hidden='true'>\uD83C\uDF81</span><span class='nc-herogift__tx'><b>Free 5-pack resistance bands</b><small>Added free to every order. No code needed.</small></span><span class='nc-herogift__pill'>FREE</span>";host.appendChild(a);return true;}function boot(){if(add())return;var n=0,iv=setInterval(function(){n++;if(add()||n>40)clearInterval(iv);},250);}if(document.readyState!=='loading')boot();else document.addEventListener('DOMContentLoaded',boot);setTimeout(boot,1200);})();</script>{% comment %} Header: flashy free-gift pill, top-left of the header, desktop only. Anchored to .shopify-section-header with inline critical styles + high z-index so it cannot be buried. {% endcomment %}<style>@keyframes ncHdrGiftShine{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}@keyframes ncHdrGiftPulse{0%,100%{box-shadow:0 8px 18px -7px rgba(200,92,34,.6)}50%{box-shadow:0 12px 28px -6px rgba(217,118,58,.95),0 0 16px 1px rgba(217,118,58,.5)}}.nc-hdr-gift{gap:8px;padding:11px 18px;border-radius:100px;background:linear-gradient(120deg,#C85C22,#E8935A,#D9763A,#C85C22)!important;background-size:220% 220%!important;color:#fff!important;font-size:13.5px;font-weight:800;letter-spacing:.02em;text-decoration:none;line-height:1;white-space:nowrap;animation:ncHdrGiftShine 6s ease infinite,ncHdrGiftPulse 2.6s ease-in-out infinite}.nc-hdr-gift:hover{filter:brightness(1.07)}@media(max-width:1000px){.nc-hdr-gift{display:none!important}}</style><script>(function(){function add(){if(window.matchMedia&&!window.matchMedia('(min-width:1001px)').matches)return true;var host=document.querySelector('.shopify-section-header')||document.querySelector('#header-outer')||document.querySelector('#header-inner');if(!host)return false;if(document.querySelector('.nc-hdr-gift'))return true;try{if(getComputedStyle(host).position==='static')host.style.position='relative';}catch(e){}var a=document.createElement('a');a.className='nc-hdr-gift';a.href='/collections/best-sellers';a.style.cssText='position:absolute;left:16px;top:50%;transform:translateY(-50%);z-index:9999;display:inline-flex;align-items:center';a.innerHTML='🎁 <span>Free 5-pack resistance bands</span>';host.appendChild(a);return true;}function boot(){if(add())return;var n=0,iv=setInterval(function(){n++;if(add()||n>40)clearInterval(iv);},250);if(window.MutationObserver){var mo=new MutationObserver(function(){if(add()){mo.disconnect();clearInterval(iv);}});mo.observe(document.documentElement,{childList:true,subtree:true});}}if(document.readyState!=='loading')boot();else document.addEventListener('DOMContentLoaded',boot);setTimeout(boot,1000);setTimeout(boot,2500);setTimeout(boot,5000);})();</script>{% schema %}{"name":"NC Hover Image Fit","settings":[]}{% endschema %}