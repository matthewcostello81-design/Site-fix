{% comment %} nc-nohover: card image treatment. Picture 1 = feature-callout (card default + PDP main), picture 2 = lifestyle (revealed on real mouse hover). Callout (1st) contained+letterbox-filled; lifestyle (2nd/hover) cover. Hover swap suppressed while scrolling (cards pointer-events:none during scroll) so it only switches on a genuine mouse hover. Cards ~18% shorter. SALE badge: any dollar-amount badge is converted to a percent. {% endcomment %}<style>#root .l4cl .product-card figure picture:first-of-type,.product-card figure picture:first-of-type{background:linear-gradient(180deg,#F6F1E9,#EBE2D2) !important;transform:none !important}#root .l4cl .product-card figure picture:first-of-type img,.product-card figure picture:first-of-type img{object-fit:contain !important;transform:none !important}#root .l4cl .product-card figure picture:nth-of-type(2),#root .l4cl .product-card figure picture ~ picture,.product-card figure picture:nth-of-type(2),.product-card figure picture ~ picture{background:transparent !important}#root .l4cl .product-card figure picture:nth-of-type(2) img,#root .l4cl .product-card figure picture ~ picture img,.product-card figure picture:nth-of-type(2) img,.product-card figure picture ~ picture img{object-fit:cover !important;transform:none !important}#root .l4cl .product-card figure,#root .l4cl li.legacy-product-card figure,.l4cl .product-card figure{aspect-ratio:310 / 352.6 !important;margin-bottom:0 !important}#root .l4cl .product-card figure + *{margin-top:0 !important;padding-top:6px !important}#root .l4cl .product-card h3{margin-top:0 !important}#root .l4cl .product-card .overlay-sale,.product-card figure .overlay-sale,.product-card .overlay-sale{right:auto !important;width:auto !important;max-width:calc(100% - 24px) !important;display:inline-block !important}body.nc-scrolling #root .l4cl .product-card,body.nc-scrolling .l4cl .product-card,body.nc-scrolling #root .product-card,body.nc-scrolling .product-card{pointer-events:none !important}</style><script>(function(){function sample(pic){if(pic.dataset.ncFill)return;var img=pic.querySelector('img');if(!img)return;var s=img.currentSrc||img.src;if(!s||s.indexOf('data:')===0)return;var p=new Image();p.crossOrigin='anonymous';p.onload=function(){try{var W=p.naturalWidth,H=p.naturalHeight;if(!W)return;var cv=document.createElement('canvas');cv.width=W;cv.height=H;var cx=cv.getContext('2d');cx.drawImage(p,0,0);function px(x,y){var d=cx.getImageData(x,y,1,1).data;return [d[0],d[1],d[2]];}function avg(a,b){return [Math.round((a[0]+b[0])/2),Math.round((a[1]+b[1])/2),Math.round((a[2]+b[2])/2)];}var top=avg(px(3,3),px(W-4,3));var bot=avg(px(3,H-4),px(W-4,H-4));var tC='rgb('+top[0]+','+top[1]+','+top[2]+')';var bC='rgb('+bot[0]+','+bot[1]+','+bot[2]+')';var box=pic.getBoundingClientRect();var frac=0.06;if(box.height>box.width&&box.height>0){frac=(box.height-box.width)/(2*box.height);}if(frac<0)frac=0;if(frac>0.5)frac=0.5;var t=(frac*100).toFixed(2),b=((1-frac)*100).toFixed(2);pic.style.setProperty('background','linear-gradient(180deg,'+tC+' 0%,'+tC+' '+t+'%,'+bC+' '+b+'%,'+bC+' 100%)','important');pic.dataset.ncFill='1';}catch(e){}};p.src=s;}function run(){document.querySelectorAll('.product-card figure picture:first-of-type').forEach(function(pic){var img=pic.querySelector('img');if(!img)return;if(img.complete&&img.naturalWidth)sample(pic);else img.addEventListener('load',function(){sample(pic);},{once:true});});}function digits(str,start){var num='';for(var k=start;k<str.length;k++){var ch=str.charAt(k);if((ch>='0'&&ch<='9')||ch==='.')num+=ch;else if(num)break;}return num;}function allNums(str){var out=[],cur='';for(var j=0;j<str.length;j++){var c=str.charAt(j);if((c>='0'&&c<='9')||c==='.')cur+=c;else{if(cur){var v=parseFloat(cur);if(v>0)out.push(v);}cur='';}}if(cur){var v2=parseFloat(cur);if(v2>0)out.push(v2);}return out;}function fixBadge(){var bs=document.querySelectorAll('.overlay-sale');for(var i=0;i<bs.length;i++){var b=bs[i];var t=b.textContent||'';var di=t.indexOf('$');if(di<0)continue;var D=parseFloat(digits(t,di+1));if(!D)continue;var card=b.closest('.product-card');if(!card)continue;var pe=card.querySelector('.price');if(!pe)continue;var nums=allNums(pe.textContent||'');if(!nums.length)continue;var P=Math.max.apply(null,nums);var pct=Math.round(D/(P+D)*100);if(pct>0&&pct<100)b.textContent=pct+'% OFF';}}function tick(){run();fixBadge();}if(document.readyState!=='loading')tick();else document.addEventListener('DOMContentLoaded',tick);document.addEventListener('mouseover',function(e){var t=e.target;if(t&&t.closest&&t.closest('.product-card'))run();},true);setTimeout(tick,600);setTimeout(tick,1500);setTimeout(tick,3000);var _nst;function _nscr(){document.body.classList.add('nc-scrolling');clearTimeout(_nst);_nst=setTimeout(function(){document.body.classList.remove('nc-scrolling');},200);}window.addEventListener('scroll',_nscr,{passive:true});window.addEventListener('wheel',_nscr,{passive:true});window.addEventListener('touchmove',_nscr,{passive:true});})();</script>{% comment %} Free-gift bar (.nc-gift-home): match brand cream + teal palette instead of the mint-green gradient, so it reads as an on-brand raised card. Loads last so it wins cleanly. {% endcomment %}<style>#content .nc-gift-home,.nc-gift-home{background:linear-gradient(115deg,#F7F1E3 0%,#EFE4CB 52%,#E6D6B4 100%)!important;border:1px solid rgba(44,110,114,.24)!important;border-radius:18px!important;box-shadow:0 16px 38px -24px rgba(15,42,51,.38)!important}#content .nc-gift-home__eb,.nc-gift-home__eb{color:#2C6E72!important}#content .nc-gift-home__t,.nc-gift-home__t{color:#0F2A33!important}#content .nc-gift-home__s,.nc-gift-home__s{color:#3C5860!important}#content .nc-gift-home__pill,.nc-gift-home__pill{background-image:linear-gradient(135deg,#2C6E72,#15414A,#2C6E72,#15414A)!important;background-size:240% 240%!important;color:#fff!important;box-shadow:0 10px 22px -10px rgba(21,65,74,.6)!important}#content .nc-gift-home,.nc-gift-home{max-width:1040px!impor