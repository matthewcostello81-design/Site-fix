{%- comment -%}
  PG Drawer: Pocketera overrides for the cart drawer (and cart page bars) built by
  nc-cartfix / nc-recs. Loads LAST in overlay-group so its rules win. Swaps the
  drawer logo to the Pocketera logo, recolors the NC green/orange accents to
  purple and black, and hides every recommendation row except the product whose
  URL matches the keep filter (the R36S protective case).
{%- endcomment -%}
{%- assign keep = section.settings.keep_match | default: 'data-frog' -%}
<style>
  /* Drawer top: logo + free-shipping pill */
  #cart#cart#cart img.nc-dlogo{height:110px !important;max-width:300px !important;margin:-6px auto 2px !important;object-fit:contain !important}
  #cart#cart#cart .nc-dship{background:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 45%,#4A1C66 100%) !important;box-shadow:0 10px 22px -12px rgba(122,47,162,.6) !important}
  #cart#cart#cart .nc-dtrust span{color:#7A2FA2 !important}
  #cart#cart#cart .nc-dtrust svg{stroke:#7A2FA2 !important}

  /* Checkout button: black, purple hover */
  #cart#cart#cart button[name="checkout"]{background:#121212 !important;background-image:none !important;background-color:#121212 !important;animation:none !important;box-shadow:0 12px 26px -12px rgba(18,18,18,.55) !important;border-radius:10px !important}
  #cart#cart#cart button[name="checkout"]:hover{background:#7A2FA2 !important;background-color:#7A2FA2 !important}

  /* Discount tier progress: purple */
  #cart#cart#cart .nc-tiers{background:linear-gradient(120deg,#F6EFFB,#EEE0F7) !important;border:1px solid rgba(122,47,162,.25) !important}
  #cart#cart#cart .nc-track-fill{background:linear-gradient(90deg,#9B4BC4,#7A2FA2) !important;animation:none !important}
  #cart#cart#cart .nc-node{border-color:#CBA8E0 !important;background:#fff !important}
  #cart#cart#cart .nc-node.done{background:#7A2FA2 !important;border-color:#7A2FA2 !important;animation:none !important}
  #cart#cart#cart .nc-node.cur{box-shadow:0 0 0 5px rgba(122,47,162,.25) !important}
  #cart#cart#cart .nc-tiers-msg b{color:#7A2FA2 !important}
  #cart#cart#cart .nc-lab.on,#cart#cart#cart .nc-lab.on b{color:#7A2FA2 !important}
  #cart#cart#cart .nc-lab b{color:#2b2b2b !important}

  /* Items card */
  #cart#cart#cart .l4ca:not(.in-panel){background:#fff !important;border:1px solid #e0cdee !important;box-shadow:0 12px 26px -20px rgba(74,28,102,.35) !important}
  #cart#cart#cart .l4ca:not(.in-panel)::before{color:#7A2FA2 !important;border-bottom-color:rgba(122,47,162,.15) !important}

  /* Recommendation rails: purple/black */
  #cart#cart#cart .nc-rec-price{color:#7A2FA2 !important}
  #cart#cart#cart .nc-rec-was{color:#8a8a8a !important}
  #cart#cart#cart .nc-rec-off{background:#7A2FA2 !important;color:#fff !important}
  #cart#cart#cart .nc-rec-add,#cart#cart#cart .nc-recs-panel .nc-rec-add{background:#121212 !important;background-image:none !important;animation:none !important;color:#fff !important;border:none !important}
  #cart#cart#cart .nc-rec-add:hover,#cart#cart#cart .nc-recs-panel .nc-rec-add:hover{background:#7A2FA2 !important;color:#fff !important;filter:none !important}
  #cart#cart#cart .nc-recs-panel{background:linear-gradient(120deg,#F8F3FC,#F1E7F8) !important;border:1px solid rgba(122,47,162,.2) !important}
  #cart#cart#cart .nc-rec:hover{background:rgba(122,47,162,.06) !important}

  /* Only the protective case may appear as a recommendation */
  #cart .nc-rec:not(:has(a[href*="{{ keep }}"])):not([href*="{{ keep }}"]){display:none !important}
  #cart .nc-recs:not(:has([href*="{{ keep }}"])){display:none !important}
  #cart .nc-recs-panel:not(:has([href*="{{ keep }}"])){display:none !important}

  /* Free shipping bar, savings chips, count badge, stepper, upsell note */
  #cart#cart#cart .nc-lsave-off{background:linear-gradient(120deg,#7A2FA2,#9B4BC4) !important;color:#fff !important}
  #cart#cart#cart .nc-cc-badge{background:#7A2FA2 !important}
  #cart#cart#cart .semantic-amount .decr,#cart#cart#cart .semantic-amount .incr{color:#7A2FA2 !important}
  #cart#cart#cart .nc-upsell-note{color:#7A2FA2 !important;background:rgba(122,47,162,.1) !important}

  /* "Shipped for free" bars anywhere (drawer, cart page, express checkout):
     nc-cartfix also paints the gradient on the ::before pseudo, so both layers
     must be recolored. Global on purpose - every lime status bar goes purple. */
  .overlay-lime,
  html .overlay-lime,
  #cart#cart#cart .overlay-lime,
  body.template-cart .overlay-lime{background:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 45%,#4A1C66 100%) !important;border:none !important}
  .overlay-lime::before,
  html .overlay-lime::before,
  #cart#cart#cart .overlay-lime::before{background:linear-gradient(120deg,#9B4BC4 0%,#7A2FA2 45%,#4A1C66 100%) !important}
  .overlay-lime,.overlay-lime *{color:#fff !important;-webkit-text-fill-color:#fff !important}
  body.template-cart .form-cart .l4us li::before{color:#7A2FA2 !important;-webkit-text-fill-color:#7A2FA2 !important}
</style>
<script>
(function(){
  if (window.pgDrawer) return; window.pgDrawer = 1;
  var LOGO = {{ section.settings.logo_image | image_url: width: 420 | json }};
  function fix(){
    var c = document.getElementById('cart');
    if (!c) return;
    var img = c.querySelector('img.nc-dlogo');
    if (img && !img.dataset.pg){ img.dataset.pg = '1'; if (LOGO) img.src = LOGO; img.alt = 'Pocketera'; }
    var t = c.querySelector('.nc-dlogo-txt');
    if (t && t.textContent !== 'POCKETERA') t.textContent = 'POCKETERA';
  }
  function bind(){
    fix();
    var c = document.getElementById('cart');
    if (c){ try { new MutationObserver(fix).observe(c, {childList: true, subtree: true}); } catch(e){} }
  }
  if (document.readyState !== 'loading') bind(); else document.addEventListener('DOMContentLoaded', bind);
  setTimeout(fix, 400); setTimeout(fix, 1200); setTimeout(fix, 3000);
})();
</script>
{% schema %}
{
  "name": "PG Drawer",
  "settings": [
    {"type": "image_picker", "id": "logo_image", "label": "Drawer logo image"},
    {"type": "text", "id": "keep_match", "label": "Only show recommendations whose URL contains", "default": "data-frog"}
  ]
}
{% endschema %}
