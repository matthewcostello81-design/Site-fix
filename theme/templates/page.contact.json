        "faq_1": {
          "type": "text",
          "settings": {
            "faq_question": "When will my order be delivered?",
            "icon": "none",
            "header_image_svg": "",
            "header_image_width": 25,
            "faq_answer": "<p>Orders are typically processed within 1-3 business days. Estimated delivery time is 7-14 business days after processing. Tracking is sent by email when available.</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        },
        "faq_2": {
          "type": "text",
          "settings": {
            "faq_question": "Can I return my product?",
            "icon": "none",
            "header_image_svg": "",
            "header_image_width": 25,
            "faq_answer": "<p>Customers may request a return within 30 days of delivery. Items must be unused, in original condition, and returned in original packaging. Please contact us before sending an item back so we can confirm eligibility and provide return instructions.</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        },
        "faq_3": {
          "type": "text",
          "settings": {
            "faq_question": "What if my item is damaged, defective, or incorrect?",
            "icon": "none",
            "header_image_svg": "",
            "header_image_width": 25,
            "faq_answer": "<p>Contact us within 7 days of delivery with your order number, a description of the issue, and photos of the product and packaging when available. We will review the issue and provide next steps.</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        }
      },
